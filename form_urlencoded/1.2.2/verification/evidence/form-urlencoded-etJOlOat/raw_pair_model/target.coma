function skip_ampersands [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 454 0 454 57] (input: Seq.seq UInt8.t) (start: int) : int

axiom skip_ampersands_def: forall input: Seq.seq UInt8.t, start: int [skip_ampersands input start]. ([%#slib'7] 0
        <= start
      /\ start <= Seq.length input)
    -> skip_ampersands input start
    = ([%#slib'11] if start < Seq.length input /\ UInt8.t'int (Seq.get input start) = 38 then
      skip_ampersands input (start + 1)
    else
      start
    )

axiom skip_ampersands_spec: forall input: Seq.seq UInt8.t, start: int [skip_ampersands input start]. ([%#slib'7] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#slib'8] start <= skip_ampersands input start /\ skip_ampersands input start <= Seq.length input)

axiom skip_ampersands_spec'0: forall input: Seq.seq UInt8.t, start: int [skip_ampersands input start]. ([%#slib'7] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#slib'9] forall i: int. start <= i /\ i < skip_ampersands input start -> UInt8.t'int (Seq.get input i) = 38)

axiom skip_ampersands_spec'1: forall input: Seq.seq UInt8.t, start: int [skip_ampersands input start]. ([%#slib'7] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#slib'10] skip_ampersands input start = Seq.length input
    \/ UInt8.t'int (Seq.get input (skip_ampersands input start)) <> 38)

function find_byte_before [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 469 0 469 79] (input: Seq.seq UInt8.t) (start: int) (end': int) (byte: int) : int

axiom find_byte_before_def:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'2] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> find_byte_before input start end' byte
    = ([%#slib'13] if start < end' /\ UInt8.t'int (Seq.get input start) <> byte then
      find_byte_before input (start + 1) end' byte
    else
      start
    )

axiom find_byte_before_spec:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'2] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'3] start <= find_byte_before input start end' byte /\ find_byte_before input start end' byte <= end')

axiom find_byte_before_spec'0:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'2] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'4] forall i: int. start <= i /\ i < find_byte_before input start end' byte
      -> UInt8.t'int (Seq.get input i) <> byte)

axiom find_byte_before_spec'1:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'2] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'5] find_byte_before input start end' byte = end'
    \/ UInt8.t'int (Seq.get input (find_byte_before input start end' byte)) = byte)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

