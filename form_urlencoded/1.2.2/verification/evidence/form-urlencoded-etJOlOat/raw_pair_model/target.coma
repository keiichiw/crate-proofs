constant start : int

function raw_pair_model [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 528 0 528 81] (input: Seq.seq UInt8.t) (start: int) : t_Option_tup4_Int_Int_Int_Int

goal vc_raw_pair_model: ([%#slib] start = skip_ampersands input 0)
  -> ([%#slib'0] start < Seq.length input)
  -> ([@stop_split] [@expl:find_byte_before requires] [%#slib'2] 0 <= start
    /\ start <= Seq.length input /\ Seq.length input <= Seq.length input)
  /\ (([@stop_split] [@expl:find_byte_before ensures] ([@stop_split] [@expl:find_byte_before ensures #0] [%#slib'3] start
        <= find_byte_before input start (Seq.length input) 38
      /\ find_byte_before input start (Seq.length input) 38 <= Seq.length input)
    /\ ([@stop_split] [@expl:find_byte_before ensures #1] [%#slib'4] forall i: int. start <= i
          /\ i < find_byte_before input start (Seq.length input) 38 -> UInt8.t'int (Seq.get input i) <> 38)
    /\ ([@stop_split] [@expl:find_byte_before ensures #2] [%#slib'5] find_byte_before input start (Seq.length input) 38
      = Seq.length input
    \/ UInt8.t'int (Seq.get input (find_byte_before input start (Seq.length input) 38)) = 38))
  -> (let end' = find_byte_before input start (Seq.length input) 38 in ([@stop_split] [@expl:find_byte_before requires] [%#slib'2] 0
      <= start
    /\ start <= end' /\ end' <= Seq.length input)
  /\ (([@stop_split] [@expl:find_byte_before ensures] ([@stop_split] [@expl:find_byte_before ensures #0] [%#slib'3] start
        <= find_byte_before input start end' 61
      /\ find_byte_before input start end' 61 <= end')
    /\ ([@stop_split] [@expl:find_byte_before ensures #1] [%#slib'4] forall i: int. start <= i
          /\ i < find_byte_before input start end' 61 -> UInt8.t'int (Seq.get input i) <> 61)
    /\ ([@stop_split] [@expl:find_byte_before ensures #2] [%#slib'5] find_byte_before input start end' 61 = end'
    \/ UInt8.t'int (Seq.get input (find_byte_before input start end' 61)) = 61))
  -> (let eq = find_byte_before input start end' 61 in if end' < Seq.length input then
    let next = end' + 1 in [@stop_split] [@expl:raw_pair_model ensures] [%#slib'1] match Some { f0 = start;
                                                                                                f1 = eq;
                                                                                                f2 = end';
                                                                                                f3 = next } with
      | Some {f0 = pair_start; f1 = eq'0; f2 = end''0; f3 = next'0} -> pair_start = start
      /\ pair_start < end''0
      /\ end''0 <= Seq.length input
      /\ pair_start <= eq'0
      /\ eq'0 <= end''0
      /\ (eq'0 < end''0 -> UInt8.t'int (Seq.get input eq'0) = 61)
      /\ (end''0 = Seq.length input \/ UInt8.t'int (Seq.get input end''0) = 38)
      /\ next'0 = (if end''0 < Seq.length input then end''0 + 1 else end''0)
      | None -> false
      end
  else
    let next = end' in [@stop_split] [@expl:raw_pair_model ensures] [%#slib'1] match Some { f0 = start;
                                                                                            f1 = eq;
                                                                                            f2 = end';
                                                                                            f3 = next } with
      | Some {f0 = pair_start; f1 = eq'0; f2 = end''0; f3 = next'0} -> pair_start = start
      /\ pair_start < end''0
      /\ end''0 <= Seq.length input
      /\ pair_start <= eq'0
      /\ eq'0 <= end''0
      /\ (eq'0 < end''0 -> UInt8.t'int (Seq.get input eq'0) = 61)
      /\ (end''0 = Seq.length input \/ UInt8.t'int (Seq.get input end''0) = 38)
      /\ next'0 = (if end''0 < Seq.length input then end''0 + 1 else end''0)
      | None -> false
      end
  ))))
