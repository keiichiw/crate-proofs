use creusot.int.UInt8
use seq.Seq
use map.Map
use int.Int

function index_Mapping_u8_u8 [@inline:trivial] (self: Map.map UInt8.t UInt8.t) (a: UInt8.t) : UInt8.t =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_u8

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t UInt8.t) : Seq.seq UInt8.t

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t UInt8.t [map_u8 self m]. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t UInt8.t [map_u8 self m]. [%#sseq'1] forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_u8 m (Seq.get self i)

function replace_plus_model [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/plus_model.rs" 7 0 7 52] (bytes: Seq.seq UInt8.t) : Seq.seq UInt8.t
 = [%#splus_model'2] map_u8 bytes (fun (byte: UInt8.t) -> if UInt8.t'int byte = 43 then (32: UInt8.t) else byte)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant bytes : Seq.seq UInt8.t

predicate no_plus_identity [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/plus_model.rs" 16 0 16 47] (bytes: Seq.seq UInt8.t)

goal vc_no_plus_identity: ([%#splus_model] forall i: int. 0 <= i /\ i < Seq.length bytes
      -> UInt8.t'int (Seq.get bytes i) <> 43)
  -> ([@stop_split] [@expl:no_plus_identity ensures] ([@stop_split] [@expl:no_plus_identity ensures #0] [%#splus_model'0] true)
  /\ ([@stop_split] [@expl:no_plus_identity ensures #1] [%#splus_model'1] replace_plus_model bytes = bytes))
