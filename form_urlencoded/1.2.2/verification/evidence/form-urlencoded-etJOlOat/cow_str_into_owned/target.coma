use seq.Seq
use creusot.prelude.Any

type t_String

type t_Cow_str = Borrowed string | Owned t_String

let elim_Owned (_x: t_Cow_str) (return (f0: t_String)) = any
  [ _k (f0: t_String) -> {Owned f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Owned] match _x with
      | Owned _ -> true
      | _ -> false
      end}
    any) ]

let elim_Borrowed (_x: t_Cow_str) (return (f0: string)) = any
  [ _k (f0: string) -> {Borrowed f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Borrowed] match _x with
      | Borrowed _ -> true
      | _ -> false
