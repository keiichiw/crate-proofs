predicate inv_String (_1: t_String)

function view_String (self: t_String) : Seq.seq Char.t

function view_str (self: string) : Seq.seq Char.t

let to_owned_str (self_: string) (return (x: t_String)) = any
  [ return (result: t_String) ->
  {[@stop_split] [@expl:to_owned_str ensures] ([@stop_split] [@expl:to_owned result type invariant] inv_String result)
    /\ ([@stop_split] [@expl:to_owned ensures] [%#sstring] view_String result = view_str self_)}
    (! return {result}) ]

predicate inv_Cow_str (_1: t_Cow_str)

axiom inv_axiom [@rewrite]: forall x: t_Cow_str [inv_Cow_str x]. inv_Cow_str x
    = match x with
      | Borrowed f0 -> true
      | Owned f0 -> inv_String f0
      end

