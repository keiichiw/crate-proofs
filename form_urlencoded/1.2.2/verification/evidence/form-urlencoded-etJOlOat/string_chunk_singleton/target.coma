goal vc_string_chunk_singleton:
  [@stop_split] [@expl:string_chunk_singleton ensures] ([@stop_split] [@expl:string_chunk_singleton ensures #0] [%#slib] true)
  /\ ([@stop_split] [@expl:string_chunk_singleton ensures #1] [%#slib'0] map_ref_str (Seq.singleton s) (fun (x: string) -> string_chunk_bytes x)
