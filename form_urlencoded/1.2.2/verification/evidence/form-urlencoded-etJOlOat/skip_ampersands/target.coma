use creusot.int.UInt8
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq UInt8.t

constant start : int

function skip_ampersands [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 454 0 454 57] (input: Seq.seq UInt8.t) (start: int) : int

goal vc_skip_ampersands: ([%#slib'0] 0 <= start /\ start <= Seq.length input)
  -> (if start < Seq.length input then
    if UInt8.t'int (Seq.get input start) = 38 then
      (([@stop_split] [@expl:skip_ampersands requires] [%#slib'0] 0 <= start + 1 /\ start + 1 <= Seq.length input)
        /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length input
        - start) ([%#slib] Seq.length input - (start + 1))))
      /\ (([@stop_split] [@expl:skip_ampersands ensures] ([@stop_split] [@expl:skip_ampersands ensures #0] [%#slib'1] start
              + 1
            <= skip_ampersands input (start + 1)
          /\ skip_ampersands input (start + 1) <= Seq.length input)
        /\ ([@stop_split] [@expl:skip_ampersands ensures #1] [%#slib'2] forall i: int. start + 1 <= i
              /\ i < skip_ampersands input (start + 1) -> UInt8.t'int (Seq.get input i) = 38)
        /\ ([@stop_split] [@expl:skip_ampersands ensures #2] [%#slib'3] skip_ampersands input (start + 1)
          = Seq.length input
        \/ UInt8.t'int (Seq.get input (skip_ampersands input (start + 1))) <> 38))
      -> (let result = skip_ampersands input (start
      + 1) in [@stop_split] [@expl:skip_ampersands ensures] ([@stop_split] [@expl:skip_ampersands ensures #0] [%#slib'1] start
          <= result
        /\ result <= Seq.length input)
      /\ ([@stop_split] [@expl:skip_ampersands ensures #1] [%#slib'2] forall i: int. start <= i /\ i < result
          -> UInt8.t'int (Seq.get input i) = 38)
      /\ ([@stop_split] [@expl:skip_ampersands ensures #2] [%#slib'3] result = Seq.length input
      \/ UInt8.t'int (Seq.get input result) <> 38)))
    else
      let result = start in [@stop_split] [@expl:skip_ampersands ensures] ([@stop_split] [@expl:skip_ampersands ensures #0] [%#slib'1] start
          <= result
        /\ result <= Seq.length input)
      /\ ([@stop_split] [@expl:skip_ampersands ensures #1] [%#slib'2] forall i: int. start <= i /\ i < result
          -> UInt8.t'int (Seq.get input i) = 38)
      /\ ([@stop_split] [@expl:skip_ampersands ensures #2] [%#slib'3] result = Seq.length input
      \/ UInt8.t'int (Seq.get input result) <> 38)
  
  else
    let result = start in [@stop_split] [@expl:skip_ampersands ensures] ([@stop_split] [@expl:skip_ampersands ensures #0] [%#slib'1] start
        <= result
      /\ result <= Seq.length input)
    /\ ([@stop_split] [@expl:skip_ampersands ensures #1] [%#slib'2] forall i: int. start <= i /\ i < result
        -> UInt8.t'int (Seq.get input i) = 38)
    /\ ([@stop_split] [@expl:skip_ampersands ensures #2] [%#slib'3] result = Seq.length input
    \/ UInt8.t'int (Seq.get input result) <> 38)
  )
