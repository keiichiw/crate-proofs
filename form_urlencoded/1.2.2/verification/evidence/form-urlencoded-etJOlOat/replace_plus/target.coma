      /\ (forall j: int. 0 <= j /\ j < UInt64.t'int i -> UInt8.t'int (Seq.get (Slice64.view input) j) <> 43)
      | None -> forall j: int. 0 <= j /\ j < Seq.length (Slice64.view input)
        -> UInt8.t'int (Seq.get (Slice64.view input) j) <> 43
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_usize) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
