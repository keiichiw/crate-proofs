type t_Option_usize = None | Some UInt64.t

let find_plus (input: Slice64.slice UInt8.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) -> {[@stop_split] [@expl:find_plus ensures] [%#slib'7] match result with
