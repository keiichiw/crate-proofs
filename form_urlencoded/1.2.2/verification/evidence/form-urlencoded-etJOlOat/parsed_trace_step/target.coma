function utf8_step [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/stdlib_models.rs" 26 0 26 63] (bytes: Seq.seq int) (pos: int) : tup3_Int_Int_bool
 = [%#sstdlib_models'4] let b0 = Seq.get bytes pos in let remaining = Seq.length bytes - pos in if 0 <= b0
  /\ b0 <= 127 then
    { f0'1 = b0; f1'1 = 1; f2'1 = true }
  else
    if 194 <= b0 /\ b0 <= 223 then
      if remaining < 2 then
        { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
      else
        let b1 = Seq.get bytes (pos + 1) in if 128 <= b1 /\ b1 <= 191 then
          { f0'1 = (b0 - 192) * 64 + (b1 - 128); f1'1 = 2; f2'1 = true }
        else
          { f0'1 = 65533; f1'1 = 1; f2'1 = false }
      
    
    else
      if 224 <= b0 /\ b0 <= 239 then
        if remaining < 2 then
          { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
        else
          let b1 = Seq.get bytes (pos + 1) in let second_ok = if b0 = 224 then
            160 <= b1 /\ b1 <= 191
          else
            if b0 = 237 then 128 <= b1 /\ b1 <= 159 else 128 <= b1 /\ b1 <= 191
           in if not second_ok then
            { f0'1 = 65533; f1'1 = 1; f2'1 = false }
          else
            if remaining < 3 then
              { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
            else
              let b2 = Seq.get bytes (pos + 2) in if 128 <= b2 /\ b2 <= 191 then
                { f0'1 = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128); f1'1 = 3; f2'1 = true }
              else
                { f0'1 = 65533; f1'1 = 2; f2'1 = false }
            
          
        
      
      else
        if 240 <= b0 /\ b0 <= 244 then
          if remaining < 2 then
            { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
          else
            let b1 = Seq.get bytes (pos + 1) in let second_ok = if b0 = 240 then
              144 <= b1 /\ b1 <= 191
            else
              if b0 = 244 then 128 <= b1 /\ b1 <= 143 else 128 <= b1 /\ b1 <= 191
             in if not second_ok then
              { f0'1 = 65533; f1'1 = 1; f2'1 = false }
            else
              if remaining < 3 then
                { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
              else
                let b2 = Seq.get bytes (pos + 2) in if not (128 <= b2 /\ b2 <= 191) then
                  { f0'1 = 65533; f1'1 = 2; f2'1 = false }
                else
                  if remaining < 4 then
                    { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
                  else
                    let b3 = Seq.get bytes (pos + 3) in if 128 <= b3 /\ b3 <= 191 then
                      { f0'1 = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
                        f1'1 = 4;
                        f2'1 = true }
                    else
                      { f0'1 = 65533; f1'1 = 3; f2'1 = false }
                  
                
              
            
          
        
        else
          { f0'1 = 65533; f1'1 = 1; f2'1 = false }
      
    
  


