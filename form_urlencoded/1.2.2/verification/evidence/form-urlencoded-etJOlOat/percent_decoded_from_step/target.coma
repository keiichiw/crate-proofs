use seq.Seq
use int.Int

function percent_hex_value_model [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 360 0 360 48] (byte: int) : int
 = [%#slib'5] if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_decoded_from [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 389 0 389 68] (bytes: Seq.seq int) (index: int) : Seq.seq int

axiom percent_decoded_from_def: forall bytes: Seq.seq int, index: int [percent_decoded_from bytes index]. ([%#slib'3] 0
        <= index
      /\ index <= Seq.length bytes)
    -> percent_decoded_from bytes index
    = ([%#slib'4] if index = Seq.length bytes then
      Seq.empty: Seq.seq int
    else
      let first = Seq.get bytes index in if first = 37 /\ index + 3 <= Seq.length bytes then
        let high = percent_hex_value_model (Seq.get bytes (index
        + 1)) in let low = percent_hex_value_model (Seq.get bytes (index + 2)) in if ge_log_Int high 0
        /\ ge_log_Int low 0 then
          Seq.(++) (Seq.singleton (high * 16 + low)) (percent_decoded_from bytes (index + 3))
        else
          Seq.(++) (Seq.singleton first) (percent_decoded_from bytes (index + 1))
      
      else
        Seq.(++) (Seq.singleton first) (percent_decoded_from bytes (index + 1))
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant bytes : Seq.seq int

constant index : int

predicate percent_decoded_from_step [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 425 0 425 69] (bytes: Seq.seq int) (index: int)

goal vc_percent_decoded_from_step: ([%#slib] 0 <= index /\ index < Seq.length bytes)
  -> ([@stop_split] [@expl:percent_decoded_from_step ensures] ([@stop_split] [@expl:percent_decoded_from_step ensures #0] [%#slib'0] true)
  /\ ([@stop_split] [@expl:percent_decoded_from_step ensures #1] [%#slib'1] percent_decoded_from bytes index
  = (if Seq.get bytes index = 37
  /\ index + 3 <= Seq.length bytes
  /\ ge_log_Int (percent_hex_value_model (Seq.get bytes (index + 1))) 0
  /\ ge_log_Int (percent_hex_value_model (Seq.get bytes (index + 2))) 0 then
    Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get bytes (index + 1)) * 16
    + percent_hex_value_model (Seq.get bytes (index + 2)))) (percent_decoded_from bytes (index + 3))
  else
    Seq.(++) (Seq.singleton (Seq.get bytes index)) (percent_decoded_from bytes (index + 1))
  )))
