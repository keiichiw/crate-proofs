meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_ByteSerialize. forall result: tup2_usize_Option_usize. ([%#slib] UInt64.t'int result.f0
          = (if Seq.length (remaining_bytes self_) = 0 then 0 else 1)
        /\ match result.f1 with
          | Some n -> UInt64.t'int n
          = (if Seq.length (remaining_bytes self_) = 0 then 0 else Seq.length (remaining_bytes self_))
          | None -> false
          end)
      -> ([%#siter] forall s: Seq.seq string, i: MutBorrow.t t_ByteSerialize. produces_ByteSerialize self_ s i.current
            /\ completed_ByteSerialize i -> UInt64.t'int result.f0 <= Seq.length s)
      /\ ([%#siter'0] match result.f1 with
        | Some r -> forall s: Seq.seq string, i: t_ByteSerialize. produces_ByteSerialize self_ s i
          -> Seq.length s <= UInt64.t'int r
        | None -> true
        end)
