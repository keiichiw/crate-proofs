      = Seq.length (Slice64.view self_))
    /\ ([@stop_split] [@expl:to_vec ensures #1] [%#sslice'0] forall i: int. 0 <= i
        /\ i < Seq.length (Slice64.view self_)
      -> postcondition_clone () (Seq.get (Slice64.view self_) i) (Seq.get (view_Vec_u8_Global result) i))}
    (! return {result}) ]

