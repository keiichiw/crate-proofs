constant bytes : Seq.seq int

function percent_decoded_model [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 381 0 381 57] (bytes: Seq.seq int) : Seq.seq int

goal vc_percent_decoded_model: [@stop_split] [@expl:percent_decoded_from requires] [%#slib'0] 0 <= 0
  /\ 0 <= Seq.length bytes
