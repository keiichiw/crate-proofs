use creusot.int.UInt8
use seq.Seq
use map.Map
use int.ComputerDivision
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate unchanged_byte [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1174 0 1174 40] (byte: int) =
  [%#slib'3] byte = 42
  \/ byte = 45
  \/ byte = 46 \/ 48 <= byte /\ byte <= 57 \/ 65 <= byte /\ byte <= 90 \/ byte = 95 \/ 97 <= byte /\ byte <= 122

axiom unchanged_byte_spec: forall byte: int [unchanged_byte byte]. [%#slib'2] unchanged_byte byte
    = (byte = 42
    \/ byte = 45
    \/ byte = 46 \/ 48 <= byte /\ byte <= 57 \/ 65 <= byte /\ byte <= 90 \/ byte = 95 \/ 97 <= byte /\ byte <= 122)

function safe_run_end [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1195 0 1195 54] (bytes: Seq.seq UInt8.t) (start: int) : int

axiom safe_run_end_def: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'5] 0 <= start
      /\ start <= Seq.length bytes)
    -> safe_run_end bytes start
    = ([%#slib'10] if start < Seq.length bytes /\ unchanged_byte (UInt8.t'int (Seq.get bytes start)) then
      safe_run_end bytes (start + 1)
    else
      start
    )

axiom safe_run_end_spec: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'5] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'6] start <= safe_run_end bytes start /\ safe_run_end bytes start <= Seq.length bytes)

axiom safe_run_end_spec'0: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'5] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'7] forall i: int. start <= i /\ i < safe_run_end bytes start
      -> unchanged_byte (UInt8.t'int (Seq.get bytes i)))

axiom safe_run_end_spec'1: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'5] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'8] safe_run_end bytes start = Seq.length bytes
    \/ not unchanged_byte (UInt8.t'int (Seq.get bytes (safe_run_end bytes start))))

axiom safe_run_end_spec'2: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'5] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'9] start < Seq.length bytes /\ unchanged_byte (UInt8.t'int (Seq.get bytes start))
    -> start < safe_run_end bytes start)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'1] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function uppercase_hex [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1183 0 1183 39] (digit: int) : int
 = [%#slib'18] if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. [%#slib'17] uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function escaped_byte_chunk [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1205 0 1205 48] (byte: int) : Seq.seq int
 = [%#slib'16] if byte = 32 then
    Seq.singleton 43
  else
    Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex (ComputerDivision.mod byte 16)))


function encoded_chunks [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1220 0 1220 54] (bytes: Seq.seq UInt8.t) : Seq.seq (Seq.seq int)

axiom encoded_chunks_def: forall bytes: Seq.seq UInt8.t [encoded_chunks bytes]. encoded_chunks bytes
    = ([%#slib'14] if Seq.length bytes = 0 then
      Seq.empty: Seq.seq (Seq.seq int)
    else
      let byte = UInt8.t'int (Seq.get bytes 0) in if unchanged_byte byte then
        let end' = safe_run_end bytes 0 in Seq.(++) (Seq.singleton (map_u8 (Seq.([..]) bytes 0 end') (fun (b: UInt8.t) -> UInt8.t'int b))) (encoded_chunks (Seq.([..]) bytes end' (Seq.length bytes)))
      else
        Seq.(++) (Seq.singleton (escaped_byte_chunk byte)) (encoded_chunks (Seq.([..]) bytes 1 (Seq.length bytes)))
    
    )

axiom encoded_chunks_spec: forall bytes: Seq.seq UInt8.t [encoded_chunks bytes]. [%#slib'12] (Seq.length bytes = 0)
    = (Seq.length (encoded_chunks bytes) = 0)

axiom encoded_chunks_spec'0:
  forall bytes: Seq.seq UInt8.t [encoded_chunks bytes]. [%#slib'13] gt_log_Int (Seq.length bytes) 0
    -> 1 <= Seq.length (encoded_chunks bytes) /\ Seq.length (encoded_chunks bytes) <= Seq.length bytes

function byte_sequence_as_ints [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 374 0 374 56] (bytes: Seq.seq UInt8.t) : Seq.seq int
 = [%#slib'15] map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant bytes : Seq.seq UInt8.t

constant end' : int

predicate encoded_chunks_first_run [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1244 0 1244 65] (bytes: Seq.seq UInt8.t) (end': int)

goal vc_encoded_chunks_first_run: ([%#slib] gt_log_Int (Seq.length bytes) 0
    /\ unchanged_byte (UInt8.t'int (Seq.get bytes 0)) /\ end' = safe_run_end bytes 0)
  -> ([@stop_split] [@expl:encoded_chunks_first_run ensures] ([@stop_split] [@expl:encoded_chunks_first_run ensures #0] [%#slib'0] true)
  /\ ([@stop_split] [@expl:encoded_chunks_first_run ensures #1] [%#slib'1] encoded_chunks bytes
  = Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) bytes 0 end'))) (encoded_chunks (Seq.([..]) bytes end' (Seq.length bytes)))))
