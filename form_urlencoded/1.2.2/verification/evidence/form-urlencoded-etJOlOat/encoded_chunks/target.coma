use creusot.int.UInt8
use seq.Seq
use map.Map
use int.ComputerDivision
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate unchanged_byte [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1174 0 1174 40] (byte: int) =
  [%#slib'8] byte = 42
  \/ byte = 45
  \/ byte = 46 \/ 48 <= byte /\ byte <= 57 \/ 65 <= byte /\ byte <= 90 \/ byte = 95 \/ 97 <= byte /\ byte <= 122

axiom unchanged_byte_spec: forall byte: int [unchanged_byte byte]. [%#slib'2] unchanged_byte byte
    = (byte = 42
    \/ byte = 45
    \/ byte = 46 \/ 48 <= byte /\ byte <= 57 \/ 65 <= byte /\ byte <= 90 \/ byte = 95 \/ 97 <= byte /\ byte <= 122)

function safe_run_end [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1195 0 1195 54] (bytes: Seq.seq UInt8.t) (start: int) : int

axiom safe_run_end_def: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'3] 0 <= start
      /\ start <= Seq.length bytes)
    -> safe_run_end bytes start
    = ([%#slib'10] if start < Seq.length bytes /\ unchanged_byte (UInt8.t'int (Seq.get bytes start)) then
      safe_run_end bytes (start + 1)
    else
      start
    )

axiom safe_run_end_spec: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'3] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'4] start <= safe_run_end bytes start /\ safe_run_end bytes start <= Seq.length bytes)

axiom safe_run_end_spec'0: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'3] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'5] forall i: int. start <= i /\ i < safe_run_end bytes start
      -> unchanged_byte (UInt8.t'int (Seq.get bytes i)))

axiom safe_run_end_spec'1: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'3] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'6] safe_run_end bytes start = Seq.length bytes
    \/ not unchanged_byte (UInt8.t'int (Seq.get bytes (safe_run_end bytes start))))

axiom safe_run_end_spec'2: forall bytes: Seq.seq UInt8.t, start: int [safe_run_end bytes start]. ([%#slib'3] 0 <= start
      /\ start <= Seq.length bytes)
    -> ([%#slib'7] start < Seq.length bytes /\ unchanged_byte (UInt8.t'int (Seq.get bytes start))
    -> start < safe_run_end bytes start)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'0] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function uppercase_hex [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1183 0 1183 39] (digit: int) : int
 = [%#slib'13] if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. [%#slib'12] uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function escaped_byte_chunk [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 1205 0 1205 48] (byte: int) : Seq.seq int
 = [%#slib'11] if byte = 32 then
    Seq.singleton 43
  else
    Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex (ComputerDivision.mod byte 16)))


