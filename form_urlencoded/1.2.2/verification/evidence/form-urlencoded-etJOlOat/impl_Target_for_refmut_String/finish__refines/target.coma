use creusot.prelude.MutBorrow

type t_String

predicate inv_String (_1: t_String)

predicate invariant_refmut_String [@inline:trivial] (self: MutBorrow.t t_String) =
  [%#sinvariant] inv_String self.current /\ inv_String self.final

meta "rewrite_def" predicate invariant_refmut_String

predicate inv_refmut_String [@inline:trivial] (_1: MutBorrow.t t_String) = invariant_refmut_String _1

meta "rewrite_def" predicate inv_refmut_String

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: MutBorrow.t t_String. ([%#slib] inv_refmut_String self)
    -> ([%#slib'0] inv_refmut_String self)
    /\ (forall result: MutBorrow.t t_String. ([%#slib'1] inv_refmut_String result) /\ ([%#slib'2] result = self)
      -> ([%#slib'3] inv_refmut_String result))
