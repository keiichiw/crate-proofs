type tup3_Int_Int_bool = { f0'1: int; f1'1: int; f2'1: bool }

function utf8_step [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/stdlib_models.rs" 26 0 26 63] (bytes: Seq.seq int) (pos: int) : tup3_Int_Int_bool
 = [%#sstdlib_models'4] let b0 = Seq.get bytes pos in let remaining = Seq.length bytes - pos in if 0 <= b0
  /\ b0 <= 127 then
    { f0'1 = b0; f1'1 = 1; f2'1 = true }
  else
    if 194 <= b0 /\ b0 <= 223 then
      if remaining < 2 then
        { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
      else
        let b1 = Seq.get bytes (pos + 1) in if 128 <= b1 /\ b1 <= 191 then
          { f0'1 = (b0 - 192) * 64 + (b1 - 128); f1'1 = 2; f2'1 = true }
        else
          { f0'1 = 65533; f1'1 = 1; f2'1 = false }
      
    
    else
      if 224 <= b0 /\ b0 <= 239 then
        if remaining < 2 then
          { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
        else
          let b1 = Seq.get bytes (pos + 1) in let second_ok = if b0 = 224 then
            160 <= b1 /\ b1 <= 191
          else
            if b0 = 237 then 128 <= b1 /\ b1 <= 159 else 128 <= b1 /\ b1 <= 191
           in if not second_ok then
            { f0'1 = 65533; f1'1 = 1; f2'1 = false }
          else
            if remaining < 3 then
              { f0'1 = 65533; f1'1 = remaining; f2'1 = false }
            else
