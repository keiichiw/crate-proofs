        /\ pair_start < end'
        /\ end' <= Seq.length input
        /\ pair_start <= eq
        /\ eq <= end'
        /\ (eq < end' -> UInt8.t'int (Seq.get input eq) = 61)
        /\ (end' = Seq.length input \/ UInt8.t'int (Seq.get input end') = 38)
        /\ next = (if end' < Seq.length input then end' + 1 else end')
        | None -> false
        end)
    -> match raw_pair_model input start with
      | Some {f0'0 = pair_start; f1'0 = eq; f2'0 = end'; f3'0 = next} -> let name = Seq.([..]) input pair_start eq in if eq
      < end' then
        let value = Seq.([..]) input (eq
        + 1) end' in [@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length input) ([%#slib] Seq.length (Seq.([..]) input next (Seq.length input)))
      else
        let value = Seq.empty: Seq.seq UInt8.t in [@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length input) ([%#slib] Seq.length (Seq.([..]) input next (Seq.length input)))
      
      | None -> true
      end)
  ))
