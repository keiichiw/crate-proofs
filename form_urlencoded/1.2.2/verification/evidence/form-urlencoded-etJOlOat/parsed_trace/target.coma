goal vc_parsed_trace: ([@stop_split] [@expl:skip_ampersands requires] [%#slib'0] 0 <= 0 /\ 0 <= Seq.length input)
  /\ (([@stop_split] [@expl:skip_ampersands ensures] ([@stop_split] [@expl:skip_ampersands ensures #0] [%#slib'1] 0
        <= skip_ampersands input 0
      /\ skip_ampersands input 0 <= Seq.length input)
    /\ ([@stop_split] [@expl:skip_ampersands ensures #1] [%#slib'2] forall i: int. 0 <= i /\ i < skip_ampersands input 0
        -> UInt8.t'int (Seq.get input i) = 38)
    /\ ([@stop_split] [@expl:skip_ampersands ensures #2] [%#slib'3] skip_ampersands input 0 = Seq.length input
    \/ UInt8.t'int (Seq.get input (skip_ampersands input 0)) <> 38))
  -> (let start = skip_ampersands input 0 in if start = Seq.length input then
    true
  else
    ([@stop_split] [@expl:raw_pair_model requires] ([@stop_split] [@expl:raw_pair_model requires #0] [%#slib'4] start
        = skip_ampersands input 0)
      /\ ([@stop_split] [@expl:raw_pair_model requires #1] [%#slib'5] start < Seq.length input))
    /\ (([@stop_split] [@expl:raw_pair_model ensures] [%#slib'6] match raw_pair_model input start with
