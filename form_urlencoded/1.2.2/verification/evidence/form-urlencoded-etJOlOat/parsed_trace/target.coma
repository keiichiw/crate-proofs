  < Seq.length input then
    end' + 1
  else
    end'
   in Some { f0'0 = start; f1'0 = eq; f2'0 = end'; f3'0 = next }

axiom raw_pair_model_spec: forall input: Seq.seq UInt8.t, start: int [raw_pair_model input start]. ([%#slib'4] start
      = skip_ampersands input 0)
