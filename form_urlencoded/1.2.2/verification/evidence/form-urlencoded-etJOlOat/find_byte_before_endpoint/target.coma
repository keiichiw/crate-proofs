use creusot.int.UInt8
use seq.Seq
use int.Int

function find_byte_before [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 469 0 469 79] (input: Seq.seq UInt8.t) (start: int) (end': int) (byte: int) : int

axiom find_byte_before_def:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'6] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> find_byte_before input start end' byte
    = ([%#slib'10] if start < end' /\ UInt8.t'int (Seq.get input start) <> byte then
      find_byte_before input (start + 1) end' byte
    else
      start
    )

axiom find_byte_before_spec:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'6] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'7] start <= find_byte_before input start end' byte /\ find_byte_before input start end' byte <= end')

axiom find_byte_before_spec'0:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'6] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'8] forall i: int. start <= i /\ i < find_byte_before input start end' byte
      -> UInt8.t'int (Seq.get input i) <> byte)

axiom find_byte_before_spec'1:
  forall input: Seq.seq UInt8.t, start: int, end': int, byte: int [find_byte_before input start end' byte]. ([%#slib'6] 0
        <= start
      /\ start <= end' /\ end' <= Seq.length input)
    -> ([%#slib'9] find_byte_before input start end' byte = end'
    \/ UInt8.t'int (Seq.get input (find_byte_before input start end' byte)) = byte)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq UInt8.t

constant start : int

constant end' : int

constant limit : int

constant byte : int

predicate find_byte_before_endpoint [#"/Users/keiichiw/workspace/crate-proofs/form_urlencoded/1.2.2/crate/src/lib.rs" 501 0 507 9] (input: Seq.seq UInt8.t) (start: int) (end': int) (limit: int) (byte: int)

goal vc_find_byte_before_endpoint: ([%#slib'0] 0 <= start
    /\ start <= end' /\ end' <= limit /\ limit <= Seq.length input)
  -> ([%#slib'1] forall i: int. start <= i /\ i < end' -> UInt8.t'int (Seq.get input i) <> byte)
  -> ([%#slib'2] end' = limit \/ UInt8.t'int (Seq.get input end') = byte)
  -> (if start < end' then
    (([@stop_split] [@expl:find_byte_before_endpoint requires] ([@stop_split] [@expl:find_byte_before_endpoint requires #0] [%#slib'0] 0
            <= start + 1
          /\ start + 1 <= end' /\ end' <= limit /\ limit <= Seq.length input)
        /\ ([@stop_split] [@expl:find_byte_before_endpoint requires #1] [%#slib'1] forall i: int. start + 1 <= i
              /\ i < end' -> UInt8.t'int (Seq.get input i) <> byte)
        /\ ([@stop_split] [@expl:find_byte_before_endpoint requires #2] [%#slib'2] end' = limit
        \/ UInt8.t'int (Seq.get input end') = byte))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] end' - start) ([%#slib] end' - (start + 1))))
    /\ (([@stop_split] [@expl:find_byte_before_endpoint ensures] ([@stop_split] [@expl:find_byte_before_endpoint ensures #0] [%#slib'3] find_byte_before_endpoint input (start
        + 1) end' limit byte)
      /\ ([@stop_split] [@expl:find_byte_before_endpoint ensures #1] [%#slib'4] find_byte_before input (start
        + 1) limit byte
      = end'))
    -> ([@stop_split] [@expl:find_byte_before_endpoint ensures] ([@stop_split] [@expl:find_byte_before_endpoint ensures #0] [%#slib'3] find_byte_before_endpoint input (start
      + 1) end' limit byte)
    /\ ([@stop_split] [@expl:find_byte_before_endpoint ensures #1] [%#slib'4] find_byte_before input start limit byte
    = end')))
  else
    [@stop_split] [@expl:find_byte_before_endpoint ensures] ([@stop_split] [@expl:find_byte_before_endpoint ensures #0] [%#slib'3] true)
    /\ ([@stop_split] [@expl:find_byte_before_endpoint ensures #1] [%#slib'4] find_byte_before input start limit byte
    = end')
  )
