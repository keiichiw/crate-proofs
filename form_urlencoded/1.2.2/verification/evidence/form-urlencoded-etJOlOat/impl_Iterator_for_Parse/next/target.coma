                                    f1'1 = cow_str_scalars value }) (parsed_trace (remaining_input self.final))
      /\ parsed_borrow_trace (remaining_input self.current)
        = Seq.(++) (Seq.singleton { f0'3 = cow_str_borrowed key;
                                    f1'3 = cow_str_borrowed value }) (parsed_borrow_trace (remaining_input self.final))
      /\ produces_Parse self.current (Seq.singleton { f0'5 = key; f1'5 = value }) self.final
      end)}
    (! return {result}) ]
