use creusot.slice.Slice64
use creusot.prelude.MutBorrow
use creusot.prelude.Opaque
use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate resolve_refmut_slice_u8 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt8.t)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_slice_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let replace_plus_in_place (bytes: MutBorrow.t (Slice64.slice UInt8.t)) (first: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:replace_plus_in_place requires] UInt64.t'int first < Seq.length (Slice64.view bytes.current)
  /\ UInt8.t'int (Seq.get (Slice64.view bytes.current) (UInt64.t'int first)) = 43
  /\ (forall i: int. 0 <= i /\ i < UInt64.t'int first -> UInt8.t'int (Seq.get (Slice64.view bytes.current) i) <> 43)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &original <- Slice64.view bytes.current ] s1
    | s1 = [ &_11 <- first ] s2
    | s2 = Opaque.fresh_ptr
        (fun (_ptr: Opaque.ptr) -> -{Slice64.slice_ptr_len _ptr = Slice64.length bytes.current}- [ &_12 <- _ptr ] s3)
    | s3 = [ &_13 <- Slice64.slice_ptr_len _12 ] s4
    | s4 = [ &_14 <- UInt64.lt _11 _13 ] s5
    | s5 = {[@expl:index in bounds] _14} s6
    | s6 = Slice64.set <UInt8.t> {bytes.current} {_11} {(32: UInt8.t)}
        (fun (r: Slice64.slice UInt8.t) -> [ &bytes <- { bytes with current = r } ] s7)
    | s7 = UInt64.add {first} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s8)
    | s8 = [ &_old <- bytes.final ] s9
    | s9 = bb3 ]
  | bb3 = bb3
    [ bb3 = {[@expl:inferred invariant: unchanged value] _old = bytes.final}
      {[@expl:loop invariant] UInt64.t'int first < UInt64.t'int i
      /\ UInt64.t'int i <= Seq.length (Slice64.view bytes.current)
      /\ Seq.length (Slice64.view bytes.current) = Seq.length original
      /\ (forall j: int. 0 <= j /\ j < UInt64.t'int i
          -> UInt8.t'int (Seq.get (Slice64.view bytes.current) j)
          = (if UInt8.t'int (Seq.get original j) = 43 then 32 else UInt8.t'int (Seq.get original j)))
      /\ (forall j: int. UInt64.t'int i <= j /\ j < Seq.length (Slice64.view bytes.current)
        -> UInt8.t'int (Seq.get (Slice64.view bytes.current) j) = UInt8.t'int (Seq.get original j))}
      (! s0)
      [ s0 = len_u8 {bytes.current} (fun (_x: UInt64.t) -> [ &_26 <- _x ] s1)
      | s1 = [ &_24 <- UInt64.lt i _26 ] s2
      | s2 = any [ br0 -> {_24 = false} (! bb12) | br1 -> {_24} (! bb6) ] ]
      [ bb6 = s0
        [ s0 = [ &_31 <- i ] s1
        | s1 = Opaque.fresh_ptr
            (fun (_ptr: Opaque.ptr) ->
              -{Slice64.slice_ptr_len _ptr = Slice64.length bytes.current}-
              [ &_32 <- _ptr ] s2)
        | s2 = [ &_33 <- Slice64.slice_ptr_len _32 ] s3
        | s3 = [ &_34 <- UInt64.lt _31 _33 ] s4
        | s4 = {[@expl:index in bounds] _34} s5
        | s5 = Slice64.get <UInt8.t> {bytes.current} {_31} (fun (r: UInt8.t) -> [ &_30 <- r ] s6)
        | s6 = [ &_29 <- _30 = (43: UInt8.t) ] s7
        | s7 = any [ br0 -> {_29 = false} (! bb11) | br1 -> {_29} (! bb8) ] ]
      | bb8 = s0
        [ s0 = [ &_35 <- i ] s1
        | s1 = Opaque.fresh_ptr
            (fun (_ptr: Opaque.ptr) ->
              -{Slice64.slice_ptr_len _ptr = Slice64.length bytes.current}-
              [ &_36 <- _ptr ] s2)
        | s2 = [ &_37 <- Slice64.slice_ptr_len _36 ] s3
        | s3 = [ &_38 <- UInt64.lt _35 _37 ] s4
        | s4 = {[@expl:index in bounds] _38} s5
        | s5 = Slice64.set <UInt8.t> {bytes.current} {_35} {(32: UInt8.t)}
            (fun (r: Slice64.slice UInt8.t) -> [ &bytes <- { bytes with current = r } ] s6)
        | s6 = bb11 ]
      | bb11 = s0 [ s0 = UInt64.add {i} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1) | s1 = bb3 ] ] ]
  | bb12 = s0 [ s0 = -{resolve_refmut_slice_u8 bytes}- s1 | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & bytes: MutBorrow.t (Slice64.slice UInt8.t) = bytes
  | & first: UInt64.t = first
  | & original: Seq.seq UInt8.t = Any.any_l ()
  | & _11: UInt64.t = Any.any_l ()
  | & _12: Opaque.ptr = Any.any_l ()
  | & _13: UInt64.t = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _26: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & _30: UInt8.t = Any.any_l ()
  | & _31: UInt64.t = Any.any_l ()
  | & _32: Opaque.ptr = Any.any_l ()
  | & _33: UInt64.t = Any.any_l ()
  | & _34: bool = Any.any_l ()
  | & _35: UInt64.t = Any.any_l ()
  | & _36: Opaque.ptr = Any.any_l ()
  | & _37: UInt64.t = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _old: Slice64.slice UInt8.t = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:replace_plus_in_place ensures] Seq.length (Slice64.view bytes.final)
      = Seq.length (Slice64.view bytes.current)
    /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes.current)
      -> UInt8.t'int (Seq.get (Slice64.view bytes.final) i)
      = (if UInt8.t'int (Seq.get (Slice64.view bytes.current) i) = 43 then
        32
      else
        UInt8.t'int (Seq.get (Slice64.view bytes.current) i)
      ))}
    (! return {result}) ]
