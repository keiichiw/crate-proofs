use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let byte_serialized_unchanged (byte: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {byte = (42: UInt8.t)} (! bb9)
    | br1 -> {byte = (45: UInt8.t)} (! bb9)
    | br2 -> {byte = (46: UInt8.t)} (! bb9)
    | br3 -> {byte = (95: UInt8.t)} (! bb9)
    | default -> -{byte <> (42: UInt8.t) /\ byte <> (45: UInt8.t) /\ byte <> (46: UInt8.t) /\ byte <> (95: UInt8.t)}-
      (! bb2) ]
  | bb2 = s0
    [ s0 = [ &_8 <- UInt8.le (48: UInt8.t) byte ] s1 | s1 = any [ br0 -> {_8 = false} (! bb3) | br1 -> {_8} (! bb7) ] ]
  | bb7 = s0
    [ s0 = [ &_9 <- UInt8.le byte (57: UInt8.t) ] s1 | s1 = any [ br0 -> {_9 = false} (! bb3) | br1 -> {_9} (! bb9) ] ]
  | bb3 = s0
    [ s0 = [ &_6 <- UInt8.le (65: UInt8.t) byte ] s1 | s1 = any [ br0 -> {_6 = false} (! bb4) | br1 -> {_6} (! bb6) ] ]
  | bb6 = s0
    [ s0 = [ &_7 <- UInt8.le byte (90: UInt8.t) ] s1 | s1 = any [ br0 -> {_7 = false} (! bb4) | br1 -> {_7} (! bb9) ] ]
  | bb4 = s0
    [ s0 = [ &_4 <- UInt8.le (97: UInt8.t) byte ] s1 | s1 = any [ br0 -> {_4 = false} (! bb1) | br1 -> {_4} (! bb5) ] ]
  | bb5 = s0
    [ s0 = [ &_5 <- UInt8.le byte (122: UInt8.t) ] s1 | s1 = any [ br0 -> {_5 = false} (! bb1) | br1 -> {_5} (! bb9) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & byte: UInt8.t = byte
  | & _4: bool = Any.any_l ()
  | & _5: bool = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & _7: bool = Any.any_l ()
  | & _8: bool = Any.any_l ()
  | & _9: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:byte_serialized_unchanged ensures] result
    = (UInt8.t'int byte = 42
    \/ UInt8.t'int byte = 45
    \/ UInt8.t'int byte = 46
    \/ 48 <= UInt8.t'int byte /\ UInt8.t'int byte <= 57
    \/ 65 <= UInt8.t'int byte /\ UInt8.t'int byte <= 90
    \/ UInt8.t'int byte = 95 \/ 97 <= UInt8.t'int byte /\ UInt8.t'int byte <= 122)}
    (! return {result}) ]
