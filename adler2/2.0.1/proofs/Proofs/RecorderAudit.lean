-- Generated by scripts/sync-theorems.py from verification/theorems.json.
import Lean
import Proofs.Smoke
import Proofs.Codec
import Proofs.PublicUpdate
open Lean Elab Command

run_cmd do
  let names : List Name := [
    `adler2.new_spec,
    `adler2.checksum_spec,
    `adler2.from_checksum_spec,
    `adler2.write_slice_spec,
    `adler2.adler32_slice_spec
  ]
  for theorem_name in names do
    match (← getEnv).find? theorem_name with
    | some (.thmInfo _) => pure ()
    | _ => throwError "Expected a theorem: {theorem_name}"
    let axioms ← Lean.collectAxioms theorem_name
    for ax in axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Unapproved axiom in {theorem_name}: {ax}"
    liftIO <| IO.println s!"proofs.rs:checked:{theorem_name}"
