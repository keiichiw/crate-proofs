s_before":[]},{"span":{"Deduplicated":265},"id":2130,"kind":{"StorageDead":140},"comments_before":[]},{"span":{"Deduplicated":265},"id":2132,"kind":{"StorageDead":129},"comments_before":[]},{"span":{"Deduplicated":265},"id":2134,"kind":{"StorageDead":118},"comments_before":[]},{"span":{"Deduplicated":265},"id":2136,"kind":{"StorageDead":107},"comments_before":[]},{"span":{"Deduplicated":265},"id":2138,"kind":{"StorageDead":105},"comments_before":[]},{"span":{"Deduplicated":265},"id":2139,"kind":{"StorageDead":104},"comments_before":[]},{"span":{"Deduplicated":265},"id":2141,"kind":{"StorageDead":99},"comments_before":[]},{"span":{"Deduplicated":265},"id":2143,"kind":{"StorageDead":97},"comments_before":[]},{"span":{"Deduplicated":265},"id":2144,"kind":{"StorageDead":96},"comments_before":[]},{"span":{"Deduplicated":265},"id":2146,"kind":{"StorageDead":91},"comments_before":[]},{"span":{"Deduplicated":265},"id":2148,"kind":{"StorageDead":89},"comments_before":[]},{"span":{"Deduplicated":265},"id":2151,"kind":{"StorageDead":79},"comments_before":[]},{"span":{"Deduplicated":265},"id":2152,"kind":{"StorageDead":78},"comments_before":[]},{"span":{"Deduplicated":265},"id":2155,"kind":{"StorageDead":52},"comments_before":[]},{"span":{"Deduplicated":265},"id":2156,"kind":{"StorageDead":51},"comments_before":[]},{"span":{"Deduplicated":265},"id":2160,"kind":{"StorageDead":20},"comments_before":[]},{"span":{"Deduplicated":265},"id":2162,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":265},"id":2163,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":265},"id":2743,"kind":{"StorageDead":164},"comments_before":[]},{"span":{"Deduplicated":265},"id":2744,"kind":{"StorageDead":163},"comments_before":[]},{"span":{"Deduplicated":265},"id":2745,"kind":{"StorageDead":162},"comments_before":[]},{"span":{"Deduplicated":265},"id":2746,"kind":{"StorageDead":161},"comments_before":[]},{"span":{"Deduplicated":265},"id":2747,"kind":{"StorageDead":160},"comments_before":[]},{"span":{"Deduplicated":265},"id":2748,"kind":{"StorageDead":159},"comments_before":[]},{"span":{"Deduplicated":265},"id":2749,"kind":{"StorageDead":158},"comments_before":[]},{"span":{"Deduplicated":265},"id":2750,"kind":{"StorageDead":157},"comments_before":[]},{"span":{"Deduplicated":265},"id":2751,"kind":{"StorageDead":156},"comments_before":[]},{"span":{"Deduplicated":265},"id":2752,"kind":{"StorageDead":155},"comments_before":[]},{"span":{"Deduplicated":265},"id":2753,"kind":{"StorageDead":154},"comments_before":[]},{"span":{"Deduplicated":265},"id":2754,"kind":{"StorageDead":153},"comments_before":[]},{"span":{"Deduplicated":265},"id":2755,"kind":{"StorageDead":152},"comments_before":[]},{"span":{"Deduplicated":265},"id":2756,"kind":{"StorageDead":151},"comments_before":[]},{"span":{"Deduplicated":265},"id":2757,"kind":{"StorageDead":150},"comments_before":[]},{"span":{"Deduplicated":265},"id":2758,"kind":{"StorageDead":149},"comments_before":[]},{"span":{"Deduplicated":265},"id":2759,"kind":{"StorageDead":148},"comments_before":[]},{"span":{"Deduplicated":265},"id":2760,"kind":{"StorageDead":147},"comments_before":[]},{"span":{"Deduplicated":265},"id":2164,"kind":"Return","comments_before":[]}]},"comments":[[51,["The basic algorithm is, for every byte:","  a = (a + byte) % MOD","  b = (b + a) % MOD","where MOD = 65521.","","For efficiency, we can defer the `% MOD` operations as long as neither a nor b overflows:","- Between calls to `write`, we ensure that a and b are always in range 0..MOD.","- We use 32-bit arithmetic in this function.","- Therefore, a and b must not increase by more than 2^32-MOD without performing a `% MOD`","  operation.","","According to Wikipedia, b is calculated as follows for non-incremental checksumming:","  b = n×D1 + (n−1)×D2 + (n−2)×D3 + ... + Dn + n*1 (mod 65521)","Where n is the number of bytes and Di is the i-th Byte. We need to change this to account","for the previous values of a and b, as well as treat every input Byte as being 255:","  b_inc = n×255 + (n-1)×255 + ... + 255 + n*65520","Or in other words:","  b_inc = n*65520 + n(n+1)/2*255","The max chunk size is thus the largest value of n so that b_inc <= 2^32-65521.","  2^32-65521 = n*65520 + n(n+1)/2*255","Plugging this into an equation solver since I can't math gives n = 5552.18..., so 5552.","","On top of the optimization outlined above, the algorithm can also be parallelized with a","bit more work:","","Note that b is a linear combination of a vector of input bytes (D1, ..., Dn).","","If we fix some value k<N and rewrite indices 1, ..., N as","","  1_1, 1_2, ..., 1_k, 2_1, ..., 2_k, ..., (N/k)_k,","","then we can express a and b in terms of sums of smaller sequences kb and ka:","","  ka(j) := D1_j + D2_j + ... + D(N/k)_j where j <= k","  kb(j) := (N/k)*D1_j + (N/k-1)*D2_j + ... + D(N/k)_j where j <= k",""," a = ka(1) + ka(2) + ... + ka(k) + 1"," b = k*(kb(1) + kb(2) + ... + kb(k)) - 1*ka(2) - ...  - (k-1)*ka(k) + N","","We use this insight to unroll the main loop and process k=4 bytes at a time.","The resulting code is highly amenable to SIMD acceleration, although the immediate speedups","stem from increased pipeline parallelism rather than auto-vectorization.","","This technique is described in-depth (here:)[https://software.intel.com/content/www/us/\\","en/develop/articles/fast-computation-of-fletcher-checksums.html]"]],[63,["iterate over 4 bytes at a time"]],[78,["special-case the final chunk because it may be shorter than the rest"]],[89,["combine the sub-sum results into the main sum"]],[101,["iterate over the remaining few bytes in serial"]]]}}},null,{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["len",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":118,"col":4},"end":{"line":118,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of elements in the slice."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.len(), 3);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"SliceLen","diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":8},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":15}],"output":{"Deduplicated":0}},"src":"Normal","body":"Opaque"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["split_at",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":1963,"col":4},"end":{"line":1963,"col":60}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Divides one slice into two at an index."},{"DocComment":""},{"DocComment":" The first will contain all indices from `[0, mid)` (excluding"},{"DocComment":" the index `mid` itself) and the second will contain all"},{"DocComment":" indices from `[mid, len)` (excluding the index `len` itself)."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `mid > len`.  For a non-panicking alternative see"},{"DocComment":" [`split_at_checked`](slice::split_at_checked)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"    let (left, right) = v.split_at(0);"},{"DocComment":"    assert_eq!(left, []);"},{"DocComment":"    assert_eq!(right, ['a', 'b', 'c']);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = v.split_at(2);"},{"DocComment":"     assert_eq!(left, ['a', 'b']);"},{"DocComment":"     assert_eq!(right, ['c']);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = v.split_at(3);"},{"DocComment":"     assert_eq!(left, ['a', 'b', 'c']);"},{"DocComment":"     assert_eq!(right, []);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1961,"col":4},"end":{"line":1961,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":8},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":15},{"Deduplicated":0}],"output":{"Value":[169,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":15},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"src":"Normal","body":"Opaque"},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":1243,"col":4},"end":{"line":1243,"col":77}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are slices and do not overlap. If `chunk_size` does not divide the length of the"},{"DocComment":" slice, then the last up to `chunk_size-1` elements will be omitted and can be retrieved"},{"DocComment":" from the `remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a smaller"},{"DocComment":" chunk, and [`rchunks_exact`] for the same iterator but starting at the end of the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":1242,"col":4},"end":{"line":1242,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"regions_outlive":[],"types_outlive":[],"skip_binder":[{"Deduplicated":8},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":15},{"Deduplicated":0}],"output":{"Value":[170,{"Adt":{"id":8,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":31,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Impl":{"Ty":{"params":{"regions":[{"index":0,"name":"'a","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":5},"kind":"InherentImplBlock"}}},{"Ident":["remainder",0]}],"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":1876,"col":4},"end":{"line":1876,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"