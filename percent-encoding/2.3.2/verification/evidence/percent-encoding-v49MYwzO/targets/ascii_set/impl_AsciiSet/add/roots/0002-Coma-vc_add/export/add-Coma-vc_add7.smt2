(declare-fun byte () (_ BitVec 8))

;; "Assert"
(assert (and (inv_AsciiSet (t_AsciiSetqtmk self)) (< (bv2int byte) 128)))

;; "result"
(declare-fun result () (_ BitVec 64))

;; "Assert"
(assert (= (bv2int result) 4))

;; "Assert"
(assert
  (not
    (= (match (mul_with_overflow #x0000000000000008 result) (((Tuple2 usfst
                                                                ussnd) ussnd))) true)))

;; "Assert"
(assert
  (= const_BITS_PER_CHUNK (match (mul_with_overflow
                                   #x0000000000000008
                                   result) (((Tuple2 usfst1 ussnd1) usfst1)))))

;; "Assert"
(assert (not (= const_BITS_PER_CHUNK #x0000000000000000)))

;; "Assert"
(assert
  (= (bv2int (bvurem ((_ extract 63 0) ((_ zero_extend 248) byte)) const_BITS_PER_CHUNK)) 
  (mod1
    (bv2int ((_ extract 63 0) ((_ zero_extend 248) byte)))
    (bv2int const_BITS_PER_CHUNK))))

;; "Assert"
(assert (not (= const_BITS_PER_CHUNK #x0000000000000000)))

;; "Assert"
(assert
  (= (bv2int (bvudiv ((_ extract 63 0) ((_ zero_extend 248) byte)) const_BITS_PER_CHUNK)) 
  (div1
    (bv2int ((_ extract 63 0) ((_ zero_extend 248) byte)))
    (bv2int const_BITS_PER_CHUNK))))

;; "Assert"
(assert
  (bvult (bvudiv ((_ extract 63 0) ((_ zero_extend 248) byte)) const_BITS_PER_CHUNK) #x0000000000000004))

;; Goal "vc_add"
(assert
  (not
  (< (bv2int (bvudiv ((_ extract 63 0) ((_ zero_extend 248) byte)) const_BITS_PER_CHUNK)) 
  (length1
    (elts2 self)))))

(check-sat)
