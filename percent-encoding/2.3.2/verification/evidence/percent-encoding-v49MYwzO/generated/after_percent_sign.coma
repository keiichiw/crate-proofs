use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use map.Map
use int.Int

type t_Iter_u8

predicate inv_Iter_u8 (_1: t_Iter_u8)

predicate invariant_ref_Iter_u8 [@inline:trivial] (self: t_Iter_u8) = inv_Iter_u8 self

meta "rewrite_def" predicate invariant_ref_Iter_u8

predicate inv_ref_Iter_u8 [@inline:trivial] (_1: t_Iter_u8) = invariant_ref_Iter_u8 _1

meta "rewrite_def" predicate inv_ref_Iter_u8

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

let as_slice_u8 (self_: t_Iter_u8) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:as_slice 'self_' type invariant] inv_ref_Iter_u8 self_}
  any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_slice ensures] Slice64.view result
    = Slice64.view (view_Iter_u8 self_)}
    (! return {result}) ]

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate invariant_refmut_Iter_u8 [@inline:trivial] (self: MutBorrow.t t_Iter_u8) =
  inv_Iter_u8 self.current /\ inv_Iter_u8 self.final

meta "rewrite_def" predicate invariant_refmut_Iter_u8

predicate inv_refmut_Iter_u8 [@inline:trivial] (_1: MutBorrow.t t_Iter_u8) = invariant_refmut_Iter_u8 _1

meta "rewrite_def" predicate inv_refmut_Iter_u8

predicate resolve_refmut_Iter_u8 [@inline:trivial] (_1: MutBorrow.t t_Iter_u8) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Iter_u8

type t_Option_u8 = None | Some UInt8.t

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


let percent_hex_value (byte: UInt8.t) (return (x: t_Option_u8)) = any
  [ return (result: t_Option_u8) -> {[@stop_split] [@expl:percent_hex_value ensures] match result with
      | Some value -> percent_hex_value_model (UInt8.t'int byte) = UInt8.t'int value
      | None -> percent_hex_value_model (UInt8.t'int byte) = - 1
      end}
    (! return {result}) ]

type t_Option_Infallible = None'0 | Some'0 ()

type t_ControlFlow_Option_Infallible_u8 = Continue UInt8.t | Break t_Option_Infallible

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Option_Infallible (_1: t_Option_Infallible)

axiom inv_axiom [@rewrite]: forall x: t_Option_Infallible [inv_Option_Infallible x]. inv_Option_Infallible x
    = match x with
      | None'0 -> true
      | Some'0 f0 -> inv_Infallible f0
      end

predicate inv_ControlFlow_Option_Infallible_u8 (_1: t_ControlFlow_Option_Infallible_u8)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Option_Infallible_u8 [inv_ControlFlow_Option_Infallible_u8 x]. inv_ControlFlow_Option_Infallible_u8 x
    = match x with
      | Continue f0 -> true
      | Break f0 -> inv_Option_Infallible f0
      end

let branch_Option_u8 (self_: t_Option_u8) (return (x: t_ControlFlow_Option_Infallible_u8)) = any
  [ return (result: t_ControlFlow_Option_Infallible_u8) ->
  {[@stop_split] [@expl:branch_Option_u8 ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Option_Infallible_u8 result)
    /\ ([@stop_split] [@expl:branch ensures] match self_ with
      | Some v -> result = Continue v
      | None -> result = Break (None'0)
      end)}
    (! return {result}) ]

let elim_Break (_x: t_ControlFlow_Option_Infallible_u8) (return (f0: t_Option_Infallible)) = any
  [ _k (f0: t_Option_Infallible) -> {Break f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

let from_residual_Option_u8 (residual: t_Option_Infallible) (return (x: t_Option_u8)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] inv_Option_Infallible residual}
  any
  [ return (result: t_Option_u8) -> {[@stop_split] [@expl:from_residual ensures] result = None} (! return {result}) ]

let elim_Continue (_x: t_ControlFlow_Option_Infallible_u8) (return (f0: UInt8.t)) = any
  [ _k (f0: UInt8.t) -> {Continue f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Continue] match _x with
      | Continue _ -> true
      | _ -> false
      end}
    any) ]

type t_RangeFrom_usize = { start: UInt64.t }

predicate in_bounds_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) =
  UInt64.t'int self.start <= Seq.length seq

predicate has_value_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  Seq.([..]) seq (UInt64.t'int self.start) (Seq.length seq) = Slice64.view out

let index_slice_u8 (self_: Slice64.slice UInt8.t) (ix: t_RangeFrom_usize) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:index requires] in_bounds_RangeFrom_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:index ensures] has_value_RangeFrom_usize ix (Slice64.view self_) result}
    (! return {result}) ]

let iter_u8 (self_: Slice64.slice UInt8.t) (return (x: t_Iter_u8)) = any
  [ return (result: t_Iter_u8) ->
  {[@stop_split] [@expl:iter_u8 ensures] ([@stop_split] [@expl:iter result type invariant] inv_Iter_u8 result)
    /\ ([@stop_split] [@expl:iter ensures] view_Iter_u8 result = self_)}
    (! return {result}) ]

predicate resolve_Iter_u8 (_1: t_Iter_u8)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let after_percent_sign (iter: MutBorrow.t t_Iter_u8) (return (x: t_Option_u8)) =
{[@stop_split] [@expl:after_percent_sign 'iter' type invariant] inv_refmut_Iter_u8 iter}
  (! bb0
  [ bb0 = s0
    [ s0 = as_slice_u8 {iter.current} (fun (_x: Slice64.slice UInt8.t) -> [ &bytes <- _x ] s1)
    | s1 = len_u8 {bytes} (fun (_x: UInt64.t) -> [ &_8 <- _x ] s2)
    | s2 = [ &_7 <- UInt64.lt _8 (2: UInt64.t) ] s3
    | s3 = any [ br0 -> {_7 = false} (! bb4) | br1 -> {_7} (! bb3) ] ]
  | bb3 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_Iter_u8 iter} any) ]
    | s1 = -{resolve_refmut_Iter_u8 iter}- s2
    | s2 = [ &_ret <- None ] s3
    | s3 = return {_ret} ]
  | bb4 = s0
    [ s0 = [ &_15 <- (0: UInt64.t) ] s1
    | s1 = [ &_16 <- Slice64.length bytes ] s2
    | s2 = [ &_17 <- UInt64.lt _15 _16 ] s3
    | s3 = {[@expl:index in bounds] _17} s4
    | s4 = Slice64.get <UInt8.t> {bytes} {_15} (fun (r: UInt8.t) -> [ &_14 <- r ] s5)
    | s5 = percent_hex_value {_14} (fun (_x: t_Option_u8) -> [ &_13 <- _x ] s6)
    | s6 = branch_Option_u8 {_13} (fun (_x: t_ControlFlow_Option_Infallible_u8) -> [ &_12 <- _x ] s7)
    | s7 = any
      [ br0 (x0: UInt8.t) -> {_12 = Continue x0} (! bb10)
      | br1 (x0: t_Option_Infallible) -> {_12 = Break x0} (! bb9) ] ]
  | bb9 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_Iter_u8 iter} any) ]
    | s1 = -{resolve_refmut_Iter_u8 iter}- s2
    | s2 = elim_Break {_12} (fun (r0: t_Option_Infallible) -> [ &residual <- r0 ] s3)
    | s3 = from_residual_Option_u8 {residual} (fun (_x: t_Option_u8) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ]
  | bb10 = s0
    [ s0 = elim_Continue {_12} (fun (r0: UInt8.t) -> [ &val' <- r0 ] s1)
    | s1 = [ &high <- val' ] s2
    | s2 = [ &_27 <- (1: UInt64.t) ] s3
    | s3 = [ &_28 <- Slice64.length bytes ] s4
    | s4 = [ &_29 <- UInt64.lt _27 _28 ] s5
    | s5 = {[@expl:index in bounds] _29} s6
    | s6 = Slice64.get <UInt8.t> {bytes} {_27} (fun (r: UInt8.t) -> [ &_26 <- r ] s7)
    | s7 = percent_hex_value {_26} (fun (_x: t_Option_u8) -> [ &_25 <- _x ] s8)
    | s8 = branch_Option_u8 {_25} (fun (_x: t_ControlFlow_Option_Infallible_u8) -> [ &_24 <- _x ] s9)
    | s9 = any
      [ br0 (x0: UInt8.t) -> {_24 = Continue x0} (! bb18)
      | br1 (x0: t_Option_Infallible) -> {_24 = Break x0} (! bb17) ] ]
  | bb17 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_Iter_u8 iter} any) ]
    | s1 = -{resolve_refmut_Iter_u8 iter}- s2
    | s2 = elim_Break {_24} (fun (r0: t_Option_Infallible) -> [ &residual'0 <- r0 ] s3)
    | s3 = from_residual_Option_u8 {residual'0} (fun (_x: t_Option_u8) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ]
  | bb18 = s0
    [ s0 = elim_Continue {_24} (fun (r0: UInt8.t) -> [ &val''0 <- r0 ] s1)
    | s1 = [ &low <- val''0 ] s2
    | s2 = [ &_39 <- { start = (2: UInt64.t) } ] s3
    | s3 = index_slice_u8 {bytes} {_39} (fun (_x: Slice64.slice UInt8.t) -> [ &_37 <- _x ] s4)
    | s4 = iter_u8 {_37} (fun (_x: t_Iter_u8) -> [ &_35 <- _x ] s5)
    | s5 = s6 [ _ck -> (! {[@expl:type invariant] inv_Iter_u8 iter.current} any) ]
    | s6 = -{resolve_Iter_u8 iter.current}- s7
    | s7 = [ &iter <- { iter with current = _35 } ] s8
    | s8 = s9 [ _ck -> (! {[@expl:type invariant] inv_refmut_Iter_u8 iter} any) ]
    | s9 = -{resolve_refmut_Iter_u8 iter}- s10
    | s10 = UInt8.mul {high} {(16: UInt8.t)} (fun (_x: UInt8.t) -> [ &_41 <- _x ] s11)
    | s11 = UInt8.add {_41} {low} (fun (_x: UInt8.t) -> [ &_40 <- _x ] s12)
    | s12 = [ &_ret <- Some _40 ] s13
    | s13 = return {_ret} ] ]
  [ & _ret: t_Option_u8 = Any.any_l ()
  | & iter: MutBorrow.t t_Iter_u8 = iter
  | & bytes: Slice64.slice UInt8.t = Any.any_l ()
  | & _7: bool = Any.any_l ()
  | & _8: UInt64.t = Any.any_l ()
  | & high: UInt8.t = Any.any_l ()
  | & _12: t_ControlFlow_Option_Infallible_u8 = Any.any_l ()
  | & _13: t_Option_u8 = Any.any_l ()
  | & _14: UInt8.t = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _16: UInt64.t = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & residual: t_Option_Infallible = Any.any_l ()
  | & val': UInt8.t = Any.any_l ()
  | & low: UInt8.t = Any.any_l ()
  | & _24: t_ControlFlow_Option_Infallible_u8 = Any.any_l ()
  | & _25: t_Option_u8 = Any.any_l ()
  | & _26: UInt8.t = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & _28: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & residual'0: t_Option_Infallible = Any.any_l ()
  | & val''0: UInt8.t = Any.any_l ()
  | & _35: t_Iter_u8 = Any.any_l ()
  | & _37: Slice64.slice UInt8.t = Any.any_l ()
  | & _39: t_RangeFrom_usize = Any.any_l ()
  | & _40: UInt8.t = Any.any_l ()
  | & _41: UInt8.t = Any.any_l () ])
  [ return (result: t_Option_u8) -> {[@stop_split] [@expl:after_percent_sign ensures] match result with
      | Some value -> let before = byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)) in let after = byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.final)) in ge_log_Int (Seq.length before) 2
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 0)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 1)) 0
      /\ UInt8.t'int value
        = percent_hex_value_model (Seq.get before 0) * 16 + percent_hex_value_model (Seq.get before 1)
      /\ after = Seq.([..]) before 2 (Seq.length before)
      | None -> Slice64.view (view_Iter_u8 iter.final) = Slice64.view (view_Iter_u8 iter.current)
      /\ (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) < 2
      \/ ge_log_Int (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)))) 2
        /\ percent_hex_value_model (Seq.get (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) 0) < 0
      \/ ge_log_Int (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)))) 2
      /\ percent_hex_value_model (Seq.get (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) 1) < 0)
      end}
    (! return {result}) ]
