use seq.Seq
use map.Map
use creusot.int.UInt8
use creusot.prelude.Char
use int.Int

function tail_ref_str (self: Seq.seq string) : Seq.seq string = [%#sseq'7] Seq.([..]) self 1 (Seq.length self)

function flat_map_ref_str (self: Seq.seq string) (other: Map.map string (Seq.seq int)) : Seq.seq int

axiom flat_map_ref_str_def:
  forall self: Seq.seq string, other: Map.map string (Seq.seq int) [flat_map_ref_str self other]. flat_map_ref_str self other
    = ([%#sseq'3] if Seq.length self = 0 then
      Seq.empty: Seq.seq int
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_ref_str (tail_ref_str self) other)
    )

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'5] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'6] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'7] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = ([%#sseq'3] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t =
  [%#sstring] flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function string_chunk_bytes (s: string) : Seq.seq int =
  [%#slib] map_u8 (to_bytes (view_str s)) (fun (b: UInt8.t) -> UInt8.t'int b)

function encoder_chunks_bytes [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encoder_cow.rs" 185 0 185 54] (chunks: Seq.seq string) : Seq.seq int
 = [%#sencoder_cow'1] flat_map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function flat_map_push_back_ref_str (self: Seq.seq string) (x: string) (f: Map.map string (Seq.seq int)) : ()

axiom flat_map_push_back_ref_str_def:
  forall self: Seq.seq string, x: string, f: Map.map string (Seq.seq int) [flat_map_push_back_ref_str self x f]. flat_map_push_back_ref_str self x f
    = ([%#sseq'1] if gt_log_Int (Seq.length self) 0 then
      let _ = flat_map_push_back_ref_str (tail_ref_str self) x f in ()
    else
      ()
    )

axiom flat_map_push_back_ref_str_spec:
  forall self: Seq.seq string, x: string, f: Map.map string (Seq.seq int). [%#sseq] flat_map_ref_str (Seq.snoc self x) f
    = Seq.(++) (flat_map_ref_str self f) (Map.get f x)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant chunks : Seq.seq string

constant chunk : string

predicate append_encoder_chunk [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encoder_cow.rs" 238 0 238 63] (chunks: Seq.seq string) (chunk: string)

goal vc_append_encoder_chunk:
  ([@stop_split] [@expl:flat_map_push_back ensures] [%#sseq] flat_map_ref_str (Seq.snoc chunks chunk) (fun (item: string) -> string_chunk_bytes item)
    = Seq.(++) (flat_map_ref_str chunks (fun (item: string) -> string_chunk_bytes item)) (Map.get (fun (item: string) -> string_chunk_bytes item) chunk))
  -> (let _ = flat_map_push_back_ref_str chunks chunk (fun (item: string) -> string_chunk_bytes item) in [@stop_split] [@expl:append_encoder_chunk ensures] ([@stop_split] [@expl:append_encoder_chunk ensures #0] [%#sencoder_cow] true)
  /\ ([@stop_split] [@expl:append_encoder_chunk ensures #1] [%#sencoder_cow'0] encoder_chunks_bytes (Seq.snoc chunks chunk)
  = Seq.(++) (encoder_chunks_bytes chunks) (string_chunk_bytes chunk)))
