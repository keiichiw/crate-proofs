goal vc_slice_byte_views_ext_eq_from_model: ([%#sequality_models] deep_model_ref_slice_u8 left
    = deep_model_ref_slice_u8 right)
  -> (let left_model = deep_model_ref_slice_u8 left in let right_model = deep_model_ref_slice_u8 right in Seq.length (Slice64.view left)
    = Seq.length left_model
  && Seq.length (Slice64.view right) = Seq.length right_model
  && Seq.length (Slice64.view left) = Seq.length (Slice64.view right)
  && (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view left)
      -> UInt8.t'int (Seq.get (Slice64.view left) i) = UInt8.t'int (Seq.get (Slice64.view right) i))
  && Seq.(==) (Slice64.view left) (Slice64.view right)
