use creusot.int.UInt8
use seq.Seq
use map.Map
use int.Int

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'1] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'2] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  [%#slib] map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

predicate nonempty_left_concat_tail_u8 [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/string_bytes_lemmas.rs" 49 0 49 68] (left: Seq.seq UInt8.t) (right: Seq.seq UInt8.t)

axiom nonempty_left_concat_tail_u8_spec:
  forall left: Seq.seq UInt8.t, right: Seq.seq UInt8.t [nonempty_left_concat_tail_u8 left right]. ([%#sstring_bytes_lemmas'2] gt_log_Int (Seq.length left) 0)
    -> ([%#sstring_bytes_lemmas'3] nonempty_left_concat_tail_u8 left right)

axiom nonempty_left_concat_tail_u8_spec'0:
  forall left: Seq.seq UInt8.t, right: Seq.seq UInt8.t. ([%#sstring_bytes_lemmas'2] gt_log_Int (Seq.length left) 0)
    -> ([%#sstring_bytes_lemmas'4] Seq.(==) (tail_u8 (Seq.(++) left right)) (Seq.(++) (tail_u8 left) right))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

