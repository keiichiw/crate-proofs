type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = [%#slib'10] if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


function decoded_trace [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 99 0 99 49] (input: Seq.seq int) : Seq.seq int

axiom decoded_trace_def: forall input: Seq.seq int [decoded_trace input]. decoded_trace input
    = ([%#slib'5] if Seq.length input = 0 then
      Seq.empty: Seq.seq int
    else
      if ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
        Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
        + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))
      else
        Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))
    
    )

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'1] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes'0: Seq.seq UInt8.t) : Seq.seq int =
  [%#slib'6] map_u8 bytes'0 (fun (byte: UInt8.t) -> UInt8.t'int byte)

function remaining_input [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 882 4 882 43] [@inline:trivial] (self: t_PercentDecode) : Seq.seq UInt8.t
 = [%#slib'7] Slice64.view (view_Iter_u8 self.bytes)

meta "rewrite_def" function remaining_input

predicate produces_PercentDecode [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 1033 4 1033 64] (self: t_PercentDecode) (visited: Seq.seq UInt8.t) (o: t_PercentDecode) =
  [%#slib'8] decoded_trace (byte_sequence_as_ints (remaining_input self))
  = Seq.(++) (byte_sequence_as_ints visited) (decoded_trace (byte_sequence_as_ints (remaining_input o)))

function produces_trans_PercentDecode [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 1055 4 1055 90] (a: t_PercentDecode) (ab: Seq.seq UInt8.t) (b: t_PercentDecode) (bc: Seq.seq UInt8.t) (c: t_PercentDecode) : ()
 = [%#slib'16] ()

axiom produces_trans_PercentDecode_spec:
  forall a: t_PercentDecode, ab: Seq.seq UInt8.t, b: t_PercentDecode, bc: Seq.seq UInt8.t, c: t_PercentDecode. ([%#slib'13] produces_PercentDecode a ab b)
    -> ([%#slib'14] produces_PercentDecode b bc c) -> ([%#slib'15] produces_PercentDecode a (Seq.(++) ab bc) c)

function produces_refl_PercentDecode [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 1044 4 1044 26] (self: t_PercentDecode) : ()
 = [%#slib'12] ()

axiom produces_refl_PercentDecode_spec:
  forall self: t_PercentDecode. [%#slib'11] produces_PercentDecode self (Seq.empty: Seq.seq UInt8.t) self

predicate resolve_refmut_PercentDecode [@inline:trivial] (_1: MutBorrow.t t_PercentDecode) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_PercentDecode

predicate completed_PercentDecode [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 1028 4 1028 35] (self: MutBorrow.t t_PercentDecode) =
  [%#slib'9] Seq.length (remaining_input self.current) = 0 /\ resolve_refmut_PercentDecode self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_PercentDecode. ([%#siter] inv_ref_PercentDecode self_)
    -> ([%#slib] inv_ref_PercentDecode self_)
    /\ (forall result: tup2_usize_Option_usize. ([%#slib'0] UInt64.t'int result.f0
          = ComputerDivision.div (Seq.length (Slice64.view (view_Iter_u8 self_.bytes))) 3
          + (if ComputerDivision.mod (Seq.length (Slice64.view (view_Iter_u8 self_.bytes))) 3 = 0 then 0 else 1))
        /\ ([%#slib'1] match result.f1 with
            | Some upper -> UInt64.t'int upper = Seq.length (Slice64.view (view_Iter_u8 self_.bytes))
            | None -> false
            end)
        /\ ([%#slib'2] Seq.length (decoded_trace (byte_sequence_as_ints (remaining_input self_)))
          <= Seq.length (remaining_input self_))
        /\ ([%#slib'3] Seq.length (remaining_input self_)
        <= 3 * Seq.length (decoded_trace (byte_sequence_as_ints (remaining_input self_))))
      -> ([%#siter'0] forall s: Seq.seq UInt8.t, i: MutBorrow.t t_PercentDecode. produces_PercentDecode self_ s i.current
            /\ completed_PercentDecode i -> UInt64.t'int result.f0 <= Seq.length s)
      /\ ([%#siter'1] match result.f1 with
        | Some r -> forall s: Seq.seq UInt8.t, i: t_PercentDecode. produces_PercentDecode self_ s i
          -> Seq.length s <= UInt64.t'int r
        | None -> true
        end))
