      /\ Seq.length after <= Seq.length before
      /\ (if Seq.get before 0 = 37
      /\ ge_log_Int (Seq.length before) 3
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 2)) 0 then
        UInt8.t'int value = percent_hex_value_model (Seq.get before 1) * 16 + percent_hex_value_model (Seq.get before 2)
        /\ after = Seq.([..]) before 3 (Seq.length before)
