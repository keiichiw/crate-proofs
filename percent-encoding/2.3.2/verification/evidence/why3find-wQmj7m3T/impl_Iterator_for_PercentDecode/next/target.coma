function percent_hex_value_model (byte: int) : int = [%#slib'8] if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


