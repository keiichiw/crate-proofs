let percent_encode (input: Slice64.slice UInt8.t) (ascii_set'0: t_AsciiSet) (return (x: t_PercentEncode)) =
{[@stop_split] [@expl:percent_encode 'ascii_set' type invariant] [%#slib'5] inv_ref_AsciiSet ascii_set'0}
  any
  [ return (result: t_PercentEncode) ->
  {[@stop_split] [@expl:percent_encode ensures] ([@stop_split] [@expl:percent_encode result type invariant] [%#slib'6] inv_PercentEncode result)
    /\ ([@stop_split] [@expl:percent_encode ensures #0] [%#slib'7] remaining_input result = Slice64.view input)
    /\ ([@stop_split] [@expl:percent_encode ensures #1] [%#slib'8] configured_set result = mask_words ascii_set'0)}
    (! return {result}) ]

