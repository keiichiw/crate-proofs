function mask_words [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/ascii_set.rs" 115 4 115 40] (self: t_AsciiSet) : Seq.seq UInt32BW.t
 = [%#sascii_set'9] Seq.create 4 (fun (i: int) -> Seq.get (Slice64BW.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. [%#sascii_set'8] Seq.length (mask_words self) = 4

let union (self: t_AsciiSet) (other: t_AsciiSet) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:union requires] ([@stop_split] [@expl:union 'self' type invariant] [%#sascii_set'4] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:union 'other' type invariant] [%#sascii_set'5] inv_AsciiSet other)}
  any
  [ return (result: t_AsciiSet) ->
  {[@stop_split] [@expl:union ensures] ([@stop_split] [@expl:union result type invariant] [%#sascii_set'6] inv_AsciiSet result)
    /\ ([@stop_split] [@expl:union ensures] [%#sascii_set'7] forall i: int. 0 <= i /\ i < 4
      -> Seq.get (mask_words result) i = UInt32BW.bw_or (Seq.get (mask_words self) i) (Seq.get (mask_words other) i))}
    (! return {result}) ]

