type t_AsciiSet = { mask: Slice64BW.array UInt32BW.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32BW.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64BW.array UInt32BW.t) =
  [%#sarray] inv_Seq_u32 (Slice64BW.view self) /\ Seq.length (Slice64BW.view self) = UInt64BW.t'int (4: UInt64BW.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64BW.array UInt32BW.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = [%#sinvariant] inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

function mask_words [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/ascii_set.rs" 115 4 115 40] (self: t_AsciiSet) : Seq.seq UInt32BW.t
 = [%#sascii_set'10] Seq.create 4 (fun (i: int) -> Seq.get (Slice64BW.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. [%#sascii_set'9] Seq.length (mask_words self) = 4

predicate contains_model [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/ascii_set.rs" 188 0 188 62] (set: t_AsciiSet) (byte: UInt8BW.t) =
  [%#sascii_set'8] UInt8BW.t'int byte < 128
  /\ UInt32BW.bw_and (Seq.get (mask_words set) (ComputerDivision.div (UInt8BW.t'int byte) 32)) (UInt32BW.shl (1: UInt32BW.t) (UInt32BW.of_BV256 (UInt8BW.to_BV256 (UInt8BW.bw_and byte (31: UInt8BW.t)))))
  <> (0: UInt32BW.t)

let contains (self: t_AsciiSet) (byte: UInt8BW.t) (return (x: bool)) =
{[@stop_split] [@expl:contains requires] ([@stop_split] [@expl:contains 'self' type invariant] [%#sascii_set'5] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:contains requires] [%#sascii_set'6] UInt8BW.t'int byte < 128)}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:contains ensures] [%#sascii_set'7] result = contains_model self byte}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate should_encode_model [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encode_models.rs" 14 0 14 60] (mask'0: Seq.seq UInt32BW.t) (byte: UInt8BW.t) =
  [%#sencode_models] ge_log_Int (UInt8BW.t'int byte) 128
  \/ UInt32BW.bw_and (Seq.get mask'0 (ComputerDivision.div (UInt8BW.t'int byte) 32)) (UInt32BW.shl (1: UInt32BW.t) (UInt32BW.of_BV256 (UInt8BW.to_BV256 (UInt8BW.bw_and byte (31: UInt8BW.t)))))
  <> (0: UInt32BW.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

