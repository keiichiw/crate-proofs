  [ & _ret: bool = Any.any_l () | & self: t_AsciiSet = self | & byte: UInt8BW.t = byte | & _9: bool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:should_percent_encode ensures] ([@stop_split] [@expl:should_percent_encode ensures #0] [%#sascii_set'3] result
      = (ge_log_Int (UInt8BW.t'int byte) 128 \/ contains_model self byte))
