use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use map.Map
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Iter_u8

type t_PercentDecode = { bytes: t_Iter_u8 }

predicate inv_Iter_u8 (_1: t_Iter_u8)

predicate invariant_ref_Iter_u8 [@inline:trivial] (self: t_Iter_u8) = [%#sinvariant'0] inv_Iter_u8 self

meta "rewrite_def" predicate invariant_ref_Iter_u8

predicate inv_ref_Iter_u8 [@inline:trivial] (_1: t_Iter_u8) = invariant_ref_Iter_u8 _1

meta "rewrite_def" predicate inv_ref_Iter_u8

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

let as_slice_u8 (self_: t_Iter_u8) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:as_slice 'self_' type invariant] [%#sslice] inv_ref_Iter_u8 self_}
  any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_slice ensures] [%#sslice'0] Slice64.view result
    = Slice64.view (view_Iter_u8 self_)}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice'1] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

function percent_hex_value_model (byte: int) : int = [%#slib'63] if 48 <= byte /\ byte <= 57 then
    byte - 48
