use creusot.int.UInt32
use seq.Seq
use creusot.int.UInt8
use int.ComputerDivision
use map.Map
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate should_encode_model [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encode_models.rs" 14 0 14 60] (mask: Seq.seq UInt32.t) (byte: UInt8.t) =
  [%#sencode_models'3] ge_log_Int (UInt8.t'int byte) 128
  \/ UInt32.bw_and (Seq.get mask (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

function uppercase_hex (digit: int) : int = [%#slib'3] if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. [%#slib'2] uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function uppercase_hex'0 [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 83 0 83 39] (digit: int) : int
 = [%#slib'1] uppercase_hex digit

function encoded_byte_model [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 89 0 89 48] (byte: int) : Seq.seq int
 =
  [%#slib] Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex'0 (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex'0 (ComputerDivision.mod byte 16)))

function safe_run_end [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encode_models.rs" 32 0 32 70] (input: Seq.seq UInt8.t) (start: int) (mask: Seq.seq UInt32.t) : int

axiom safe_run_end_spec:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. ([%#sencode_models'9] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#sencode_models'10] Seq.length mask = 4)
    -> ([%#sencode_models'11] start <= safe_run_end input start mask
    /\ safe_run_end input start mask <= Seq.length input)

axiom safe_run_end_spec'0:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. ([%#sencode_models'9] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#sencode_models'10] Seq.length mask = 4)
    -> ([%#sencode_models'12] forall i: int. start <= i /\ i < safe_run_end input start mask
      -> not should_encode_model mask (Seq.get input i))

axiom safe_run_end_spec'1:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. ([%#sencode_models'9] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#sencode_models'10] Seq.length mask = 4)
    -> ([%#sencode_models'13] safe_run_end input start mask = Seq.length input
    \/ should_encode_model mask (Seq.get input (safe_run_end input start mask)))

axiom safe_run_end_spec'2:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. ([%#sencode_models'9] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#sencode_models'10] Seq.length mask = 4)
    -> ([%#sencode_models'14] start < Seq.length input /\ not should_encode_model mask (Seq.get input start)
    -> start < safe_run_end input start mask)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'1] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  [%#slib'0] map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

function encoded_chunks [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encode_models.rs" 123 0 123 70] (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t) : Seq.seq (Seq.seq int)

axiom encoded_chunks_def:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. ([%#sencode_models'5] Seq.length mask
      = 4)
    -> encoded_chunks mask input
    = ([%#sencode_models'7] if Seq.length input = 0 then
      Seq.empty: Seq.seq (Seq.seq int)
    else
      if should_encode_model mask (Seq.get input 0) then
        Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))
      else
        let end' = safe_run_end input 0 mask in Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) input 0 end'))) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input)))
    
    )

axiom encoded_chunks_spec:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. ([%#sencode_models'5] Seq.length mask
      = 4)
    -> ([%#sencode_models'6] if Seq.length input = 0 then
      Seq.length (encoded_chunks mask input) = 0
    else
      gt_log_Int (Seq.length (encoded_chunks mask input)) 0
      /\ (if should_encode_model mask (Seq.get input 0) then
        Seq.get (encoded_chunks mask input) 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
      else
        let end' = safe_run_end input 0 mask in Seq.get (encoded_chunks mask input) 0
          = byte_sequence_as_ints (Seq.([..]) input 0 end')
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input end' (Seq.length input))
      )
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant mask : Seq.seq UInt32.t

constant input : Seq.seq UInt8.t

predicate encoded_chunks_first_escaped [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/encode_models.rs" 95 0 95 75] (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t)

goal vc_encoded_chunks_first_escaped: ([%#sencode_models] gt_log_Int (Seq.length input) 0 /\ Seq.length mask = 4)
  -> ([%#sencode_models'0] should_encode_model mask (Seq.get input 0))
  -> ([@stop_split] [@expl:encoded_chunks_first_escaped ensures] ([@stop_split] [@expl:encoded_chunks_first_escaped ensures #0] [%#sencode_models'1] true)
  /\ ([@stop_split] [@expl:encoded_chunks_first_escaped ensures #1] [%#sencode_models'2] encoded_chunks mask input
  = Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))))
