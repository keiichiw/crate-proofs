goal refines: forall self_: t_PercentEncode. ([%#siter] inv_ref_PercentEncode self_)
    -> ([%#slib] inv_ref_PercentEncode self_)
    /\ (forall result: tup2_usize_Option_usize. ([%#slib'0] UInt64.t'int result.f0
          = (if Seq.length (remaining_input self_) = 0 then 0 else 1))
        /\ ([%#slib'1] match result.f1 with
            | Some upper -> UInt64.t'int upper = Seq.length (remaining_input self_)
            | None -> false
            end)
        /\ ([%#slib'2] Seq.length (encoded_chunks (configured_set self_) (remaining_input self_))
          <= Seq.length (remaining_input self_))
        /\ ([%#slib'3] (Seq.length (remaining_input self_) = 0)
          = (Seq.length (encoded_chunks (configured_set self_) (remaining_input self_)) = 0))
        /\ ([%#slib'4] gt_log_Int (Seq.length (remaining_input self_)) 0
        -> ge_log_Int (Seq.length (encoded_chunks (configured_set self_) (remaining_input self_))) 1)
      -> ([%#siter'0] forall s: Seq.seq string, i: MutBorrow.t t_PercentEncode. produces_PercentEncode self_ s i.current
            /\ completed_PercentEncode i -> UInt64.t'int result.f0 <= Seq.length s)
      /\ ([%#siter'1] match result.f1 with
        | Some r -> forall s: Seq.seq string, i: t_PercentEncode. produces_PercentEncode self_ s i
          -> Seq.length s <= UInt64.t'int r
        | None -> true
        end))
