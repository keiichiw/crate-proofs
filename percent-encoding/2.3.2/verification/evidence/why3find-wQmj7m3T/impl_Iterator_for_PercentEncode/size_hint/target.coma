    \/ should_encode_model mask (Seq.get input (safe_run_end input start mask)))

axiom safe_run_end_spec'2:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. ([%#sencode_models'5] 0
        <= start
      /\ start <= Seq.length input)
    -> ([%#sencode_models'6] Seq.length mask = 4)
    -> ([%#sencode_models'10] start < Seq.length input /\ not should_encode_model mask (Seq.get input start)
