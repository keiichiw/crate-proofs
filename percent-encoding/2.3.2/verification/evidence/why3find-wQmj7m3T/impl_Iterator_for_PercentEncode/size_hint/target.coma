let size_hint_PercentEncode [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/lib.rs" 701 4 701 49]
  (self: t_PercentEncode) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] [%#slib'1] inv_ref_PercentEncode self}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] [%#slib] encoded_chunk_count_bounds (configured_set self) (remaining_input self)} s1
    | s1 = percent_encode_size_hint [%#slib'0] {self.bytes} (fun (_x: tup2_usize_Option_usize) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ] [ & _ret: tup2_usize_Option_usize = Any.any_l () | & self: t_PercentEncode = self ])
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_PercentEncode ensures] ([@stop_split] [@expl:size_hint ensures #0] [%#slib'2] UInt64.t'int result.f0
      = (if Seq.length (remaining_input self) = 0 then 0 else 1))
    /\ ([@stop_split] [@expl:size_hint ensures #1] [%#slib'3] match result.f1 with
        | Some upper -> UInt64.t'int upper = Seq.length (remaining_input self)
        | None -> false
