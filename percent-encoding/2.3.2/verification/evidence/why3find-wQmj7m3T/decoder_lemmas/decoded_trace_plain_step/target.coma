  -> ([%#sdecoder_lemmas'0] not (ge_log_Int (Seq.length input) 3
    /\ Seq.get input 0 = 37
    /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
    /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0))
  -> ([@stop_split] [@expl:decoded_trace_plain_step ensures] ([@stop_split] [@expl:decoded_trace_plain_step ensures #0] [%#sdecoder_lemmas'1] true)
  /\ ([@stop_split] [@expl:decoded_trace_plain_step ensures #1] [%#sdecoder_lemmas'2] decoded_trace input
  = Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))))
