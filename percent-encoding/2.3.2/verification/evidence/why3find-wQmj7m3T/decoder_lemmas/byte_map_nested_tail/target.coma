use creusot.int.UInt8
use seq.Seq
use map.Map
use int.Int

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec:
  forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'0] Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. [%#sseq'1] forall i: int. 0
          <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  [%#slib'2] map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

predicate byte_model_subsequence (bytes: Seq.seq UInt8.t) (start: int) (end': int)

axiom byte_model_subsequence_spec:
  forall bytes: Seq.seq UInt8.t, start: int, end': int [byte_model_subsequence bytes start end']. ([%#slib] 0 <= start
      /\ start <= end' /\ end' <= Seq.length bytes) -> ([%#slib'0] byte_model_subsequence bytes start end')

axiom byte_model_subsequence_spec'0: forall bytes: Seq.seq UInt8.t, start: int, end': int. ([%#slib] 0 <= start
      /\ start <= end' /\ end' <= Seq.length bytes)
    -> ([%#slib'1] byte_sequence_as_ints (Seq.([..]) bytes start end')
    = Seq.([..]) (byte_sequence_as_ints bytes) start end')

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

