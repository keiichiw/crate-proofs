use seq.Seq

type t_T

function concat_assoc_T (self: Seq.seq t_T) (other1: Seq.seq t_T) (other2: Seq.seq t_T) : ()

axiom concat_assoc_T_spec:
  forall self: Seq.seq t_T, other1: Seq.seq t_T, other2: Seq.seq t_T. [%#sseq] Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant left : Seq.seq t_T

constant middle : Seq.seq t_T

constant right : Seq.seq t_T

predicate concat_assoc_T'0 [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/decoder_lemmas.rs" 42 0 42 82] (left: Seq.seq t_T) (middle: Seq.seq t_T) (right: Seq.seq t_T)

goal vc_concat_assoc_T:
  [@stop_split] [@expl:concat_assoc_T ensures] ([@stop_split] [@expl:concat_assoc ensures #0] [%#sdecoder_lemmas] true)
  /\ ([@stop_split] [@expl:concat_assoc ensures #1] [%#sdecoder_lemmas'0] Seq.(++) left (Seq.(++) middle right)
  = Seq.(++) (Seq.(++) left middle) right)
