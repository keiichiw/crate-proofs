predicate decoded_trace_escape_step [#"/Users/keiichiw/workspace/crate-proofs/percent-encoding/2.3.2/crate/src/decoder_lemmas.rs" 101 0 101 64] (input: Seq.seq int)

goal vc_decoded_trace_escape_step: ([%#sdecoder_lemmas] ge_log_Int (Seq.length input) 3)
  -> ([%#sdecoder_lemmas'0] Seq.get input 0 = 37)
  -> ([%#sdecoder_lemmas'1] ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0)
  -> ([%#sdecoder_lemmas'2] ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0)
  -> ([@stop_split] [@expl:decoded_trace_escape_step ensures] ([@stop_split] [@expl:decoded_trace_escape_step ensures #0] [%#sdecoder_lemmas'3] true)
  /\ ([@stop_split] [@expl:decoded_trace_escape_step ensures #1] [%#sdecoder_lemmas'4] decoded_trace input
  = Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
  + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))))
