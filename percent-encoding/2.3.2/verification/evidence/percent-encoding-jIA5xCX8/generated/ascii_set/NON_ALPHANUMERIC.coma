use creusot.slice.Slice64BW
use creusot.int.UInt32BW
use seq.Seq
use creusot.int.UInt64BW
use creusot.int.UInt8BW
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_AsciiSet = { mask: Slice64BW.array UInt32BW.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32BW.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64BW.array UInt32BW.t) =
  inv_Seq_u32 (Slice64BW.view self) /\ Seq.length (Slice64BW.view self) = UInt64BW.t'int (4: UInt64BW.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64BW.array UInt32BW.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

constant const_NON_ALPHANUMERIC : t_AsciiSet

axiom const_NON_ALPHANUMERIC_spec: inv_ref_AsciiSet const_NON_ALPHANUMERIC

function mask_words (self: t_AsciiSet) : Seq.seq UInt32BW.t =
  Seq.create 4 (fun (i: int) -> Seq.get (Slice64BW.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

constant const_CONTROLS : t_AsciiSet

axiom const_CONTROLS_spec: inv_ref_AsciiSet const_CONTROLS

axiom const_CONTROLS_spec'0: Seq.length (mask_words const_CONTROLS) = 4

axiom const_CONTROLS_spec'1: Seq.get (mask_words const_CONTROLS) 0 = (4294967295: UInt32BW.t)
  /\ Seq.get (mask_words const_CONTROLS) 1 = (0: UInt32BW.t)
  /\ Seq.get (mask_words const_CONTROLS) 2 = (0: UInt32BW.t)
  /\ Seq.get (mask_words const_CONTROLS) 3 = (2147483648: UInt32BW.t)

let add (self: t_AsciiSet) (byte: UInt8BW.t) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:add requires] ([@stop_split] [@expl:add 'self' type invariant] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:add requires] UInt8BW.t'int byte < 128)}
  any
  [ return (result: t_AsciiSet) ->
  {[@stop_split] [@expl:add ensures] ([@stop_split] [@expl:add result type invariant] inv_AsciiSet result)
    /\ ([@stop_split] [@expl:add ensures] forall i: int. 0 <= i /\ i < 4
      -> Seq.get (mask_words result) i
      = (if i = ComputerDivision.div (UInt8BW.t'int byte) 32 then
        UInt32BW.bw_or (Seq.get (mask_words self) i) (UInt32BW.shl (1: UInt32BW.t) (UInt32BW.of_BV256 (UInt8BW.to_BV256 (UInt8BW.bw_and byte (31: UInt8BW.t)))))
      else
        Seq.get (mask_words self) i
      ))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

