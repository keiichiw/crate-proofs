  | & _21: MutBorrow.t (MutBorrow.t (Seq.seq tup2_ref_str_bool)) = Any.any_l ()
  | & _22: MutBorrow.t (MutBorrow.t (Seq.seq tup2_ref_str_bool)) = Any.any_l () ])
