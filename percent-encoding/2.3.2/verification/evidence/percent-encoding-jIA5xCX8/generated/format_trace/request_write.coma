        (fun (_x: MutBorrow.t (MutBorrow.t (Seq.seq tup2_ref_str_bool))) -> [ &_21 <- _x ] s3)
    | s3 = MutBorrow.borrow_mut <Seq.seq tup2_ref_str_bool> {_21.current.current}
        (fun (_bor: MutBorrow.t (Seq.seq tup2_ref_str_bool)) ->
          [ &_20 <- _bor ] [ &_21 <- { _21 with current = { _21.current with current = _bor.final } } ] s4)
    | s4 = push_back_ghost_tup2_ref_str_bool {_20} {event} (fun (_x: ()) -> [ &_19 <- _x ] s5)
