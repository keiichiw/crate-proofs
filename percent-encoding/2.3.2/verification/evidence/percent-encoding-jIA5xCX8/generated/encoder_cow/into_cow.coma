function mask_words (self: t_AsciiSet) : Seq.seq UInt32.t

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

function configured_set [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt32.t = mask_words self.ascii_set

meta "rewrite_def" function configured_set

let clone_PercentEncode (self: t_PercentEncode) (return (x: t_PercentEncode)) =
{[@stop_split] [@expl:clone 'self' type invariant] inv_ref_PercentEncode self}
  any
  [ return (result: t_PercentEncode) ->
  {[@stop_split] [@expl:clone_PercentEncode ensures] ([@stop_split] [@expl:clone result type invariant] inv_PercentEncode result)
    /\ ([@stop_split] [@expl:clone ensures #0] remaining_input result = remaining_input self)
    /\ ([@stop_split] [@expl:clone ensures #1] configured_set result = configured_set self)}
    (! return {result}) ]

