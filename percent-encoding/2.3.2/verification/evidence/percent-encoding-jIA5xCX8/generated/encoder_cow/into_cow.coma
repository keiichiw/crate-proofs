predicate empty_prefix_to_bytes (prefix: Seq.seq Char.t)

axiom empty_prefix_to_bytes_spec: forall prefix: Seq.seq Char.t [empty_prefix_to_bytes prefix]. Seq.length prefix = 0
    -> empty_prefix_to_bytes prefix

axiom empty_prefix_to_bytes_spec'0: forall prefix: Seq.seq Char.t. Seq.length prefix = 0
    -> Seq.(==) prefix (Seq.empty: Seq.seq Char.t)

axiom empty_prefix_to_bytes_spec'1: forall prefix: Seq.seq Char.t. Seq.length prefix = 0
    -> Seq.(==) (to_bytes prefix) (Seq.empty: Seq.seq UInt8.t)

predicate invariant_refmut_String [@inline:trivial] (self: MutBorrow.t t_String) =
  inv_String self.current /\ inv_String self.final

meta "rewrite_def" predicate invariant_refmut_String

predicate inv_refmut_String [@inline:trivial] (_1: MutBorrow.t t_String) = invariant_refmut_String _1

meta "rewrite_def" predicate inv_refmut_String

let append_string (output: MutBorrow.t t_String) (chunk: string) (return (x: ())) =
{[@stop_split] [@expl:append_string 'output' type invariant] inv_refmut_String output}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:append_string ensures] ([@stop_split] [@expl:append_string ensures #0] view_String output.final
      = Seq.(++) (view_String output.current) (view_str chunk))
    /\ ([@stop_split] [@expl:append_string ensures #1] byte_sequence_as_ints (to_bytes (view_String output.final))
    = Seq.(++) (byte_sequence_as_ints (to_bytes (view_String output.current))) (string_chunk_bytes chunk))}
    (! return {result}) ]

predicate resolve_refmut_String [@inline:trivial] (_1: MutBorrow.t t_String) = _1.final = _1.current

