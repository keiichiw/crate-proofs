let new_unit (x: ()) (return (x'0: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]

function tail_ref_str (self: Seq.seq string) : Seq.seq string = Seq.([..]) self 1 (Seq.length self)

function flat_map_ref_str (self: Seq.seq string) (other: Map.map string (Seq.seq int)) : Seq.seq int

axiom flat_map_ref_str_def:
  forall self: Seq.seq string, other: Map.map string (Seq.seq int) [flat_map_ref_str self other]. flat_map_ref_str self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq int
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_ref_str (tail_ref_str self) other)
    )

function encoder_chunks_bytes (chunks: Seq.seq string) : Seq.seq int =
  flat_map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)

predicate append_encoder_chunk (chunks: Seq.seq string) (chunk: string)

axiom append_encoder_chunk_spec:
  forall chunks: Seq.seq string, chunk: string [append_encoder_chunk chunks chunk]. append_encoder_chunk chunks chunk

axiom append_encoder_chunk_spec'0:
  forall chunks: Seq.seq string, chunk: string. encoder_chunks_bytes (Seq.snoc chunks chunk)
    = Seq.(++) (encoder_chunks_bytes chunks) (string_chunk_bytes chunk)

predicate string_bytes_concat (prefix: Seq.seq Char.t) (suffix: Seq.seq Char.t)

axiom string_bytes_concat_spec:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t [string_bytes_concat prefix suffix]. string_bytes_concat prefix suffix

axiom string_bytes_concat_spec'0:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t. to_bytes (Seq.(++) prefix suffix)
    = Seq.(++) (to_bytes prefix) (to_bytes suffix)

axiom string_bytes_concat_spec'1:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t. byte_sequence_as_ints (to_bytes (Seq.(++) prefix suffix))
    = Seq.(++) (byte_sequence_as_ints (to_bytes prefix)) (byte_sequence_as_ints (to_bytes suffix))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate produces_append (initial: t_PercentEncode) (prefix: Seq.seq string) (before: t_PercentEncode) (chunk: string) (after: t_PercentEncode)

axiom produces_append_spec:
  forall initial: t_PercentEncode, prefix: Seq.seq string, before: t_PercentEncode, chunk: string, after: t_PercentEncode [produces_append initial prefix before chunk after]. produces_PercentEncode initial prefix before
    -> produces_PercentEncode before (Seq.singleton chunk) after -> produces_append initial prefix before chunk after

axiom produces_append_spec'0:
  forall initial: t_PercentEncode, prefix: Seq.seq string, before: t_PercentEncode, chunk: string, after: t_PercentEncode. produces_PercentEncode initial prefix before
    -> produces_PercentEncode before (Seq.singleton chunk) after
    -> produces_PercentEncode initial (Seq.snoc prefix chunk) after

function flatten_chunks (chunks: Seq.seq (Seq.seq int)) : Seq.seq int

axiom flatten_chunks_spec: forall chunks: Seq.seq (Seq.seq int) [flatten_chunks chunks]. if Seq.length chunks = 0 then
      Seq.length (flatten_chunks chunks) = 0
    else
      flatten_chunks chunks = Seq.(++) (Seq.get chunks 0) (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks)))


predicate encoder_chunks_flatten (chunks: Seq.seq string)

axiom encoder_chunks_flatten_spec:
  forall chunks: Seq.seq string [encoder_chunks_flatten chunks]. encoder_chunks_flatten chunks

axiom encoder_chunks_flatten_spec'0: forall chunks: Seq.seq string. encoder_chunks_bytes chunks
    = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))

predicate produces_complete (initial: t_PercentEncode) (visited: Seq.seq string) (iter: t_PercentEncode)

axiom produces_complete_spec:
  forall initial: t_PercentEncode, visited: Seq.seq string, iter: t_PercentEncode [produces_complete initial visited iter]. produces_PercentEncode initial visited iter
    -> configured_set initial = configured_set iter
    -> Seq.length (remaining_input iter) = 0 -> produces_complete initial visited iter

axiom produces_complete_spec'0:
  forall initial: t_PercentEncode, visited: Seq.seq string, iter: t_PercentEncode. produces_PercentEncode initial visited iter
    -> configured_set initial = configured_set iter
    -> Seq.length (remaining_input iter) = 0
    -> encoded_chunks (configured_set initial) (remaining_input initial)
    = map_ref_str visited (fun (chunk: string) -> string_chunk_bytes chunk)

type t_Cow_str = Borrowed string | Owned t_String

let from_utf8_unchecked (bytes'0: Slice64.slice UInt8.t) (return (x: string)) =
{[@stop_split] [@expl:from_utf8_unchecked requires] (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes'0)
      -> UInt8.t'int (Seq.get (Slice64.view bytes'0) i) < 128)
  \/ (exists s: Seq.seq Char.t. to_bytes s = Slice64.view bytes'0)}
  any
  [ return (result: string) -> {[@stop_split] [@expl:from_utf8_unchecked ensures] to_bytes (view_str result)
    = Slice64.view bytes'0}
    (! return {result}) ]

predicate inv_Cow_str (_1: t_Cow_str)

axiom inv_axiom'0 [@rewrite]: forall x: t_Cow_str [inv_Cow_str x]. inv_Cow_str x
    = match x with
      | Borrowed f0 -> true
      | Owned f0 -> inv_String f0
      end

function cow_string_bytes (value: t_Cow_str) : Seq.seq int = match value with
    | Borrowed s -> byte_sequence_as_ints (to_bytes (view_str s))
    | Owned s -> byte_sequence_as_ints (to_bytes (view_String s))
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_cow (iter: t_PercentEncode) (return (x: t_Cow_str)) =
{[@stop_split] [@expl:into_cow 'iter' type invariant] inv_PercentEncode iter}
  (! bb0
  [ bb0 = s0
    [ s0 = clone_PercentEncode {iter} (fun (_x: t_PercentEncode) -> [ &initial <- _x ] s1)
    | s1 = s2 [ _ck -> (! {[@expl:type invariant] inv_PercentEncode initial} any) ]
    | s2 = [ &iter'0 <- iter ] s3
    | s3 = MutBorrow.borrow_mut <t_PercentEncode> {iter'0}
        (fun (_bor: MutBorrow.t t_PercentEncode) ->
          [ &_10 <- _bor ] -{inv_PercentEncode _bor.final}-
          [ &iter'0 <- _bor.final ] s4) [ _ck -> (! {[@expl:type invariant] inv_PercentEncode iter'0} any) ]
    | s4 = next_PercentEncode {_10} (fun (_x: t_Option_ref_str) -> [ &_9 <- _x ] s5)
    | s5 = any [ br0 -> {_9 = None} (! bb4) | br1 (x0: string) -> {_9 = Some x0} (! bb5) ] ]
  | bb5 = s0
    [ s0 = elim_Some {_9} (fun (r0: string) -> [ &first <- r0 ] s1)
    | s1 = MutBorrow.borrow_mut <t_PercentEncode> {iter'0}
        (fun (_bor: MutBorrow.t t_PercentEncode) ->
          [ &_20 <- _bor ] -{inv_PercentEncode _bor.final}-
          [ &iter'0 <- _bor.final ] s2) [ _ck -> (! {[@expl:type invariant] inv_PercentEncode iter'0} any) ]
    | s2 = next_PercentEncode {_20} (fun (_x: t_Option_ref_str) -> [ &_19 <- _x ] s3)
    | s3 = any [ br0 -> {_19 = None} (! bb10) | br1 (x0: string) -> {_19 = Some x0} (! bb11) ] ]
