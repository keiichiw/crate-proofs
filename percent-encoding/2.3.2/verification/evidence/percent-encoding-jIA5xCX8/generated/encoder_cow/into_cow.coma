  [ return (result: ()) -> {[@stop_split] [@expl:push_back_ghost ensures] self.final = Seq.snoc self.current x}
    (! return {result}) ]

predicate resolve_refmut_Seq_ref_str [@inline:trivial] (_1: MutBorrow.t (Seq.seq string)) = _1.final = _1.current

