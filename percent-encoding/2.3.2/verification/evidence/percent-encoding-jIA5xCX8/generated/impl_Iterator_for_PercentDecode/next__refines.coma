(* <PercentDecode<'_> as core::iter::Iterator> *)

use creusot.prelude.MutBorrow
use creusot.int.UInt8
use seq.Seq
use map.Map
use creusot.slice.Slice64
use int.Int

type t_Iter_u8

type t_PercentDecode = { bytes: t_Iter_u8 }

predicate inv_Iter_u8 (_1: t_Iter_u8)

predicate inv_PercentDecode (_1: t_PercentDecode)

axiom inv_axiom [@rewrite]: forall x: t_PercentDecode [inv_PercentDecode x]. inv_PercentDecode x = inv_Iter_u8 x.bytes

predicate invariant_refmut_PercentDecode [@inline:trivial] (self: MutBorrow.t t_PercentDecode) =
  inv_PercentDecode self.current /\ inv_PercentDecode self.final

meta "rewrite_def" predicate invariant_refmut_PercentDecode

predicate inv_refmut_PercentDecode [@inline:trivial] (_1: MutBorrow.t t_PercentDecode) =
  invariant_refmut_PercentDecode _1

meta "rewrite_def" predicate inv_refmut_PercentDecode

type t_Option_u8 = None | Some UInt8.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


function decoded_trace (input: Seq.seq int) : Seq.seq int

axiom decoded_trace_def: forall input: Seq.seq int [decoded_trace input]. decoded_trace input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq int
    else
      if ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
        Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
        + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))
      else
        Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))
    
    )

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes'0: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes'0 (fun (byte: UInt8.t) -> UInt8.t'int byte)

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

function remaining_input [@inline:trivial] (self: t_PercentDecode) : Seq.seq UInt8.t =
  Slice64.view (view_Iter_u8 self.bytes)

meta "rewrite_def" function remaining_input

predicate produces_PercentDecode (self: t_PercentDecode) (visited: Seq.seq UInt8.t) (o: t_PercentDecode) =
  decoded_trace (byte_sequence_as_ints (remaining_input self))
  = Seq.(++) (byte_sequence_as_ints visited) (decoded_trace (byte_sequence_as_ints (remaining_input o)))

function produces_trans_PercentDecode (a: t_PercentDecode) (ab: Seq.seq UInt8.t) (b: t_PercentDecode) (bc: Seq.seq UInt8.t) (c: t_PercentDecode) : ()
 = ()

axiom produces_trans_PercentDecode_spec:
  forall a: t_PercentDecode, ab: Seq.seq UInt8.t, b: t_PercentDecode, bc: Seq.seq UInt8.t, c: t_PercentDecode. produces_PercentDecode a ab b
    -> produces_PercentDecode b bc c -> produces_PercentDecode a (Seq.(++) ab bc) c

function produces_refl_PercentDecode (self: t_PercentDecode) : () = ()

axiom produces_refl_PercentDecode_spec:
  forall self: t_PercentDecode. produces_PercentDecode self (Seq.empty: Seq.seq UInt8.t) self

predicate resolve_refmut_PercentDecode [@inline:trivial] (_1: MutBorrow.t t_PercentDecode) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_PercentDecode

predicate completed_PercentDecode (self: MutBorrow.t t_PercentDecode) =
  Seq.length (remaining_input self.current) = 0 /\ resolve_refmut_PercentDecode self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: MutBorrow.t t_PercentDecode. inv_refmut_PercentDecode self_
    -> inv_refmut_PercentDecode self_
    /\ (forall result: t_Option_u8. match result with
          | Some item -> produces_PercentDecode self_.current (Seq.singleton item) self_.final
          | None -> completed_PercentDecode self_
          end
      -> match result with
        | None -> completed_PercentDecode self_
        | Some v -> produces_PercentDecode self_.current (Seq.singleton v) self_.final
        end)
