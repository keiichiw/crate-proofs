use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt32
use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate should_encode_model (mask: Seq.seq UInt32.t) (byte: UInt8.t) =
  ge_log_Int (UInt8.t'int byte) 128
  \/ UInt32.bw_and (Seq.get mask (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq UInt8.t

constant start : int

constant mask : Seq.seq UInt32.t

function safe_run_end (input: Seq.seq UInt8.t) (start: int) (mask: Seq.seq UInt32.t) : int

goal vc_safe_run_end: 0 <= start /\ start <= Seq.length input
  -> Seq.length mask = 4
  -> (if ge_log_Int start (Seq.length input) then
    let result = start in [@stop_split] [@expl:safe_run_end ensures] ([@stop_split] [@expl:safe_run_end ensures #0] start
        <= result
      /\ result <= Seq.length input)
    /\ ([@stop_split] [@expl:safe_run_end ensures #1] forall i: int. start <= i /\ i < result
        -> not should_encode_model mask (Seq.get input i))
    /\ ([@stop_split] [@expl:safe_run_end ensures #2] result = Seq.length input
      \/ should_encode_model mask (Seq.get input result))
    /\ ([@stop_split] [@expl:safe_run_end ensures #3] start < Seq.length input
      /\ not should_encode_model mask (Seq.get input start) -> start < result)
  else
    if should_encode_model mask (Seq.get input start) then
      let result = start in [@stop_split] [@expl:safe_run_end ensures] ([@stop_split] [@expl:safe_run_end ensures #0] start
          <= result
        /\ result <= Seq.length input)
      /\ ([@stop_split] [@expl:safe_run_end ensures #1] forall i: int. start <= i /\ i < result
          -> not should_encode_model mask (Seq.get input i))
      /\ ([@stop_split] [@expl:safe_run_end ensures #2] result = Seq.length input
        \/ should_encode_model mask (Seq.get input result))
      /\ ([@stop_split] [@expl:safe_run_end ensures #3] start < Seq.length input
        /\ not should_encode_model mask (Seq.get input start) -> start < result)
    else
      (([@stop_split] [@expl:safe_run_end requires] ([@stop_split] [@expl:safe_run_end requires #0] 0 <= start + 1
            /\ start + 1 <= Seq.length input)
          /\ ([@stop_split] [@expl:safe_run_end requires #1] Seq.length mask = 4))
        /\ ([@expl:variant decreases] well_founded_relation_Int (Seq.length input - start) (Seq.length input
        - (start + 1))))
      /\ (([@stop_split] [@expl:safe_run_end ensures] ([@stop_split] [@expl:safe_run_end ensures #0] start + 1
            <= safe_run_end input (start + 1) mask
          /\ safe_run_end input (start + 1) mask <= Seq.length input)
        /\ ([@stop_split] [@expl:safe_run_end ensures #1] forall i: int. start + 1 <= i
              /\ i < safe_run_end input (start + 1) mask -> not should_encode_model mask (Seq.get input i))
        /\ ([@stop_split] [@expl:safe_run_end ensures #2] safe_run_end input (start + 1) mask = Seq.length input
          \/ should_encode_model mask (Seq.get input (safe_run_end input (start + 1) mask)))
        /\ ([@stop_split] [@expl:safe_run_end ensures #3] start + 1 < Seq.length input
          /\ not should_encode_model mask (Seq.get input (start + 1))
        -> start + 1 < safe_run_end input (start + 1) mask))
      -> (let result = safe_run_end input (start
      + 1) mask in [@stop_split] [@expl:safe_run_end ensures] ([@stop_split] [@expl:safe_run_end ensures #0] start
          <= result
        /\ result <= Seq.length input)
      /\ ([@stop_split] [@expl:safe_run_end ensures #1] forall i: int. start <= i /\ i < result
          -> not should_encode_model mask (Seq.get input i))
      /\ ([@stop_split] [@expl:safe_run_end ensures #2] result = Seq.length input
        \/ should_encode_model mask (Seq.get input result))
      /\ ([@stop_split] [@expl:safe_run_end ensures #3] start < Seq.length input
        /\ not should_encode_model mask (Seq.get input start) -> start < result)))
  
  )
