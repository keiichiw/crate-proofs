use creusot.int.UInt32
use seq.Seq
use creusot.int.UInt8
use int.ComputerDivision
use map.Map
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate should_encode_model (mask: Seq.seq UInt32.t) (byte: UInt8.t) =
  ge_log_Int (UInt8.t'int byte) 128
  \/ UInt32.bw_and (Seq.get mask (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

function uppercase_hex (digit: int) : int = if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function uppercase_hex'0 (digit: int) : int = uppercase_hex digit

function encoded_byte_model (byte: int) : Seq.seq int =
  Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex'0 (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex'0 (ComputerDivision.mod byte 16)))

function safe_run_end (input: Seq.seq UInt8.t) (start: int) (mask: Seq.seq UInt32.t) : int

axiom safe_run_end_spec:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> start <= safe_run_end input start mask /\ safe_run_end input start mask <= Seq.length input

axiom safe_run_end_spec'0:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> (forall i: int. start <= i /\ i < safe_run_end input start mask
      -> not should_encode_model mask (Seq.get input i))

axiom safe_run_end_spec'1:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> safe_run_end input start mask = Seq.length input
    \/ should_encode_model mask (Seq.get input (safe_run_end input start mask))

axiom safe_run_end_spec'2:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> start < Seq.length input /\ not should_encode_model mask (Seq.get input start)
    -> start < safe_run_end input start mask

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant mask : Seq.seq UInt32.t

constant input : Seq.seq UInt8.t

function encoded_chunks (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t) : Seq.seq (Seq.seq int)

goal vc_encoded_chunks: Seq.length mask = 4
  -> (if Seq.length input = 0 then
    let result = Seq.empty: Seq.seq (Seq.seq int) in [@stop_split] [@expl:encoded_chunks ensures] if Seq.length input
    = 0 then
      Seq.length result = 0
    else
      gt_log_Int (Seq.length result) 0
      /\ (if should_encode_model mask (Seq.get input 0) then
        Seq.get result 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
        /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
      else
        let end' = safe_run_end input 0 mask in Seq.get result 0 = byte_sequence_as_ints (Seq.([..]) input 0 end')
        /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input end' (Seq.length input))
      )
  
  else
    if should_encode_model mask (Seq.get input 0) then
      (([@stop_split] [@expl:encoded_chunks requires] Seq.length mask = 4)
        /\ ([@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 1 (Seq.length input)))))
      /\ (([@stop_split] [@expl:encoded_chunks ensures] if Seq.length (Seq.([..]) input 1 (Seq.length input)) = 0 then
          Seq.length (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) = 0
        else
          gt_log_Int (Seq.length (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))) 0
          /\ (if should_encode_model mask (Seq.get (Seq.([..]) input 1 (Seq.length input)) 0) then
            Seq.get (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) 0
              = encoded_byte_model (UInt8.t'int (Seq.get (Seq.([..]) input 1 (Seq.length input)) 0))
            /\ Seq.([..]) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) 1 (Seq.length (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))))
            = encoded_chunks mask (Seq.([..]) (Seq.([..]) input 1 (Seq.length input)) 1 (Seq.length (Seq.([..]) input 1 (Seq.length input))))
          else
            let end' = safe_run_end (Seq.([..]) input 1 (Seq.length input)) 0 mask in Seq.get (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) 0
              = byte_sequence_as_ints (Seq.([..]) (Seq.([..]) input 1 (Seq.length input)) 0 end')
            /\ Seq.([..]) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) 1 (Seq.length (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))))
            = encoded_chunks mask (Seq.([..]) (Seq.([..]) input 1 (Seq.length input)) end' (Seq.length (Seq.([..]) input 1 (Seq.length input))))
          )
        )
      -> (let result = Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))) in [@stop_split] [@expl:encoded_chunks ensures] if Seq.length input
      = 0 then
        Seq.length result = 0
      else
        gt_log_Int (Seq.length result) 0
        /\ (if should_encode_model mask (Seq.get input 0) then
          Seq.get result 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
          /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
        else
          let end' = safe_run_end input 0 mask in Seq.get result 0 = byte_sequence_as_ints (Seq.([..]) input 0 end')
          /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input end' (Seq.length input))
        )
      ))
    else
      ([@stop_split] [@expl:safe_run_end requires] ([@stop_split] [@expl:safe_run_end requires #0] 0 <= 0
          /\ 0 <= Seq.length input)
        /\ ([@stop_split] [@expl:safe_run_end requires #1] Seq.length mask = 4))
      /\ (([@stop_split] [@expl:safe_run_end ensures] ([@stop_split] [@expl:safe_run_end ensures #0] 0
            <= safe_run_end input 0 mask
          /\ safe_run_end input 0 mask <= Seq.length input)
        /\ ([@stop_split] [@expl:safe_run_end ensures #1] forall i: int. 0 <= i /\ i < safe_run_end input 0 mask
            -> not should_encode_model mask (Seq.get input i))
        /\ ([@stop_split] [@expl:safe_run_end ensures #2] safe_run_end input 0 mask = Seq.length input
          \/ should_encode_model mask (Seq.get input (safe_run_end input 0 mask)))
        /\ ([@stop_split] [@expl:safe_run_end ensures #3] 0 < Seq.length input
          /\ not should_encode_model mask (Seq.get input 0) -> 0 < safe_run_end input 0 mask))
      -> (let end' = safe_run_end input 0 mask in (([@stop_split] [@expl:encoded_chunks requires] Seq.length mask = 4)
        /\ ([@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input end' (Seq.length input)))))
      /\ (([@stop_split] [@expl:encoded_chunks ensures] if Seq.length (Seq.([..]) input end' (Seq.length input))
        = 0 then
          Seq.length (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) = 0
        else
          gt_log_Int (Seq.length (encoded_chunks mask (Seq.([..]) input end' (Seq.length input)))) 0
          /\ (if should_encode_model mask (Seq.get (Seq.([..]) input end' (Seq.length input)) 0) then
            Seq.get (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) 0
              = encoded_byte_model (UInt8.t'int (Seq.get (Seq.([..]) input end' (Seq.length input)) 0))
            /\ Seq.([..]) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) 1 (Seq.length (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))))
            = encoded_chunks mask (Seq.([..]) (Seq.([..]) input end' (Seq.length input)) 1 (Seq.length (Seq.([..]) input end' (Seq.length input))))
          else
            let end''0 = safe_run_end (Seq.([..]) input end' (Seq.length input)) 0 mask in Seq.get (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) 0
              = byte_sequence_as_ints (Seq.([..]) (Seq.([..]) input end' (Seq.length input)) 0 end''0)
            /\ Seq.([..]) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) 1 (Seq.length (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))))
            = encoded_chunks mask (Seq.([..]) (Seq.([..]) input end' (Seq.length input)) end''0 (Seq.length (Seq.([..]) input end' (Seq.length input))))
          )
        )
      -> (let result = Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) input 0 end'))) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input))) in [@stop_split] [@expl:encoded_chunks ensures] if Seq.length input
      = 0 then
        Seq.length result = 0
      else
        gt_log_Int (Seq.length result) 0
        /\ (if should_encode_model mask (Seq.get input 0) then
          Seq.get result 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
          /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
        else
          let end''0 = safe_run_end input 0 mask in Seq.get result 0 = byte_sequence_as_ints (Seq.([..]) input 0 end''0)
          /\ Seq.([..]) result 1 (Seq.length result) = encoded_chunks mask (Seq.([..]) input end''0 (Seq.length input))
        )
      ))))
  
  )
