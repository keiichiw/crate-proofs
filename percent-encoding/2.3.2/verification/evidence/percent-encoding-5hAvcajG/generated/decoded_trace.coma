use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq int

function decoded_trace (input: Seq.seq int) : Seq.seq int

goal vc_decoded_trace: if Seq.length input = 0 then
    true
  else
    if ge_log_Int (Seq.length input) 3 then
      if Seq.get input 0 = 37 then
        if ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0 then
          if ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
            [@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 3 (Seq.length input)))
          else
            [@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 1 (Seq.length input)))
        
        else
          [@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 1 (Seq.length input)))
      
      else
        [@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 1 (Seq.length input)))
    
    else
      [@expl:variant decreases] well_founded_relation_Int (Seq.length input) (Seq.length (Seq.([..]) input 1 (Seq.length input)))
  
  
