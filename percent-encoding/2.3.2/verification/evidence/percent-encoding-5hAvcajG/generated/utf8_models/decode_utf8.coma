use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Char
use map.Map
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

type t_Cow_slice_u8 = Borrowed (Slice64.slice UInt8.t) | Owned t_Vec_u8_Global

let elim_Owned (_x: t_Cow_slice_u8) (return (f0: t_Vec_u8_Global)) = any
  [ _k (f0: t_Vec_u8_Global) -> {Owned f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Owned] match _x with
      | Owned _ -> true
      | _ -> false
      end}
    any) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. Seq.length (view_Vec_u8_Global self) <= UInt64.t'int const_MAX

let deref_Vec_u8_Global (self_: t_Vec_u8_Global) (return (x: Slice64.slice UInt8.t)) = any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:deref ensures] Slice64.view result
    = view_Vec_u8_Global self_}
    (! return {result}) ]

type t_Utf8Error

type t_Result_ref_str_Utf8Error = Ok string | Err t_Utf8Error

predicate inv_Utf8Error (_1: t_Utf8Error)

predicate inv_Result_ref_str_Utf8Error (_1: t_Result_ref_str_Utf8Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_ref_str_Utf8Error [inv_Result_ref_str_Utf8Error x]. inv_Result_ref_str_Utf8Error x
    = match x with
      | Ok f0 -> true
      | Err f0 -> inv_Utf8Error f0
      end

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

predicate utf8_is_valid (bytes: Seq.seq UInt8.t) = exists chars: Seq.seq Char.t. to_bytes chars = bytes

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

predicate utf8_int_valid (bytes: Seq.seq int) =
  exists raw: Seq.seq UInt8.t, chars: Seq.seq Char.t. map_u8 raw (fun (byte: UInt8.t) -> UInt8.t'int byte) = bytes
    /\ to_bytes chars = raw

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

function view_str (self: string) : Seq.seq Char.t

function std_error_offset (_error: t_Utf8Error) : int

type t_Option_Int = None | Some int

type tup2_Int_Option_Int = { f0: int; f1: t_Option_Int }

type t_Option_tup2_Int_Option_Int = None'0 | Some'0 tup2_Int_Option_Int

type tup3_Int_Int_bool = { f0'0: int; f1'0: int; f2'0: bool }

function utf8_step (bytes: Seq.seq int) (pos: int) : tup3_Int_Int_bool =
  let b0 = Seq.get bytes pos in let remaining = Seq.length bytes - pos in if 0 <= b0 /\ b0 <= 127 then
    { f0'0 = b0; f1'0 = 1; f2'0 = true }
  else
    if 194 <= b0 /\ b0 <= 223 then
      if remaining < 2 then
        { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
      else
        let b1 = Seq.get bytes (pos + 1) in if 128 <= b1 /\ b1 <= 191 then
          { f0'0 = (b0 - 192) * 64 + (b1 - 128); f1'0 = 2; f2'0 = true }
        else
          { f0'0 = 65533; f1'0 = 1; f2'0 = false }
      
    
    else
      if 224 <= b0 /\ b0 <= 239 then
        if remaining < 2 then
          { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
        else
          let b1 = Seq.get bytes (pos + 1) in let second_ok = if b0 = 224 then
            160 <= b1 /\ b1 <= 191
          else
            if b0 = 237 then 128 <= b1 /\ b1 <= 159 else 128 <= b1 /\ b1 <= 191
           in if not second_ok then
            { f0'0 = 65533; f1'0 = 1; f2'0 = false }
          else
            if remaining < 3 then
              { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
            else
              let b2 = Seq.get bytes (pos + 2) in if 128 <= b2 /\ b2 <= 191 then
                { f0'0 = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128); f1'0 = 3; f2'0 = true }
              else
                { f0'0 = 65533; f1'0 = 2; f2'0 = false }
            
          
        
      
      else
        if 240 <= b0 /\ b0 <= 244 then
          if remaining < 2 then
            { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
          else
            let b1 = Seq.get bytes (pos + 1) in let second_ok = if b0 = 240 then
              144 <= b1 /\ b1 <= 191
            else
              if b0 = 244 then 128 <= b1 /\ b1 <= 143 else 128 <= b1 /\ b1 <= 191
             in if not second_ok then
              { f0'0 = 65533; f1'0 = 1; f2'0 = false }
            else
              if remaining < 3 then
                { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
              else
                let b2 = Seq.get bytes (pos + 2) in if not (128 <= b2 /\ b2 <= 191) then
                  { f0'0 = 65533; f1'0 = 2; f2'0 = false }
                else
                  if remaining < 4 then
                    { f0'0 = 65533; f1'0 = remaining; f2'0 = false }
                  else
                    let b3 = Seq.get bytes (pos + 3) in if 128 <= b3 /\ b3 <= 191 then
                      { f0'0 = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
                        f1'0 = 4;
                        f2'0 = true }
                    else
                      { f0'0 = 65533; f1'0 = 3; f2'0 = false }
                  
                
              
            
          
        
        else
          { f0'0 = 65533; f1'0 = 1; f2'0 = false }
      
    
  


function strict_error (bytes: Seq.seq int) : t_Option_tup2_Int_Option_Int

axiom strict_error_def: forall bytes: Seq.seq int [strict_error bytes]. strict_error bytes
    = (if Seq.length bytes = 0 then
      None'0
    else
      let {f1'0 = consumed; f2'0 = valid} = utf8_step bytes 0 in if valid then
        match strict_error (Seq.([..]) bytes consumed (Seq.length bytes)) with
          | Some'0 {f0 = offset; f1 = len} -> Some'0 { f0 = consumed + offset; f1 = len }
          | None'0 -> None'0
          end
      else
        let lead = Seq.get bytes 0 in let remaining = Seq.length bytes in let truncated = 194 <= lead
          /\ lead <= 223 /\ remaining < 2
        \/ 224 <= lead /\ lead <= 239 /\ remaining < 3 /\ consumed = remaining
        \/ 240 <= lead /\ lead <= 244 /\ remaining < 4 /\ consumed = remaining in Some'0 { f0 = 0;
                                                                                           f1 = (if truncated then
                                                                                             None
                                                                                           else
                                                                                             Some consumed
                                                                                           ) }
    
    )

function strict_error_offset (bytes: Seq.seq int) : int = match strict_error bytes with
    | Some'0 {f0 = offset} -> offset
    | None'0 -> 0
    end

function std_error_length (_error: t_Utf8Error) : t_Option_Int

function strict_error_length (bytes: Seq.seq int) : t_Option_Int = match strict_error bytes with
    | Some'0 {f1 = length} -> length
    | None'0 -> None
    end

let from_utf8 (bytes: Slice64.slice UInt8.t) (return (x: t_Result_ref_str_Utf8Error)) = any
  [ return (result: t_Result_ref_str_Utf8Error) ->
  {[@stop_split] [@expl:from_utf8 ensures] ([@stop_split] [@expl:from_utf8 result type invariant] inv_Result_ref_str_Utf8Error result)
    /\ ([@stop_split] [@expl:from_utf8 ensures] match result with
      | Ok value -> utf8_is_valid (Slice64.view bytes)
      /\ utf8_int_valid (byte_sequence_as_ints (Slice64.view bytes))
      /\ (exists chars: Seq.seq Char.t. to_bytes chars = Slice64.view bytes /\ view_str value = chars)
      | Err error -> not utf8_is_valid (Slice64.view bytes)
      /\ not utf8_int_valid (byte_sequence_as_ints (Slice64.view bytes))
      /\ std_error_offset error = strict_error_offset (byte_sequence_as_ints (Slice64.view bytes))
      /\ std_error_length error = strict_error_length (byte_sequence_as_ints (Slice64.view bytes))
      end)}
    (! return {result}) ]

let elim_Err (_x: t_Result_ref_str_Utf8Error) (return (f0'1: t_Utf8Error)) = any
  [ _k (f0'1: t_Utf8Error) -> {Err f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_String

type t_Cow_str = Borrowed'0 string | Owned'0 t_String

type t_Result_Cow_str_Utf8Error = Ok'0 t_Cow_str | Err'0 t_Utf8Error

let elim_Ok (_x: t_Result_ref_str_Utf8Error) (return (f0'1: string)) = any
  [ _k (f0'1: string) -> {Ok f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_String (_1: t_String)

function view_String (self: t_String) : Seq.seq Char.t

let from_utf8_unchecked (bytes: t_Vec_u8_Global) (return (x: t_String)) =
{[@stop_split] [@expl:from_utf8_unchecked requires] exists s: Seq.seq Char.t. to_bytes s = view_Vec_u8_Global bytes}
  any
  [ return (result: t_String) ->
  {[@stop_split] [@expl:from_utf8_unchecked ensures] ([@stop_split] [@expl:from_utf8_unchecked result type invariant] inv_String result)
    /\ ([@stop_split] [@expl:from_utf8_unchecked ensures] to_bytes (view_String result) = view_Vec_u8_Global bytes)}
    (! return {result}) ]

let elim_Borrowed (_x: t_Cow_slice_u8) (return (f0'1: Slice64.slice UInt8.t)) = any
  [ _k (f0'1: Slice64.slice UInt8.t) -> {Borrowed f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Borrowed] match _x with
      | Borrowed _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_Cow_str (_1: t_Cow_str)

axiom inv_axiom'0 [@rewrite]: forall x: t_Cow_str [inv_Cow_str x]. inv_Cow_str x
    = match x with
      | Borrowed'0 f0'1 -> true
      | Owned'0 f0'1 -> inv_String f0'1
      end

predicate inv_Result_Cow_str_Utf8Error (_1: t_Result_Cow_str_Utf8Error)

axiom inv_axiom'1 [@rewrite]:
  forall x: t_Result_Cow_str_Utf8Error [inv_Result_Cow_str_Utf8Error x]. inv_Result_Cow_str_Utf8Error x
    = match x with
      | Ok'0 f0'1 -> inv_Cow_str f0'1
      | Err'0 f0'1 -> inv_Utf8Error f0'1
      end

function cow_bytes (value: t_Cow_slice_u8) : Seq.seq UInt8.t = match value with
    | Borrowed bytes -> Slice64.view bytes
    | Owned bytes -> view_Vec_u8_Global bytes
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let decode_utf8 (input: t_Cow_slice_u8) (return (x: t_Result_Cow_str_Utf8Error)) = (! bb0
  [ bb0 = any
    [ br0 (x0: Slice64.slice UInt8.t) -> {input = Borrowed x0} (! bb4)
    | br1 (x0: t_Vec_u8_Global) -> {input = Owned x0} (! bb3) ]
  | bb3 = s0
    [ s0 = elim_Owned {input} (fun (r0: t_Vec_u8_Global) -> [ &bytes'0 <- r0 ] s1)
    | s1 = [ &_18 <- bytes'0 ] s2
    | s2 = deref_Vec_u8_Global {_18} (fun (_x: Slice64.slice UInt8.t) -> [ &_16 <- _x ] s3)
    | s3 = [ &raw <- _16 ] s4
    | s4 = from_utf8 {raw} (fun (_x: t_Result_ref_str_Utf8Error) -> [ &_19 <- _x ] s5)
    | s5 = any [ br0 (x0: string) -> {_19 = Ok x0} (! bb17) | br1 (x0: t_Utf8Error) -> {_19 = Err x0} (! bb16) ] ]
  | bb16 = s0
    [ s0 = elim_Err {_19} (fun (r0: t_Utf8Error) -> [ &error'0 <- r0 ] s1)
    | s1 = [ &_ret <- Err'0 error'0 ] s2
    | s2 = return {_ret} ]
  | bb17 = s0
    [ s0 = elim_Ok {_19} (fun (r0: string) -> [ &_value <- r0 ] s1)
    | s1 = {[@expl:assertion] utf8_is_valid (view_Vec_u8_Global bytes'0)} s2
    | s2 = from_utf8_unchecked {bytes'0} (fun (_x: t_String) -> [ &_27 <- _x ] s3)
    | s3 = [ &_26 <- Owned'0 _27 ] s4
    | s4 = [ &_ret <- Ok'0 _26 ] s5
    | s5 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Borrowed {input} (fun (r0: Slice64.slice UInt8.t) -> [ &bytes <- r0 ] s1)
    | s1 = from_utf8 {bytes} (fun (_x: t_Result_ref_str_Utf8Error) -> [ &_6 <- _x ] s2)
    | s2 = any [ br0 (x0: string) -> {_6 = Ok x0} (! bb9) | br1 (x0: t_Utf8Error) -> {_6 = Err x0} (! bb8) ] ]
  | bb8 = s0
    [ s0 = elim_Err {_6} (fun (r0: t_Utf8Error) -> [ &error <- r0 ] s1)
    | s1 = [ &_ret <- Err'0 error ] s2
    | s2 = return {_ret} ]
  | bb9 = s0
    [ s0 = elim_Ok {_6} (fun (r0: string) -> [ &value <- r0 ] s1)
    | s1 = [ &_10 <- Borrowed'0 value ] s2
    | s2 = [ &_ret <- Ok'0 _10 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_Cow_str_Utf8Error = Any.any_l ()
  | & input: t_Cow_slice_u8 = input
  | & bytes: Slice64.slice UInt8.t = Any.any_l ()
  | & _6: t_Result_ref_str_Utf8Error = Any.any_l ()
  | & value: string = Any.any_l ()
  | & _10: t_Cow_str = Any.any_l ()
  | & error: t_Utf8Error = Any.any_l ()
  | & bytes'0: t_Vec_u8_Global = Any.any_l ()
  | & raw: Slice64.slice UInt8.t = Any.any_l ()
  | & _16: Slice64.slice UInt8.t = Any.any_l ()
  | & _18: t_Vec_u8_Global = Any.any_l ()
  | & _19: t_Result_ref_str_Utf8Error = Any.any_l ()
  | & _value: string = Any.any_l ()
  | & _26: t_Cow_str = Any.any_l ()
  | & _27: t_String = Any.any_l ()
  | & error'0: t_Utf8Error = Any.any_l () ])
  [ return (result: t_Result_Cow_str_Utf8Error) ->
  {[@stop_split] [@expl:decode_utf8 ensures] ([@stop_split] [@expl:decode_utf8 result type invariant] inv_Result_Cow_str_Utf8Error result)
    /\ ([@stop_split] [@expl:decode_utf8 ensures] match result with
      | Ok'0 (Borrowed'0 value) -> match input with
        | Borrowed bytes -> utf8_int_valid (byte_sequence_as_ints (Slice64.view bytes))
        /\ (exists chars: Seq.seq Char.t. to_bytes chars = Slice64.view bytes /\ view_str value = chars)
        | Owned _ -> false
        end
      | Ok'0 (Owned'0 value) -> match input with
        | Borrowed _ -> false
        | Owned bytes -> utf8_int_valid (byte_sequence_as_ints (view_Vec_u8_Global bytes))
        /\ (exists chars: Seq.seq Char.t. to_bytes chars = view_Vec_u8_Global bytes /\ view_String value = chars)
        end
      | Err'0 error -> not utf8_is_valid (cow_bytes input)
      /\ not utf8_int_valid (byte_sequence_as_ints (cow_bytes input))
      /\ std_error_offset error = strict_error_offset (byte_sequence_as_ints (cow_bytes input))
      /\ std_error_length error = strict_error_length (byte_sequence_as_ints (cow_bytes input))
      end)}
    (! return {result}) ]
