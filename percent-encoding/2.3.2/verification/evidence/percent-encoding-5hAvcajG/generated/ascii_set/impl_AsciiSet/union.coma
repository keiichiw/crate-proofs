(* ascii_set::AsciiSet *)

use creusot.int.UInt64BW
use creusot.int.UInt32BW
use creusot.slice.Slice64BW
use creusot.prelude.Any
use seq.Seq
use int.Int

type t_AsciiSet = { mask: Slice64BW.array UInt32BW.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32BW.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64BW.array UInt32BW.t) =
  inv_Seq_u32 (Slice64BW.view self) /\ Seq.length (Slice64BW.view self) = UInt64BW.t'int (4: UInt64BW.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64BW.array UInt32BW.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

function mask_words (self: t_AsciiSet) : Seq.seq UInt32BW.t =
  Seq.create 4 (fun (i: int) -> Seq.get (Slice64BW.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let union (self: t_AsciiSet) (other: t_AsciiSet) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:union requires] ([@stop_split] [@expl:union 'self' type invariant] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:union 'other' type invariant] inv_AsciiSet other)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- (0: UInt64BW.t) ] s1
    | s1 = [ &_10 <- UInt64BW.lt _9 (4: UInt64BW.t) ] s2
    | s2 = {[@expl:index in bounds] _10} s3
    | s3 = Slice64BW.get <UInt32BW.t> {self.mask} {_9} (fun (r: UInt32BW.t) -> [ &_8 <- r ] s4)
    | s4 = [ &_12 <- (0: UInt64BW.t) ] s5
    | s5 = [ &_13 <- UInt64BW.lt _12 (4: UInt64BW.t) ] s6
    | s6 = {[@expl:index in bounds] _13} s7
    | s7 = Slice64BW.get <UInt32BW.t> {other.mask} {_12} (fun (r: UInt32BW.t) -> [ &_11 <- r ] s8)
    | s8 = [ &_7 <- UInt32BW.bw_or _8 _11 ] s9
    | s9 = [ &_16 <- (1: UInt64BW.t) ] s10
    | s10 = [ &_17 <- UInt64BW.lt _16 (4: UInt64BW.t) ] s11
    | s11 = {[@expl:index in bounds] _17} s12
    | s12 = Slice64BW.get <UInt32BW.t> {self.mask} {_16} (fun (r: UInt32BW.t) -> [ &_15 <- r ] s13)
    | s13 = [ &_19 <- (1: UInt64BW.t) ] s14
    | s14 = [ &_20 <- UInt64BW.lt _19 (4: UInt64BW.t) ] s15
    | s15 = {[@expl:index in bounds] _20} s16
    | s16 = Slice64BW.get <UInt32BW.t> {other.mask} {_19} (fun (r: UInt32BW.t) -> [ &_18 <- r ] s17)
    | s17 = [ &_14 <- UInt32BW.bw_or _15 _18 ] s18
    | s18 = [ &_23 <- (2: UInt64BW.t) ] s19
    | s19 = [ &_24 <- UInt64BW.lt _23 (4: UInt64BW.t) ] s20
    | s20 = {[@expl:index in bounds] _24} s21
    | s21 = Slice64BW.get <UInt32BW.t> {self.mask} {_23} (fun (r: UInt32BW.t) -> [ &_22 <- r ] s22)
    | s22 = [ &_26 <- (2: UInt64BW.t) ] s23
    | s23 = [ &_27 <- UInt64BW.lt _26 (4: UInt64BW.t) ] s24
    | s24 = {[@expl:index in bounds] _27} s25
    | s25 = Slice64BW.get <UInt32BW.t> {other.mask} {_26} (fun (r: UInt32BW.t) -> [ &_25 <- r ] s26)
    | s26 = [ &_21 <- UInt32BW.bw_or _22 _25 ] s27
    | s27 = [ &_30 <- (3: UInt64BW.t) ] s28
    | s28 = [ &_31 <- UInt64BW.lt _30 (4: UInt64BW.t) ] s29
    | s29 = {[@expl:index in bounds] _31} s30
    | s30 = Slice64BW.get <UInt32BW.t> {self.mask} {_30} (fun (r: UInt32BW.t) -> [ &_29 <- r ] s31)
    | s31 = [ &_33 <- (3: UInt64BW.t) ] s32
    | s32 = [ &_34 <- UInt64BW.lt _33 (4: UInt64BW.t) ] s33
    | s33 = {[@expl:index in bounds] _34} s34
    | s34 = Slice64BW.get <UInt32BW.t> {other.mask} {_33} (fun (r: UInt32BW.t) -> [ &_32 <- r ] s35)
    | s35 = [ &_28 <- UInt32BW.bw_or _29 _32 ] s36
    | s36 = any
      [ any_ (__arr_temp: Slice64BW.array UInt32BW.t) -> (! -{Seq.get __arr_temp.Slice64BW.elts 0 = _7
        /\ Seq.get __arr_temp.Slice64BW.elts 1 = _14
        /\ Seq.get __arr_temp.Slice64BW.elts 2 = _21
        /\ Seq.get __arr_temp.Slice64BW.elts 3 = _28 /\ Seq.length __arr_temp.Slice64BW.elts = 4}-
        [ &mask'0 <- __arr_temp ] s37) ]
    | s37 = [ &_ret <- { mask = mask'0 } ] s38
    | s38 = return {_ret} ] ]
  [ & _ret: t_AsciiSet = Any.any_l ()
  | & self: t_AsciiSet = self
  | & other: t_AsciiSet = other
  | & mask'0: Slice64BW.array UInt32BW.t = Any.any_l ()
  | & _7: UInt32BW.t = Any.any_l ()
  | & _8: UInt32BW.t = Any.any_l ()
  | & _9: UInt64BW.t = Any.any_l ()
  | & _10: bool = Any.any_l ()
  | & _11: UInt32BW.t = Any.any_l ()
  | & _12: UInt64BW.t = Any.any_l ()
  | & _13: bool = Any.any_l ()
  | & _14: UInt32BW.t = Any.any_l ()
  | & _15: UInt32BW.t = Any.any_l ()
  | & _16: UInt64BW.t = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & _18: UInt32BW.t = Any.any_l ()
  | & _19: UInt64BW.t = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & _21: UInt32BW.t = Any.any_l ()
  | & _22: UInt32BW.t = Any.any_l ()
  | & _23: UInt64BW.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _25: UInt32BW.t = Any.any_l ()
  | & _26: UInt64BW.t = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & _28: UInt32BW.t = Any.any_l ()
  | & _29: UInt32BW.t = Any.any_l ()
  | & _30: UInt64BW.t = Any.any_l ()
  | & _31: bool = Any.any_l ()
  | & _32: UInt32BW.t = Any.any_l ()
  | & _33: UInt64BW.t = Any.any_l ()
  | & _34: bool = Any.any_l () ])
  [ return (result: t_AsciiSet) ->
  {[@stop_split] [@expl:union ensures] ([@stop_split] [@expl:union result type invariant] inv_AsciiSet result)
    /\ ([@stop_split] [@expl:union ensures] forall i: int. 0 <= i /\ i < 4
      -> Seq.get (mask_words result) i = UInt32BW.bw_or (Seq.get (mask_words self) i) (Seq.get (mask_words other) i))}
    (! return {result}) ]
