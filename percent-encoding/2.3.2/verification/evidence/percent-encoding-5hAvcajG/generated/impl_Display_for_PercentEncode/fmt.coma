(* <PercentEncode<'_> as core::fmt::Display> *)

use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.prelude.Any

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

type t_AsciiSet

type t_PercentEncode = { bytes: Slice64.slice UInt8.t; ascii_set: t_AsciiSet }

type t_Result_unit_Error = Ok () | Err ()

predicate inv_AsciiSet (_1: t_AsciiSet)

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

predicate inv_PercentEncode (_1: t_PercentEncode)

axiom inv_axiom [@rewrite]: forall x: t_PercentEncode [inv_PercentEncode x]. inv_PercentEncode x
    = inv_ref_AsciiSet x.ascii_set

predicate invariant_ref_PercentEncode [@inline:trivial] (self: t_PercentEncode) = inv_PercentEncode self

meta "rewrite_def" predicate invariant_ref_PercentEncode

predicate inv_ref_PercentEncode [@inline:trivial] (_1: t_PercentEncode) = invariant_ref_PercentEncode _1

meta "rewrite_def" predicate inv_ref_PercentEncode

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

let format_encoder (encoder: t_PercentEncode) (formatter: MutBorrow.t t_Formatter) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:format_encoder requires] ([@stop_split] [@expl:format_encoder 'encoder' type invariant] inv_ref_PercentEncode encoder)
  /\ ([@stop_split] [@expl:format_encoder 'formatter' type invariant] inv_refmut_Formatter formatter)}
  any [ return (result: t_Result_unit_Error) -> (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let fmt_PercentEncode (self: t_PercentEncode) (formatter: MutBorrow.t t_Formatter) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:fmt_PercentEncode requires] ([@stop_split] [@expl:fmt 'self' type invariant] inv_ref_PercentEncode self)
  /\ ([@stop_split] [@expl:fmt 'formatter' type invariant] inv_refmut_Formatter formatter)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Formatter> {formatter.current} {MutBorrow.get_id formatter}
        (fun (_bor: MutBorrow.t t_Formatter) ->
          [ &_4 <- _bor ] -{inv_Formatter _bor.final}-
          [ &formatter <- { formatter with current = _bor.final } ] s1)
      [ _ck -> (! {[@expl:type invariant] inv_Formatter formatter.current} any) ]
    | s1 = format_encoder {self} {_4} (fun (_x: t_Result_unit_Error) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Formatter formatter} any) ]
    | s3 = -{resolve_refmut_Formatter formatter}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Result_unit_Error = Any.any_l ()
  | & self: t_PercentEncode = self
  | & formatter: MutBorrow.t t_Formatter = formatter
  | & _4: MutBorrow.t t_Formatter = Any.any_l () ]) [ return (result: t_Result_unit_Error) -> (! return {result}) ]
