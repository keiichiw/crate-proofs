let field_ascii_set (builder: MutBorrow.t t_DebugStruct) (name: string) (value: t_AsciiSet)
  (trace: MutBorrow.t t_DebugTrace) (return (x: ())) =
{[@stop_split] [@expl:field_ascii_set requires] ([@stop_split] [@expl:field_ascii_set 'builder' type invariant] inv_refmut_DebugStruct builder)
  /\ ([@stop_split] [@expl:field_ascii_set 'value' type invariant] inv_ref_AsciiSet value)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_18 <- dyn_Debug_of_AsciiSet value ] s1
    | s1 = MutBorrow.borrow_final <t_DebugStruct> {builder.current} {MutBorrow.get_id builder}
        (fun (_bor: MutBorrow.t t_DebugStruct) ->
          [ &_16 <- _bor ] -{inv_DebugStruct _bor.final}-
          [ &builder <- { builder with current = _bor.final } ] s2)
      [ _ck -> (! {[@expl:type invariant] inv_DebugStruct builder.current} any) ]
    | s2 = field {_16} {name} {_18} (fun (_x: MutBorrow.t t_DebugStruct) -> [ &_15 <- _x ] s3)
    | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_DebugStruct _15} any) ]
    | s4 = -{resolve_refmut_DebugStruct _15}- s5
    | s5 = s6 [ _ck -> (! {[@expl:type invariant] inv_refmut_DebugStruct builder} any) ]
    | s6 = -{resolve_refmut_DebugStruct builder}- s7
    | s7 = [ &value_model <- mask_words value ] s8
    | s8 = MutBorrow.borrow_mut <MutBorrow.t t_DebugTrace> {trace}
        (fun (_bor: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_28 <- _bor ] [ &trace <- _bor.final ] s9)
    | s9 = deref_mut_Ghost_refmut_DebugTrace {_28}
        (fun (_x: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_27 <- _x ] s10)
    | s10 = MutBorrow.borrow_mut <Seq.seq string> {_27.current.current.field_names}
        (fun (_bor: MutBorrow.t (Seq.seq string)) ->
          [ &_26 <- _bor ]
          [ &_27 <- { _27 with current = { _27.current with current = { _27.current.current with field_names = _bor.final } } } ]
          s11)
    | s11 = push_back_ghost_ref_str {_26} {name} (fun (_x: ()) -> [ &_25 <- _x ] s12)
    | s12 = -{resolve_refmut_refmut_DebugTrace _27}- s13
    | s13 = MutBorrow.borrow_mut <MutBorrow.t t_DebugTrace> {trace}
        (fun (_bor: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_33 <- _bor ] [ &trace <- _bor.final ] s14)
    | s14 = deref_mut_Ghost_refmut_DebugTrace {_33}
        (fun (_x: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_32 <- _x ] s15)
    | s15 = MutBorrow.borrow_mut <Seq.seq UInt8.t> {_32.current.current.field_type_tags}
        (fun (_bor: MutBorrow.t (Seq.seq UInt8.t)) ->
          [ &_31 <- _bor ]
          [ &_32 <- { _32 with current = { _32.current with current = { _32.current.current with field_type_tags = _bor.final } } } ]
          s16)
    | s16 = push_back_ghost_u8 {_31} {(3: UInt8.t)} (fun (_x: ()) -> [ &_30 <- _x ] s17)
    | s17 = -{resolve_refmut_refmut_DebugTrace _32}- s18
    | s18 = MutBorrow.borrow_mut <MutBorrow.t t_DebugTrace> {trace}
        (fun (_bor: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_37 <- _bor ] [ &trace <- _bor.final ] s19)
    | s19 = deref_mut_Ghost_refmut_DebugTrace {_37}
        (fun (_x: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_36 <- _x ] s20)
    | s20 = MutBorrow.borrow_mut <Seq.seq (Seq.seq UInt32.t)> {_36.current.current.ascii_set_values}
        (fun (_bor: MutBorrow.t (Seq.seq (Seq.seq UInt32.t))) ->
          [ &_35 <- _bor ]
          [ &_36 <- { _36 with current = { _36.current with current = { _36.current.current with ascii_set_values = _bor.final } } } ]
