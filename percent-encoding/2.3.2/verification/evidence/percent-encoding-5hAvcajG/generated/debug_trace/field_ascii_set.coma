    | s21 = push_back_ghost_Snapshot_Seq_u32 {_35} {value_model} (fun (_x: ()) -> [ &_34 <- _x ] s22)
    | s22 = -{resolve_refmut_refmut_DebugTrace _36}- s23
    | s23 = -{resolve_Ghost_refmut_DebugTrace'0 trace}- s24
    | s24 = new_unit {_24} (fun (_x: ()) -> [ &_23 <- _x ] s25)
    | s25 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & builder: MutBorrow.t t_DebugStruct = builder
  | & name: string = name
  | & value: t_AsciiSet = value
  | & trace: MutBorrow.t t_DebugTrace = trace
  | & _15: MutBorrow.t t_DebugStruct = Any.any_l ()
  | & _16: MutBorrow.t t_DebugStruct = Any.any_l ()
  | & _18: dyn_Debug = Any.any_l ()
  | & value_model: Seq.seq UInt32.t = Any.any_l ()
  | & _23: () = Any.any_l ()
  | & _24: () = Any.any_l ()
  | & _25: () = Any.any_l ()
  | & _26: MutBorrow.t (Seq.seq string) = Any.any_l ()
  | & _27: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l ()
  | & _28: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l ()
  | & _30: () = Any.any_l ()
  | & _31: MutBorrow.t (Seq.seq UInt8.t) = Any.any_l ()
  | & _32: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l ()
  | & _33: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l ()
  | & _34: () = Any.any_l ()
  | & _35: MutBorrow.t (Seq.seq (Seq.seq UInt32.t)) = Any.any_l ()
  | & _36: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l ()
  | & _37: MutBorrow.t (MutBorrow.t t_DebugTrace) = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:field_ascii_set ensures] ([@stop_split] [@expl:field_ascii_set ensures #0] trace.final.field_names
