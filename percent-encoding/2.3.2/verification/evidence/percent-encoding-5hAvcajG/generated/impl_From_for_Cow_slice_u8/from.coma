(* <_::borrow::Cow<'a, [u8]> as core::convert::From<PercentDecode<'a>>> *)

use creusot.int.UInt8
use seq.Seq
use map.Map
use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

type t_Iter_u8

type t_PercentDecode = { bytes: t_Iter_u8 }

type t_Vec_u8_Global

type t_Option_Vec_u8_Global = None | Some t_Vec_u8_Global

predicate inv_Iter_u8 (_1: t_Iter_u8)

predicate inv_PercentDecode (_1: t_PercentDecode)

axiom inv_axiom [@rewrite]: forall x: t_PercentDecode [inv_PercentDecode x]. inv_PercentDecode x = inv_Iter_u8 x.bytes

predicate invariant_ref_PercentDecode [@inline:trivial] (self: t_PercentDecode) = inv_PercentDecode self

meta "rewrite_def" predicate invariant_ref_PercentDecode

predicate inv_ref_PercentDecode [@inline:trivial] (_1: t_PercentDecode) = invariant_ref_PercentDecode _1

meta "rewrite_def" predicate inv_ref_PercentDecode

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes'0: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes'0 (fun (byte: UInt8.t) -> UInt8.t'int byte)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. Seq.length (view_Vec_u8_Global self) <= UInt64.t'int const_MAX

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


function decoded_trace (input: Seq.seq int) : Seq.seq int

axiom decoded_trace_def: forall input: Seq.seq int [decoded_trace input]. decoded_trace input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq int
    else
      if ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
        Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
        + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))
      else
        Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))
    
    )

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

function remaining_input [@inline:trivial] (self: t_PercentDecode) : Seq.seq UInt8.t =
  Slice64.view (view_Iter_u8 self.bytes)

meta "rewrite_def" function remaining_input

let if_any (self: t_PercentDecode) (return (x: t_Option_Vec_u8_Global)) =
{[@stop_split] [@expl:if_any 'self' type invariant] inv_ref_PercentDecode self}
  any
  [ return (result: t_Option_Vec_u8_Global) -> {[@stop_split] [@expl:if_any ensures] match result with
      | Some bytes'0 -> byte_sequence_as_ints (view_Vec_u8_Global bytes'0)
        = decoded_trace (byte_sequence_as_ints (remaining_input self))
      /\ Seq.length (view_Vec_u8_Global bytes'0) < Seq.length (remaining_input self)
      | None -> decoded_trace (byte_sequence_as_ints (remaining_input self))
      = byte_sequence_as_ints (remaining_input self)
      end}
    (! return {result}) ]

predicate resolve_Iter_u8 (_1: t_Iter_u8)

predicate resolve_PercentDecode (_1: t_PercentDecode)

axiom resolve_axiom [@rewrite]: forall x: t_PercentDecode [resolve_PercentDecode x]. resolve_PercentDecode x
    = resolve_Iter_u8 x.bytes

let elim_Some (_x: t_Option_Vec_u8_Global) (return (f0: t_Vec_u8_Global)) = any
  [ _k (f0: t_Vec_u8_Global) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_Cow_slice_u8 = Borrowed (Slice64.slice UInt8.t) | Owned t_Vec_u8_Global

predicate invariant_ref_Iter_u8 [@inline:trivial] (self: t_Iter_u8) = inv_Iter_u8 self

meta "rewrite_def" predicate invariant_ref_Iter_u8

predicate inv_ref_Iter_u8 [@inline:trivial] (_1: t_Iter_u8) = invariant_ref_Iter_u8 _1

meta "rewrite_def" predicate inv_ref_Iter_u8

let as_slice_u8 (self_: t_Iter_u8) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:as_slice 'self_' type invariant] inv_ref_Iter_u8 self_}
  any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_slice ensures] Slice64.view result
    = Slice64.view (view_Iter_u8 self_)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let from_Cow_slice_u8 (iter: t_PercentDecode) (return (x: t_Cow_slice_u8)) =
{[@stop_split] [@expl:from 'iter' type invariant] inv_PercentDecode iter}
  (! bb0
  [ bb0 = s0
    [ s0 = if_any {iter} (fun (_x: t_Option_Vec_u8_Global) -> [ &_4 <- _x ] s1)
    | s1 = any [ br0 -> {_4 = None} (! bb4) | br1 (x0: t_Vec_u8_Global) -> {_4 = Some x0} (! bb3) ] ]
  | bb3 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_PercentDecode iter} any) ]
    | s1 = -{resolve_PercentDecode iter}- s2
    | s2 = elim_Some {_4} (fun (r0: t_Vec_u8_Global) -> [ &vec <- r0 ] s3)
    | s3 = [ &_ret <- Owned vec ] s4
    | s4 = return {_ret} ]
  | bb4 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_PercentDecode iter} any) ]
    | s1 = -{resolve_PercentDecode iter}- s2
    | s2 = as_slice_u8 {iter.bytes} (fun (_x: Slice64.slice UInt8.t) -> [ &_10 <- _x ] s3)
    | s3 = [ &_ret <- Borrowed _10 ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Cow_slice_u8 = Any.any_l ()
  | & iter: t_PercentDecode = iter
  | & _4: t_Option_Vec_u8_Global = Any.any_l ()
  | & vec: t_Vec_u8_Global = Any.any_l ()
  | & _10: Slice64.slice UInt8.t = Any.any_l () ])
  [ return (result: t_Cow_slice_u8) -> {[@stop_split] [@expl:from ensures] match result with
      | Borrowed bytes'0 -> Slice64.view bytes'0 = remaining_input iter
      /\ byte_sequence_as_ints (Slice64.view bytes'0) = decoded_trace (byte_sequence_as_ints (remaining_input iter))
      | Owned bytes'0 -> byte_sequence_as_ints (view_Vec_u8_Global bytes'0)
        = decoded_trace (byte_sequence_as_ints (remaining_input iter))
      /\ Seq.length (view_Vec_u8_Global bytes'0) < Seq.length (remaining_input iter)
      end}
    (! return {result}) ]
