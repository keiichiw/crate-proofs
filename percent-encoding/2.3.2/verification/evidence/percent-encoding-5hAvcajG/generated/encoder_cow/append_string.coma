use creusot.prelude.Char
use seq.Seq
use creusot.int.UInt8
use map.Map
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

predicate string_bytes_concat (prefix: Seq.seq Char.t) (suffix: Seq.seq Char.t)

axiom string_bytes_concat_spec:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t [string_bytes_concat prefix suffix]. string_bytes_concat prefix suffix

axiom string_bytes_concat_spec'0:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t. to_bytes (Seq.(++) prefix suffix)
    = Seq.(++) (to_bytes prefix) (to_bytes suffix)

axiom string_bytes_concat_spec'1:
  forall prefix: Seq.seq Char.t, suffix: Seq.seq Char.t. byte_sequence_as_ints (to_bytes (Seq.(++) prefix suffix))
    = Seq.(++) (byte_sequence_as_ints (to_bytes prefix)) (byte_sequence_as_ints (to_bytes suffix))

type t_String

function view_String (self: t_String) : Seq.seq Char.t

function view_str (self: string) : Seq.seq Char.t

predicate inv_String (_1: t_String)

predicate invariant_refmut_String [@inline:trivial] (self: MutBorrow.t t_String) =
  inv_String self.current /\ inv_String self.final

meta "rewrite_def" predicate invariant_refmut_String

predicate inv_refmut_String [@inline:trivial] (_1: MutBorrow.t t_String) = invariant_refmut_String _1

meta "rewrite_def" predicate inv_refmut_String

let push_str (self_: MutBorrow.t t_String) (string': string) (return (x: ())) =
{[@stop_split] [@expl:push_str 'self_' type invariant] inv_refmut_String self_}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:push_str ensures] view_String self_.final
    = Seq.(++) (view_String self_.current) (view_str string')}
    (! return {result}) ]

predicate resolve_refmut_String [@inline:trivial] (_1: MutBorrow.t t_String) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_String

function string_chunk_bytes (s: string) : Seq.seq int =
  map_u8 (to_bytes (view_str s)) (fun (b: UInt8.t) -> UInt8.t'int b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let append_string (output: MutBorrow.t t_String) (chunk: string) (return (x: ())) =
{[@stop_split] [@expl:append_string 'output' type invariant] inv_refmut_String output}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] string_bytes_concat (view_String output.current) (view_str chunk)} s1
    | s1 = MutBorrow.borrow_final <t_String> {output.current} {MutBorrow.get_id output}
        (fun (_bor: MutBorrow.t t_String) ->
          [ &_14 <- _bor ] -{inv_String _bor.final}-
          [ &output <- { output with current = _bor.final } ] s2)
      [ _ck -> (! {[@expl:type invariant] inv_String output.current} any) ]
    | s2 = push_str {_14} {chunk} (fun (_x: ()) -> [ &_13 <- _x ] s3)
    | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_String output} any) ]
    | s4 = -{resolve_refmut_String output}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & output: MutBorrow.t t_String = output
  | & chunk: string = chunk
  | & _13: () = Any.any_l ()
  | & _14: MutBorrow.t t_String = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:append_string ensures] ([@stop_split] [@expl:append_string ensures #0] view_String output.final
      = Seq.(++) (view_String output.current) (view_str chunk))
    /\ ([@stop_split] [@expl:append_string ensures #1] byte_sequence_as_ints (to_bytes (view_String output.final))
    = Seq.(++) (byte_sequence_as_ints (to_bytes (view_String output.current))) (string_chunk_bytes chunk))}
    (! return {result}) ]
