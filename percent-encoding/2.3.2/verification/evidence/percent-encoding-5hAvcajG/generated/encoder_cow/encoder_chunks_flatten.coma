use seq.Seq
use map.Map
use creusot.int.UInt8
use creusot.prelude.Char
use int.Int

function tail_ref_str (self: Seq.seq string) : Seq.seq string = Seq.([..]) self 1 (Seq.length self)

function flat_map_ref_str (self: Seq.seq string) (other: Map.map string (Seq.seq int)) : Seq.seq int

axiom flat_map_ref_str_def:
  forall self: Seq.seq string, other: Map.map string (Seq.seq int) [flat_map_ref_str self other]. flat_map_ref_str self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq int
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_ref_str (tail_ref_str self) other)
    )

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function string_chunk_bytes (s: string) : Seq.seq int =
  map_u8 (to_bytes (view_str s)) (fun (b: UInt8.t) -> UInt8.t'int b)

function encoder_chunks_bytes (chunks: Seq.seq string) : Seq.seq int =
  flat_map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)

function flatten_chunks (chunks: Seq.seq (Seq.seq int)) : Seq.seq int

axiom flatten_chunks_spec: forall chunks: Seq.seq (Seq.seq int) [flatten_chunks chunks]. if Seq.length chunks = 0 then
      Seq.length (flatten_chunks chunks) = 0
    else
      flatten_chunks chunks = Seq.(++) (Seq.get chunks 0) (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks)))


function index_Mapping_ref_str_Seq_Int [@inline:trivial] (self: Map.map string (Seq.seq int)) (a: string) : Seq.seq int
 = Map.get self a

meta "rewrite_def" function index_Mapping_ref_str_Seq_Int

function map_ref_str (self: Seq.seq string) (m: Map.map string (Seq.seq int)) : Seq.seq (Seq.seq int)

axiom map_ref_str_spec:
  forall self: Seq.seq string, m: Map.map string (Seq.seq int) [map_ref_str self m]. Seq.length (map_ref_str self m)
    = Seq.length self

axiom map_ref_str_spec'0:
  forall self: Seq.seq string, m: Map.map string (Seq.seq int) [map_ref_str self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_ref_str self m) i = index_Mapping_ref_str_Seq_Int m (Seq.get self i)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant chunks : Seq.seq string

predicate encoder_chunks_flatten (chunks: Seq.seq string)

goal vc_encoder_chunks_flatten: if Seq.length chunks = 0 then
    ([@stop_split] [@expl:map ensures] ([@stop_split] [@expl:map ensures #0] Seq.length (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))
        = Seq.length chunks)
      /\ ([@stop_split] [@expl:map ensures #1] forall i: int. 0 <= i /\ i < Seq.length chunks
        -> Seq.get (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)) i
        = index_Mapping_ref_str_Seq_Int (fun (chunk: string) -> string_chunk_bytes chunk) (Seq.get chunks i)))
    -> ([@stop_split] [@expl:flatten_chunks ensures] if Seq.length (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))
      = 0 then
        Seq.length (flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))) = 0
      else
        flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))
        = Seq.(++) (Seq.get (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)) 0) (flatten_chunks (Seq.([..]) (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)) 1 (Seq.length (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)))))
      )
    -> ([@stop_split] [@expl:encoder_chunks_flatten ensures] ([@stop_split] [@expl:encoder_chunks_flatten ensures #0] encoder_chunks_bytes chunks
      = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)))
    /\ ([@stop_split] [@expl:encoder_chunks_flatten ensures #1] encoder_chunks_bytes chunks
    = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))))
  else
    let tail = tail_ref_str chunks in ([@stop_split] [@expl:map ensures] ([@stop_split] [@expl:map ensures #0] Seq.length (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))
        = Seq.length chunks)
      /\ ([@stop_split] [@expl:map ensures #1] forall i: int. 0 <= i /\ i < Seq.length chunks
        -> Seq.get (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)) i
        = index_Mapping_ref_str_Seq_Int (fun (chunk: string) -> string_chunk_bytes chunk) (Seq.get chunks i)))
    -> (let mapped = map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk) in ([@expl:variant decreases] well_founded_relation_Int (Seq.length chunks) (Seq.length tail))
    /\ (([@stop_split] [@expl:encoder_chunks_flatten ensures] ([@stop_split] [@expl:encoder_chunks_flatten ensures #0] encoder_chunks_flatten tail)
      /\ ([@stop_split] [@expl:encoder_chunks_flatten ensures #1] encoder_chunks_bytes tail
      = flatten_chunks (map_ref_str tail (fun (chunk: string) -> string_chunk_bytes chunk))))
    -> (if encoder_chunks_flatten tail then
      ([@stop_split] [@expl:map ensures] ([@stop_split] [@expl:map ensures #0] Seq.length (map_ref_str tail (fun (chunk: string) -> string_chunk_bytes chunk))
          = Seq.length tail)
        /\ ([@stop_split] [@expl:map ensures #1] forall i: int. 0 <= i /\ i < Seq.length tail
          -> Seq.get (map_ref_str tail (fun (chunk: string) -> string_chunk_bytes chunk)) i
          = index_Mapping_ref_str_Seq_Int (fun (chunk: string) -> string_chunk_bytes chunk) (Seq.get tail i)))
      -> (if Seq.(==) (Seq.([..]) mapped 1 (Seq.length mapped)) (map_ref_str tail (fun (chunk: string) -> string_chunk_bytes chunk)) then
        ([@stop_split] [@expl:flatten_chunks ensures] if Seq.length mapped = 0 then
            Seq.length (flatten_chunks mapped) = 0
          else
            flatten_chunks mapped
            = Seq.(++) (Seq.get mapped 0) (flatten_chunks (Seq.([..]) mapped 1 (Seq.length mapped)))
          )
        -> ([@stop_split] [@expl:encoder_chunks_flatten ensures] ([@stop_split] [@expl:encoder_chunks_flatten ensures #0] encoder_chunks_bytes chunks
          = flatten_chunks mapped)
        /\ ([@stop_split] [@expl:encoder_chunks_flatten ensures #1] encoder_chunks_bytes chunks
        = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk))))
      else
        [@stop_split] [@expl:encoder_chunks_flatten ensures] ([@stop_split] [@expl:encoder_chunks_flatten ensures #0] false)
        /\ ([@stop_split] [@expl:encoder_chunks_flatten ensures #1] encoder_chunks_bytes chunks
        = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)))
      )
    else
      [@stop_split] [@expl:encoder_chunks_flatten ensures] ([@stop_split] [@expl:encoder_chunks_flatten ensures #0] false)
      /\ ([@stop_split] [@expl:encoder_chunks_flatten ensures #1] encoder_chunks_bytes chunks
      = flatten_chunks (map_ref_str chunks (fun (chunk: string) -> string_chunk_bytes chunk)))
    )))
  
