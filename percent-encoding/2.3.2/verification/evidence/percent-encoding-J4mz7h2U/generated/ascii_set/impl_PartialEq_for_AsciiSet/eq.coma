(* <ascii_set::AsciiSet as core::cmp::PartialEq> *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.slice.Slice64
use creusot.prelude.Any
use seq.Seq

type t_AsciiSet = { mask: Slice64.array UInt32.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64.array UInt32.t) =
  inv_Seq_u32 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64.array UInt32.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

function mask_words (self: t_AsciiSet) : Seq.seq UInt32.t =
  Seq.create 4 (fun (i: int) -> Seq.get (Slice64.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

function deep_model_AsciiSet (self: t_AsciiSet) : Seq.seq UInt32.t = mask_words self

axiom deep_model_AsciiSet_spec: forall self: t_AsciiSet [deep_model_AsciiSet self]. deep_model_AsciiSet self
    = mask_words self

function deep_model_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) : Seq.seq UInt32.t = deep_model_AsciiSet self

meta "rewrite_def" function deep_model_ref_AsciiSet

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let eq_AsciiSet (self: t_AsciiSet) (other: t_AsciiSet) (return (x: bool)) =
{[@stop_split] [@expl:eq_AsciiSet requires] ([@stop_split] [@expl:eq 'self' type invariant] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:eq 'other' type invariant] inv_ref_AsciiSet other)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_8 <- (0: UInt64.t) ] s1
    | s1 = [ &_9 <- UInt64.lt _8 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _9} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_8} (fun (r: UInt32.t) -> [ &_7 <- r ] s4)
    | s4 = [ &_11 <- (0: UInt64.t) ] s5
    | s5 = [ &_12 <- UInt64.lt _11 (4: UInt64.t) ] s6
    | s6 = {[@expl:index in bounds] _12} s7
    | s7 = Slice64.get <UInt32.t> {other.mask} {_11} (fun (r: UInt32.t) -> [ &_10 <- r ] s8)
    | s8 = [ &_6 <- _7 = _10 ] s9
    | s9 = any [ br0 -> {_6 = false} (! bb13) | br1 -> {_6} (! bb3) ] ]
  | bb3 = s0
    [ s0 = [ &_15 <- (1: UInt64.t) ] s1
    | s1 = [ &_16 <- UInt64.lt _15 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _16} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_15} (fun (r: UInt32.t) -> [ &_14 <- r ] s4)
    | s4 = [ &_18 <- (1: UInt64.t) ] s5
    | s5 = [ &_19 <- UInt64.lt _18 (4: UInt64.t) ] s6
    | s6 = {[@expl:index in bounds] _19} s7
    | s7 = Slice64.get <UInt32.t> {other.mask} {_18} (fun (r: UInt32.t) -> [ &_17 <- r ] s8)
    | s8 = [ &_13 <- _14 = _17 ] s9
    | s9 = any [ br0 -> {_13 = false} (! bb13) | br1 -> {_13} (! bb6) ] ]
  | bb6 = s0
    [ s0 = [ &_22 <- (2: UInt64.t) ] s1
    | s1 = [ &_23 <- UInt64.lt _22 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _23} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_22} (fun (r: UInt32.t) -> [ &_21 <- r ] s4)
    | s4 = [ &_25 <- (2: UInt64.t) ] s5
    | s5 = [ &_26 <- UInt64.lt _25 (4: UInt64.t) ] s6
    | s6 = {[@expl:index in bounds] _26} s7
    | s7 = Slice64.get <UInt32.t> {other.mask} {_25} (fun (r: UInt32.t) -> [ &_24 <- r ] s8)
    | s8 = [ &_20 <- _21 = _24 ] s9
    | s9 = any [ br0 -> {_20 = false} (! bb13) | br1 -> {_20} (! bb9) ] ]
  | bb9 = s0
    [ s0 = [ &_28 <- (3: UInt64.t) ] s1
    | s1 = [ &_29 <- UInt64.lt _28 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _29} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_28} (fun (r: UInt32.t) -> [ &_27 <- r ] s4)
    | s4 = [ &_31 <- (3: UInt64.t) ] s5
    | s5 = [ &_32 <- UInt64.lt _31 (4: UInt64.t) ] s6
    | s6 = {[@expl:index in bounds] _32} s7
    | s7 = Slice64.get <UInt32.t> {other.mask} {_31} (fun (r: UInt32.t) -> [ &_30 <- r ] s8)
    | s8 = [ &_ret <- _27 = _30 ] s9
    | s9 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_AsciiSet = self
  | & other: t_AsciiSet = other
  | & _6: bool = Any.any_l ()
  | & _7: UInt32.t = Any.any_l ()
  | & _8: UInt64.t = Any.any_l ()
  | & _9: bool = Any.any_l ()
  | & _10: UInt32.t = Any.any_l ()
  | & _11: UInt64.t = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & _13: bool = Any.any_l ()
  | & _14: UInt32.t = Any.any_l ()
  | & _15: UInt64.t = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _17: UInt32.t = Any.any_l ()
  | & _18: UInt64.t = Any.any_l ()
  | & _19: bool = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & _21: UInt32.t = Any.any_l ()
  | & _22: UInt64.t = Any.any_l ()
  | & _23: bool = Any.any_l ()
  | & _24: UInt32.t = Any.any_l ()
  | & _25: UInt64.t = Any.any_l ()
  | & _26: bool = Any.any_l ()
