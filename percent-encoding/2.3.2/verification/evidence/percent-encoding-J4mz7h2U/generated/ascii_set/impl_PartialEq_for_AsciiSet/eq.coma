  | & _28: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & _30: UInt32.t = Any.any_l ()
  | & _31: UInt64.t = Any.any_l ()
  | & _32: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] result
    = (deep_model_ref_AsciiSet self = deep_model_ref_AsciiSet other)}
    (! return {result}) ]
