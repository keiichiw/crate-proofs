(* ascii_set::AsciiSet *)

use creusot.int.UInt64BW
use creusot.int.UInt32BW
use creusot.slice.Slice64BW
use creusot.prelude.Any
use seq.Seq
use int.Int

type t_AsciiSet = { mask: Slice64BW.array UInt32BW.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32BW.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64BW.array UInt32BW.t) =
  inv_Seq_u32 (Slice64BW.view self) /\ Seq.length (Slice64BW.view self) = UInt64BW.t'int (4: UInt64BW.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64BW.array UInt32BW.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

function mask_words (self: t_AsciiSet) : Seq.seq UInt32BW.t =
  Seq.create 4 (fun (i: int) -> Seq.get (Slice64BW.view self.mask) i)

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let complement (self: t_AsciiSet) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:complement 'self' type invariant] inv_ref_AsciiSet self}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_7 <- (0: UInt64BW.t) ] s1
    | s1 = [ &_8 <- UInt64BW.lt _7 (4: UInt64BW.t) ] s2
    | s2 = {[@expl:index in bounds] _8} s3
    | s3 = Slice64BW.get <UInt32BW.t> {self.mask} {_7} (fun (r: UInt32BW.t) -> [ &_6 <- r ] s4)
    | s4 = [ &_5 <- UInt32BW.bw_not _6 ] s5
    | s5 = [ &_11 <- (1: UInt64BW.t) ] s6
    | s6 = [ &_12 <- UInt64BW.lt _11 (4: UInt64BW.t) ] s7
    | s7 = {[@expl:index in bounds] _12} s8
    | s8 = Slice64BW.get <UInt32BW.t> {self.mask} {_11} (fun (r: UInt32BW.t) -> [ &_10 <- r ] s9)
    | s9 = [ &_9 <- UInt32BW.bw_not _10 ] s10
    | s10 = [ &_15 <- (2: UInt64BW.t) ] s11
    | s11 = [ &_16 <- UInt64BW.lt _15 (4: UInt64BW.t) ] s12
    | s12 = {[@expl:index in bounds] _16} s13
    | s13 = Slice64BW.get <UInt32BW.t> {self.mask} {_15} (fun (r: UInt32BW.t) -> [ &_14 <- r ] s14)
    | s14 = [ &_13 <- UInt32BW.bw_not _14 ] s15
    | s15 = [ &_19 <- (3: UInt64BW.t) ] s16
    | s16 = [ &_20 <- UInt64BW.lt _19 (4: UInt64BW.t) ] s17
    | s17 = {[@expl:index in bounds] _20} s18
    | s18 = Slice64BW.get <UInt32BW.t> {self.mask} {_19} (fun (r: UInt32BW.t) -> [ &_18 <- r ] s19)
    | s19 = [ &_17 <- UInt32BW.bw_not _18 ] s20
    | s20 = any
      [ any_ (__arr_temp: Slice64BW.array UInt32BW.t) -> (! -{Seq.get __arr_temp.Slice64BW.elts 0 = _5
        /\ Seq.get __arr_temp.Slice64BW.elts 1 = _9
        /\ Seq.get __arr_temp.Slice64BW.elts 2 = _13
        /\ Seq.get __arr_temp.Slice64BW.elts 3 = _17 /\ Seq.length __arr_temp.Slice64BW.elts = 4}-
        [ &mask'0 <- __arr_temp ] s21) ]
    | s21 = [ &_ret <- { mask = mask'0 } ] s22
    | s22 = return {_ret} ] ]
  [ & _ret: t_AsciiSet = Any.any_l ()
  | & self: t_AsciiSet = self
  | & mask'0: Slice64BW.array UInt32BW.t = Any.any_l ()
  | & _5: UInt32BW.t = Any.any_l ()
  | & _6: UInt32BW.t = Any.any_l ()
  | & _7: UInt64BW.t = Any.any_l ()
  | & _8: bool = Any.any_l ()
  | & _9: UInt32BW.t = Any.any_l ()
  | & _10: UInt32BW.t = Any.any_l ()
  | & _11: UInt64BW.t = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & _13: UInt32BW.t = Any.any_l ()
  | & _14: UInt32BW.t = Any.any_l ()
  | & _15: UInt64BW.t = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _17: UInt32BW.t = Any.any_l ()
  | & _18: UInt32BW.t = Any.any_l ()
  | & _19: UInt64BW.t = Any.any_l ()
  | & _20: bool = Any.any_l () ])
  [ return (result: t_AsciiSet) ->
  {[@stop_split] [@expl:complement ensures] ([@stop_split] [@expl:complement result type invariant] inv_AsciiSet result)
    /\ ([@stop_split] [@expl:complement ensures] forall i: int. 0 <= i /\ i < 4
      -> Seq.get (mask_words result) i = UInt32BW.bw_not (Seq.get (mask_words self) i))}
    (! return {result}) ]
