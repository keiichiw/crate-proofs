use int.Int

type t_AsciiSet

type t_PercentEncode = { bytes: Slice64.slice UInt8.t; ascii_set: t_AsciiSet }

predicate inv_AsciiSet (_1: t_AsciiSet)

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

predicate inv_PercentEncode (_1: t_PercentEncode)

axiom inv_axiom [@rewrite]: forall x: t_PercentEncode [inv_PercentEncode x]. inv_PercentEncode x
    = inv_ref_AsciiSet x.ascii_set

predicate invariant_ref_PercentEncode [@inline:trivial] (self: t_PercentEncode) = inv_PercentEncode self

meta "rewrite_def" predicate invariant_ref_PercentEncode

predicate inv_ref_PercentEncode [@inline:trivial] (_1: t_PercentEncode) = invariant_ref_PercentEncode _1

meta "rewrite_def" predicate inv_ref_PercentEncode

function remaining_input [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt8.t = Slice64.view self.bytes

meta "rewrite_def" function remaining_input

function mask_words (self: t_AsciiSet) : Seq.seq UInt32.t

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

function configured_set [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt32.t = mask_words self.ascii_set

meta "rewrite_def" function configured_set

let clone_PercentEncode (self: t_PercentEncode) (return (x: t_PercentEncode)) =
{[@stop_split] [@expl:clone 'self' type invariant] inv_ref_PercentEncode self}
  any
  [ return (result: t_PercentEncode) ->
  {[@stop_split] [@expl:clone_PercentEncode ensures] ([@stop_split] [@expl:clone result type invariant] inv_PercentEncode result)
    /\ ([@stop_split] [@expl:clone ensures #0] remaining_input result = remaining_input self)
    /\ ([@stop_split] [@expl:clone ensures #1] configured_set result = configured_set self)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate should_encode_model (mask: Seq.seq UInt32.t) (byte: UInt8.t) =
  ge_log_Int (UInt8.t'int byte) 128
  \/ UInt32.bw_and (Seq.get mask (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

function uppercase_hex (digit: int) : int = if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function uppercase_hex'0 (digit: int) : int = uppercase_hex digit

function encoded_byte_model (byte: int) : Seq.seq int =
  Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex'0 (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex'0 (ComputerDivision.mod byte 16)))

function safe_run_end (input: Seq.seq UInt8.t) (start: int) (mask: Seq.seq UInt32.t) : int

axiom safe_run_end_spec:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> start <= safe_run_end input start mask /\ safe_run_end input start mask <= Seq.length input

axiom safe_run_end_spec'0:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> (forall i: int. start <= i /\ i < safe_run_end input start mask
      -> not should_encode_model mask (Seq.get input i))

axiom safe_run_end_spec'1:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> safe_run_end input start mask = Seq.length input
    \/ should_encode_model mask (Seq.get input (safe_run_end input start mask))

axiom safe_run_end_spec'2:
  forall input: Seq.seq UInt8.t, start: int, mask: Seq.seq UInt32.t [safe_run_end input start mask]. 0 <= start
      /\ start <= Seq.length input
    -> Seq.length mask = 4
    -> start < Seq.length input /\ not should_encode_model mask (Seq.get input start)
    -> start < safe_run_end input start mask

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes'0: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes'0 (fun (byte: UInt8.t) -> UInt8.t'int byte)

function encoded_chunks (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t) : Seq.seq (Seq.seq int)

axiom encoded_chunks_def:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. Seq.length mask = 4
    -> encoded_chunks mask input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq (Seq.seq int)
    else
      if should_encode_model mask (Seq.get input 0) then
        Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))
      else
        let end' = safe_run_end input 0 mask in Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) input 0 end'))) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input)))
    
    )

axiom encoded_chunks_spec:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. Seq.length mask = 4
    -> (if Seq.length input = 0 then
      Seq.length (encoded_chunks mask input) = 0
    else
      gt_log_Int (Seq.length (encoded_chunks mask input)) 0
      /\ (if should_encode_model mask (Seq.get input 0) then
        Seq.get (encoded_chunks mask input) 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
      else
        let end' = safe_run_end input 0 mask in Seq.get (encoded_chunks mask input) 0
          = byte_sequence_as_ints (Seq.([..]) input 0 end')
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input end' (Seq.length input))
      )
    )

let new_ref_str (return (x: Seq.seq string)) = any
  [ return (result: Seq.seq string) -> {[@stop_split] [@expl:new ensures] result = (Seq.empty: Seq.seq string)}
    (! return {result}) ]

type tup2_ref_str_bool = { f0: string; f1: bool }

let new_tup2_ref_str_bool (return (x: Seq.seq tup2_ref_str_bool)) = any
  [ return (result: Seq.seq tup2_ref_str_bool) -> {[@stop_split] [@expl:new ensures] result
    = (Seq.empty: Seq.seq tup2_ref_str_bool)}
    (! return {result}) ]

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Option_ref_str = None | Some string

predicate invariant_refmut_PercentEncode [@inline:trivial] (self: MutBorrow.t t_PercentEncode) =
  inv_PercentEncode self.current /\ inv_PercentEncode self.final

meta "rewrite_def" predicate invariant_refmut_PercentEncode

predicate inv_refmut_PercentEncode [@inline:trivial] (_1: MutBorrow.t t_PercentEncode) =
  invariant_refmut_PercentEncode _1

meta "rewrite_def" predicate inv_refmut_PercentEncode

function index_Mapping_ref_str_Seq_Int [@inline:trivial] (self: Map.map string (Seq.seq int)) (a: string) : Seq.seq int
 = Map.get self a

meta "rewrite_def" function index_Mapping_ref_str_Seq_Int

function map_ref_str (self: Seq.seq string) (m: Map.map string (Seq.seq int)) : Seq.seq (Seq.seq int)

axiom map_ref_str_spec:
  forall self: Seq.seq string, m: Map.map string (Seq.seq int) [map_ref_str self m]. Seq.length (map_ref_str self m)
    = Seq.length self

axiom map_ref_str_spec'0:
  forall self: Seq.seq string, m: Map.map string (Seq.seq int) [map_ref_str self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_ref_str self m) i = index_Mapping_ref_str_Seq_Int m (Seq.get self i)

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function string_chunk_bytes (s: string) : Seq.seq int =
  map_u8 (to_bytes (view_str s)) (fun (b: UInt8.t) -> UInt8.t'int b)

function concat_empty_Seq_Int (self: Seq.seq (Seq.seq int)) : ()

axiom concat_empty_Seq_Int_spec: forall self: Seq.seq (Seq.seq int). Seq.(++) self (Seq.empty: Seq.seq (Seq.seq int))
    = self

axiom concat_empty_Seq_Int_spec'0: forall self: Seq.seq (Seq.seq int). Seq.(++) (Seq.empty: Seq.seq (Seq.seq int)) self
    = self

predicate produces_PercentEncode (self: t_PercentEncode) (visited: Seq.seq string) (o: t_PercentEncode) =
  encoded_chunks (configured_set self) (remaining_input self)
  = Seq.(++) (map_ref_str visited (fun (chunk: string) -> string_chunk_bytes chunk)) (encoded_chunks (configured_set o) (remaining_input o))

function produces_trans_PercentEncode (a: t_PercentEncode) (ab: Seq.seq string) (b: t_PercentEncode) (bc: Seq.seq string) (c: t_PercentEncode) : ()
 = ()

axiom produces_trans_PercentEncode_spec:
  forall a: t_PercentEncode, ab: Seq.seq string, b: t_PercentEncode, bc: Seq.seq string, c: t_PercentEncode. produces_PercentEncode a ab b
    -> produces_PercentEncode b bc c -> produces_PercentEncode a (Seq.(++) ab bc) c

function produces_refl_PercentEncode (self: t_PercentEncode) : () =
  let empty_chunks = map_ref_str (Seq.empty: Seq.seq string) (fun (chunk: string) -> string_chunk_bytes chunk) in let encoded = encoded_chunks (configured_set self) (remaining_input self) in let _ = concat_empty_Seq_Int encoded in ()

axiom produces_refl_PercentEncode_spec:
  forall self: t_PercentEncode. produces_PercentEncode self (Seq.empty: Seq.seq string) self

predicate resolve_refmut_PercentEncode [@inline:trivial] (_1: MutBorrow.t t_PercentEncode) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_PercentEncode

predicate completed_PercentEncode (self: MutBorrow.t t_PercentEncode) =
  Seq.length (remaining_input self.current) = 0 /\ resolve_refmut_PercentEncode self

let next_PercentEncode (self: MutBorrow.t t_PercentEncode) (return (x: t_Option_ref_str)) =
{[@stop_split] [@expl:next 'self' type invariant] inv_refmut_PercentEncode self}
  any
  [ return (result: t_Option_ref_str) ->
  {[@stop_split] [@expl:next_PercentEncode ensures] ([@stop_split] [@expl:next ensures #0] match result with
        | Some item -> produces_PercentEncode self.current (Seq.singleton item) self.final
        | None -> completed_PercentEncode self
        end)
    /\ ([@stop_split] [@expl:next ensures #1] configured_set self.final = configured_set self.current)
    /\ ([@stop_split] [@expl:next ensures #2] match result with
      | Some _ -> Seq.length (remaining_input self.final) < Seq.length (remaining_input self.current)
      | None -> self.final = self.current
      end)}
    (! return {result}) ]

predicate successful_model_prefix (expected: Seq.seq (Seq.seq int)) (trace: Seq.seq tup2_ref_str_bool) (count: int) =
  0 <= count
  /\ count <= Seq.length expected
  /\ Seq.length trace = count
  /\ (forall j: int. 0 <= j /\ j < count
    -> string_chunk_bytes (Seq.get trace j).f0 = Seq.get expected j /\ (Seq.get trace j).f1)

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

let elim_Some (_x: t_Option_ref_str) (return (f0'0: string)) = any
  [ _k (f0'0: string) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

let deref_mut_Ghost_Seq_ref_str (self: MutBorrow.t (Seq.seq string)) (return (x: MutBorrow.t (Seq.seq string))) = any
  [ return (result: MutBorrow.t (Seq.seq string)) -> {[@stop_split] [@expl:deref_mut ensures] result = self}
    (! return {result}) ]

let push_back_ghost_ref_str (self: MutBorrow.t (Seq.seq string)) (x: string) (return (x'0: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push_back_ghost ensures] self.final = Seq.snoc self.current x}
    (! return {result}) ]

predicate resolve_refmut_Seq_ref_str [@inline:trivial] (_1: MutBorrow.t (Seq.seq string)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Seq_ref_str

let new_unit (x: ()) (return (x'0: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]

predicate produces_append (initial: t_PercentEncode) (prefix: Seq.seq string) (before: t_PercentEncode) (chunk: string) (after: t_PercentEncode)

axiom produces_append_spec:
  forall initial: t_PercentEncode, prefix: Seq.seq string, before: t_PercentEncode, chunk: string, after: t_PercentEncode [produces_append initial prefix before chunk after]. produces_PercentEncode initial prefix before
    -> produces_PercentEncode before (Seq.singleton chunk) after -> produces_append initial prefix before chunk after

axiom produces_append_spec'0:
  forall initial: t_PercentEncode, prefix: Seq.seq string, before: t_PercentEncode, chunk: string, after: t_PercentEncode. produces_PercentEncode initial prefix before
    -> produces_PercentEncode before (Seq.singleton chunk) after
    -> produces_PercentEncode initial (Seq.snoc prefix chunk) after

let borrow_mut_Seq_tup2_ref_str_bool (self: MutBorrow.t (Seq.seq tup2_ref_str_bool))
  (return (x: MutBorrow.t (Seq.seq tup2_ref_str_bool))) = any
  [ return (result: MutBorrow.t (Seq.seq tup2_ref_str_bool)) -> {[@stop_split] [@expl:borrow_mut ensures] result = self}
    (! return {result}) ]

type t_Result_unit_Error = Ok () | Err ()

let request_write (formatter: MutBorrow.t t_Formatter) (chunk: string) (trace: MutBorrow.t (Seq.seq tup2_ref_str_bool))
  (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:request_write 'formatter' type invariant] inv_refmut_Formatter formatter}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:request_write ensures] trace.final
    = Seq.snoc trace.current { f0 = chunk;
                               f1 = match result with
                                 | Ok () -> true
                                 | Err _ -> false
                                 end }}
    (! return {result}) ]

predicate produced_chunk_matches (expected: Seq.seq (Seq.seq int)) (initial: t_PercentEncode) (prefix: Seq.seq string) (chunk: string) (after: t_PercentEncode)

axiom produced_chunk_matches_spec:
  forall expected: Seq.seq (Seq.seq int), initial: t_PercentEncode, prefix: Seq.seq string, chunk: string, after: t_PercentEncode [produced_chunk_matches expected initial prefix chunk after]. expected
      = encoded_chunks (configured_set initial) (remaining_input initial)
    -> produces_PercentEncode initial (Seq.snoc prefix chunk) after
    -> produced_chunk_matches expected initial prefix chunk after

axiom produced_chunk_matches_spec'0:
  forall expected: Seq.seq (Seq.seq int), initial: t_PercentEncode, prefix: Seq.seq string, chunk: string, after: t_PercentEncode. expected
      = encoded_chunks (configured_set initial) (remaining_input initial)
    -> produces_PercentEncode initial (Seq.snoc prefix chunk) after -> Seq.length prefix < Seq.length expected

axiom produced_chunk_matches_spec'1:
  forall expected: Seq.seq (Seq.seq int), initial: t_PercentEncode, prefix: Seq.seq string, chunk: string, after: t_PercentEncode. expected
      = encoded_chunks (configured_set initial) (remaining_input initial)
    -> produces_PercentEncode initial (Seq.snoc prefix chunk) after
    -> string_chunk_bytes chunk = Seq.get expected (Seq.length prefix)

predicate successful_model_prefix_push (expected: Seq.seq (Seq.seq int)) (trace: Seq.seq tup2_ref_str_bool) (count: int) (chunk: string)

axiom successful_model_prefix_push_spec:
  forall expected: Seq.seq (Seq.seq int), trace: Seq.seq tup2_ref_str_bool, count: int, chunk: string [successful_model_prefix_push expected trace count chunk]. successful_model_prefix expected trace count
    -> count < Seq.length expected
    -> string_chunk_bytes chunk = Seq.get expected count -> successful_model_prefix_push expected trace count chunk

axiom successful_model_prefix_push_spec'0:
  forall expected: Seq.seq (Seq.seq int), trace: Seq.seq tup2_ref_str_bool, count: int, chunk: string. successful_model_prefix expected trace count
    -> count < Seq.length expected
    -> string_chunk_bytes chunk = Seq.get expected count
    -> successful_model_prefix expected (Seq.snoc trace { f0 = chunk; f1 = true }) (count + 1)

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

let elim_Err (_x: t_Result_unit_Error) (return (f0'0: ())) = any
  [ _k (f0'0: ()) -> {Err f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

predicate failed_model_prefix (expected: Seq.seq (Seq.seq int)) (trace: Seq.seq tup2_ref_str_bool) (count: int) =
  0 <= count
  /\ count < Seq.length expected
  /\ Seq.length trace = count + 1
  /\ (forall j: int. 0 <= j /\ j < count
      -> string_chunk_bytes (Seq.get trace j).f0 = Seq.get expected j /\ (Seq.get trace j).f1)
  /\ string_chunk_bytes (Seq.get trace count).f0 = Seq.get expected count /\ not (Seq.get trace count).f1

predicate failed_model_prefix_push (expected: Seq.seq (Seq.seq int)) (trace: Seq.seq tup2_ref_str_bool) (count: int) (chunk: string)

axiom failed_model_prefix_push_spec:
  forall expected: Seq.seq (Seq.seq int), trace: Seq.seq tup2_ref_str_bool, count: int, chunk: string [failed_model_prefix_push expected trace count chunk]. successful_model_prefix expected trace count
    -> count < Seq.length expected
    -> string_chunk_bytes chunk = Seq.get expected count -> failed_model_prefix_push expected trace count chunk

axiom failed_model_prefix_push_spec'0:
  forall expected: Seq.seq (Seq.seq int), trace: Seq.seq tup2_ref_str_bool, count: int, chunk: string. successful_model_prefix expected trace count
    -> count < Seq.length expected
    -> string_chunk_bytes chunk = Seq.get expected count
    -> failed_model_prefix expected (Seq.snoc trace { f0 = chunk; f1 = false }) count

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let format_encoder (encoder: t_PercentEncode) (formatter: MutBorrow.t t_Formatter) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:format_encoder requires] ([@stop_split] [@expl:format_encoder 'encoder' type invariant] inv_ref_PercentEncode encoder)
  /\ ([@stop_split] [@expl:format_encoder 'formatter' type invariant] inv_refmut_Formatter formatter)}
  (! bb0
  [ bb0 = s0
    [ s0 = clone_PercentEncode {encoder} (fun (_x: t_PercentEncode) -> [ &iter <- _x ] s1)
    | s1 = [ &expected <- encoded_chunks (configured_set encoder) (remaining_input encoder) ] s2
    | s2 = new_ref_str (fun (_x: Seq.seq string) -> [ &visited <- _x ] s3)
    | s3 = new_tup2_ref_str_bool (fun (_x: Seq.seq tup2_ref_str_bool) -> [ &trace <- _x ] s4)
    | s4 = [ &initial <- iter ] s5
    | s5 = [ &_old <- formatter.final ] s6
    | s6 = bb6 ]
  | bb6 = bb6invariant
    [ bb6 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb6 (Seq.length (remaining_input iter))}
      bb6invariant
    | bb6invariant = {[@expl:inferred invariant: type invariant] inv_PercentEncode iter}
      {[@expl:inferred invariant: type invariant] inv_refmut_Formatter formatter}
      {[@expl:inferred invariant: unchanged value] _old = formatter.final}
      {[@expl:loop invariant #0] Seq.length visited = Seq.length trace}
      {[@expl:loop invariant #1] produces_PercentEncode initial visited iter}
      {[@expl:loop invariant #2] successful_model_prefix expected trace (Seq.length trace)}
      (! [ &variant_old_bb6 <- Seq.length (remaining_input iter) ] s0)
      [ s0 = [ &before <- iter ] s1
      | s1 = MutBorrow.borrow_mut <t_PercentEncode> {iter}
          (fun (_bor: MutBorrow.t t_PercentEncode) ->
            [ &_32 <- _bor ] -{inv_PercentEncode _bor.final}-
            [ &iter <- _bor.final ] s2) [ _ck -> (! {[@expl:type invariant] inv_PercentEncode iter} any) ]
      | s2 = next_PercentEncode {_32} (fun (_x: t_Option_ref_str) -> [ &_31 <- _x ] s3)
      | s3 = any [ br0 -> {_31 = None} (! bb11) | br1 (x0: string) -> {_31 = Some x0} (! bb12) ] ]
      [ bb12 = s0
        [ s0 = elim_Some {_31} (fun (r0: string) -> [ &chunk <- r0 ] s1)
        | s1 = [ &prefix <- visited ] s2
        | s2 = [ &after <- iter ] s3
        | s3 = MutBorrow.borrow_mut <Seq.seq string> {visited}
            (fun (_bor: MutBorrow.t (Seq.seq string)) -> [ &_48 <- _bor ] [ &visited <- _bor.final ] s4)
        | s4 = deref_mut_Ghost_Seq_ref_str {_48} (fun (_x: MutBorrow.t (Seq.seq string)) -> [ &_47 <- _x ] s5)
