(* PercentEncode<'a> *)

use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.int.UInt32
use int.ComputerDivision
use map.Map
use creusot.prelude.Char
use creusot.prelude.Any
use int.Int

type t_AsciiSet

type t_PercentEncode = { bytes: Slice64.slice UInt8.t; ascii_set: t_AsciiSet }

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate inv_AsciiSet (_1: t_AsciiSet)

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

predicate inv_PercentEncode (_1: t_PercentEncode)

axiom inv_axiom [@rewrite]: forall x: t_PercentEncode [inv_PercentEncode x]. inv_PercentEncode x
    = inv_ref_AsciiSet x.ascii_set

predicate invariant_refmut_PercentEncode [@inline:trivial] (self: MutBorrow.t t_PercentEncode) =
  inv_PercentEncode self.current /\ inv_PercentEncode self.final

meta "rewrite_def" predicate invariant_refmut_PercentEncode

predicate inv_refmut_PercentEncode [@inline:trivial] (_1: MutBorrow.t t_PercentEncode) =
  invariant_refmut_PercentEncode _1

meta "rewrite_def" predicate inv_refmut_PercentEncode

predicate resolve_refmut_PercentEncode [@inline:trivial] (_1: MutBorrow.t t_PercentEncode) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_PercentEncode

type t_Option_ref_str = None | Some string

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function mask_words (self: t_AsciiSet) : Seq.seq UInt32.t

axiom mask_words_spec: forall self: t_AsciiSet [mask_words self]. Seq.length (mask_words self) = 4

predicate contains_model (set: t_AsciiSet) (byte: UInt8.t) =
  UInt8.t'int byte < 128
  /\ UInt32.bw_and (Seq.get (mask_words set) (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

predicate should_encode_model (mask: Seq.seq UInt32.t) (byte: UInt8.t) =
  ge_log_Int (UInt8.t'int byte) 128
  \/ UInt32.bw_and (Seq.get mask (ComputerDivision.div (UInt8.t'int byte) 32)) (UInt32.shl (1: UInt32.t) (UInt32.of_int (UInt8.t'int (UInt8.bw_and byte (31: UInt8.t)))))
  <> (0: UInt32.t)

let should_percent_encode (self: t_AsciiSet) (byte: UInt8.t) (return (x: bool)) =
{[@stop_split] [@expl:should_percent_encode 'self' type invariant] inv_ref_AsciiSet self}
  any
  [ return (result: bool) ->
  {[@stop_split] [@expl:should_percent_encode ensures] ([@stop_split] [@expl:should_percent_encode ensures #0] result
      = (ge_log_Int (UInt8.t'int byte) 128 \/ contains_model self byte))
    /\ ([@stop_split] [@expl:should_percent_encode ensures #1] result = should_encode_model (mask_words self) byte)}
    (! return {result}) ]

type t_RangeFrom_usize = { start: UInt64.t }

predicate in_bounds_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) =
  UInt64.t'int self.start <= Seq.length seq

predicate has_value_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  Seq.([..]) seq (UInt64.t'int self.start) (Seq.length seq) = Slice64.view out

let index_slice_u8 (self_: Slice64.slice UInt8.t) (ix: t_RangeFrom_usize) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:index requires] in_bounds_RangeFrom_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:index ensures] has_value_RangeFrom_usize ix (Slice64.view self_) result}
    (! return {result}) ]

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes'0: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes'0 (fun (byte: UInt8.t) -> UInt8.t'int byte)

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

function uppercase_hex (digit: int) : int = if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function uppercase_hex'0 (digit: int) : int = uppercase_hex digit

function encoded_byte_model (byte: int) : Seq.seq int =
  Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex'0 (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex'0 (ComputerDivision.mod byte 16)))

let percent_encode_byte (byte: UInt8.t) (return (x: string)) = any
  [ return (result: string) ->
  {[@stop_split] [@expl:percent_encode_byte ensures] byte_sequence_as_ints (to_bytes (view_str result))
    = encoded_byte_model (UInt8.t'int byte)}
    (! return {result}) ]

function configured_set [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt32.t = mask_words self.ascii_set

meta "rewrite_def" function configured_set

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function safe_run_end (input: Seq.seq UInt8.t) (start'0: int) (mask: Seq.seq UInt32.t) : int

axiom safe_run_end_spec:
  forall input: Seq.seq UInt8.t, start'0: int, mask: Seq.seq UInt32.t [safe_run_end input start'0 mask]. 0 <= start'0
      /\ start'0 <= Seq.length input
    -> Seq.length mask = 4
    -> start'0 <= safe_run_end input start'0 mask /\ safe_run_end input start'0 mask <= Seq.length input

axiom safe_run_end_spec'0:
  forall input: Seq.seq UInt8.t, start'0: int, mask: Seq.seq UInt32.t [safe_run_end input start'0 mask]. 0 <= start'0
      /\ start'0 <= Seq.length input
    -> Seq.length mask = 4
    -> (forall i: int. start'0 <= i /\ i < safe_run_end input start'0 mask
      -> not should_encode_model mask (Seq.get input i))

axiom safe_run_end_spec'1:
  forall input: Seq.seq UInt8.t, start'0: int, mask: Seq.seq UInt32.t [safe_run_end input start'0 mask]. 0 <= start'0
      /\ start'0 <= Seq.length input
    -> Seq.length mask = 4
    -> safe_run_end input start'0 mask = Seq.length input
    \/ should_encode_model mask (Seq.get input (safe_run_end input start'0 mask))

axiom safe_run_end_spec'2:
  forall input: Seq.seq UInt8.t, start'0: int, mask: Seq.seq UInt32.t [safe_run_end input start'0 mask]. 0 <= start'0
      /\ start'0 <= Seq.length input
    -> Seq.length mask = 4
    -> start'0 < Seq.length input /\ not should_encode_model mask (Seq.get input start'0)
    -> start'0 < safe_run_end input start'0 mask

function encoded_chunks (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t) : Seq.seq (Seq.seq int)

axiom encoded_chunks_def:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. Seq.length mask = 4
    -> encoded_chunks mask input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq (Seq.seq int)
    else
      if should_encode_model mask (Seq.get input 0) then
        Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))
      else
        let end' = safe_run_end input 0 mask in Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) input 0 end'))) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input)))
    
    )

axiom encoded_chunks_spec:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks mask input]. Seq.length mask = 4
    -> (if Seq.length input = 0 then
      Seq.length (encoded_chunks mask input) = 0
    else
      gt_log_Int (Seq.length (encoded_chunks mask input)) 0
      /\ (if should_encode_model mask (Seq.get input 0) then
        Seq.get (encoded_chunks mask input) 0 = encoded_byte_model (UInt8.t'int (Seq.get input 0))
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input 1 (Seq.length input))
      else
        let end' = safe_run_end input 0 mask in Seq.get (encoded_chunks mask input) 0
          = byte_sequence_as_ints (Seq.([..]) input 0 end')
        /\ Seq.([..]) (encoded_chunks mask input) 1 (Seq.length (encoded_chunks mask input))
        = encoded_chunks mask (Seq.([..]) input end' (Seq.length input))
      )
    )

predicate encoded_chunks_first_escaped (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t)

axiom encoded_chunks_first_escaped_spec:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t [encoded_chunks_first_escaped mask input]. gt_log_Int (Seq.length input) 0
      /\ Seq.length mask = 4 -> should_encode_model mask (Seq.get input 0) -> encoded_chunks_first_escaped mask input

axiom encoded_chunks_first_escaped_spec'0:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t. gt_log_Int (Seq.length input) 0 /\ Seq.length mask = 4
    -> should_encode_model mask (Seq.get input 0)
    -> encoded_chunks mask input
    = Seq.(++) (Seq.singleton (encoded_byte_model (UInt8.t'int (Seq.get input 0)))) (encoded_chunks mask (Seq.([..]) input 1 (Seq.length input)))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function index_slice_u8'0 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: UInt64.t) : UInt8.t =
  Seq.get (Slice64.view self) (UInt64.t'int ix)

meta "rewrite_def" function index_slice_u8'0

predicate safe_prefix_extend (input: Seq.seq UInt8.t) (mask: Seq.seq UInt32.t) (end': int)

axiom safe_prefix_extend_spec:
  forall input: Seq.seq UInt8.t, mask: Seq.seq UInt32.t, end': int [safe_prefix_extend input mask end']. Seq.length mask
      = 4
    -> 0 <= end' /\ end' < Seq.length input
    -> (forall i: int. 0 <= i /\ i < end' -> not should_encode_model mask (Seq.get input i))
    -> not should_encode_model mask (Seq.get input end') -> safe_prefix_extend input mask end'

axiom safe_prefix_extend_spec'0: forall input: Seq.seq UInt8.t, mask: Seq.seq UInt32.t, end': int. Seq.length mask = 4
    -> 0 <= end' /\ end' < Seq.length input
    -> (forall i: int. 0 <= i /\ i < end' -> not should_encode_model mask (Seq.get input i))
    -> not should_encode_model mask (Seq.get input end')
    -> (forall i: int. 0 <= i /\ i < end' + 1 -> not should_encode_model mask (Seq.get input i))

type tup2_ref_slice_u8_ref_slice_u8 = { f0: Slice64.slice UInt8.t; f1: Slice64.slice UInt8.t }

let split_at_u8 (self_: Slice64.slice UInt8.t) (mid: UInt64.t) (return (x: tup2_ref_slice_u8_ref_slice_u8)) =
{[@stop_split] [@expl:split_at requires] UInt64.t'int mid <= Seq.length (Slice64.view self_)}
  any
  [ return (result: tup2_ref_slice_u8_ref_slice_u8) ->
  {[@stop_split] [@expl:split_at ensures] let {f0 = left; f1 = right} = result in Slice64.view left
      = Seq.([..]) (Slice64.view self_) 0 (UInt64.t'int mid)
    /\ Slice64.view right = Seq.([..]) (Slice64.view self_) (UInt64.t'int mid) (Seq.length (Slice64.view self_))}
    (! return {result}) ]

let from_utf8_unchecked (bytes'0: Slice64.slice UInt8.t) (return (x: string)) =
{[@stop_split] [@expl:from_utf8_unchecked requires] (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes'0)
      -> UInt8.t'int (Seq.get (Slice64.view bytes'0) i) < 128)
  \/ (exists s: Seq.seq Char.t. to_bytes s = Slice64.view bytes'0)}
  any
  [ return (result: string) -> {[@stop_split] [@expl:from_utf8_unchecked ensures] to_bytes (view_str result)
    = Slice64.view bytes'0}
    (! return {result}) ]

predicate byte_model_subsequence (bytes'0: Seq.seq UInt8.t) (start'0: int) (end': int)

axiom byte_model_subsequence_spec:
  forall bytes'0: Seq.seq UInt8.t, start'0: int, end': int [byte_model_subsequence bytes'0 start'0 end']. 0 <= start'0
      /\ start'0 <= end' /\ end' <= Seq.length bytes'0 -> byte_model_subsequence bytes'0 start'0 end'

axiom byte_model_subsequence_spec'0: forall bytes'0: Seq.seq UInt8.t, start'0: int, end': int. 0 <= start'0
      /\ start'0 <= end' /\ end' <= Seq.length bytes'0
    -> byte_sequence_as_ints (Seq.([..]) bytes'0 start'0 end') = Seq.([..]) (byte_sequence_as_ints bytes'0) start'0 end'

predicate safe_run_end_unique (input: Seq.seq UInt8.t) (end': int) (mask: Seq.seq UInt32.t)

axiom safe_run_end_unique_spec:
  forall input: Seq.seq UInt8.t, end': int, mask: Seq.seq UInt32.t [safe_run_end_unique input end' mask]. gt_log_Int (Seq.length input) 0
      /\ Seq.length mask = 4
    -> 0 <= end' /\ end' <= Seq.length input
    -> (forall i: int. 0 <= i /\ i < end' -> not should_encode_model mask (Seq.get input i))
    -> end' = Seq.length input \/ should_encode_model mask (Seq.get input end') -> safe_run_end_unique input end' mask

axiom safe_run_end_unique_spec'0:
  forall input: Seq.seq UInt8.t, end': int, mask: Seq.seq UInt32.t. gt_log_Int (Seq.length input) 0
      /\ Seq.length mask = 4
    -> 0 <= end' /\ end' <= Seq.length input
    -> (forall i: int. 0 <= i /\ i < end' -> not should_encode_model mask (Seq.get input i))
    -> end' = Seq.length input \/ should_encode_model mask (Seq.get input end') -> end' = safe_run_end input 0 mask

predicate encoded_chunks_first_run (mask: Seq.seq UInt32.t) (input: Seq.seq UInt8.t) (end': int)

axiom encoded_chunks_first_run_spec:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t, end': int [encoded_chunks_first_run mask input end']. gt_log_Int (Seq.length input) 0
      /\ Seq.length mask = 4
    -> not should_encode_model mask (Seq.get input 0)
    -> end' = safe_run_end input 0 mask -> encoded_chunks_first_run mask input end'

axiom encoded_chunks_first_run_spec'0:
  forall mask: Seq.seq UInt32.t, input: Seq.seq UInt8.t, end': int. gt_log_Int (Seq.length input) 0
      /\ Seq.length mask = 4
    -> not should_encode_model mask (Seq.get input 0)
    -> end' = safe_run_end input 0 mask
    -> encoded_chunks mask input
    = Seq.(++) (Seq.singleton (byte_sequence_as_ints (Seq.([..]) input 0 end'))) (encoded_chunks mask (Seq.([..]) input end' (Seq.length input)))

function remaining_input [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt8.t = Slice64.view self.bytes

meta "rewrite_def" function remaining_input

function string_chunk_bytes (s: string) : Seq.seq int =
  map_u8 (to_bytes (view_str s)) (fun (b: UInt8.t) -> UInt8.t'int b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let next_chunk (self: MutBorrow.t t_PercentEncode) (return (x: t_Option_ref_str)) =
{[@stop_split] [@expl:next_chunk 'self' type invariant] inv_refmut_PercentEncode self}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &input <- self.current.bytes ] s1
    | s1 = len_u8 {input} (fun (_x: UInt64.t) -> [ &_7 <- _x ] s2)
    | s2 = [ &_6 <- _7 = (0: UInt64.t) ] s3
    | s3 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb2) ] ]
  | bb2 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_PercentEncode self} any) ]
    | s1 = -{resolve_refmut_PercentEncode self}- s2
    | s2 = [ &_ret <- None ] s3
    | s3 = return {_ret} ]
  | bb3 = s0
    [ s0 = [ &_11 <- (0: UInt64.t) ] s1
    | s1 = [ &_12 <- Slice64.length input ] s2
    | s2 = [ &_13 <- UInt64.lt _11 _12 ] s3
    | s3 = {[@expl:index in bounds] _13} s4
    | s4 = Slice64.get <UInt8.t> {input} {_11} (fun (r: UInt8.t) -> [ &first <- r ] s5)
    | s5 = should_percent_encode {self.current.ascii_set} {first} (fun (_x: bool) -> [ &_14 <- _x ] s6)
    | s6 = any [ br0 -> {_14 = false} (! bb9) | br1 -> {_14} (! bb6) ] ]
  | bb6 = s0
    [ s0 = [ &_21 <- { start = (1: UInt64.t) } ] s1
    | s1 = index_slice_u8 {input} {_21} (fun (_x: Slice64.slice UInt8.t) -> [ &_19 <- _x ] s2)
    | s2 = [ &_18 <- _19 ] s3
    | s3 = [ &self <- { self with current = { self.current with bytes = _18 } } ] s4
    | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_refmut_PercentEncode self} any) ]
    | s5 = -{resolve_refmut_PercentEncode self}- s6
    | s6 = percent_encode_byte {first} (fun (_x: string) -> [ &escaped <- _x ] s7)
    | s7 = {[@expl:assertion] should_encode_model (configured_set self.current) first} s8
    | s8 = {[@expl:assertion] encoded_chunks_first_escaped (configured_set self.current) (Slice64.view input)} s9
    | s9 = [ &_ret <- Some escaped ] s10
    | s10 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &end' <- (0: UInt64.t) ] s1 | s1 = bb10 ]
  | bb10 = bb10invariant
    [ bb10 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb10 (Seq.length (Slice64.view input)
      - UInt64.t'int end')}
      bb10invariant
    | bb10invariant = {[@expl:loop invariant #0] UInt64.t'int end' <= Seq.length (Slice64.view input)}
      {[@expl:loop invariant #1] forall i: int. 0 <= i /\ i < UInt64.t'int end'
        -> not should_encode_model (configured_set self.current) (Seq.get (Slice64.view input) i)}
      (! [ &variant_old_bb10 <- Seq.length (Slice64.view input) - UInt64.t'int end' ] s0)
      [ s0 = len_u8 {input} (fun (_x: UInt64.t) -> [ &_50 <- _x ] s1)
      | s1 = [ &_48 <- UInt64.lt end' _50 ] s2
      | s2 = any [ br0 -> {_48 = false} (! bb19) | br1 -> {_48} (! bb13) ] ]
      [ bb13 = s0
        [ s0 = [ &_55 <- end' ] s1
        | s1 = [ &_56 <- Slice64.length input ] s2
        | s2 = [ &_57 <- UInt64.lt _55 _56 ] s3
        | s3 = {[@expl:index in bounds] _57} s4
        | s4 = Slice64.get <UInt8.t> {input} {_55} (fun (r: UInt8.t) -> [ &_54 <- r ] s5)
        | s5 = should_percent_encode {self.current.ascii_set} {_54} (fun (_x: bool) -> [ &_52 <- _x ] s6)
        | s6 = any [ br0 -> {_52 = false} (! bb17) | br1 -> {_52} (! bb19) ] ]
      | bb17 = s0
        [ s0 = {[@expl:assertion] not should_encode_model (configured_set self.current) (index_slice_u8'0 input end')}
          s1
        | s1 =
          {[@expl:assertion] safe_prefix_extend (Slice64.view input) (configured_set self.current) (UInt64.t'int end')}
          s2
        | s2 = UInt64.add {end'} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &end' <- _x ] s3)
        | s3 = bb10 ] ] ]
  | bb19 = s0
    [ s0 = split_at_u8 {input} {end'} (fun (_x: tup2_ref_slice_u8_ref_slice_u8) -> [ &_71 <- _x ] s1)
    | s1 = [ &unchanged_slice <- _71.f0 ] s2
    | s2 = [ &remaining <- _71.f1 ] s3
    | s3 = [ &self <- { self with current = { self.current with bytes = remaining } } ] s4
    | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_refmut_PercentEncode self} any) ]
    | s5 = -{resolve_refmut_PercentEncode self}- s6
    | s6 = from_utf8_unchecked {unchanged_slice} (fun (_x: string) -> [ &unchanged <- _x ] s7)
    | s7 = {[@expl:assertion] byte_model_subsequence (Slice64.view input) 0 (UInt64.t'int end')} s8
    | s8 =
      {[@expl:assertion] byte_model_subsequence (Slice64.view input) (UInt64.t'int end') (Seq.length (Slice64.view input))}
      s9
    | s9 =
      {[@expl:assertion] safe_run_end_unique (Slice64.view input) (UInt64.t'int end') (configured_set self.current)}
      s10
    | s10 =
      {[@expl:assertion] encoded_chunks_first_run (configured_set self.current) (Slice64.view input) (UInt64.t'int end')}
      s11
