    | s13 = -{resolve_refmut_refmut_DebugTrace _28}- s14
    | s14 = MutBorrow.borrow_mut <MutBorrow.t t_DebugTrace> {trace}
        (fun (_bor: MutBorrow.t (MutBorrow.t t_DebugTrace)) -> [ &_34 <- _bor ] [ &trace <- _bor.final ] s15)
