use seq.Seq
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


function decoded_trace (input: Seq.seq int) : Seq.seq int

axiom decoded_trace_def: forall input: Seq.seq int [decoded_trace input]. decoded_trace input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq int
    else
      if ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
        Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
        + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))
      else
        Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq int

predicate decoded_trace_plain_step (input: Seq.seq int)

goal vc_decoded_trace_plain_step: gt_log_Int (Seq.length input) 0
  -> not (ge_log_Int (Seq.length input) 3
    /\ Seq.get input 0 = 37
    /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
    /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0)
  -> ([@stop_split] [@expl:decoded_trace_plain_step ensures] ([@stop_split] [@expl:decoded_trace_plain_step ensures #0] true)
  /\ ([@stop_split] [@expl:decoded_trace_plain_step ensures #1] decoded_trace input
  = Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))))
