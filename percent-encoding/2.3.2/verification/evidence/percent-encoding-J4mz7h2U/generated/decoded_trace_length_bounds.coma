    /\ ([@stop_split] [@expl:decoded_trace_length_bounds ensures #1] Seq.length (decoded_trace input)
      <= Seq.length input)
    /\ ([@stop_split] [@expl:decoded_trace_length_bounds ensures #2] Seq.length input
    <= 3 * Seq.length (decoded_trace input))
