function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

let as_slice_u8 (self_: t_Iter_u8) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:as_slice 'self_' type invariant] inv_ref_Iter_u8 self_}
  any
