predicate byte_model_subsequence (bytes'0: Seq.seq UInt8.t) (start: int) (end': int)

axiom byte_model_subsequence_spec:
  forall bytes'0: Seq.seq UInt8.t, start: int, end': int [byte_model_subsequence bytes'0 start end']. 0 <= start
      /\ start <= end' /\ end' <= Seq.length bytes'0 -> byte_model_subsequence bytes'0 start end'

axiom byte_model_subsequence_spec'0: forall bytes'0: Seq.seq UInt8.t, start: int, end': int. 0 <= start
      /\ start <= end' /\ end' <= Seq.length bytes'0
    -> byte_sequence_as_ints (Seq.([..]) bytes'0 start end') = Seq.([..]) (byte_sequence_as_ints bytes'0) start end'

predicate decoded_trace_plain_step (input: Seq.seq int)

axiom decoded_trace_plain_step_spec:
  forall input: Seq.seq int [decoded_trace_plain_step input]. gt_log_Int (Seq.length input) 0
    -> not (ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0) -> decoded_trace_plain_step input

axiom decoded_trace_plain_step_spec'0: forall input: Seq.seq int. gt_log_Int (Seq.length input) 0
    -> not (ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0)
    -> decoded_trace input
    = Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))

predicate byte_map_nested_tail (bytes'0: Seq.seq UInt8.t) (start: int)

axiom byte_map_nested_tail_spec: forall bytes'0: Seq.seq UInt8.t, start: int [byte_map_nested_tail bytes'0 start]. 0
        <= start
