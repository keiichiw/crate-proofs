    <= Seq.length input

axiom decoded_trace_length_bounds_spec'1: forall input: Seq.seq int. Seq.length input
    <= 3 * Seq.length (decoded_trace input)

predicate decoded_trace_escape_step (input: Seq.seq int)

axiom decoded_trace_escape_step_spec:
  forall input: Seq.seq int [decoded_trace_escape_step input]. ge_log_Int (Seq.length input) 3
    -> Seq.get input 0 = 37
    -> ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
