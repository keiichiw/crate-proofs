let after_percent_sign (iter: MutBorrow.t t_Iter_u8) (return (x: t_Option_u8)) =
{[@stop_split] [@expl:after_percent_sign 'iter' type invariant] inv_refmut_Iter_u8 iter}
  any
  [ return (result: t_Option_u8) -> {[@stop_split] [@expl:after_percent_sign ensures] match result with
      | Some'0 value -> let before = byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)) in let after = byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.final)) in ge_log_Int (Seq.length before) 2
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 0)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get before 1)) 0
      /\ UInt8.t'int value
        = percent_hex_value_model (Seq.get before 0) * 16 + percent_hex_value_model (Seq.get before 1)
      /\ after = Seq.([..]) before 2 (Seq.length before)
      | None'0 -> Slice64.view (view_Iter_u8 iter.final) = Slice64.view (view_Iter_u8 iter.current)
      /\ (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) < 2
      \/ ge_log_Int (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)))) 2
        /\ percent_hex_value_model (Seq.get (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) 0) < 0
      \/ ge_log_Int (Seq.length (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current)))) 2
      /\ percent_hex_value_model (Seq.get (byte_sequence_as_ints (Slice64.view (view_Iter_u8 iter.current))) 1) < 0)
      end}
    (! return {result}) ]

