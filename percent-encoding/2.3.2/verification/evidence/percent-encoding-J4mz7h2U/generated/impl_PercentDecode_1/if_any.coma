axiom byte_map_prefix_push_spec'0: forall bytes'0: Seq.seq UInt8.t, index: int. 0 <= index /\ index < Seq.length bytes'0
    -> Seq.([..]) (byte_sequence_as_ints bytes'0) 0 (index + 1)
