axiom byte_map_nested_tail_spec'0: forall bytes'0: Seq.seq UInt8.t, start: int. 0 <= start /\ start < Seq.length bytes'0
    -> Seq.([..]) (byte_sequence_as_ints (Seq.([..]) bytes'0 start (Seq.length bytes'0))) 1 (Seq.length bytes'0 - start)
    = byte_sequence_as_ints (Seq.([..]) bytes'0 (start + 1) (Seq.length bytes'0))

predicate byte_map_prefix_push (bytes'0: Seq.seq UInt8.t) (index: int)

axiom byte_map_prefix_push_spec: forall bytes'0: Seq.seq UInt8.t, index: int [byte_map_prefix_push bytes'0 index]. 0
        <= index
