(* <PercentDecode<'_> as core::iter::Iterator> *)

use seq.Seq
use creusot.int.UInt8
use map.Map
use creusot.slice.Slice64
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function percent_hex_value_model (byte: int) : int = if 48 <= byte /\ byte <= 57 then
    byte - 48
  else
    if 65 <= byte /\ byte <= 70 then byte - 55 else if 97 <= byte /\ byte <= 102 then byte - 87 else - 1


function decoded_trace (input: Seq.seq int) : Seq.seq int

axiom decoded_trace_def: forall input: Seq.seq int [decoded_trace input]. decoded_trace input
    = (if Seq.length input = 0 then
      Seq.empty: Seq.seq int
    else
      if ge_log_Int (Seq.length input) 3
      /\ Seq.get input 0 = 37
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 1)) 0
      /\ ge_log_Int (percent_hex_value_model (Seq.get input 2)) 0 then
        Seq.(++) (Seq.singleton (percent_hex_value_model (Seq.get input 1) * 16
        + percent_hex_value_model (Seq.get input 2))) (decoded_trace (Seq.([..]) input 3 (Seq.length input)))
      else
        Seq.(++) (Seq.singleton (Seq.get input 0)) (decoded_trace (Seq.([..]) input 1 (Seq.length input)))
    
    )

predicate decoded_trace_length_bounds (input: Seq.seq int)

axiom decoded_trace_length_bounds_spec:
  forall input: Seq.seq int [decoded_trace_length_bounds input]. decoded_trace_length_bounds input

axiom decoded_trace_length_bounds_spec'0: forall input: Seq.seq int. Seq.length (decoded_trace input)
    <= Seq.length input

axiom decoded_trace_length_bounds_spec'1: forall input: Seq.seq int. Seq.length input
    <= 3 * Seq.length (decoded_trace input)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

type t_Iter_u8

type t_PercentDecode = { bytes: t_Iter_u8 }

function view_Iter_u8 (self: t_Iter_u8) : Slice64.slice UInt8.t

function remaining_input [@inline:trivial] (self: t_PercentDecode) : Seq.seq UInt8.t =
  Slice64.view (view_Iter_u8 self.bytes)

meta "rewrite_def" function remaining_input

predicate inv_Iter_u8 (_1: t_Iter_u8)

predicate invariant_ref_Iter_u8 [@inline:trivial] (self: t_Iter_u8) = inv_Iter_u8 self

meta "rewrite_def" predicate invariant_ref_Iter_u8

predicate inv_ref_Iter_u8 [@inline:trivial] (_1: t_Iter_u8) = invariant_ref_Iter_u8 _1

meta "rewrite_def" predicate inv_ref_Iter_u8

let len_Iter_u8 (self_: t_Iter_u8) (return (x: UInt64.t)) =
{[@stop_split] [@expl:len 'self_' type invariant] inv_ref_Iter_u8 self_}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] UInt64.t'int result
    = Seq.length (Slice64.view (view_Iter_u8 self_))}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

let percent_decode_size_hint (len: UInt64.t) (return (x: tup2_usize_Option_usize)) = any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:percent_decode_size_hint ensures] ([@stop_split] [@expl:percent_decode_size_hint ensures #0] UInt64.t'int result.f0
      = ComputerDivision.div (UInt64.t'int len) 3 + (if ComputerDivision.mod (UInt64.t'int len) 3 = 0 then 0 else 1))
    /\ ([@stop_split] [@expl:percent_decode_size_hint ensures #1] match result.f1 with
      | Some upper -> UInt64.t'int upper = UInt64.t'int len
      | None -> false
      end)}
    (! return {result}) ]

predicate inv_PercentDecode (_1: t_PercentDecode)

axiom inv_axiom [@rewrite]: forall x: t_PercentDecode [inv_PercentDecode x]. inv_PercentDecode x = inv_Iter_u8 x.bytes

predicate invariant_ref_PercentDecode [@inline:trivial] (self: t_PercentDecode) = inv_PercentDecode self

meta "rewrite_def" predicate invariant_ref_PercentDecode

predicate inv_ref_PercentDecode [@inline:trivial] (_1: t_PercentDecode) = invariant_ref_PercentDecode _1

meta "rewrite_def" predicate inv_ref_PercentDecode

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let size_hint_PercentDecode (self: t_PercentDecode) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_PercentDecode self}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] decoded_trace_length_bounds (byte_sequence_as_ints (remaining_input self))} s1
    | s1 = len_Iter_u8 {self.bytes} (fun (_x: UInt64.t) -> [ &_13 <- _x ] s2)
    | s2 = percent_decode_size_hint {_13} (fun (_x: tup2_usize_Option_usize) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_usize_Option_usize = Any.any_l () | & self: t_PercentDecode = self | & _13: UInt64.t = Any.any_l () ])
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_PercentDecode ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = ComputerDivision.div (Seq.length (Slice64.view (view_Iter_u8 self.bytes))) 3
      + (if ComputerDivision.mod (Seq.length (Slice64.view (view_Iter_u8 self.bytes))) 3 = 0 then 0 else 1))
    /\ ([@stop_split] [@expl:size_hint ensures #1] match result.f1 with
        | Some upper -> UInt64.t'int upper = Seq.length (Slice64.view (view_Iter_u8 self.bytes))
        | None -> false
        end)
    /\ ([@stop_split] [@expl:size_hint ensures #2] Seq.length (decoded_trace (byte_sequence_as_ints (remaining_input self)))
      <= Seq.length (remaining_input self))
    /\ ([@stop_split] [@expl:size_hint ensures #3] Seq.length (remaining_input self)
    <= 3 * Seq.length (decoded_trace (byte_sequence_as_ints (remaining_input self))))}
    (! return {result}) ]
