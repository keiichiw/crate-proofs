use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant chunks : Seq.seq (Seq.seq int)

function flatten_chunks (chunks: Seq.seq (Seq.seq int)) : Seq.seq int

goal vc_flatten_chunks: if Seq.length chunks = 0 then
    let result = Seq.empty: Seq.seq int in [@stop_split] [@expl:flatten_chunks ensures] if Seq.length chunks = 0 then
      Seq.length result = 0
    else
      result = Seq.(++) (Seq.get chunks 0) (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks)))
  
  else
    ([@expl:variant decreases] well_founded_relation_Int (Seq.length chunks) (Seq.length (Seq.([..]) chunks 1 (Seq.length chunks))))
    /\ (([@stop_split] [@expl:flatten_chunks ensures] if Seq.length (Seq.([..]) chunks 1 (Seq.length chunks)) = 0 then
        Seq.length (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks))) = 0
      else
        flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks))
        = Seq.(++) (Seq.get (Seq.([..]) chunks 1 (Seq.length chunks)) 0) (flatten_chunks (Seq.([..]) (Seq.([..]) chunks 1 (Seq.length chunks)) 1 (Seq.length (Seq.([..]) chunks 1 (Seq.length chunks)))))
      )
    -> (let result = Seq.(++) (Seq.get chunks 0) (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks))) in [@stop_split] [@expl:flatten_chunks ensures] if Seq.length chunks
    = 0 then
      Seq.length result = 0
    else
      result = Seq.(++) (Seq.get chunks 0) (flatten_chunks (Seq.([..]) chunks 1 (Seq.length chunks)))
    ))
  
