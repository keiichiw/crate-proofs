use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.prelude.Char
use seq.Seq
use map.Map
use creusot.prelude.Any
use int.Int

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

let as_bytes (self_: string) (return (x: Slice64.slice UInt8.t)) = any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_bytes ensures] Slice64.view result
    = to_bytes (view_str self_)}
    (! return {result}) ]

type t_AsciiSet

type t_PercentEncode = { bytes: Slice64.slice UInt8.t; ascii_set: t_AsciiSet }

predicate inv_AsciiSet (_1: t_AsciiSet)

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

predicate inv_PercentEncode (_1: t_PercentEncode)

axiom inv_axiom [@rewrite]: forall x: t_PercentEncode [inv_PercentEncode x]. inv_PercentEncode x
    = inv_ref_AsciiSet x.ascii_set

function remaining_input [@inline:trivial] (self: t_PercentEncode) : Seq.seq UInt8.t = Slice64.view self.bytes

meta "rewrite_def" function remaining_input

let percent_encode (input: Slice64.slice UInt8.t) (ascii_set'0: t_AsciiSet) (return (x: t_PercentEncode)) =
{[@stop_split] [@expl:percent_encode 'ascii_set' type invariant] inv_ref_AsciiSet ascii_set'0}
  any
  [ return (result: t_PercentEncode) ->
  {[@stop_split] [@expl:percent_encode ensures] ([@stop_split] [@expl:percent_encode result type invariant] inv_PercentEncode result)
    /\ ([@stop_split] [@expl:percent_encode ensures] remaining_input result = Slice64.view input)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let utf8_percent_encode (input: string) (ascii_set'0: t_AsciiSet) (return (x: t_PercentEncode)) =
{[@stop_split] [@expl:utf8_percent_encode 'ascii_set' type invariant] inv_ref_AsciiSet ascii_set'0}
  (! bb0
  [ bb0 = s0
    [ s0 = as_bytes {input} (fun (_x: Slice64.slice UInt8.t) -> [ &_6 <- _x ] s1)
    | s1 = percent_encode {_6} {ascii_set'0} (fun (_x: t_PercentEncode) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: t_PercentEncode = Any.any_l ()
  | & input: string = input
  | & ascii_set'0: t_AsciiSet = ascii_set'0
  | & _6: Slice64.slice UInt8.t = Any.any_l () ])
  [ return (result: t_PercentEncode) ->
  {[@stop_split] [@expl:utf8_percent_encode ensures] ([@stop_split] [@expl:utf8_percent_encode result type invariant] inv_PercentEncode result)
    /\ ([@stop_split] [@expl:utf8_percent_encode ensures] remaining_input result = to_bytes (view_str input))}
    (! return {result}) ]
