use creusot.int.UInt8
use creusot.slice.Slice64
use seq.Seq
use creusot.int.UInt64
use int.ComputerDivision
use map.Map
use creusot.prelude.Char
use creusot.prelude.Any
use int.Int

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_3 (self: Slice64.array UInt8.t) =
  inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (3: UInt64.t)

predicate inv_array_u8_3 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_3 _1

meta "rewrite_def" predicate inv_array_u8_3

predicate invariant_ref_array_u8_3 [@inline:trivial] (self: Slice64.array UInt8.t) = inv_array_u8_3 self

meta "rewrite_def" predicate invariant_ref_array_u8_3

predicate inv_ref_array_u8_3 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_ref_array_u8_3 _1

meta "rewrite_def" predicate inv_ref_array_u8_3

function index_array_u8_3 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
  Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_array_u8_3

function uppercase_hex (digit: int) : int = if digit < 10 then 48 + digit else 55 + digit

axiom uppercase_hex_spec: forall digit: int [uppercase_hex digit]. uppercase_hex digit
    = (if digit < 10 then 48 + digit else 55 + digit)

function uppercase_hex'0 (digit: int) : int = uppercase_hex digit

let percent_encoded_bytes (byte: UInt8.t) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:percent_encoded_bytes ensures] ([@stop_split] [@expl:percent_encoded_bytes result type invariant] inv_ref_array_u8_3 result)
    /\ ([@stop_split] [@expl:percent_encoded_bytes ensures] Seq.length (Slice64.view result) = 3
    /\ UInt8.t'int (index_array_u8_3 result 0) = 37
    /\ UInt8.t'int (index_array_u8_3 result 1) = uppercase_hex'0 (ComputerDivision.div (UInt8.t'int byte) 16)
    /\ UInt8.t'int (index_array_u8_3 result 2) = uppercase_hex'0 (ComputerDivision.mod (UInt8.t'int byte) 16)
    /\ UInt8.t'int (index_array_u8_3 result 0) < 128
    /\ UInt8.t'int (index_array_u8_3 result 1) < 128 /\ UInt8.t'int (index_array_u8_3 result 2) < 128)}
    (! return {result}) ]

predicate ascii_three (bytes: Seq.seq UInt8.t)

axiom ascii_three_spec: forall bytes: Seq.seq UInt8.t [ascii_three bytes]. Seq.length bytes = 3
    -> UInt8.t'int (Seq.get bytes 0) < 128 /\ UInt8.t'int (Seq.get bytes 1) < 128 /\ UInt8.t'int (Seq.get bytes 2) < 128
    -> ascii_three bytes

axiom ascii_three_spec'0: forall bytes: Seq.seq UInt8.t. Seq.length bytes = 3
    -> UInt8.t'int (Seq.get bytes 0) < 128 /\ UInt8.t'int (Seq.get bytes 1) < 128 /\ UInt8.t'int (Seq.get bytes 2) < 128
    -> (forall i: int. 0 <= i /\ i < Seq.length bytes -> UInt8.t'int (Seq.get bytes i) < 128)

function index_Mapping_u8_Int [@inline:trivial] (self: Map.map UInt8.t int) (a: UInt8.t) : int = Map.get self a

meta "rewrite_def" function index_Mapping_u8_Int

function map_u8 (self: Seq.seq UInt8.t) (m: Map.map UInt8.t int) : Seq.seq int

axiom map_u8_spec: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. Seq.length (map_u8 self m)
    = Seq.length self

axiom map_u8_spec'0: forall self: Seq.seq UInt8.t, m: Map.map UInt8.t int [map_u8 self m]. forall i: int. 0 <= i
        /\ i < Seq.length self -> Seq.get (map_u8 self m) i = index_Mapping_u8_Int m (Seq.get self i)

function byte_sequence_as_ints (bytes: Seq.seq UInt8.t) : Seq.seq int =
  map_u8 bytes (fun (byte: UInt8.t) -> UInt8.t'int byte)

function escaped_byte_chunk (byte: int) : Seq.seq int = if byte = 32 then
    Seq.singleton 43
  else
    Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex (ComputerDivision.mod byte 16)))


predicate encoded_array_model (bytes: Seq.seq UInt8.t) (byte: int)

axiom encoded_array_model_spec: forall bytes: Seq.seq UInt8.t, byte: int [encoded_array_model bytes byte]. byte <> 32
      /\ Seq.length bytes = 3
    -> UInt8.t'int (Seq.get bytes 0) = 37
    -> UInt8.t'int (Seq.get bytes 1) = uppercase_hex (ComputerDivision.div byte 16)
    -> UInt8.t'int (Seq.get bytes 2) = uppercase_hex (ComputerDivision.mod byte 16) -> encoded_array_model bytes byte

axiom encoded_array_model_spec'0: forall bytes: Seq.seq UInt8.t, byte: int. byte <> 32 /\ Seq.length bytes = 3
    -> UInt8.t'int (Seq.get bytes 0) = 37
    -> UInt8.t'int (Seq.get bytes 1) = uppercase_hex (ComputerDivision.div byte 16)
    -> UInt8.t'int (Seq.get bytes 2) = uppercase_hex (ComputerDivision.mod byte 16)
    -> byte_sequence_as_ints bytes = escaped_byte_chunk byte

function encoded_byte_model (byte: int) : Seq.seq int =
  Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton (uppercase_hex'0 (ComputerDivision.div byte 16)))) (Seq.singleton (uppercase_hex'0 (ComputerDivision.mod byte 16)))

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t = flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

let from_utf8_unchecked (bytes: Slice64.slice UInt8.t) (return (x: string)) =
{[@stop_split] [@expl:from_utf8_unchecked requires] (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes)
      -> UInt8.t'int (Seq.get (Slice64.view bytes) i) < 128)
  \/ (exists s: Seq.seq Char.t. to_bytes s = Slice64.view bytes)}
  any
  [ return (result: string) -> {[@stop_split] [@expl:from_utf8_unchecked ensures] to_bytes (view_str result)
    = Slice64.view bytes}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let percent_encode_byte (byte: UInt8.t) (return (x: string)) = (! bb0
  [ bb0 = s0
    [ s0 = percent_encoded_bytes {byte} (fun (_x: Slice64.array UInt8.t) -> [ &encoded <- _x ] s1)
    | s1 = {[@expl:assertion] ascii_three (Slice64.view encoded)} s2
    | s2 = [ &_11 <- byte <> (32: UInt8.t) ] s3
    | s3 = any [ br0 -> {_11 = false} (! bb3) | br1 -> {_11} (! bb2) ] ]
  | bb2 = s0
    [ s0 = {[@expl:assertion] encoded_array_model (Slice64.view encoded) (UInt8.t'int byte)} s1
    | s1 = {[@expl:assertion] encoded_byte_model (UInt8.t'int byte) = escaped_byte_chunk (UInt8.t'int byte)} s2
    | s2 = bb4 ]
  | bb3 = s0
    [ s0 = {[@expl:assertion] encoded_byte_model (UInt8.t'int byte)
      = Seq.(++) (Seq.(++) (Seq.singleton 37) (Seq.singleton 50)) (Seq.singleton 48)}
      s1
    | s1 = bb4 ]
  | bb4 = s0
    [ s0 = {[@expl:assertion] byte_sequence_as_ints (Slice64.view encoded) = encoded_byte_model (UInt8.t'int byte)} s1
    | s1 = from_utf8_unchecked {encoded} (fun (_x: string) -> [ &_27 <- _x ] s2)
    | s2 = [ &_ret <- _27 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: string = Any.any_l ()
  | & byte: UInt8.t = byte
  | & encoded: Slice64.array UInt8.t = Any.any_l ()
  | & _11: bool = Any.any_l ()
  | & _27: string = Any.any_l () ])
  [ return (result: string) ->
  {[@stop_split] [@expl:percent_encode_byte ensures] byte_sequence_as_ints (to_bytes (view_str result))
    = encoded_byte_model (UInt8.t'int byte)}
    (! return {result}) ]
