(* ascii_set::AsciiSet *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.slice.Slice64
use creusot.prelude.Any
use seq.Seq

type t_AsciiSet = { mask: Slice64.array UInt32.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64.array UInt32.t) =
  inv_Seq_u32 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64.array UInt32.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let union (self: t_AsciiSet) (other: t_AsciiSet) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:union requires] ([@stop_split] [@expl:union 'self' type invariant] inv_ref_AsciiSet self)
  /\ ([@stop_split] [@expl:union 'other' type invariant] inv_AsciiSet other)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- (0: UInt64.t) ] s1
    | s1 = [ &_7 <- UInt64.lt _6 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _7} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_6} (fun (r: UInt32.t) -> [ &_5 <- r ] s4)
    | s4 = [ &_9 <- (0: UInt64.t) ] s5
    | s5 = [ &_10 <- UInt64.lt _9 (4: UInt64.t) ] s6
    | s6 = {[@expl:index in bounds] _10} s7
    | s7 = Slice64.get <UInt32.t> {other.mask} {_9} (fun (r: UInt32.t) -> [ &_8 <- r ] s8)
    | s8 = [ &_4 <- UInt32.bw_or _5 _8 ] s9
    | s9 = [ &_13 <- (1: UInt64.t) ] s10
    | s10 = [ &_14 <- UInt64.lt _13 (4: UInt64.t) ] s11
    | s11 = {[@expl:index in bounds] _14} s12
    | s12 = Slice64.get <UInt32.t> {self.mask} {_13} (fun (r: UInt32.t) -> [ &_12 <- r ] s13)
    | s13 = [ &_16 <- (1: UInt64.t) ] s14
    | s14 = [ &_17 <- UInt64.lt _16 (4: UInt64.t) ] s15
    | s15 = {[@expl:index in bounds] _17} s16
    | s16 = Slice64.get <UInt32.t> {other.mask} {_16} (fun (r: UInt32.t) -> [ &_15 <- r ] s17)
    | s17 = [ &_11 <- UInt32.bw_or _12 _15 ] s18
    | s18 = [ &_20 <- (2: UInt64.t) ] s19
    | s19 = [ &_21 <- UInt64.lt _20 (4: UInt64.t) ] s20
    | s20 = {[@expl:index in bounds] _21} s21
    | s21 = Slice64.get <UInt32.t> {self.mask} {_20} (fun (r: UInt32.t) -> [ &_19 <- r ] s22)
    | s22 = [ &_23 <- (2: UInt64.t) ] s23
    | s23 = [ &_24 <- UInt64.lt _23 (4: UInt64.t) ] s24
    | s24 = {[@expl:index in bounds] _24} s25
    | s25 = Slice64.get <UInt32.t> {other.mask} {_23} (fun (r: UInt32.t) -> [ &_22 <- r ] s26)
    | s26 = [ &_18 <- UInt32.bw_or _19 _22 ] s27
    | s27 = [ &_27 <- (3: UInt64.t) ] s28
    | s28 = [ &_28 <- UInt64.lt _27 (4: UInt64.t) ] s29
    | s29 = {[@expl:index in bounds] _28} s30
    | s30 = Slice64.get <UInt32.t> {self.mask} {_27} (fun (r: UInt32.t) -> [ &_26 <- r ] s31)
    | s31 = [ &_30 <- (3: UInt64.t) ] s32
    | s32 = [ &_31 <- UInt64.lt _30 (4: UInt64.t) ] s33
    | s33 = {[@expl:index in bounds] _31} s34
    | s34 = Slice64.get <UInt32.t> {other.mask} {_30} (fun (r: UInt32.t) -> [ &_29 <- r ] s35)
    | s35 = [ &_25 <- UInt32.bw_or _26 _29 ] s36
    | s36 = any
      [ any_ (__arr_temp: Slice64.array UInt32.t) -> (! -{Seq.get __arr_temp.Slice64.elts 0 = _4
        /\ Seq.get __arr_temp.Slice64.elts 1 = _11
        /\ Seq.get __arr_temp.Slice64.elts 2 = _18
        /\ Seq.get __arr_temp.Slice64.elts 3 = _25 /\ Seq.length __arr_temp.Slice64.elts = 4}-
        [ &mask'0 <- __arr_temp ] s37) ]
    | s37 = [ &_ret <- { mask = mask'0 } ] s38
    | s38 = return {_ret} ] ]
  [ & _ret: t_AsciiSet = Any.any_l ()
  | & self: t_AsciiSet = self
  | & other: t_AsciiSet = other
  | & mask'0: Slice64.array UInt32.t = Any.any_l ()
  | & _4: UInt32.t = Any.any_l ()
  | & _5: UInt32.t = Any.any_l ()
  | & _6: UInt64.t = Any.any_l ()
  | & _7: bool = Any.any_l ()
  | & _8: UInt32.t = Any.any_l ()
  | & _9: UInt64.t = Any.any_l ()
  | & _10: bool = Any.any_l ()
  | & _11: UInt32.t = Any.any_l ()
  | & _12: UInt32.t = Any.any_l ()
  | & _13: UInt64.t = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _15: UInt32.t = Any.any_l ()
  | & _16: UInt64.t = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & _18: UInt32.t = Any.any_l ()
  | & _19: UInt32.t = Any.any_l ()
  | & _20: UInt64.t = Any.any_l ()
  | & _21: bool = Any.any_l ()
  | & _22: UInt32.t = Any.any_l ()
  | & _23: UInt64.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _25: UInt32.t = Any.any_l ()
  | & _26: UInt32.t = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & _28: bool = Any.any_l ()
  | & _29: UInt32.t = Any.any_l ()
  | & _30: UInt64.t = Any.any_l ()
  | & _31: bool = Any.any_l () ])
  [ return (result: t_AsciiSet) -> {[@stop_split] [@expl:union result type invariant] inv_AsciiSet result}
    (! return {result}) ]
