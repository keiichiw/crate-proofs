(* ascii_set::AsciiSet *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.slice.Slice64
use creusot.prelude.Any
use seq.Seq

type t_AsciiSet = { mask: Slice64.array UInt32.t }

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64.array UInt32.t) =
  inv_Seq_u32 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64.array UInt32.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let complement (self: t_AsciiSet) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:complement 'self' type invariant] inv_ref_AsciiSet self}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_5 <- (0: UInt64.t) ] s1
    | s1 = [ &_6 <- UInt64.lt _5 (4: UInt64.t) ] s2
    | s2 = {[@expl:index in bounds] _6} s3
    | s3 = Slice64.get <UInt32.t> {self.mask} {_5} (fun (r: UInt32.t) -> [ &_4 <- r ] s4)
    | s4 = [ &_3 <- UInt32.bw_not _4 ] s5
    | s5 = [ &_9 <- (1: UInt64.t) ] s6
    | s6 = [ &_10 <- UInt64.lt _9 (4: UInt64.t) ] s7
    | s7 = {[@expl:index in bounds] _10} s8
    | s8 = Slice64.get <UInt32.t> {self.mask} {_9} (fun (r: UInt32.t) -> [ &_8 <- r ] s9)
    | s9 = [ &_7 <- UInt32.bw_not _8 ] s10
    | s10 = [ &_13 <- (2: UInt64.t) ] s11
    | s11 = [ &_14 <- UInt64.lt _13 (4: UInt64.t) ] s12
    | s12 = {[@expl:index in bounds] _14} s13
    | s13 = Slice64.get <UInt32.t> {self.mask} {_13} (fun (r: UInt32.t) -> [ &_12 <- r ] s14)
    | s14 = [ &_11 <- UInt32.bw_not _12 ] s15
    | s15 = [ &_17 <- (3: UInt64.t) ] s16
    | s16 = [ &_18 <- UInt64.lt _17 (4: UInt64.t) ] s17
    | s17 = {[@expl:index in bounds] _18} s18
    | s18 = Slice64.get <UInt32.t> {self.mask} {_17} (fun (r: UInt32.t) -> [ &_16 <- r ] s19)
    | s19 = [ &_15 <- UInt32.bw_not _16 ] s20
    | s20 = any
      [ any_ (__arr_temp: Slice64.array UInt32.t) -> (! -{Seq.get __arr_temp.Slice64.elts 0 = _3
        /\ Seq.get __arr_temp.Slice64.elts 1 = _7
        /\ Seq.get __arr_temp.Slice64.elts 2 = _11
        /\ Seq.get __arr_temp.Slice64.elts 3 = _15 /\ Seq.length __arr_temp.Slice64.elts = 4}-
        [ &mask'0 <- __arr_temp ] s21) ]
    | s21 = [ &_ret <- { mask = mask'0 } ] s22
    | s22 = return {_ret} ] ]
  [ & _ret: t_AsciiSet = Any.any_l ()
  | & self: t_AsciiSet = self
  | & mask'0: Slice64.array UInt32.t = Any.any_l ()
  | & _3: UInt32.t = Any.any_l ()
  | & _4: UInt32.t = Any.any_l ()
  | & _5: UInt64.t = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & _7: UInt32.t = Any.any_l ()
  | & _8: UInt32.t = Any.any_l ()
  | & _9: UInt64.t = Any.any_l ()
  | & _10: bool = Any.any_l ()
  | & _11: UInt32.t = Any.any_l ()
  | & _12: UInt32.t = Any.any_l ()
  | & _13: UInt64.t = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _15: UInt32.t = Any.any_l ()
  | & _16: UInt32.t = Any.any_l ()
  | & _17: UInt64.t = Any.any_l ()
  | & _18: bool = Any.any_l () ])
  [ return (result: t_AsciiSet) -> {[@stop_split] [@expl:complement result type invariant] inv_AsciiSet result}
    (! return {result}) ]
