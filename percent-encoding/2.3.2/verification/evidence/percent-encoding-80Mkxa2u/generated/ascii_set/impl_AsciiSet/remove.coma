(* ascii_set::AsciiSet *)

use creusot.slice.Slice64
use creusot.int.UInt32
use creusot.int.UInt8
use creusot.int.UInt64
use creusot.prelude.Any
use seq.Seq
use int.Int

type t_AsciiSet = { mask: Slice64.array UInt32.t }

constant size_of_u32: int = 4

meta "rewrite_def" constant size_of_u32

axiom size_of_u32_spec: 0 <= size_of_u32

let size_of_u32'0 (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:size_of ensures] UInt64.t'int result = size_of_u32}
    (! return {result}) ]

type tup2_usize_bool = { f0: UInt64.t; f1: bool }

constant const_BITS_PER_CHUNK : UInt64.t

let set_BITS_PER_CHUNK (return) = bb0
  [ bb0 = s0
    [ s0 = size_of_u32'0 (fun (_x: UInt64.t) -> [ &_1 <- _x ] s1)
    | s1 = [ &_2 <- let (_fst, _snd) = UInt64.mul_with_overflow (8: UInt64.t) _1 in { f0 = _fst; f1 = _snd } ] s2
    | s2 = {[@expl:Mul overflow] not _2.f1} s3
    | s3 = [ &_ret <- _2.f0 ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & _1: UInt64.t = Any.any_l () | & _2: tup2_usize_bool = Any.any_l () ]
  [ return (_const: UInt64.t) -> -{const_BITS_PER_CHUNK = _const}- return ]

predicate inv_Seq_u32 [@inline:trivial] (_1: Seq.seq UInt32.t) = true

meta "rewrite_def" predicate inv_Seq_u32

predicate invariant_array_u32_4 (self: Slice64.array UInt32.t) =
  inv_Seq_u32 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (4: UInt64.t)

predicate inv_array_u32_4 [@inline:trivial] (_1: Slice64.array UInt32.t) = invariant_array_u32_4 _1

meta "rewrite_def" predicate inv_array_u32_4

predicate inv_AsciiSet (_1: t_AsciiSet)

axiom inv_axiom [@rewrite]: forall x: t_AsciiSet [inv_AsciiSet x]. inv_AsciiSet x = inv_array_u32_4 x.mask

predicate invariant_ref_AsciiSet [@inline:trivial] (self: t_AsciiSet) = inv_AsciiSet self

meta "rewrite_def" predicate invariant_ref_AsciiSet

predicate inv_ref_AsciiSet [@inline:trivial] (_1: t_AsciiSet) = invariant_ref_AsciiSet _1

meta "rewrite_def" predicate inv_ref_AsciiSet

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let remove (self: t_AsciiSet) (byte: UInt8.t) (return (x: t_AsciiSet)) =
{[@stop_split] [@expl:remove 'self' type invariant] inv_ref_AsciiSet self}
  (! set_BITS_PER_CHUNK
    (bb0
    [ bb0 = s0
      [ s0 = [ &mask'0 <- self.mask ] s1
      | s1 = [ &_7 <- UInt64.of_int (UInt8.t'int byte) ] s2
      | s2 = [ &_9 <- const_BITS_PER_CHUNK = (0: UInt64.t) ] s3
      | s3 = {[@expl:remainder by zero] not _9} s4
      | s4 = UInt64.rem {_7} {const_BITS_PER_CHUNK} (fun (_x: UInt64.t) -> [ &_6 <- _x ] s5)
      | s5 = UInt32.shl {(1: UInt32.t)} {UInt64.t'int _6} (fun (_x: UInt32.t) -> [ &_5 <- _x ] s6)
      | s6 = [ &_4 <- UInt32.bw_not _5 ] s7
      | s7 = [ &_11 <- UInt64.of_int (UInt8.t'int byte) ] s8
      | s8 = [ &_13 <- const_BITS_PER_CHUNK = (0: UInt64.t) ] s9
      | s9 = {[@expl:division by zero] not _13} s10
      | s10 = UInt64.div {_11} {const_BITS_PER_CHUNK} (fun (_x: UInt64.t) -> [ &_10 <- _x ] s11)
      | s11 = [ &_14 <- UInt64.lt _10 (4: UInt64.t) ] s12
      | s12 = {[@expl:index in bounds] _14} s13
      | s13 = Slice64.get <UInt32.t> {mask'0} {_10}
          (fun (r: UInt32.t) ->
            Slice64.set <UInt32.t> {mask'0} {_10} {UInt32.bw_and r _4}
              (fun (r'0: Slice64.array UInt32.t) -> [ &mask'0 <- r'0 ] s14))
      | s14 = [ &_ret <- { mask = mask'0 } ] s15
      | s15 = return {_ret} ] ]
    [ & _ret: t_AsciiSet = Any.any_l ()
    | & self: t_AsciiSet = self
    | & byte: UInt8.t = byte
    | & mask'0: Slice64.array UInt32.t = Any.any_l ()
    | & _4: UInt32.t = Any.any_l ()
    | & _5: UInt32.t = Any.any_l ()
    | & _6: UInt64.t = Any.any_l ()
    | & _7: UInt64.t = Any.any_l ()
    | & _9: bool = Any.any_l ()
    | & _10: UInt64.t = Any.any_l ()
    | & _11: UInt64.t = Any.any_l ()
    | & _13: bool = Any.any_l ()
    | & _14: bool = Any.any_l () ]))
  [ return (result: t_AsciiSet) -> {[@stop_split] [@expl:remove result type invariant] inv_AsciiSet result}
    (! return {result}) ]
