  type t_String
  
  type t_Cow_str =
    | Borrowed string
    | Owned t_String
  
  predicate inv_String t_String
  
  predicate inv_Cow_str t_Cow_str
  
  axiom inv_axiom :
    forall x:t_Cow_str [inv_Cow_str x].
     inv_Cow_str x <->
     match x with
     | Borrowed f0 -> true
     | Owned f0 -> inv_String f0
     end
  
  type tup3_Int_Int_bool =
    | Tup3_Int_Int_bool'mk (f0:int) (f1:int) (f2:bool)
  
  (* meta model_record function f2 *)
  
