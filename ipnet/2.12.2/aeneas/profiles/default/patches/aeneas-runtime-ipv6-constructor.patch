+/-- The unchanged checked U128 addition model reports integer overflow at its
+    maximum value when adding one. -/
+theorem U128.add_one_max_fail (x : U128) (h : x.val = 2^128 - 1) :
+    (x + (UScalar.one : U128) : Result U128) = Result.fail .integerOverflow := by
+  change UScalar.tryMk .U128 (x.val + 1) = Result.fail .integerOverflow
+  simp [UScalar.tryMk, UScalar.tryMkOpt, UScalar.check_bounds,
+    UScalarTy.numBits, h]
+
+/-- The unchanged checked usize addition model reports integer overflow at
+    the platform's maximum value when adding one. -/
+theorem Usize.add_one_max_fail (x : Usize)
+    (h : x.val = 2^Usize.numBits - 1) :
+    (x + (UScalar.one : Usize) : Result Usize) = Result.fail .integerOverflow := by
+  have hp : 0 < 2 ^ System.Platform.numBits := pow_pos (by decide) _
+  have hnot : ¬ (2 ^ System.Platform.numBits - 1 + 1 <
+      2 ^ System.Platform.numBits) := by omega
+  change UScalar.tryMk .Usize (x.val + 1) = Result.fail .integerOverflow
+  simp [UScalar.tryMk, UScalar.tryMkOpt, UScalar.check_bounds,
+    UScalarTy.numBits, Usize.numBits, h, hnot]
+
