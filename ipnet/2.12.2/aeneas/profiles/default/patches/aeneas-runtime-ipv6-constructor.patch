diff --git a/backends/lean/Aeneas/Std/NetIpAddr.lean b/backends/lean/Aeneas/Std/NetIpAddr.lean
new file mode 100644
index 0000000000000000000000000000000000000000..3d788d418cccbc8a8d3869ba0fd405b7ae834a64
--- /dev/null
+++ b/backends/lean/Aeneas/Std/NetIpAddr.lean
@@ -0,0 +1,57 @@
+module
+public import Aeneas.Std.Scalar.CoreConvertNum
+public import Aeneas.Std.Core.Cmp
+public section
+
+namespace ipnet
+open Aeneas.Std Result
+
+/- A narrowly scoped, review-trusted model for the pinned core IPv4 address
+   comparison. The source implementation compares its four octets
+   lexicographically; this model compares the same big-endian integer. The
+   correspondence with the Rust implementation is an external trust boundary. -/
+@[rust_type "core::net::ip_addr::Ipv4Addr"]
+structure core.net.ip_addr.Ipv4Addr where
+  octets : Array U8 4#usize
+
+@[rust_type "core::net::ip_addr::Ipv6Addr"]
+structure core.net.ip_addr.Ipv6Addr where
+  octets : Array U8 16#usize
+
+/- The pinned core Ipv6Addr::new converts each segment to big endian and
+   reinterprets the resulting eight words as sixteen bytes. This precise
+   constructor model concatenates the corresponding big-endian byte pairs.
+   The Rust layout correspondence is a reviewed external boundary. -/
+@[expose, rust_fun "core::net::ip_addr::{core::net::ip_addr::Ipv6Addr}::new"]
+def core.net.ip_addr.Ipv6Addr.new
+    (a b c d e f g h : U16) : Result core.net.ip_addr.Ipv6Addr :=
+  ok {
+    octets := Array.from
+      ((core.num.U16.to_be_bytes a).val ++
+       (core.num.U16.to_be_bytes b).val ++
+       (core.num.U16.to_be_bytes c).val ++
+       (core.num.U16.to_be_bytes d).val ++
+       (core.num.U16.to_be_bytes e).val ++
+       (core.num.U16.to_be_bytes f).val ++
+       (core.num.U16.to_be_bytes g).val ++
+       (core.num.U16.to_be_bytes h).val)
+      (by simp)
+  }
+
+@[expose, rust_fun "core::net::ip_addr::{core::cmp::Ord<core::net::ip_addr::Ipv4Addr>}::cmp"]
+def core.net.ip_addr.Ipv4Addr.Insts.CoreCmpOrd.cmp
+    (self other : core.net.ip_addr.Ipv4Addr) : Result Ordering :=
+  ok (compare (core.num.U32.from_be_bytes self.octets).val
+    (core.num.U32.from_be_bytes other.octets).val)
+
+/- The pinned Rust IPv6 comparator compares the eight network-order segments.
+   Their lexicographic order equals the order of this big-endian integer. The
+   Rust-to-model correspondence, including `segments()` and its native-endian
+   transmute, is a separately reviewed external boundary. -/
+@[expose, rust_fun "core::net::ip_addr::{core::cmp::Ord<core::net::ip_addr::Ipv6Addr>}::cmp"]
+def core.net.ip_addr.Ipv6Addr.Insts.CoreCmpOrd.cmp
+    (self other : core.net.ip_addr.Ipv6Addr) : Result Ordering :=
+  ok (compare (core.num.U128.from_be_bytes self.octets).val
+    (core.num.U128.from_be_bytes other.octets).val)
+
+end ipnet
