use creusot.int.UInt16
use creusot.int.UInt8
use creusot.prelude.Any

type t_Date = { year: UInt16.t; month: UInt8.t; day: UInt8.t }

type t_DateModel = { year'0: int; month'0: int; day'0: int }

function deep_model_Date (self: t_Date) : t_DateModel = { year'0 = UInt16.t'int self.year;
                                                          month'0 = UInt8.t'int self.month;
                                                          day'0 = UInt8.t'int self.day }

function deep_model_ref_Date [@inline:trivial] (self: t_Date) : t_DateModel = deep_model_Date self

meta "rewrite_def" function deep_model_ref_Date

let eq_Date (self: t_Date) (rhs: t_Date) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] result
    = (deep_model_ref_Date self = deep_model_ref_Date rhs)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let structural_eq (a: t_Date) (b: t_Date) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = eq_Date {a} {b} (fun (_x: bool) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & a: t_Date = a | & b: t_Date = b ])
  [ return (result: bool) -> {[@stop_split] [@expl:structural_eq ensures] result
    = (deep_model_Date a = deep_model_Date b)}
    (! return {result}) ]
