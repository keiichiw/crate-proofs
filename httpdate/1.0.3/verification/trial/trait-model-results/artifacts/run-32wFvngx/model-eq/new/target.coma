(* eq_model::Date *)

use creusot.int.UInt16
use creusot.int.UInt8
use creusot.prelude.Any

type t_Date = { year: UInt16.t; month: UInt8.t; day: UInt8.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let new (year'0: UInt16.t) (month'0: UInt8.t) (day'0: UInt8.t) (return (x: t_Date)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { year = year'0; month = month'0; day = day'0 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Date = Any.any_l ()
  | & year'0: UInt16.t = year'0
  | & month'0: UInt8.t = month'0
  | & day'0: UInt8.t = day'0 ]) [ return (result: t_Date) -> (! return {result}) ]
