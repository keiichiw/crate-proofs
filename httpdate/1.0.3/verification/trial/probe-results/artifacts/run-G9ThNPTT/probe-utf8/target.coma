use creusot.prelude.Any
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use int.Int

type t_Utf8Error

type t_Result_ref_str_Utf8Error = Ok string | Err t_Utf8Error

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_29 (self: Slice64.array UInt8.t) =
  inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (29: UInt64.t)

predicate inv_array_u8_29 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_29 _1

meta "rewrite_def" predicate inv_array_u8_29

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let ascii_is_utf8 (bytes: Slice64.array UInt8.t) (return (x: bool)) =
{[@stop_split] [@expl:ascii_is_utf8 requires] ([@stop_split] [@expl:ascii_is_utf8 'bytes' type invariant] inv_array_u8_29 bytes)
  /\ ([@stop_split] [@expl:ascii_is_utf8 requires] forall i: int. 0 <= i /\ i < 29
    -> UInt8.t'int (Seq.get (Slice64.view bytes) i) < 128)}
  (! bb0
  [ bb0 = s0 [ s0 = [ &_9 <- bytes ] s1 | s1 = {false} any ] ]
  [ & _ret: bool = Any.any_l ()
  | & bytes: Slice64.array UInt8.t = bytes
  | & _5: t_Result_ref_str_Utf8Error = Any.any_l ()
  | & _6: t_Result_ref_str_Utf8Error = Any.any_l ()
  | & _9: Slice64.array UInt8.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:ascii_is_utf8 ensures] result} (! return {result}) ]
