use creusot.int.UInt64
use creusot.prelude.Any
use creusot.prelude.MutBorrow

type t_T

type t_DefaultHasher

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let hash_via_default_hasher_T (value: t_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:hash_via_default_hasher 'value' type invariant] inv_ref_T value}
  (! bb0
  [ bb0 = {false} any ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & value: t_T = value
  | & hasher: t_DefaultHasher = Any.any_l ()
  | & _3: () = Any.any_l ()
  | & _4: t_T = Any.any_l ()
  | & _5: MutBorrow.t t_DefaultHasher = Any.any_l ()
  | & _6: MutBorrow.t t_DefaultHasher = Any.any_l () ]) [ return (result: UInt64.t) -> (! return {result}) ]
