function digit_char (d: int) : Char.t = if d = 0 then
    Char.of_int 48
  else
    if d = 1 then
      Char.of_int 49
    else
      if d = 2 then
        Char.of_int 50
      else
        if d = 3 then
          Char.of_int 51
        else
          if d = 4 then
            Char.of_int 52
          else
            if d = 5 then
              Char.of_int 53
            else
              if d = 6 then
                Char.of_int 54
              else
                if d = 7 then Char.of_int 55 else if d = 8 then Char.of_int 56 else Char.of_int 57
            
          
        
      
    
  


let digit_byte (n: UInt16.t) (return (x: UInt8.t)) = {[@stop_split] [@expl:digit_byte requires] UInt16.t'int n < 10}
  any
  [ return (result: UInt8.t) ->
  {[@stop_split] [@expl:digit_byte ensures] ([@stop_split] [@expl:digit_byte ensures #0] UInt8.t'int result
        = UInt16.t'int n + 48
      /\ UInt8.t'int result < 128)
    /\ ([@stop_split] [@expl:digit_byte ensures #1] literal_char result = digit_char (UInt16.t'int n)
    /\ Char.to_int (literal_char result) = UInt8.t'int result)}
    (! return {result}) ]

function ascii_chars [@inline:trivial] (bytes: Seq.seq UInt8.t) : Seq.seq Char.t =
  Seq.create (Seq.length bytes) (fun (i: int) -> literal_char (Seq.get bytes i))

meta "rewrite_def" function ascii_chars

function decimal_chars (v: int) : Seq.seq Char.t = if v < 10 then
    Seq.create 1 [|digit_char v|]
  else
    if v < 100 then
      Seq.create 2 [|digit_char (ComputerDivision.div v 10);digit_char (ComputerDivision.mod v 10)|]
    else
      if v < 1000 then
        Seq.create 3 [|digit_char (ComputerDivision.div v 100);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
      else
        if v < 10000 then
          Seq.create 4 [|digit_char (ComputerDivision.div v 1000);digit_char (ComputerDivision.mod (ComputerDivision.div v 100) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
        else
          Seq.create 5 [|digit_char (ComputerDivision.div v 10000);digit_char (ComputerDivision.mod (ComputerDivision.div v 1000) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 100) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
      
    
  


type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

type t_Option_usize = None | Some UInt64.t

type t_Alignment = Left | Right | Center

type t_Option_Alignment = None'0 | Some'0 t_Alignment

type t_DebugOptions = {
  flags: UInt32.t;
  width: t_Option_usize;
  precision: t_Option_usize;
  fill: Char.t;
  align: t_Option_Alignment }

function debug_options (_f: t_Formatter) : t_DebugOptions

predicate append_sink (_f: t_Formatter)

function formatter_output (_f: t_Formatter) : Seq.seq Char.t

let write_ascii (f: MutBorrow.t t_Formatter) (bytes: Slice64.slice UInt8.t) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_ascii requires] ([@stop_split] [@expl:write_ascii 'f' type invariant] inv_refmut_Formatter f)
  /\ ([@stop_split] [@expl:write_ascii requires] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes)
    -> UInt8.t'int (Seq.get (Slice64.view bytes) i) < 128
    /\ Char.to_int (literal_char (Seq.get (Slice64.view bytes) i)) = UInt8.t'int (Seq.get (Slice64.view bytes) i))}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_ascii ensures] match result with
      | Ok () -> debug_options f.final = debug_options f.current
      /\ (append_sink f.current
      -> append_sink f.final
      /\ formatter_output f.final = Seq.(++) (formatter_output f.current) (ascii_chars (Slice64.view bytes)))
      | Err _ -> true
      end}
    (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

