                                                                Char.of_int 51
                                                              else
                                                                if b = (52: UInt8.t) then
                                                                  Char.of_int 52
                                                                else
                                                                  if b = (53: UInt8.t) then
                                                                    Char.of_int 53
                                                                  else
                                                                    if b = (54: UInt8.t) then
                                                                      Char.of_int 54
                                                                    else
