type t_DebugOptions = {
  flags: UInt32.t;
  width: t_Option_usize;
  precision: t_Option_usize;
  fill: Char.t;
  align: t_Option_Alignment }

predicate plain_options [@inline:trivial] (o: t_DebugOptions) =
  (o.flags = (0: UInt32.t) \/ o.flags = (4: UInt32.t))
  /\ o.width = None'0 /\ o.precision = None'0 /\ o.fill = Char.of_int 32 /\ o.align = None'1

meta "rewrite_def" predicate plain_options

function debug_options (_f: t_Formatter) : t_DebugOptions

let debug_mode (f: t_Formatter) (return (x: t_Option_bool)) =
{[@stop_split] [@expl:debug_mode 'f' type invariant] inv_ref_Formatter f}
  any
  [ return (result: t_Option_bool) -> {[@stop_split] [@expl:debug_mode ensures] match result with
      | Some pretty -> plain_options (debug_options f) /\ pretty = ((debug_options f).flags = (4: UInt32.t))
      | None -> not plain_options (debug_options f)
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_bool) (return (f0: bool)) = any
  [ _k (f0: bool) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

