function date_debug_chars [@inline:trivial] (sec'1: UInt8.t) (min'1: UInt8.t) (hour'1: UInt8.t) (day'1: UInt8.t) (mon'1: UInt8.t) (year'1: UInt16.t) (wday'1: UInt8.t) (pretty: bool) : Seq.seq Char.t
 =
