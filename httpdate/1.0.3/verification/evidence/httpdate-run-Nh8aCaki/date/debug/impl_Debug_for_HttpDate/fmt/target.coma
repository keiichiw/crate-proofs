function ascii_chars [@inline:trivial] (bytes: Seq.seq UInt8.t) : Seq.seq Char.t =
  Seq.create (Seq.length bytes) (fun (i: int) -> literal_char (Seq.get bytes i))

meta "rewrite_def" function ascii_chars

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

let write_ascii (f: MutBorrow.t t_Formatter) (bytes: Slice64.slice UInt8.t) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_ascii requires] ([@stop_split] [@expl:write_ascii 'f' type invariant] inv_refmut_Formatter f)
  /\ ([@stop_split] [@expl:write_ascii requires] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes)
    -> UInt8.t'int (Seq.get (Slice64.view bytes) i) < 128
    /\ Char.to_int (literal_char (Seq.get (Slice64.view bytes) i)) = UInt8.t'int (Seq.get (Slice64.view bytes) i))}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_ascii ensures] match result with
      | Ok () -> debug_options f.final = debug_options f.current
      /\ (append_sink f.current
      -> append_sink f.final
      /\ formatter_output f.final = Seq.(++) (formatter_output f.current) (ascii_chars (Slice64.view bytes)))
      | Err _ -> true
      end}
    (! return {result}) ]

type t_Result_Infallible_Error = Ok'0 () | Err'0 ()

type t_ControlFlow_Result_Infallible_Error_unit = Continue () | Break t_Result_Infallible_Error

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Result_Infallible_Error (_1: t_Result_Infallible_Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_Infallible_Error [inv_Result_Infallible_Error x]. inv_Result_Infallible_Error x
    = match x with
      | Ok'0 f0 -> inv_Infallible f0
      | Err'0 f0 -> true
      end

predicate inv_ControlFlow_Result_Infallible_Error_unit (_1: t_ControlFlow_Result_Infallible_Error_unit)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Result_Infallible_Error_unit [inv_ControlFlow_Result_Infallible_Error_unit x]. inv_ControlFlow_Result_Infallible_Error_unit x
    = match x with
      | Continue f0 -> true
      | Break f0 -> inv_Result_Infallible_Error f0
      end

let branch_Result_unit_Error (self_: t_Result_unit_Error) (return (x: t_ControlFlow_Result_Infallible_Error_unit)) = any
  [ return (result: t_ControlFlow_Result_Infallible_Error_unit) ->
  {[@stop_split] [@expl:branch_Result_unit_Error ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Result_Infallible_Error_unit result)
    /\ ([@stop_split] [@expl:branch ensures] match self_ with
      | Ok v -> result = Continue v
      | Err e -> result = Break (Err'0 e)
      end)}
    (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

let elim_Break (_x: t_ControlFlow_Result_Infallible_Error_unit) (return (f0: t_Result_Infallible_Error)) = any
  [ _k (f0: t_Result_Infallible_Error) -> {Break f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

type tup2_Result_unit_Error_Result_Infallible_Error = { f0: t_Result_unit_Error; f1: t_Result_Infallible_Error }

predicate postcondition_from (self: ()) (args: ()) (result: ()) = let self_ = args in result = self_

meta "rewrite_def" predicate postcondition_from

let from_Error (self_: ()) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:from ensures] result = self_} (! return {result}) ]

let from_residual_Result_unit_Error (residual: t_Result_Infallible_Error) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] inv_Result_Infallible_Error residual}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:from_residual ensures] match { f0 = result;
                                                                                                 f1 = residual } with
      | {f0 = Err result'0; f1 = Err'0 residual'0} -> postcondition_from () residual'0 result'0
      | _ -> false
      end}
    (! return {result}) ]

function prefix_chars [@inline:trivial] (pretty: bool) (first: bool) : Seq.seq Char.t = if pretty then
    if first then
      Seq.(++) (Seq.create 3 [|Char.of_int 32;Char.of_int 123;Char.of_int 10|]) (Seq.create 4 [|Char.of_int 32;Char.of_int 32;Char.of_int 32;Char.of_int 32|])
    else
      Seq.create 4 [|Char.of_int 32;Char.of_int 32;Char.of_int 32;Char.of_int 32|]
  
  else
    if first then
      Seq.create 3 [|Char.of_int 32;Char.of_int 123;Char.of_int 32|]
    else
      Seq.create 2 [|Char.of_int 44;Char.of_int 32|]
  


meta "rewrite_def" function prefix_chars

function field_chars [@inline:trivial] (pretty: bool) (first: bool) (name: Seq.seq Char.t) (number: Seq.seq Char.t) : Seq.seq Char.t
 =
  let body = Seq.(++) (Seq.(++) (Seq.(++) (prefix_chars pretty first) name) (Seq.create 2 [|Char.of_int 58;Char.of_int 32|])) number in if pretty then
    Seq.(++) body (Seq.create 2 [|Char.of_int 44;Char.of_int 10|])
  else
    body


meta "rewrite_def" function field_chars

function digit_char (d: int) : Char.t = if d = 0 then
    Char.of_int 48
  else
    if d = 1 then
      Char.of_int 49
    else
      if d = 2 then
        Char.of_int 50
      else
        if d = 3 then
          Char.of_int 51
        else
          if d = 4 then
            Char.of_int 52
          else
            if d = 5 then
              Char.of_int 53
            else
              if d = 6 then
                Char.of_int 54
              else
                if d = 7 then Char.of_int 55 else if d = 8 then Char.of_int 56 else Char.of_int 57
            
          
        
      
    
  


function decimal_chars (v: int) : Seq.seq Char.t = if v < 10 then
    Seq.create 1 [|digit_char v|]
  else
    if v < 100 then
      Seq.create 2 [|digit_char (ComputerDivision.div v 10);digit_char (ComputerDivision.mod v 10)|]
    else
      if v < 1000 then
        Seq.create 3 [|digit_char (ComputerDivision.div v 100);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
      else
        if v < 10000 then
          Seq.create 4 [|digit_char (ComputerDivision.div v 1000);digit_char (ComputerDivision.mod (ComputerDivision.div v 100) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
        else
          Seq.create 5 [|digit_char (ComputerDivision.div v 10000);digit_char (ComputerDivision.mod (ComputerDivision.div v 1000) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 100) 10);digit_char (ComputerDivision.mod (ComputerDivision.div v 10) 10);digit_char (ComputerDivision.mod v 10)|]
      
    
  


type t_HttpDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

let write_field_u8 (f: MutBorrow.t t_Formatter) (pretty: bool) (first: bool) (name: Slice64.slice UInt8.t)
  (value: UInt8.t) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_field_u8 requires] ([@stop_split] [@expl:write_field_u8 'f' type invariant] inv_refmut_Formatter f)
  /\ ([@stop_split] [@expl:write_field_u8 requires #0] plain_options (debug_options f.current))
  /\ ([@stop_split] [@expl:write_field_u8 requires #1] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view name)
    -> UInt8.t'int (Seq.get (Slice64.view name) i) < 128
    /\ Char.to_int (literal_char (Seq.get (Slice64.view name) i)) = UInt8.t'int (Seq.get (Slice64.view name) i))}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_field_u8 ensures] match result with
      | Ok () -> debug_options f.final = debug_options f.current
      /\ (append_sink f.current
      -> append_sink f.final
      /\ formatter_output f.final
      = Seq.(++) (formatter_output f.current) (field_chars pretty first (ascii_chars (Slice64.view name)) (decimal_chars (UInt8.t'int value))))
      | Err _ -> true
      end}
    (! return {result}) ]

let write_field_u16 (f: MutBorrow.t t_Formatter) (pretty: bool) (first: bool) (name: Slice64.slice UInt8.t)
  (value: UInt16.t) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_field_u16 requires] ([@stop_split] [@expl:write_field_u16 'f' type invariant] inv_refmut_Formatter f)
  /\ ([@stop_split] [@expl:write_field_u16 requires #0] plain_options (debug_options f.current))
  /\ ([@stop_split] [@expl:write_field_u16 requires #1] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view name)
    -> UInt8.t'int (Seq.get (Slice64.view name) i) < 128
    /\ Char.to_int (literal_char (Seq.get (Slice64.view name) i)) = UInt8.t'int (Seq.get (Slice64.view name) i))}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_field_u16 ensures] match result with
      | Ok () -> debug_options f.final = debug_options f.current
      /\ (append_sink f.current
      -> append_sink f.final
      /\ formatter_output f.final
      = Seq.(++) (formatter_output f.current) (field_chars pretty first (ascii_chars (Slice64.view name)) (decimal_chars (UInt16.t'int value))))
      | Err _ -> true
      end}
    (! return {result}) ]

