                      Char.of_int 116
                    else
                      if b = (112: UInt8.t) then
                        Char.of_int 112
                      else
                        if b = (68: UInt8.t) then
                          Char.of_int 68
                        else
                          if b = (97: UInt8.t) then
                            Char.of_int 97
                          else
                            if b = (101: UInt8.t) then
                              Char.of_int 101
