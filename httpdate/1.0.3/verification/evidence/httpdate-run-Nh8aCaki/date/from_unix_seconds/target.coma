function leap_adjustment [@inline:trivial] (year: int) : int = if ComputerDivision.mod year 4 = 0
  /\ (ComputerDivision.mod year 100 <> 0 \/ ComputerDivision.mod year 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function march_start [@inline:trivial] (year: int) : int = (year - 1970) * 365 + 59 + ComputerDivision.div year 4
      - ComputerDivision.div year 100
    + ComputerDivision.div year 400
  - 477

meta "rewrite_def" function march_start

function january_start [@inline:trivial] (year: int) : int = (year - 1970) * 365 + ComputerDivision.div (year - 1969) 4
    - ComputerDivision.div (year - 1901) 100
  + ComputerDivision.div (year - 1601) 400

meta "rewrite_def" function january_start

type t_Iter_i64

predicate inv_Iter_i64 (_1: t_Iter_i64)

function view_Iter_i64 (self: t_Iter_i64) : Slice64.slice Int64.t

let iter_i64 (self_: Slice64.slice Int64.t) (return (x: t_Iter_i64)) = any
  [ return (result: t_Iter_i64) ->
  {[@stop_split] [@expl:iter_i64 ensures] ([@stop_split] [@expl:iter result type invariant] inv_Iter_i64 result)
    /\ ([@stop_split] [@expl:iter ensures] view_Iter_i64 result = self_)}
    (! return {result}) ]

let into_iter_Iter_i64 (self_: t_Iter_i64) (return (x: t_Iter_i64)) =
{[@stop_split] [@expl:into_iter 'self_' type invariant] inv_Iter_i64 self_}
  any
  [ return (result: t_Iter_i64) ->
  {[@stop_split] [@expl:into_iter_Iter_i64 ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_Iter_i64 result)
    /\ ([@stop_split] [@expl:into_iter ensures] result = self_)}
    (! return {result}) ]

type t_Option_ref_i64 = None | Some Int64.t

predicate invariant_refmut_Iter_i64 [@inline:trivial] (self: MutBorrow.t t_Iter_i64) =
  inv_Iter_i64 self.current /\ inv_Iter_i64 self.final

meta "rewrite_def" predicate invariant_refmut_Iter_i64

predicate inv_refmut_Iter_i64 [@inline:trivial] (_1: MutBorrow.t t_Iter_i64) = invariant_refmut_Iter_i64 _1

meta "rewrite_def" predicate inv_refmut_Iter_i64

function index_slice_i64 [@inline:trivial] (self: Slice64.slice Int64.t) (ix: int) : Int64.t =
  Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_i64

function to_ref_seq_slice_i64 (self: Slice64.slice Int64.t) : Seq.seq Int64.t

axiom to_ref_seq_slice_i64_spec:
  forall self: Slice64.slice Int64.t [to_ref_seq_slice_i64 self]. Seq.length (to_ref_seq_slice_i64 self)
    = Seq.length (Slice64.view self)

axiom to_ref_seq_slice_i64_spec'0: forall self: Slice64.slice Int64.t [to_ref_seq_slice_i64 self]. forall i: int. 0 <= i
        /\ i < Seq.length (to_ref_seq_slice_i64 self) -> Seq.get (to_ref_seq_slice_i64 self) i = index_slice_i64 self i

predicate produces_Iter_i64 (self: t_Iter_i64) (visited: Seq.seq Int64.t) (tl: t_Iter_i64) =
  to_ref_seq_slice_i64 (view_Iter_i64 self) = Seq.(++) visited (to_ref_seq_slice_i64 (view_Iter_i64 tl))

function produces_trans_Iter_i64 (a: t_Iter_i64) (ab: Seq.seq Int64.t) (b: t_Iter_i64) (bc: Seq.seq Int64.t) (c: t_Iter_i64) : ()

axiom produces_trans_Iter_i64_spec:
  forall a: t_Iter_i64, ab: Seq.seq Int64.t, b: t_Iter_i64, bc: Seq.seq Int64.t, c: t_Iter_i64. produces_Iter_i64 a ab b
    -> produces_Iter_i64 b bc c -> produces_Iter_i64 a (Seq.(++) ab bc) c

function produces_refl_Iter_i64 (self: t_Iter_i64) : ()

axiom produces_refl_Iter_i64_spec: forall self: t_Iter_i64. produces_Iter_i64 self (Seq.empty: Seq.seq Int64.t) self

predicate resolve_refmut_Iter_i64 [@inline:trivial] (_1: MutBorrow.t t_Iter_i64) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Iter_i64

predicate completed_Iter_i64 (self: MutBorrow.t t_Iter_i64) =
  resolve_refmut_Iter_i64 self /\ Slice64.view (view_Iter_i64 self.current) = (Seq.empty: Seq.seq Int64.t)

let next_Iter_i64 (self_: MutBorrow.t t_Iter_i64) (return (x: t_Option_ref_i64)) =
{[@stop_split] [@expl:next 'self_' type invariant] inv_refmut_Iter_i64 self_}
  any
  [ return (result: t_Option_ref_i64) -> {[@stop_split] [@expl:next ensures] match result with
      | None -> completed_Iter_i64 self_
      | Some v -> produces_Iter_i64 self_.current (Seq.singleton v) self_.final
      end}
    (! return {result}) ]

function march_prefix [@inline:trivial] (index: int) : int = if index = 0 then
    0
  else
    if index = 1 then
      31
    else
      if index = 2 then
        61
      else
        if index = 3 then
          92
        else
          if index = 4 then
            122
          else
            if index = 5 then
              153
            else
              if index = 6 then
                184
              else
                if index = 7 then
                  214
                else
                  if index = 8 then
                    245
                  else
                    if index = 9 then 275 else if index = 10 then 306 else if index = 11 then 337 else 366
                
              
            
          
        
      
    
  


meta "rewrite_def" function march_prefix

predicate inv_Seq_ref_i64 [@inline:trivial] (_1: Seq.seq Int64.t) = true

meta "rewrite_def" predicate inv_Seq_ref_i64

let elim_Some (_x: t_Option_ref_i64) (return (f0'0: Int64.t)) = any
  [ _k (f0'0: Int64.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate resolve_Iter_i64 (_1: t_Iter_i64)

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function month_length [@inline:trivial] (year: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year)
        + january_offset (UInt8.t'int d.mon)
      + UInt8.t'int d.day
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon) 2 then leap_adjustment (UInt16.t'int d.year) else 0)

meta "rewrite_def" function gregorian_day

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

