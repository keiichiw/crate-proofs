use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt16
use int.Int

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function rfc850_weekday (s: Seq.seq UInt8.t) : int = if ge_log_Int (Seq.length s) 8
  /\ Seq.get s 0 = (77: UInt8.t)
  /\ Seq.get s 1 = (111: UInt8.t)
  /\ Seq.get s 2 = (110: UInt8.t)
  /\ Seq.get s 3 = (100: UInt8.t)
  /\ Seq.get s 4 = (97: UInt8.t)
  /\ Seq.get s 5 = (121: UInt8.t) /\ Seq.get s 6 = (44: UInt8.t) /\ Seq.get s 7 = (32: UInt8.t) then
    1
  else
    if ge_log_Int (Seq.length s) 9
    /\ Seq.get s 0 = (84: UInt8.t)
    /\ Seq.get s 1 = (117: UInt8.t)
    /\ Seq.get s 2 = (101: UInt8.t)
    /\ Seq.get s 3 = (115: UInt8.t)
    /\ Seq.get s 4 = (100: UInt8.t)
    /\ Seq.get s 5 = (97: UInt8.t)
    /\ Seq.get s 6 = (121: UInt8.t) /\ Seq.get s 7 = (44: UInt8.t) /\ Seq.get s 8 = (32: UInt8.t) then
      2
    else
      if ge_log_Int (Seq.length s) 11
      /\ Seq.get s 0 = (87: UInt8.t)
      /\ Seq.get s 1 = (101: UInt8.t)
      /\ Seq.get s 2 = (100: UInt8.t)
      /\ Seq.get s 3 = (110: UInt8.t)
      /\ Seq.get s 4 = (101: UInt8.t)
      /\ Seq.get s 5 = (115: UInt8.t)
      /\ Seq.get s 6 = (100: UInt8.t)
      /\ Seq.get s 7 = (97: UInt8.t)
      /\ Seq.get s 8 = (121: UInt8.t) /\ Seq.get s 9 = (44: UInt8.t) /\ Seq.get s 10 = (32: UInt8.t) then
        3
      else
        if ge_log_Int (Seq.length s) 10
        /\ Seq.get s 0 = (84: UInt8.t)
        /\ Seq.get s 1 = (104: UInt8.t)
        /\ Seq.get s 2 = (117: UInt8.t)
        /\ Seq.get s 3 = (114: UInt8.t)
        /\ Seq.get s 4 = (115: UInt8.t)
        /\ Seq.get s 5 = (100: UInt8.t)
        /\ Seq.get s 6 = (97: UInt8.t)
        /\ Seq.get s 7 = (121: UInt8.t) /\ Seq.get s 8 = (44: UInt8.t) /\ Seq.get s 9 = (32: UInt8.t) then
          4
        else
          if ge_log_Int (Seq.length s) 8
          /\ Seq.get s 0 = (70: UInt8.t)
          /\ Seq.get s 1 = (114: UInt8.t)
          /\ Seq.get s 2 = (105: UInt8.t)
          /\ Seq.get s 3 = (100: UInt8.t)
          /\ Seq.get s 4 = (97: UInt8.t)
          /\ Seq.get s 5 = (121: UInt8.t) /\ Seq.get s 6 = (44: UInt8.t) /\ Seq.get s 7 = (32: UInt8.t) then
            5
          else
            if ge_log_Int (Seq.length s) 10
            /\ Seq.get s 0 = (83: UInt8.t)
            /\ Seq.get s 1 = (97: UInt8.t)
            /\ Seq.get s 2 = (116: UInt8.t)
            /\ Seq.get s 3 = (117: UInt8.t)
            /\ Seq.get s 4 = (114: UInt8.t)
            /\ Seq.get s 5 = (100: UInt8.t)
            /\ Seq.get s 6 = (97: UInt8.t)
            /\ Seq.get s 7 = (121: UInt8.t) /\ Seq.get s 8 = (44: UInt8.t) /\ Seq.get s 9 = (32: UInt8.t) then
              6
            else
              if ge_log_Int (Seq.length s) 8
              /\ Seq.get s 0 = (83: UInt8.t)
              /\ Seq.get s 1 = (117: UInt8.t)
              /\ Seq.get s 2 = (110: UInt8.t)
              /\ Seq.get s 3 = (100: UInt8.t)
              /\ Seq.get s 4 = (97: UInt8.t)
              /\ Seq.get s 5 = (121: UInt8.t) /\ Seq.get s 6 = (44: UInt8.t) /\ Seq.get s 7 = (32: UInt8.t) then
                7
              else
                0
            
          
        
      
    
  


function rfc850_prefix_len (s: Seq.seq UInt8.t) : int = if rfc850_weekday s = 1
  \/ rfc850_weekday s = 5 \/ rfc850_weekday s = 7 then
    8
  else
    if rfc850_weekday s = 2 then
      9
    else
      if rfc850_weekday s = 3 then 11 else if rfc850_weekday s = 4 \/ rfc850_weekday s = 6 then 10 else 0
  


function rfc850_suffix (s: Seq.seq UInt8.t) : Seq.seq UInt8.t = Seq.([..]) s (rfc850_prefix_len s) (Seq.length s)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function rfc850_month [@inline:trivial] (s: Seq.seq UInt8.t) : int = if Seq.length s <> 22
  \/ Seq.get s 2 <> (45: UInt8.t) \/ Seq.get s 6 <> (45: UInt8.t) then
    0
  else
    if Seq.get s 3 = (74: UInt8.t) /\ Seq.get s 4 = (97: UInt8.t) /\ Seq.get s 5 = (110: UInt8.t) then
      1
    else
      if Seq.get s 3 = (70: UInt8.t) /\ Seq.get s 4 = (101: UInt8.t) /\ Seq.get s 5 = (98: UInt8.t) then
        2
      else
        if Seq.get s 3 = (77: UInt8.t) /\ Seq.get s 4 = (97: UInt8.t) /\ Seq.get s 5 = (114: UInt8.t) then
          3
        else
          if Seq.get s 3 = (65: UInt8.t) /\ Seq.get s 4 = (112: UInt8.t) /\ Seq.get s 5 = (114: UInt8.t) then
            4
          else
            if Seq.get s 3 = (77: UInt8.t) /\ Seq.get s 4 = (97: UInt8.t) /\ Seq.get s 5 = (121: UInt8.t) then
              5
            else
              if Seq.get s 3 = (74: UInt8.t) /\ Seq.get s 4 = (117: UInt8.t) /\ Seq.get s 5 = (110: UInt8.t) then
                6
              else
                if Seq.get s 3 = (74: UInt8.t) /\ Seq.get s 4 = (117: UInt8.t) /\ Seq.get s 5 = (108: UInt8.t) then
                  7
                else
                  if Seq.get s 3 = (65: UInt8.t) /\ Seq.get s 4 = (117: UInt8.t) /\ Seq.get s 5 = (103: UInt8.t) then
                    8
                  else
                    if Seq.get s 3 = (83: UInt8.t) /\ Seq.get s 4 = (101: UInt8.t) /\ Seq.get s 5 = (112: UInt8.t) then
                      9
                    else
                      if Seq.get s 3 = (79: UInt8.t) /\ Seq.get s 4 = (99: UInt8.t) /\ Seq.get s 5 = (116: UInt8.t) then
                        10
                      else
                        if Seq.get s 3 = (78: UInt8.t)
                        /\ Seq.get s 4 = (111: UInt8.t) /\ Seq.get s 5 = (118: UInt8.t) then
                          11
                        else
                          if Seq.get s 3 = (68: UInt8.t)
                          /\ Seq.get s 4 = (101: UInt8.t) /\ Seq.get s 5 = (99: UInt8.t) then
                            12
                          else
                            0
                        
                      
                    
                  
                
              
            
          
        
      
    
  


meta "rewrite_def" function rfc850_month

predicate rfc850_digit [@inline:trivial] (b: UInt8.t) = 48 <= UInt8.t'int b /\ UInt8.t'int b <= 57

meta "rewrite_def" predicate rfc850_digit

predicate rfc850_digit_at [@inline:trivial] (s: Seq.seq UInt8.t) (index: int) =
  if index < 0 \/ ge_log_Int index (Seq.length s) then false else rfc850_digit (Seq.get s index)

meta "rewrite_def" predicate rfc850_digit_at

predicate rfc850_syntax [@inline:trivial] (s: Seq.seq UInt8.t) =
  let suffix = rfc850_suffix s in ge_log_Int (Seq.length s) 23
  /\ gt_log_Int (rfc850_weekday s) 0
  /\ Seq.length suffix = 22
  /\ gt_log_Int (rfc850_month suffix) 0
  /\ rfc850_digit_at suffix 0
  /\ rfc850_digit_at suffix 1
  /\ rfc850_digit_at suffix 7
  /\ rfc850_digit_at suffix 8
  /\ rfc850_digit_at suffix 10
  /\ rfc850_digit_at suffix 11
  /\ rfc850_digit_at suffix 13
  /\ rfc850_digit_at suffix 14
  /\ rfc850_digit_at suffix 16
  /\ rfc850_digit_at suffix 17
  /\ Seq.get suffix 12 = (58: UInt8.t)
  /\ Seq.get suffix 15 = (58: UInt8.t)
  /\ Seq.get suffix 18 = (32: UInt8.t)
  /\ Seq.get suffix 19 = (71: UInt8.t) /\ Seq.get suffix 20 = (77: UInt8.t) /\ Seq.get suffix 21 = (84: UInt8.t)

meta "rewrite_def" predicate rfc850_syntax

function rfc850_two_digits [@inline:trivial] (s: Seq.seq UInt8.t) (index: int) : int = if index < 0
  \/ ge_log_Int (index + 1) (Seq.length s) then
    0
  else
    (UInt8.t'int (Seq.get s index) - 48) * 10 + UInt8.t'int (Seq.get s (index + 1)) - 48


meta "rewrite_def" function rfc850_two_digits

predicate rfc850_encoding [@inline:trivial] (s: Seq.seq UInt8.t) (d: t_RawDate) =
  let suffix = rfc850_suffix s in rfc850_syntax s
  /\ rfc850_weekday s = UInt8.t'int d.wday
  /\ rfc850_month suffix = UInt8.t'int d.mon
  /\ rfc850_two_digits suffix 0 = UInt8.t'int d.day
  /\ (if rfc850_two_digits suffix 7 < 70 then rfc850_two_digits suffix 7 + 2000 else rfc850_two_digits suffix 7 + 1900)
    = UInt16.t'int d.year
  /\ rfc850_two_digits suffix 10 = UInt8.t'int d.hour
  /\ rfc850_two_digits suffix 13 = UInt8.t'int d.min /\ rfc850_two_digits suffix 16 = UInt8.t'int d.sec

meta "rewrite_def" predicate rfc850_encoding

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

function encoding_laws (s: Seq.seq UInt8.t) : ()

goal vc_encoding_laws:
  [@stop_split] [@expl:encoding_laws ensures] ([@stop_split] [@expl:encoding_laws ensures #0] forall d: t_RawDate. rfc850_encoding s d
      -> 30 <= Seq.length s /\ Seq.length s <= 33)
  /\ ([@stop_split] [@expl:encoding_laws ensures #1] forall a: t_RawDate, b: t_RawDate. rfc850_encoding s a
      /\ rfc850_encoding s b -> a = b)
