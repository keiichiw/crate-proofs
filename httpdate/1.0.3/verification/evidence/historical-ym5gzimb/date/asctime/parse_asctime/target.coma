  [ return (result: t_Result_RawDate_Error) -> {[@stop_split] [@expl:parse_asctime ensures] match result with
      | Ok d -> asctime_encoding (Slice64.view s) d
      /\ UInt8.t'int d.sec < 100
      /\ UInt8.t'int d.min < 100
      /\ UInt8.t'int d.hour < 100
      /\ UInt8.t'int d.day < 100
      /\ 1 <= UInt8.t'int d.mon
      /\ UInt8.t'int d.mon <= 12 /\ UInt16.t'int d.year < 10000 /\ 1 <= UInt8.t'int d.wday /\ UInt8.t'int d.wday <= 7
      | Err _ -> not asctime_syntax (Slice64.view s) /\ (forall d: t_RawDate. not asctime_encoding (Slice64.view s) d)
      end}
    (! return {result}) ]
