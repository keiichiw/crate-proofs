    | s5 = [ &_8 <- _9 <> (32: UInt8.t) ] s6
    | s6 = any [ br0 -> {_8 = false} (! bb6) | br1 -> {_8} (! bb15) ] ]
  | bb6 = s0
    [ s0 = [ &_15 <- (13: UInt64.t) ] s1
    | s1 = [ &_16 <- Slice64.length s ] s2
    | s2 = [ &_17 <- UInt64.lt _15 _16 ] s3
    | s3 = {[@expl:index in bounds] _17} s4
    | s4 = Slice64.get <UInt8.t> {s} {_15} (fun (r: UInt8.t) -> [ &_14 <- r ] s5)
    | s5 = [ &_13 <- _14 <> (58: UInt8.t) ] s6
    | s6 = any [ br0 -> {_13 = false} (! bb9) | br1 -> {_13} (! bb15) ] ]
  | bb9 = s0
    [ s0 = [ &_20 <- (16: UInt64.t) ] s1
    | s1 = [ &_21 <- Slice64.length s ] s2
    | s2 = [ &_22 <- UInt64.lt _20 _21 ] s3
    | s3 = {[@expl:index in bounds] _22} s4
    | s4 = Slice64.get <UInt8.t> {s} {_20} (fun (r: UInt8.t) -> [ &_19 <- r ] s5)
    | s5 = [ &_18 <- _19 <> (58: UInt8.t) ] s6
    | s6 = any [ br0 -> {_18 = false} (! bb12) | br1 -> {_18} (! bb15) ] ]
  | bb12 = s0
    [ s0 = [ &_25 <- (19: UInt64.t) ] s1
    | s1 = [ &_26 <- Slice64.length s ] s2
    | s2 = [ &_27 <- UInt64.lt _25 _26 ] s3
    | s3 = {[@expl:index in bounds] _27} s4
    | s4 = Slice64.get <UInt8.t> {s} {_25} (fun (r: UInt8.t) -> [ &_24 <- r ] s5)
    | s5 = [ &_23 <- _24 <> (32: UInt8.t) ] s6
    | s6 = any [ br0 -> {_23 = false} (! bb16) | br1 -> {_23} (! bb15) ] ]
  | bb15 = s0 [ s0 = [ &_29 <- { f0 = _30 } ] s1 | s1 = [ &_ret <- Err _29 ] s2 | s2 = return {_ret} ]
  | bb16 = s0
    [ s0 = [ &_39 <- { start = (17: UInt64.t); end' = (19: UInt64.t) } ] s1
    | s1 = index_slice_u8 {s} {_39} (fun (_x: Slice64.slice UInt8.t) -> [ &_37 <- _x ] s2)
    | s2 = [ &_36 <- _37 ] s3
    | s3 = toint_2 {_36} (fun (_x: t_Result_u8_Error) -> [ &_34 <- _x ] s4)
    | s4 = branch_Result_u8_Error {_34} (fun (_x: t_ControlFlow_Result_Infallible_Error_u8) -> [ &_33 <- _x ] s5)
    | s5 = any
      [ br0 (x0: UInt8.t) -> {_33 = Continue x0} (! bb22)
      | br1 (x0: t_Result_Infallible_Error) -> {_33 = Break x0} (! bb23) ] ]
  | bb23 = s0
    [ s0 = elim_Break {_33} (fun (r0: t_Result_Infallible_Error) -> [ &residual <- r0 ] s1)
    | s1 = from_residual_Result_RawDate_Error {residual} (fun (_x: t_Result_RawDate_Error) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ]
  | bb22 = s0
    [ s0 = elim_Continue {_33} (fun (r0: UInt8.t) -> [ &val' <- r0 ] s1)
