(* <date::HttpDate as std::convert::From<std::time::SystemTime>> *)

use creusot.int.UInt64
use int.ComputerDivision
use creusot.int.UInt8
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

type t_SystemTime

predicate inv_SystemTime (_1: t_SystemTime)

function time_ns (_t: t_SystemTime) : int

constant const_UNIX_EPOCH : t_SystemTime

axiom const_UNIX_EPOCH_spec: inv_SystemTime const_UNIX_EPOCH

axiom const_UNIX_EPOCH_spec'0: time_ns const_UNIX_EPOCH = 0

type t_Duration

type t_SystemTimeError

type t_Result_Duration_SystemTimeError = Ok t_Duration | Err t_SystemTimeError

predicate invariant_ref_SystemTime [@inline:trivial] (self: t_SystemTime) = inv_SystemTime self

meta "rewrite_def" predicate invariant_ref_SystemTime

predicate inv_ref_SystemTime [@inline:trivial] (_1: t_SystemTime) = invariant_ref_SystemTime _1

meta "rewrite_def" predicate inv_ref_SystemTime

predicate inv_Duration (_1: t_Duration)

predicate inv_SystemTimeError (_1: t_SystemTimeError)

predicate inv_Result_Duration_SystemTimeError (_1: t_Result_Duration_SystemTimeError)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_Duration_SystemTimeError [inv_Result_Duration_SystemTimeError x]. inv_Result_Duration_SystemTimeError x
    = match x with
      | Ok f0 -> inv_Duration f0
      | Err f0 -> inv_SystemTimeError f0
      end

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function secs_to_nanos (secs: int) : int = secs * 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration [view_Duration self]. ge_log_Int (view_Duration self) 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

let duration_since (self_: t_SystemTime) (earlier: t_SystemTime) (return (x: t_Result_Duration_SystemTimeError)) =
{[@stop_split] [@expl:duration_since requires] ([@stop_split] [@expl:duration_since 'self_' type invariant] inv_ref_SystemTime self_)
  /\ ([@stop_split] [@expl:duration_since 'earlier' type invariant] inv_SystemTime earlier)
  /\ ([@stop_split] [@expl:duration_since requires] - 18446744073709551615999999999 <= time_ns self_ - time_ns earlier
  /\ time_ns self_ - time_ns earlier <= 18446744073709551615999999999)}
  any
  [ return (result: t_Result_Duration_SystemTimeError) ->
  {[@stop_split] [@expl:duration_since ensures] ([@stop_split] [@expl:duration_since result type invariant] inv_Result_Duration_SystemTimeError result)
    /\ ([@stop_split] [@expl:duration_since ensures] match result with
      | Ok d -> ge_log_Int (time_ns self_) (time_ns earlier) /\ view_Duration d = time_ns self_ - time_ns earlier
      | Err _ -> time_ns self_ < time_ns earlier
      end)}
    (! return {result}) ]

let expect_Duration (self_: t_Result_Duration_SystemTimeError) (msg: string) (return (x: t_Duration)) =
{[@stop_split] [@expl:expect_Duration requires] ([@stop_split] [@expl:expect 'self_' type invariant] inv_Result_Duration_SystemTimeError self_)
  /\ ([@stop_split] [@expl:expect requires] exists t: t_Duration. self_ = Ok t)}
  any
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:expect_Duration ensures] ([@stop_split] [@expl:expect result type invariant] inv_Duration result)
    /\ ([@stop_split] [@expl:expect ensures] Ok result = self_)}
    (! return {result}) ]

predicate invariant_ref_Duration [@inline:trivial] (self: t_Duration) = inv_Duration self

meta "rewrite_def" predicate invariant_ref_Duration

predicate inv_ref_Duration [@inline:trivial] (_1: t_Duration) = invariant_ref_Duration _1

meta "rewrite_def" predicate inv_ref_Duration

function nanos_to_secs (nanos: int) : int = ComputerDivision.div nanos 1000000000

let as_secs (self_: t_Duration) (return (x: UInt64.t)) =
{[@stop_split] [@expl:as_secs 'self_' type invariant] inv_ref_Duration self_}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:as_secs ensures] UInt64.t'int result
    = nanos_to_secs (view_Duration self_)}
    (! return {result}) ]

type t_Arguments

predicate inv_Arguments (_1: t_Arguments)

let from_str (s: string) (return (x: t_Arguments)) = any
  [ return (result: t_Arguments) -> {[@stop_split] [@expl:from_str result type invariant] inv_Arguments result}
    (! return {result}) ]

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

function january_start [@inline:trivial] (year'0: int) : int = (year'0 - 1970) * 365
      + ComputerDivision.div (year'0 - 1969) 4
    - ComputerDivision.div (year'0 - 1901) 100
  + ComputerDivision.div (year'0 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function leap_adjustment [@inline:trivial] (year'0: int) : int = if ComputerDivision.mod year'0 4 = 0
  /\ (ComputerDivision.mod year'0 100 <> 0 \/ ComputerDivision.mod year'0 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year)
        + january_offset (UInt8.t'int d.mon)
      + UInt8.t'int d.day
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon) 2 then leap_adjustment (UInt16.t'int d.year) else 0)

meta "rewrite_def" function gregorian_day

function month_length [@inline:trivial] (year'0: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'0
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

let from_unix_seconds (secs_since_epoch: UInt64.t) (return (x: t_RawDate)) =
{[@stop_split] [@expl:from_unix_seconds requires] UInt64.t'int secs_since_epoch < 253402300800}
  any
  [ return (result: t_RawDate) ->
  {[@stop_split] [@expl:from_unix_seconds ensures] ([@stop_split] [@expl:from_unix_seconds ensures #0] UInt8.t'int result.sec
        < 60
      /\ UInt8.t'int result.min < 60
      /\ UInt8.t'int result.hour < 24
      /\ 1 <= UInt8.t'int result.day
      /\ UInt8.t'int result.day <= 31
      /\ 1 <= UInt8.t'int result.mon
      /\ UInt8.t'int result.mon <= 12
      /\ 1970 <= UInt16.t'int result.year
      /\ UInt16.t'int result.year <= 9999 /\ 1 <= UInt8.t'int result.wday /\ UInt8.t'int result.wday <= 7)
    /\ ([@stop_split] [@expl:from_unix_seconds ensures #1] gregorian_day result
      = ComputerDivision.div (UInt64.t'int secs_since_epoch) 86400)
    /\ ([@stop_split] [@expl:from_unix_seconds ensures #2] UInt8.t'int result.sec + UInt8.t'int result.min * 60
        + UInt8.t'int result.hour * 3600
      = ComputerDivision.mod (UInt64.t'int secs_since_epoch) 86400)
    /\ ([@stop_split] [@expl:from_unix_seconds ensures #3] UInt8.t'int result.day
      <= month_length (UInt16.t'int result.year) (UInt8.t'int result.mon))
    /\ ([@stop_split] [@expl:from_unix_seconds ensures #4] UInt8.t'int result.wday
    = ComputerDivision.mod (ComputerDivision.div (UInt64.t'int secs_since_epoch) 86400 + 3) 7 + 1)}
    (! return {result}) ]

type t_HttpDate = {
  sec'0: UInt8.t;
  min'0: UInt8.t;
  hour'0: UInt8.t;
  day'0: UInt8.t;
  mon'0: UInt8.t;
  year'0: UInt16.t;
  wday'0: UInt8.t }

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec < 60
  /\ UInt8.t'int d.min < 60
  /\ UInt8.t'int d.hour < 24
  /\ 1970 <= UInt16.t'int d.year
  /\ UInt16.t'int d.year <= 9999
  /\ 1 <= UInt8.t'int d.mon
  /\ UInt8.t'int d.mon <= 12
  /\ 1 <= UInt8.t'int d.day
  /\ UInt8.t'int d.day <= month_length (UInt16.t'int d.year) (UInt8.t'int d.mon)
  /\ UInt8.t'int d.wday = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function raw_model [@inline:trivial] (self: t_HttpDate) : t_RawDate = { sec = self.sec'0;
                                                                        min = self.min'0;
                                                                        hour = self.hour'0;
                                                                        day = self.day'0;
                                                                        mon = self.mon'0;
                                                                        year = self.year'0;
                                                                        wday = self.wday'0 }

meta "rewrite_def" function raw_model

predicate invariant_HttpDate (self: t_HttpDate) = valid_calendar (raw_model self)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom'0 [@rewrite]: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x = invariant_HttpDate x

let from_raw (d: t_RawDate) (return (x: t_HttpDate)) = {[@stop_split] [@expl:from_raw requires] valid_calendar d}
  any
  [ return (result: t_HttpDate) ->
  {[@stop_split] [@expl:from_raw ensures] ([@stop_split] [@expl:from_raw result type invariant] inv_HttpDate result)
    /\ ([@stop_split] [@expl:from_raw ensures] raw_model result = d)}
    (! return {result}) ]

function unix_seconds_model [@inline:trivial] (d: t_RawDate) : int = gregorian_day d * 86400 + UInt8.t'int d.hour * 3600
    + UInt8.t'int d.min * 60
  + UInt8.t'int d.sec

meta "rewrite_def" function unix_seconds_model

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let from_HttpDate (v: t_SystemTime) (return (x: t_HttpDate)) =
{[@stop_split] [@expl:from_HttpDate requires] ([@stop_split] [@expl:from 'v' type invariant] inv_SystemTime v)
  /\ ([@stop_split] [@expl:from requires] 0 <= time_ns v /\ time_ns v < 253402300800000000000)}
  (! bb0
  [ bb0 = s0
    [ s0 = duration_since {v} {const_UNIX_EPOCH} (fun (_x: t_Result_Duration_SystemTimeError) -> [ &_8 <- _x ] s1)
    | s1 = [ &_11 <- "all times should be after the epoch" ] s2
    | s2 = expect_Duration {_8} {_11} (fun (_x: t_Duration) -> [ &dur <- _x ] s3)
    | s3 = as_secs {dur} (fun (_x: UInt64.t) -> [ &secs_since_epoch <- _x ] s4)
    | s4 = [ &_15 <- UInt64.ge secs_since_epoch (253402300800: UInt64.t) ] s5
    | s5 = any [ br0 -> {_15 = false} (! bb6) | br1 -> {_15} (! bb4) ] ]
  | bb4 = s0
    [ s0 = from_str {"date must be before year 9999"} (fun (_x: t_Arguments) -> [ &_20 <- _x ] s1) | s1 = {false} any ]
  | bb6 = s0
    [ s0 = from_unix_seconds {secs_since_epoch} (fun (_x: t_RawDate) -> [ &_21 <- _x ] s1)
    | s1 = from_raw {_21} (fun (_x: t_HttpDate) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: t_HttpDate = Any.any_l ()
  | & v: t_SystemTime = v
  | & dur: t_Duration = Any.any_l ()
  | & _8: t_Result_Duration_SystemTimeError = Any.any_l ()
  | & _11: string = Any.any_l ()
  | & secs_since_epoch: UInt64.t = Any.any_l ()
  | & _15: bool = Any.any_l ()
  | & _20: t_Arguments = Any.any_l ()
  | & _21: t_RawDate = Any.any_l () ])
  [ return (result: t_HttpDate) ->
  {[@stop_split] [@expl:from_HttpDate ensures] ([@stop_split] [@expl:from result type invariant] inv_HttpDate result)
    /\ ([@stop_split] [@expl:from ensures #0] valid_calendar (raw_model result))
    /\ ([@stop_split] [@expl:from ensures #1] unix_seconds_model (raw_model result)
    = ComputerDivision.div (time_ns v) 1000000000)}
    (! return {result}) ]
