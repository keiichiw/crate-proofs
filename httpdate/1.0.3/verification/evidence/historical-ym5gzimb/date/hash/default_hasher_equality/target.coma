use creusot.prelude.MutBorrow
use creusot.int.UInt8
use creusot.int.UInt16
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_DefaultHasher

predicate inv_DefaultHasher (_1: t_DefaultHasher)

predicate supported_hasher_DefaultHasher

function hash_state_DefaultHasher (_h: t_DefaultHasher) : int

let new (return (x: t_DefaultHasher)) = any
  [ return (result: t_DefaultHasher) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] inv_DefaultHasher result)
    /\ ([@stop_split] [@expl:new ensures #0] supported_hasher_DefaultHasher)
    /\ ([@stop_split] [@expl:new ensures #1] hash_state_DefaultHasher result = 0)}
    (! return {result}) ]

type t_HttpDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

type t_RawDate = {
  sec'0: UInt8.t;
  min'0: UInt8.t;
  hour'0: UInt8.t;
  day'0: UInt8.t;
  mon'0: UInt8.t;
  year'0: UInt16.t;
  wday'0: UInt8.t }

function leap_adjustment [@inline:trivial] (year'1: int) : int = if ComputerDivision.mod year'1 4 = 0
  /\ (ComputerDivision.mod year'1 100 <> 0 \/ ComputerDivision.mod year'1 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function month_length [@inline:trivial] (year'1: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'1
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

function january_start [@inline:trivial] (year'1: int) : int = (year'1 - 1970) * 365
      + ComputerDivision.div (year'1 - 1969) 4
    - ComputerDivision.div (year'1 - 1901) 100
  + ComputerDivision.div (year'1 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year'0)
        + january_offset (UInt8.t'int d.mon'0)
      + UInt8.t'int d.day'0
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon'0) 2 then leap_adjustment (UInt16.t'int d.year'0) else 0)

meta "rewrite_def" function gregorian_day

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec'0 < 60
  /\ UInt8.t'int d.min'0 < 60
  /\ UInt8.t'int d.hour'0 < 24
  /\ 1970 <= UInt16.t'int d.year'0
  /\ UInt16.t'int d.year'0 <= 9999
  /\ 1 <= UInt8.t'int d.mon'0
  /\ UInt8.t'int d.mon'0 <= 12
  /\ 1 <= UInt8.t'int d.day'0
  /\ UInt8.t'int d.day'0 <= month_length (UInt16.t'int d.year'0) (UInt8.t'int d.mon'0)
  /\ UInt8.t'int d.wday'0 = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function raw_model [@inline:trivial] (self: t_HttpDate) : t_RawDate = { sec'0 = self.sec;
                                                                        min'0 = self.min;
                                                                        hour'0 = self.hour;
                                                                        day'0 = self.day;
                                                                        mon'0 = self.mon;
                                                                        year'0 = self.year;
                                                                        wday'0 = self.wday }

meta "rewrite_def" function raw_model

predicate invariant_HttpDate (self: t_HttpDate) = valid_calendar (raw_model self)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom [@rewrite]: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x = invariant_HttpDate x

predicate invariant_refmut_DefaultHasher [@inline:trivial] (self: MutBorrow.t t_DefaultHasher) =
  inv_DefaultHasher self.current /\ inv_DefaultHasher self.final

meta "rewrite_def" predicate invariant_refmut_DefaultHasher

predicate inv_refmut_DefaultHasher [@inline:trivial] (_1: MutBorrow.t t_DefaultHasher) =
  invariant_refmut_DefaultHasher _1

meta "rewrite_def" predicate inv_refmut_DefaultHasher

function unix_seconds_model [@inline:trivial] (d: t_RawDate) : int = gregorian_day d * 86400
      + UInt8.t'int d.hour'0 * 3600
    + UInt8.t'int d.min'0 * 60
  + UInt8.t'int d.sec'0

meta "rewrite_def" function unix_seconds_model

function deep_model_HttpDate (self: t_HttpDate) : int = unix_seconds_model (raw_model self)

let equal_dates_hash_equally_DefaultHasher (a: t_HttpDate) (b: t_HttpDate) (left: MutBorrow.t t_DefaultHasher)
  (right: MutBorrow.t t_DefaultHasher) (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:equal_dates_hash_equally_DefaultHasher requires] ([@stop_split] [@expl:equal_dates_hash_equally 'a' type invariant] inv_HttpDate a)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'b' type invariant] inv_HttpDate b)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'left' type invariant] inv_refmut_DefaultHasher left)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'right' type invariant] inv_refmut_DefaultHasher right)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #0] supported_hasher_DefaultHasher)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #1] deep_model_HttpDate a = deep_model_HttpDate b)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #2] hash_state_DefaultHasher left.current
  = hash_state_DefaultHasher right.current)}
  any
  [ return (result: tup2_u64_u64) -> {[@stop_split] [@expl:equal_dates_hash_equally ensures] result.f0 = result.f1}
    (! return {result}) ]

predicate resolve_refmut_DefaultHasher [@inline:trivial] (_1: MutBorrow.t t_DefaultHasher) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_DefaultHasher

predicate resolve_DefaultHasher (_1: t_DefaultHasher)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let default_hasher_equality (a: t_HttpDate) (b: t_HttpDate) (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:default_hasher_equality requires] ([@stop_split] [@expl:default_hasher_equality 'a' type invariant] inv_HttpDate a)
  /\ ([@stop_split] [@expl:default_hasher_equality 'b' type invariant] inv_HttpDate b)
  /\ ([@stop_split] [@expl:default_hasher_equality requires] deep_model_HttpDate a = deep_model_HttpDate b)}
  (! bb0
  [ bb0 = s0
    [ s0 = new (fun (_x: t_DefaultHasher) -> [ &left <- _x ] s1)
    | s1 = new (fun (_x: t_DefaultHasher) -> [ &right <- _x ] s2)
    | s2 = MutBorrow.borrow_mut <t_DefaultHasher> {left}
        (fun (_bor: MutBorrow.t t_DefaultHasher) ->
          [ &_12 <- _bor ] -{inv_DefaultHasher _bor.final}-
          [ &left <- _bor.final ] s3) [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher left} any) ]
    | s3 = MutBorrow.borrow_mut <t_DefaultHasher> {right}
        (fun (_bor: MutBorrow.t t_DefaultHasher) ->
          [ &_14 <- _bor ] -{inv_DefaultHasher _bor.final}-
          [ &right <- _bor.final ] s4) [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher right} any) ]
    | s4 = MutBorrow.borrow_final <t_DefaultHasher> {_12.current} {MutBorrow.get_id _12}
        (fun (_bor: MutBorrow.t t_DefaultHasher) ->
          [ &_11 <- _bor ] -{inv_DefaultHasher _bor.final}-
          [ &_12 <- { _12 with current = _bor.final } ] s5)
      [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher _12.current} any) ]
    | s5 = MutBorrow.borrow_final <t_DefaultHasher> {_14.current} {MutBorrow.get_id _14}
        (fun (_bor: MutBorrow.t t_DefaultHasher) ->
          [ &_13 <- _bor ] -{inv_DefaultHasher _bor.final}-
          [ &_14 <- { _14 with current = _bor.final } ] s6)
      [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher _14.current} any) ]
    | s6 = equal_dates_hash_equally_DefaultHasher {a} {b} {_11} {_13} (fun (_x: tup2_u64_u64) -> [ &_ret <- _x ] s7)
    | s7 = s8 [ _ck -> (! {[@expl:type invariant] inv_refmut_DefaultHasher _14} any) ]
    | s8 = -{resolve_refmut_DefaultHasher _14}- s9
    | s9 = s10 [ _ck -> (! {[@expl:type invariant] inv_refmut_DefaultHasher _12} any) ]
    | s10 = -{resolve_refmut_DefaultHasher _12}- s11
    | s11 = s12 [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher right} any) ]
    | s12 = -{resolve_DefaultHasher right}- s13
    | s13 = s14 [ _ck -> (! {[@expl:type invariant] inv_DefaultHasher left} any) ]
    | s14 = -{resolve_DefaultHasher left}- s15
    | s15 = return {_ret} ] ]
  [ & _ret: tup2_u64_u64 = Any.any_l ()
  | & a: t_HttpDate = a
  | & b: t_HttpDate = b
  | & left: t_DefaultHasher = Any.any_l ()
  | & right: t_DefaultHasher = Any.any_l ()
  | & _11: MutBorrow.t t_DefaultHasher = Any.any_l ()
  | & _12: MutBorrow.t t_DefaultHasher = Any.any_l ()
  | & _13: MutBorrow.t t_DefaultHasher = Any.any_l ()
  | & _14: MutBorrow.t t_DefaultHasher = Any.any_l () ])
  [ return (result: tup2_u64_u64) -> {[@stop_split] [@expl:default_hasher_equality ensures] result.f0 = result.f1}
    (! return {result}) ]
