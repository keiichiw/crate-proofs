use creusot.int.UInt8
use creusot.int.UInt16
use int.ComputerDivision
use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_HttpDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

type t_RawDate = {
  sec'0: UInt8.t;
  min'0: UInt8.t;
  hour'0: UInt8.t;
  day'0: UInt8.t;
  mon'0: UInt8.t;
  year'0: UInt16.t;
  wday'0: UInt8.t }

function leap_adjustment [@inline:trivial] (year'1: int) : int = if ComputerDivision.mod year'1 4 = 0
  /\ (ComputerDivision.mod year'1 100 <> 0 \/ ComputerDivision.mod year'1 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function month_length [@inline:trivial] (year'1: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'1
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

function january_start [@inline:trivial] (year'1: int) : int = (year'1 - 1970) * 365
      + ComputerDivision.div (year'1 - 1969) 4
    - ComputerDivision.div (year'1 - 1901) 100
  + ComputerDivision.div (year'1 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year'0)
        + january_offset (UInt8.t'int d.mon'0)
      + UInt8.t'int d.day'0
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon'0) 2 then leap_adjustment (UInt16.t'int d.year'0) else 0)

meta "rewrite_def" function gregorian_day

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec'0 < 60
  /\ UInt8.t'int d.min'0 < 60
  /\ UInt8.t'int d.hour'0 < 24
  /\ 1970 <= UInt16.t'int d.year'0
  /\ UInt16.t'int d.year'0 <= 9999
  /\ 1 <= UInt8.t'int d.mon'0
  /\ UInt8.t'int d.mon'0 <= 12
  /\ 1 <= UInt8.t'int d.day'0
  /\ UInt8.t'int d.day'0 <= month_length (UInt16.t'int d.year'0) (UInt8.t'int d.mon'0)
  /\ UInt8.t'int d.wday'0 = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function raw_model [@inline:trivial] (self: t_HttpDate) : t_RawDate = { sec'0 = self.sec;
                                                                        min'0 = self.min;
                                                                        hour'0 = self.hour;
                                                                        day'0 = self.day;
                                                                        mon'0 = self.mon;
                                                                        year'0 = self.year;
                                                                        wday'0 = self.wday }

meta "rewrite_def" function raw_model

predicate invariant_HttpDate (self: t_HttpDate) = valid_calendar (raw_model self)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom [@rewrite]: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x = invariant_HttpDate x

predicate invariant_ref_HttpDate [@inline:trivial] (self: t_HttpDate) = inv_HttpDate self

meta "rewrite_def" predicate invariant_ref_HttpDate

predicate inv_ref_HttpDate [@inline:trivial] (_1: t_HttpDate) = invariant_ref_HttpDate _1

meta "rewrite_def" predicate inv_ref_HttpDate

let as_raw (self: t_HttpDate) (return (x: t_RawDate)) =
{[@stop_split] [@expl:as_raw 'self' type invariant] inv_ref_HttpDate self}
  any
  [ return (result: t_RawDate) -> {[@stop_split] [@expl:as_raw ensures] result = raw_model self} (! return {result}) ]

function unix_seconds_model [@inline:trivial] (d: t_RawDate) : int = gregorian_day d * 86400
      + UInt8.t'int d.hour'0 * 3600
    + UInt8.t'int d.min'0 * 60
  + UInt8.t'int d.sec'0

meta "rewrite_def" function unix_seconds_model

let valid_datetime_injective (a: t_RawDate) (b: t_RawDate) (return (x: ())) =
{[@stop_split] [@expl:valid_datetime_injective requires] ([@stop_split] [@expl:valid_datetime_injective requires #0] valid_calendar a
    /\ valid_calendar b)
  /\ ([@stop_split] [@expl:valid_datetime_injective requires #1] unix_seconds_model a = unix_seconds_model b)}
  any [ return (result: ()) -> {[@stop_split] [@expl:valid_datetime_injective ensures] a = b} (! return {result}) ]

type t_H

predicate inv_H (_1: t_H)

predicate invariant_refmut_H [@inline:trivial] (self: MutBorrow.t t_H) = inv_H self.current /\ inv_H self.final

meta "rewrite_def" predicate invariant_refmut_H

predicate inv_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = invariant_refmut_H _1

meta "rewrite_def" predicate inv_refmut_H

predicate supported_hasher_H

function hash_state_H (_h: t_H) : int

function hash_step_u8_H (_state: int) (_value: UInt8.t) : int

function hash_step_u16_H (_state: int) (_value: UInt16.t) : int

function date_hash_effect_H [@inline:trivial] (s: int) (d: t_RawDate) : int =
  let s'0 = hash_step_u8_H s d.sec'0 in let s'1 = hash_step_u8_H s'0 d.min'0 in let s'2 = hash_step_u8_H s'1 d.hour'0 in let s'3 = hash_step_u8_H s'2 d.day'0 in let s'4 = hash_step_u8_H s'3 d.mon'0 in let s'5 = hash_step_u16_H s'4 d.year'0 in hash_step_u8_H s'5 d.wday'0

meta "rewrite_def" function date_hash_effect_H

let hash_HttpDate (self: t_HttpDate) (state: MutBorrow.t t_H) (return (x: ())) =
{[@stop_split] [@expl:hash_HttpDate requires] ([@stop_split] [@expl:hash 'self' type invariant] inv_ref_HttpDate self)
  /\ ([@stop_split] [@expl:hash 'state' type invariant] inv_refmut_H state)
  /\ ([@stop_split] [@expl:hash requires] supported_hasher_H)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:hash ensures] hash_state_H state.final
    = date_hash_effect_H (hash_state_H state.current) (raw_model self)}
    (! return {result}) ]

predicate resolve_refmut_H [@inline:trivial] (_1: MutBorrow.t t_H) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_H

predicate invariant_ref_H [@inline:trivial] (self: t_H) = inv_H self

meta "rewrite_def" predicate invariant_ref_H

predicate inv_ref_H [@inline:trivial] (_1: t_H) = invariant_ref_H _1

meta "rewrite_def" predicate inv_ref_H

predicate precondition_finish (self: ()) (args: t_H)

axiom precondition_fndef: forall args: t_H [precondition_finish () args]. (let self_ = args in inv_ref_H self_
      /\ supported_hasher_H) -> precondition_finish () args

function hash_finish_H (_state: int) : UInt64.t

predicate postcondition_finish (self: ()) (args: t_H) (result: UInt64.t)

axiom postcondition_fndef:
  forall args: t_H, res: UInt64.t [postcondition_finish () args res]. postcondition_finish () args res
    -> (let self_ = args in res = hash_finish_H (hash_state_H self_))

predicate postcondition_once_finish (self: ()) (args: t_H) (result: UInt64.t) = postcondition_finish self args result

meta "rewrite_def" predicate postcondition_once_finish

let finish_H (self_: t_H) (return (x: UInt64.t)) = {[@stop_split] [@expl:finish requires] precondition_finish () self_}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:finish ensures] postcondition_once_finish () self_ result}
    (! return {result}) ]

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

function deep_model_HttpDate (self: t_HttpDate) : int = unix_seconds_model (raw_model self)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let equal_dates_hash_equally_H (a: t_HttpDate) (b: t_HttpDate) (left: MutBorrow.t t_H) (right: MutBorrow.t t_H)
  (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:equal_dates_hash_equally_H requires] ([@stop_split] [@expl:equal_dates_hash_equally 'a' type invariant] inv_HttpDate a)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'b' type invariant] inv_HttpDate b)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'left' type invariant] inv_refmut_H left)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally 'right' type invariant] inv_refmut_H right)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #0] supported_hasher_H)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #1] deep_model_HttpDate a = deep_model_HttpDate b)
  /\ ([@stop_split] [@expl:equal_dates_hash_equally requires #2] hash_state_H left.current
  = hash_state_H right.current)}
  (! bb0
  [ bb0 = s0
    [ s0 = as_raw {a} (fun (_x: t_RawDate) -> [ &_14 <- _x ] s1)
    | s1 = as_raw {b} (fun (_x: t_RawDate) -> [ &_16 <- _x ] s2)
    | s2 = valid_datetime_injective {_14} {_16} (fun (_x: ()) -> [ &_13 <- _x ] s3)
    | s3 = MutBorrow.borrow_final <t_H> {left.current} {MutBorrow.get_id left}
        (fun (_bor: MutBorrow.t t_H) ->
          [ &_20 <- _bor ] -{inv_H _bor.final}-
          [ &left <- { left with current = _bor.final } ] s4)
      [ _ck -> (! {[@expl:type invariant] inv_H left.current} any) ]
    | s4 = hash_HttpDate {a} {_20} (fun (_x: ()) -> [ &_18 <- _x ] s5)
    | s5 = MutBorrow.borrow_final <t_H> {right.current} {MutBorrow.get_id right}
        (fun (_bor: MutBorrow.t t_H) ->
          [ &_23 <- _bor ] -{inv_H _bor.final}-
          [ &right <- { right with current = _bor.final } ] s6)
      [ _ck -> (! {[@expl:type invariant] inv_H right.current} any) ]
    | s6 = hash_HttpDate {b} {_23} (fun (_x: ()) -> [ &_21 <- _x ] s7)
    | s7 = s8 [ _ck -> (! {[@expl:type invariant] inv_refmut_H left} any) ]
    | s8 = -{resolve_refmut_H left}- s9
    | s9 = [ &_26 <- left.current ] s10
    | s10 = finish_H {_26} (fun (_x: UInt64.t) -> [ &_24 <- _x ] s11)
    | s11 = s12 [ _ck -> (! {[@expl:type invariant] inv_refmut_H right} any) ]
    | s12 = -{resolve_refmut_H right}- s13
    | s13 = [ &_29 <- right.current ] s14
    | s14 = finish_H {_29} (fun (_x: UInt64.t) -> [ &_27 <- _x ] s15)
    | s15 = [ &_ret <- { f0 = _24; f1 = _27 } ] s16
    | s16 = return {_ret} ] ]
  [ & _ret: tup2_u64_u64 = Any.any_l ()
  | & a: t_HttpDate = a
  | & b: t_HttpDate = b
  | & left: MutBorrow.t t_H = left
  | & right: MutBorrow.t t_H = right
  | & _13: () = Any.any_l ()
  | & _14: t_RawDate = Any.any_l ()
  | & _16: t_RawDate = Any.any_l ()
  | & _18: () = Any.any_l ()
  | & _20: MutBorrow.t t_H = Any.any_l ()
  | & _21: () = Any.any_l ()
  | & _23: MutBorrow.t t_H = Any.any_l ()
  | & _24: UInt64.t = Any.any_l ()
  | & _26: t_H = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & _29: t_H = Any.any_l () ])
  [ return (result: tup2_u64_u64) -> {[@stop_split] [@expl:equal_dates_hash_equally ensures] result.f0 = result.f1}
    (! return {result}) ]
