use creusot.int.UInt8
use creusot.int.UInt16
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

function january_start [@inline:trivial] (year'0: int) : int = (year'0 - 1970) * 365
      + ComputerDivision.div (year'0 - 1969) 4
    - ComputerDivision.div (year'0 - 1901) 100
  + ComputerDivision.div (year'0 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function leap_adjustment [@inline:trivial] (year'0: int) : int = if ComputerDivision.mod year'0 4 = 0
  /\ (ComputerDivision.mod year'0 100 <> 0 \/ ComputerDivision.mod year'0 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year)
        + january_offset (UInt8.t'int d.mon)
      + UInt8.t'int d.day
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon) 2 then leap_adjustment (UInt16.t'int d.year) else 0)

meta "rewrite_def" function gregorian_day

function month_length [@inline:trivial] (year'0: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'0
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

let civil_day_injective (a: t_RawDate) (b: t_RawDate) (return (x: ())) =
{[@stop_split] [@expl:civil_day_injective requires] ([@stop_split] [@expl:civil_day_injective requires #0] 1970
      <= UInt16.t'int a.year
    /\ UInt16.t'int a.year <= 9999
    /\ 1 <= UInt8.t'int a.mon
    /\ UInt8.t'int a.mon <= 12
    /\ 1 <= UInt8.t'int a.day /\ UInt8.t'int a.day <= month_length (UInt16.t'int a.year) (UInt8.t'int a.mon))
  /\ ([@stop_split] [@expl:civil_day_injective requires #1] 1970 <= UInt16.t'int b.year
    /\ UInt16.t'int b.year <= 9999
    /\ 1 <= UInt8.t'int b.mon
    /\ UInt8.t'int b.mon <= 12
    /\ 1 <= UInt8.t'int b.day /\ UInt8.t'int b.day <= month_length (UInt16.t'int b.year) (UInt8.t'int b.mon))
  /\ ([@stop_split] [@expl:civil_day_injective requires #2] gregorian_day a = gregorian_day b)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:civil_day_injective ensures] a.year = b.year
    /\ a.mon = b.mon /\ a.day = b.day}
    (! return {result}) ]

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec < 60
  /\ UInt8.t'int d.min < 60
  /\ UInt8.t'int d.hour < 24
  /\ 1970 <= UInt16.t'int d.year
  /\ UInt16.t'int d.year <= 9999
  /\ 1 <= UInt8.t'int d.mon
  /\ UInt8.t'int d.mon <= 12
  /\ 1 <= UInt8.t'int d.day
  /\ UInt8.t'int d.day <= month_length (UInt16.t'int d.year) (UInt8.t'int d.mon)
  /\ UInt8.t'int d.wday = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function unix_seconds_model [@inline:trivial] (d: t_RawDate) : int = gregorian_day d * 86400 + UInt8.t'int d.hour * 3600
    + UInt8.t'int d.min * 60
  + UInt8.t'int d.sec

meta "rewrite_def" function unix_seconds_model

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let valid_datetime_injective (a: t_RawDate) (b: t_RawDate) (return (x: ())) =
{[@stop_split] [@expl:valid_datetime_injective requires] ([@stop_split] [@expl:valid_datetime_injective requires #0] valid_calendar a
    /\ valid_calendar b)
  /\ ([@stop_split] [@expl:valid_datetime_injective requires #1] unix_seconds_model a = unix_seconds_model b)}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] gregorian_day a = gregorian_day b} s1
    | s1 = civil_day_injective {a} {b} (fun (_x: ()) -> [ &_16 <- _x ] s2)
    | s2 = {[@expl:assertion] a.hour = b.hour} s3
    | s3 = {[@expl:assertion] a.min = b.min} s4
    | s4 = {[@expl:assertion] a.sec = b.sec} s5
    | s5 = return {_ret} ] ]
  [ & _ret: () = Any.any_l () | & a: t_RawDate = a | & b: t_RawDate = b | & _16: () = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:valid_datetime_injective ensures] a = b} (! return {result}) ]
