(* <date::HttpDate as std::str::FromStr> *)

use creusot.prelude.Char
use seq.Seq
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt16
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

predicate ascii [@inline:trivial] (s: Seq.seq Char.t) =
  forall i: int. 0 <= i /\ i < Seq.length s -> Char.to_int (Seq.get s i) < 128

meta "rewrite_def" predicate ascii

function view_str (self: string) : Seq.seq Char.t

let is_ascii (self_: string) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_ascii ensures] result = ascii (view_str self_)}
    (! return {result}) ]

predicate ascii_whitespace [@inline:trivial] (c: Char.t) =
  Char.to_int c = 32 \/ 9 <= Char.to_int c /\ Char.to_int c <= 13

meta "rewrite_def" predicate ascii_whitespace

predicate ascii_trim_relation [@inline:trivial] (input: Seq.seq Char.t) (output: Seq.seq Char.t) =
  exists lo: int, hi: int. 0 <= lo
    /\ lo <= hi
    /\ hi <= Seq.length input
    /\ output = Seq.([..]) input lo hi
    /\ (forall i: int. 0 <= i /\ i < lo -> ascii_whitespace (Seq.get input i))
    /\ (forall i: int. hi <= i /\ i < Seq.length input -> ascii_whitespace (Seq.get input i))
    /\ (lo = hi \/ not ascii_whitespace (Seq.get input lo) /\ not ascii_whitespace (Seq.get input (hi - 1)))

meta "rewrite_def" predicate ascii_trim_relation

let trim (self_: string) (return (x: string)) = {[@stop_split] [@expl:trim requires] ascii (view_str self_)}
  any
  [ return (result: string) -> {[@stop_split] [@expl:trim ensures] ascii (view_str result)
    /\ ascii_trim_relation (view_str self_) (view_str result)}
    (! return {result}) ]

predicate ascii_content [@inline:trivial] (chars: Seq.seq Char.t) (bytes: Seq.seq UInt8.t) =
  Seq.length chars = Seq.length bytes
  /\ (forall i: int. 0 <= i /\ i < Seq.length chars -> Char.to_int (Seq.get chars i) = UInt8.t'int (Seq.get bytes i))

meta "rewrite_def" predicate ascii_content

let as_bytes (self_: string) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:as_bytes requires] ascii (view_str self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:as_bytes ensures] ascii_content (view_str self_) (Slice64.view result)}
    (! return {result}) ]

function trim_unique (s: Seq.seq Char.t) (a: Seq.seq Char.t) (b: Seq.seq Char.t) : ()

axiom trim_unique_spec: forall s: Seq.seq Char.t, a: Seq.seq Char.t, b: Seq.seq Char.t. ascii_trim_relation s a
      /\ ascii_trim_relation s b -> a = b

function bytes_unique (s: Seq.seq Char.t) (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()

axiom bytes_unique_spec: forall s: Seq.seq Char.t, a: Seq.seq UInt8.t, b: Seq.seq UInt8.t. ascii_content s a
      /\ ascii_content s b -> a = b

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

type t_Error = { f0: () }

type t_Result_RawDate_Error = Ok t_RawDate | Err t_Error

function leap_adjustment [@inline:trivial] (year'0: int) : int = if ComputerDivision.mod year'0 4 = 0
  /\ (ComputerDivision.mod year'0 100 <> 0 \/ ComputerDivision.mod year'0 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function month_length [@inline:trivial] (year'0: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'0
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

function january_start [@inline:trivial] (year'0: int) : int = (year'0 - 1970) * 365
      + ComputerDivision.div (year'0 - 1969) 4
    - ComputerDivision.div (year'0 - 1901) 100
  + ComputerDivision.div (year'0 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year)
        + january_offset (UInt8.t'int d.mon)
      + UInt8.t'int d.day
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon) 2 then leap_adjustment (UInt16.t'int d.year) else 0)

meta "rewrite_def" function gregorian_day

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec < 60
  /\ UInt8.t'int d.min < 60
  /\ UInt8.t'int d.hour < 24
  /\ 1970 <= UInt16.t'int d.year
  /\ UInt16.t'int d.year <= 9999
  /\ 1 <= UInt8.t'int d.mon
  /\ UInt8.t'int d.mon <= 12
  /\ 1 <= UInt8.t'int d.day
  /\ UInt8.t'int d.day <= month_length (UInt16.t'int d.year) (UInt8.t'int d.mon)
  /\ UInt8.t'int d.wday = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function imf_month [@inline:trivial] (s: Seq.seq UInt8.t) : int = if Seq.get s 7 <> (32: UInt8.t)
  \/ Seq.get s 11 <> (32: UInt8.t) then
    0
  else
    if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (110: UInt8.t) then
      1
    else
      if Seq.get s 8 = (70: UInt8.t) /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (98: UInt8.t) then
        2
      else
        if Seq.get s 8 = (77: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (114: UInt8.t) then
          3
        else
          if Seq.get s 8 = (65: UInt8.t) /\ Seq.get s 9 = (112: UInt8.t) /\ Seq.get s 10 = (114: UInt8.t) then
            4
          else
            if Seq.get s 8 = (77: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (121: UInt8.t) then
              5
            else
              if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (110: UInt8.t) then
                6
              else
                if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (108: UInt8.t) then
                  7
                else
                  if Seq.get s 8 = (65: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (103: UInt8.t) then
                    8
                  else
                    if Seq.get s 8 = (83: UInt8.t) /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (112: UInt8.t) then
                      9
                    else
                      if Seq.get s 8 = (79: UInt8.t)
                      /\ Seq.get s 9 = (99: UInt8.t) /\ Seq.get s 10 = (116: UInt8.t) then
                        10
                      else
                        if Seq.get s 8 = (78: UInt8.t)
                        /\ Seq.get s 9 = (111: UInt8.t) /\ Seq.get s 10 = (118: UInt8.t) then
                          11
                        else
                          if Seq.get s 8 = (68: UInt8.t)
                          /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (99: UInt8.t) then
                            12
                          else
                            0
                        
                      
                    
                  
                
              
            
          
        
      
    
  


meta "rewrite_def" function imf_month

function imf_weekday [@inline:trivial] (s: Seq.seq UInt8.t) : int = if Seq.get s 3 <> (44: UInt8.t)
  \/ Seq.get s 4 <> (32: UInt8.t) then
    0
  else
    if Seq.get s 0 = (77: UInt8.t) /\ Seq.get s 1 = (111: UInt8.t) /\ Seq.get s 2 = (110: UInt8.t) then
      1
    else
      if Seq.get s 0 = (84: UInt8.t) /\ Seq.get s 1 = (117: UInt8.t) /\ Seq.get s 2 = (101: UInt8.t) then
        2
      else
        if Seq.get s 0 = (87: UInt8.t) /\ Seq.get s 1 = (101: UInt8.t) /\ Seq.get s 2 = (100: UInt8.t) then
          3
        else
          if Seq.get s 0 = (84: UInt8.t) /\ Seq.get s 1 = (104: UInt8.t) /\ Seq.get s 2 = (117: UInt8.t) then
            4
          else
            if Seq.get s 0 = (70: UInt8.t) /\ Seq.get s 1 = (114: UInt8.t) /\ Seq.get s 2 = (105: UInt8.t) then
              5
            else
              if Seq.get s 0 = (83: UInt8.t) /\ Seq.get s 1 = (97: UInt8.t) /\ Seq.get s 2 = (116: UInt8.t) then
                6
              else
                if Seq.get s 0 = (83: UInt8.t) /\ Seq.get s 1 = (117: UInt8.t) /\ Seq.get s 2 = (110: UInt8.t) then
                  7
                else
                  0
              
            
          
        
      
    
  


meta "rewrite_def" function imf_weekday

predicate imf_digit [@inline:trivial] (b: UInt8.t) = 48 <= UInt8.t'int b /\ UInt8.t'int b <= 57

meta "rewrite_def" predicate imf_digit

predicate imf_syntax [@inline:trivial] (s: Seq.seq UInt8.t) =
  Seq.length s = 29
  /\ gt_log_Int (imf_month s) 0
  /\ gt_log_Int (imf_weekday s) 0
  /\ Seq.get s 16 = (32: UInt8.t)
  /\ Seq.get s 19 = (58: UInt8.t)
  /\ Seq.get s 22 = (58: UInt8.t)
  /\ Seq.get s 25 = (32: UInt8.t)
  /\ Seq.get s 26 = (71: UInt8.t)
  /\ Seq.get s 27 = (77: UInt8.t)
  /\ Seq.get s 28 = (84: UInt8.t)
  /\ imf_digit (Seq.get s 5)
  /\ imf_digit (Seq.get s 6)
  /\ imf_digit (Seq.get s 12)
  /\ imf_digit (Seq.get s 13)
  /\ imf_digit (Seq.get s 14)
  /\ imf_digit (Seq.get s 15)
  /\ imf_digit (Seq.get s 17)
  /\ imf_digit (Seq.get s 18)
  /\ imf_digit (Seq.get s 20) /\ imf_digit (Seq.get s 21) /\ imf_digit (Seq.get s 23) /\ imf_digit (Seq.get s 24)

meta "rewrite_def" predicate imf_syntax

predicate imf_encoding [@inline:trivial] (s: Seq.seq UInt8.t) (d: t_RawDate) =
  imf_syntax s
  /\ imf_month s = UInt8.t'int d.mon
  /\ imf_weekday s = UInt8.t'int d.wday
  /\ (UInt8.t'int (Seq.get s 5) - 48) * 10 + UInt8.t'int (Seq.get s 6) - 48 = UInt8.t'int d.day
  /\ (UInt8.t'int (Seq.get s 12) - 48) * 1000 + (UInt8.t'int (Seq.get s 13) - 48) * 100
          + (UInt8.t'int (Seq.get s 14) - 48) * 10
        + UInt8.t'int (Seq.get s 15)
      - 48
    = UInt16.t'int d.year
  /\ (UInt8.t'int (Seq.get s 17) - 48) * 10 + UInt8.t'int (Seq.get s 18) - 48 = UInt8.t'int d.hour
  /\ (UInt8.t'int (Seq.get s 20) - 48) * 10 + UInt8.t'int (Seq.get s 21) - 48 = UInt8.t'int d.min
  /\ (UInt8.t'int (Seq.get s 23) - 48) * 10 + UInt8.t'int (Seq.get s 24) - 48 = UInt8.t'int d.sec

meta "rewrite_def" predicate imf_encoding

predicate rfc850_encoding (s: Seq.seq UInt8.t) (d: t_RawDate)

predicate asctime_encoding (s: Seq.seq UInt8.t) (d: t_RawDate)

let parse_date_bytes (s: Slice64.slice UInt8.t) (return (x: t_Result_RawDate_Error)) = any
  [ return (result: t_Result_RawDate_Error) ->
  {[@stop_split] [@expl:parse_date_bytes ensures] ([@stop_split] [@expl:parse_date_bytes ensures #0] match result with
        | Ok d -> valid_calendar d
        | Err _ -> true
        end)
    /\ ([@stop_split] [@expl:parse_date_bytes ensures #1] match result with
        | Ok d -> imf_encoding (Slice64.view s) d
        \/ rfc850_encoding (Slice64.view s) d \/ asctime_encoding (Slice64.view s) d
        | Err _ -> true
        end)
    /\ ([@stop_split] [@expl:parse_date_bytes ensures #2] match result with
      | Ok d -> imf_syntax (Slice64.view s) -> imf_encoding (Slice64.view s) d
      | Err _ -> forall d: t_RawDate. imf_encoding (Slice64.view s) d
          \/ rfc850_encoding (Slice64.view s) d \/ asctime_encoding (Slice64.view s) d -> not valid_calendar d
      end)}
    (! return {result}) ]

let elim_Err (_x: t_Result_RawDate_Error) (return (f0'0: t_Error)) = any
  [ _k (f0'0: t_Error) -> {Err f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_HttpDate = {
  sec'0: UInt8.t;
  min'0: UInt8.t;
  hour'0: UInt8.t;
  day'0: UInt8.t;
  mon'0: UInt8.t;
  year'0: UInt16.t;
  wday'0: UInt8.t }

type t_Result_HttpDate_Error = Ok'0 t_HttpDate | Err'0 t_Error

let elim_Ok (_x: t_Result_RawDate_Error) (return (f0'0: t_RawDate)) = any
  [ _k (f0'0: t_RawDate) -> {Ok f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

function raw_model [@inline:trivial] (self: t_HttpDate) : t_RawDate = { sec = self.sec'0;
                                                                        min = self.min'0;
                                                                        hour = self.hour'0;
                                                                        day = self.day'0;
                                                                        mon = self.mon'0;
                                                                        year = self.year'0;
                                                                        wday = self.wday'0 }

meta "rewrite_def" function raw_model

predicate invariant_HttpDate (self: t_HttpDate) = valid_calendar (raw_model self)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom [@rewrite]: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x = invariant_HttpDate x

let from_raw (d: t_RawDate) (return (x: t_HttpDate)) = {[@stop_split] [@expl:from_raw requires] valid_calendar d}
  any
  [ return (result: t_HttpDate) ->
  {[@stop_split] [@expl:from_raw ensures] ([@stop_split] [@expl:from_raw result type invariant] inv_HttpDate result)
    /\ ([@stop_split] [@expl:from_raw ensures] raw_model result = d)}
    (! return {result}) ]

predicate inv_Result_HttpDate_Error (_1: t_Result_HttpDate_Error)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Result_HttpDate_Error [inv_Result_HttpDate_Error x]. inv_Result_HttpDate_Error x
    = match x with
      | Ok'0 f0'0 -> inv_HttpDate f0'0
      | Err'0 f0'0 -> true
      end

predicate parsed_text [@inline:trivial] (s: Seq.seq Char.t) (d: t_RawDate) =
  ascii s
  /\ (exists trimmed: Seq.seq Char.t, bytes: Seq.seq UInt8.t. ascii_trim_relation s trimmed
    /\ ascii_content trimmed bytes /\ (imf_encoding bytes d \/ rfc850_encoding bytes d \/ asctime_encoding bytes d))

meta "rewrite_def" predicate parsed_text

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let from_str_HttpDate (s: string) (return (x: t_Result_HttpDate_Error)) = (! bb0
  [ bb0 = s0
    [ s0 = is_ascii {s} (fun (_x: bool) -> [ &_5 <- _x ] s1)
    | s1 = any [ br0 -> {_5 = false} (! bb3) | br1 -> {_5} (! bb2) ] ]
  | bb2 = s0
    [ s0 = trim {s} (fun (_x: string) -> [ &trimmed <- _x ] s1)
    | s1 = as_bytes {trimmed} (fun (_x: Slice64.slice UInt8.t) -> [ &x <- _x ] s2)
    | s2 =
      {[@expl:assertion] forall other: Seq.seq Char.t, bytes: Seq.seq UInt8.t. ascii_trim_relation (view_str s) other
          /\ ascii_content other bytes
        -> (let _ = trim_unique (view_str s) (view_str trimmed) other in let _ = bytes_unique (view_str trimmed) (Slice64.view x) bytes in bytes
        = Slice64.view x)}
      s3
    | s3 = parse_date_bytes {x} (fun (_x: t_Result_RawDate_Error) -> [ &_19 <- _x ] s4)
    | s4 = any [ br0 (x0: t_RawDate) -> {_19 = Ok x0} (! bb10) | br1 (x0: t_Error) -> {_19 = Err x0} (! bb9) ] ]
  | bb9 = s0
    [ s0 = elim_Err {_19} (fun (r0: t_Error) -> [ &error <- r0 ] s1)
    | s1 = [ &_ret <- Err'0 error ] s2
    | s2 = return {_ret} ]
  | bb10 = s0
    [ s0 = elim_Ok {_19} (fun (r0: t_RawDate) -> [ &raw <- r0 ] s1)
    | s1 = from_raw {raw} (fun (_x: t_HttpDate) -> [ &_23 <- _x ] s2)
    | s2 = [ &_ret <- Ok'0 _23 ] s3
    | s3 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_8 <- { f0 = _9 } ] s1 | s1 = [ &_ret <- Err'0 _8 ] s2 | s2 = return {_ret} ] ]
  [ & _ret: t_Result_HttpDate_Error = Any.any_l ()
  | & s: string = s
  | & _5: bool = Any.any_l ()
  | & _8: t_Error = Any.any_l ()
  | & _9: () = Any.any_l ()
  | & trimmed: string = Any.any_l ()
  | & x: Slice64.slice UInt8.t = Any.any_l ()
  | & _19: t_Result_RawDate_Error = Any.any_l ()
  | & raw: t_RawDate = Any.any_l ()
  | & _23: t_HttpDate = Any.any_l ()
  | & error: t_Error = Any.any_l () ])
  [ return (result: t_Result_HttpDate_Error) ->
  {[@stop_split] [@expl:from_str_HttpDate ensures] ([@stop_split] [@expl:from_str result type invariant] inv_Result_HttpDate_Error result)
    /\ ([@stop_split] [@expl:from_str ensures] match result with
      | Ok'0 d -> valid_calendar (raw_model d) /\ parsed_text (view_str s) (raw_model d)
      | Err'0 _ -> forall d: t_RawDate. parsed_text (view_str s) d -> not valid_calendar d
      end)}
    (! return {result}) ]
