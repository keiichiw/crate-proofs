let write_ascii (f: MutBorrow.t t_Formatter) (bytes: Slice64.slice UInt8.t) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_ascii requires] ([@stop_split] [@expl:write_ascii 'f' type invariant] inv_refmut_Formatter f)
  /\ ([@stop_split] [@expl:write_ascii requires] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bytes)
    -> UInt8.t'int (Seq.get (Slice64.view bytes) i) < 128
    /\ Char.to_int (literal_char (Seq.get (Slice64.view bytes) i)) = UInt8.t'int (Seq.get (Slice64.view bytes) i))}
  any
  [ return (result: t_Result_unit_Error) -> {[@stop_split] [@expl:write_ascii ensures] match result with
      | Ok () -> debug_options f.final = debug_options f.current
      /\ (append_sink f.current
      -> append_sink f.final
      /\ formatter_output f.final = Seq.(++) (formatter_output f.current) (ascii_chars (Slice64.view bytes)))
      | Err _ -> true
      end}
    (! return {result}) ]

