                                      Char.of_int 105
                                    else
                                      if b = (110: UInt8.t) then
                                        Char.of_int 110
                                      else
                                        if b = (104: UInt8.t) then
                                          Char.of_int 104
                                        else
                                          if b = (111: UInt8.t) then
                                            Char.of_int 111
                                          else
                                            if b = (117: UInt8.t) then
                                              Char.of_int 117
                                            else
                                              if b = (114: UInt8.t) then
                                                Char.of_int 114
                                              else
                                                if b = (100: UInt8.t) then
                                                  Char.of_int 100
                                                else
                                                  if b = (121: UInt8.t) then
