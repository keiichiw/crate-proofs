use seq.Seq
use creusot.prelude.Char

function concat_assoc_char (self: Seq.seq Char.t) (other1: Seq.seq Char.t) (other2: Seq.seq Char.t) : ()

axiom concat_assoc_char_spec:
  forall self: Seq.seq Char.t, other1: Seq.seq Char.t, other2: Seq.seq Char.t. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

function concat_law : ()

goal vc_concat_law:
  (forall a: Seq.seq Char.t, b: Seq.seq Char.t, c: Seq.seq Char.t. ([@stop_split] [@expl:concat_assoc ensures] Seq.(++) (Seq.(++) a b) c
        = Seq.(++) a (Seq.(++) b c)) -> (let _ = concat_assoc_char a b c in true))
  /\ (forall a: Seq.seq Char.t, b: Seq.seq Char.t, c: Seq.seq Char.t. let _ = concat_assoc_char a b c in Seq.(++) (Seq.(++) a b) c
      = Seq.(++) a (Seq.(++) b c))
  && ([@stop_split] [@expl:concat_law ensures] forall a: Seq.seq Char.t, b: Seq.seq Char.t, c: Seq.seq Char.t. Seq.(++) (Seq.(++) a b) c
    = Seq.(++) a (Seq.(++) b c))
