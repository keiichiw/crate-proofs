constant concat_law : ()

axiom concat_law_spec: forall a: Seq.seq Char.t, b: Seq.seq Char.t, c: Seq.seq Char.t. Seq.(++) (Seq.(++) a b) c
    = Seq.(++) a (Seq.(++) b c)

type t_Formatter

function formatter_output (_f: t_Formatter) : Seq.seq Char.t

predicate append_sink (_f: t_Formatter)

function literal_char (b: UInt8.t) : Char.t = if b = (10: UInt8.t) then
