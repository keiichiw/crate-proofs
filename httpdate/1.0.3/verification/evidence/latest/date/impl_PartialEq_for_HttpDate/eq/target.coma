(* <date::HttpDate as std::cmp::PartialEq> *)

use creusot.int.UInt8
use creusot.int.UInt16
use int.ComputerDivision
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_HttpDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

type t_RawDate = {
  sec'0: UInt8.t;
  min'0: UInt8.t;
  hour'0: UInt8.t;
  day'0: UInt8.t;
  mon'0: UInt8.t;
  year'0: UInt16.t;
  wday'0: UInt8.t }

function leap_adjustment [@inline:trivial] (year'1: int) : int = if ComputerDivision.mod year'1 4 = 0
  /\ (ComputerDivision.mod year'1 100 <> 0 \/ ComputerDivision.mod year'1 400 = 0) then
    1
  else
    0


meta "rewrite_def" function leap_adjustment

function month_length [@inline:trivial] (year'1: int) (month: int) : int = if month = 2 then
    28 + leap_adjustment year'1
  else
    if month = 4 \/ month = 6 \/ month = 9 \/ month = 11 then 30 else 31


meta "rewrite_def" function month_length

function january_start [@inline:trivial] (year'1: int) : int = (year'1 - 1970) * 365
      + ComputerDivision.div (year'1 - 1969) 4
    - ComputerDivision.div (year'1 - 1901) 100
  + ComputerDivision.div (year'1 - 1601) 400

meta "rewrite_def" function january_start

function january_offset [@inline:trivial] (month: int) : int = if month = 1 then
    0
  else
    if month = 2 then
      31
    else
      if month = 3 then
        59
      else
        if month = 4 then
          90
        else
          if month = 5 then
            120
          else
            if month = 6 then
              151
            else
              if month = 7 then
                181
              else
                if month = 8 then
                  212
                else
                  if month = 9 then 243 else if month = 10 then 273 else if month = 11 then 304 else 334
              
            
          
        
      
    
  


meta "rewrite_def" function january_offset

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function gregorian_day [@inline:trivial] (d: t_RawDate) : int = january_start (UInt16.t'int d.year'0)
        + january_offset (UInt8.t'int d.mon'0)
      + UInt8.t'int d.day'0
    - 1
  + (if gt_log_Int (UInt8.t'int d.mon'0) 2 then leap_adjustment (UInt16.t'int d.year'0) else 0)

meta "rewrite_def" function gregorian_day

predicate valid_calendar [@inline:trivial] (d: t_RawDate) =
  UInt8.t'int d.sec'0 < 60
  /\ UInt8.t'int d.min'0 < 60
  /\ UInt8.t'int d.hour'0 < 24
  /\ 1970 <= UInt16.t'int d.year'0
  /\ UInt16.t'int d.year'0 <= 9999
  /\ 1 <= UInt8.t'int d.mon'0
  /\ UInt8.t'int d.mon'0 <= 12
  /\ 1 <= UInt8.t'int d.day'0
  /\ UInt8.t'int d.day'0 <= month_length (UInt16.t'int d.year'0) (UInt8.t'int d.mon'0)
  /\ UInt8.t'int d.wday'0 = ComputerDivision.mod (gregorian_day d + 3) 7 + 1

meta "rewrite_def" predicate valid_calendar

function raw_model [@inline:trivial] (self: t_HttpDate) : t_RawDate = { sec'0 = self.sec;
                                                                        min'0 = self.min;
                                                                        hour'0 = self.hour;
                                                                        day'0 = self.day;
                                                                        mon'0 = self.mon;
                                                                        year'0 = self.year;
                                                                        wday'0 = self.wday }

meta "rewrite_def" function raw_model

predicate invariant_HttpDate (self: t_HttpDate) = valid_calendar (raw_model self)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom [@rewrite]: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x = invariant_HttpDate x

predicate invariant_ref_HttpDate [@inline:trivial] (self: t_HttpDate) = inv_HttpDate self

meta "rewrite_def" predicate invariant_ref_HttpDate

predicate inv_ref_HttpDate [@inline:trivial] (_1: t_HttpDate) = invariant_ref_HttpDate _1

meta "rewrite_def" predicate inv_ref_HttpDate

let as_raw (self: t_HttpDate) (return (x: t_RawDate)) =
{[@stop_split] [@expl:as_raw 'self' type invariant] inv_ref_HttpDate self}
  any
  [ return (result: t_RawDate) -> {[@stop_split] [@expl:as_raw ensures] result = raw_model self} (! return {result}) ]

let to_unix_seconds (v: t_RawDate) (return (x: UInt64.t)) =
{[@stop_split] [@expl:to_unix_seconds requires] UInt8.t'int v.sec'0 < 60
  /\ UInt8.t'int v.min'0 < 60
  /\ UInt8.t'int v.hour'0 < 24
  /\ 1 <= UInt8.t'int v.day'0
  /\ UInt8.t'int v.day'0 <= 31
  /\ 1 <= UInt8.t'int v.mon'0
  /\ UInt8.t'int v.mon'0 <= 12 /\ 1970 <= UInt16.t'int v.year'0 /\ UInt16.t'int v.year'0 <= 9999}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:to_unix_seconds ensures] ([@stop_split] [@expl:to_unix_seconds ensures #0] UInt64.t'int result
      < 253402300800)
    /\ ([@stop_split] [@expl:to_unix_seconds ensures #1] UInt64.t'int result
    = gregorian_day v * 86400 + UInt8.t'int v.hour'0 * 3600 + UInt8.t'int v.min'0 * 60 + UInt8.t'int v.sec'0)}
    (! return {result}) ]

function unix_seconds_model [@inline:trivial] (d: t_RawDate) : int = gregorian_day d * 86400
      + UInt8.t'int d.hour'0 * 3600
    + UInt8.t'int d.min'0 * 60
  + UInt8.t'int d.sec'0

meta "rewrite_def" function unix_seconds_model

let valid_datetime_injective (a: t_RawDate) (b: t_RawDate) (return (x: ())) =
{[@stop_split] [@expl:valid_datetime_injective requires] ([@stop_split] [@expl:valid_datetime_injective requires #0] valid_calendar a
    /\ valid_calendar b)
  /\ ([@stop_split] [@expl:valid_datetime_injective requires #1] unix_seconds_model a = unix_seconds_model b)}
  any [ return (result: ()) -> {[@stop_split] [@expl:valid_datetime_injective ensures] a = b} (! return {result}) ]

function deep_model_HttpDate (self: t_HttpDate) : int = unix_seconds_model (raw_model self)

function deep_model_ref_HttpDate [@inline:trivial] (self: t_HttpDate) : int = deep_model_HttpDate self

meta "rewrite_def" function deep_model_ref_HttpDate

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let eq_HttpDate (self: t_HttpDate) (other: t_HttpDate) (return (x: bool)) =
{[@stop_split] [@expl:eq_HttpDate requires] ([@stop_split] [@expl:eq 'self' type invariant] inv_ref_HttpDate self)
  /\ ([@stop_split] [@expl:eq 'other' type invariant] inv_ref_HttpDate other)}
  (! bb0
  [ bb0 = s0
    [ s0 = as_raw {self} (fun (_x: t_RawDate) -> [ &a <- _x ] s1)
    | s1 = as_raw {other} (fun (_x: t_RawDate) -> [ &b <- _x ] s2)
    | s2 = to_unix_seconds {a} (fun (_x: UInt64.t) -> [ &_12 <- _x ] s3)
    | s3 = to_unix_seconds {b} (fun (_x: UInt64.t) -> [ &_14 <- _x ] s4)
    | s4 = [ &_11 <- _12 = _14 ] s5
    | s5 = any [ br0 -> {_11 = false} (! bb8) | br1 -> {_11} (! bb5) ] ]
  | bb5 = s0 [ s0 = valid_datetime_injective {a} {b} (fun (_x: ()) -> [ &_16 <- _x ] s1) | s1 = bb8 ]
  | bb8 = s0
    [ s0 = [ &_19 <- self.sec = other.sec ] s1 | s1 = any [ br0 -> {_19 = false} (! bb21) | br1 -> {_19} (! bb9) ] ]
  | bb9 = s0
    [ s0 = [ &_22 <- self.min = other.min ] s1 | s1 = any [ br0 -> {_22 = false} (! bb21) | br1 -> {_22} (! bb10) ] ]
  | bb10 = s0
    [ s0 = [ &_25 <- self.hour = other.hour ] s1 | s1 = any [ br0 -> {_25 = false} (! bb21) | br1 -> {_25} (! bb11) ] ]
  | bb11 = s0
    [ s0 = [ &_28 <- self.day = other.day ] s1 | s1 = any [ br0 -> {_28 = false} (! bb21) | br1 -> {_28} (! bb12) ] ]
  | bb12 = s0
    [ s0 = [ &_31 <- self.mon = other.mon ] s1 | s1 = any [ br0 -> {_31 = false} (! bb21) | br1 -> {_31} (! bb13) ] ]
  | bb13 = s0
    [ s0 = [ &_34 <- self.year = other.year ] s1 | s1 = any [ br0 -> {_34 = false} (! bb21) | br1 -> {_34} (! bb14) ] ]
  | bb14 = s0 [ s0 = [ &_ret <- self.wday = other.wday ] s1 | s1 = return {_ret} ]
  | bb21 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_HttpDate = self
  | & other: t_HttpDate = other
  | & a: t_RawDate = Any.any_l ()
  | & b: t_RawDate = Any.any_l ()
  | & _11: bool = Any.any_l ()
  | & _12: UInt64.t = Any.any_l ()
  | & _14: UInt64.t = Any.any_l ()
  | & _16: () = Any.any_l ()
  | & _19: bool = Any.any_l ()
  | & _22: bool = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _28: bool = Any.any_l ()
  | & _31: bool = Any.any_l ()
  | & _34: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] result
    = (deep_model_ref_HttpDate self = deep_model_ref_HttpDate other)}
    (! return {result}) ]
