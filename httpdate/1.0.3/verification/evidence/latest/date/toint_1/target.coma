use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

let wrapping_sub (self_: UInt8.t) (rhs: UInt8.t) (return (x: UInt8.t)) = any
  [ return (result: UInt8.t) -> {[@stop_split] [@expl:wrapping_sub ensures] result = UInt8.sub self_ rhs}
    (! return {result}) ]

type t_Error = { f0: () }

type t_Result_u8_Error = Ok UInt8.t | Err t_Error

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let toint_1 (x: UInt8.t) (return (x'0: t_Result_u8_Error)) = (! bb0
  [ bb0 = s0
    [ s0 = wrapping_sub {x} {(48: UInt8.t)} (fun (_x: UInt8.t) -> [ &result <- _x ] s1)
    | s1 = [ &_6 <- UInt8.lt result (10: UInt8.t) ] s2
    | s2 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb2) ] ]
  | bb2 = s0 [ s0 = [ &_ret <- Ok result ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_9 <- { f0 = _10 } ] s1 | s1 = [ &_ret <- Err _9 ] s2 | s2 = return {_ret} ] ]
  [ & _ret: t_Result_u8_Error = Any.any_l ()
  | & x: UInt8.t = x
  | & result: UInt8.t = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & _9: t_Error = Any.any_l ()
  | & _10: () = Any.any_l () ])
  [ return (result: t_Result_u8_Error) -> {[@stop_split] [@expl:toint_1 ensures] match result with
      | Ok v -> 48 <= UInt8.t'int x /\ UInt8.t'int x <= 57 /\ UInt8.t'int v = UInt8.t'int x - 48 /\ UInt8.t'int v < 10
      | Err _ -> UInt8.t'int x < 48 \/ 57 < UInt8.t'int x
      end}
    (! return {result}) ]
