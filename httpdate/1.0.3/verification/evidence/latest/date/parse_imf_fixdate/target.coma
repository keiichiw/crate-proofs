use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Error = { f0: () }

type t_RawDate = {
  sec: UInt8.t;
  min: UInt8.t;
  hour: UInt8.t;
  day: UInt8.t;
  mon: UInt8.t;
  year: UInt16.t;
  wday: UInt8.t }

type t_Result_RawDate_Error = Ok t_RawDate | Err t_Error

type t_Range_usize = { start: UInt64.t; end': UInt64.t }

predicate in_bounds_Range_usize (self: t_Range_usize) (seq: Seq.seq UInt8.t) =
  UInt64.t'int self.start <= UInt64.t'int self.end' /\ UInt64.t'int self.end' <= Seq.length seq

predicate has_value_Range_usize (self: t_Range_usize) (seq: Seq.seq UInt8.t) (out: Slice64.slice UInt8.t) =
  Seq.([..]) seq (UInt64.t'int self.start) (UInt64.t'int self.end') = Slice64.view out

let index_slice_u8 (self_: Slice64.slice UInt8.t) (ix: t_Range_usize) (return (x: Slice64.slice UInt8.t)) =
{[@stop_split] [@expl:index requires] in_bounds_Range_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt8.t) ->
  {[@stop_split] [@expl:index ensures] has_value_Range_usize ix (Slice64.view self_) result}
    (! return {result}) ]

type t_Result_u8_Error = Ok'0 UInt8.t | Err'0 t_Error

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function index_slice_u8'0 [@inline:trivial] (self: Slice64.slice UInt8.t) (ix: int) : UInt8.t =
  Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_u8'0

let toint_2 (s: Slice64.slice UInt8.t) (return (x: t_Result_u8_Error)) =
{[@stop_split] [@expl:toint_2 requires] ge_log_Int (Seq.length (Slice64.view s)) 2}
  any
  [ return (result: t_Result_u8_Error) -> {[@stop_split] [@expl:toint_2 ensures] match result with
      | Ok'0 v -> 48 <= UInt8.t'int (index_slice_u8'0 s 0)
      /\ UInt8.t'int (index_slice_u8'0 s 0) <= 57
      /\ 48 <= UInt8.t'int (index_slice_u8'0 s 1)
      /\ UInt8.t'int (index_slice_u8'0 s 1) <= 57
      /\ UInt8.t'int v = (UInt8.t'int (index_slice_u8'0 s 0) - 48) * 10 + UInt8.t'int (index_slice_u8'0 s 1) - 48
      /\ UInt8.t'int v < 100
      | Err'0 _ -> UInt8.t'int (index_slice_u8'0 s 0) < 48
      \/ 57 < UInt8.t'int (index_slice_u8'0 s 0)
      \/ UInt8.t'int (index_slice_u8'0 s 1) < 48 \/ 57 < UInt8.t'int (index_slice_u8'0 s 1)
      end}
    (! return {result}) ]

type t_Result_Infallible_Error = Ok'1 () | Err'1 t_Error

type t_ControlFlow_Result_Infallible_Error_u8 = Continue UInt8.t | Break t_Result_Infallible_Error

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Result_Infallible_Error (_1: t_Result_Infallible_Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_Infallible_Error [inv_Result_Infallible_Error x]. inv_Result_Infallible_Error x
    = match x with
      | Ok'1 f0'0 -> inv_Infallible f0'0
      | Err'1 f0'0 -> true
      end

predicate inv_ControlFlow_Result_Infallible_Error_u8 (_1: t_ControlFlow_Result_Infallible_Error_u8)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Result_Infallible_Error_u8 [inv_ControlFlow_Result_Infallible_Error_u8 x]. inv_ControlFlow_Result_Infallible_Error_u8 x
    = match x with
      | Continue f0'0 -> true
      | Break f0'0 -> inv_Result_Infallible_Error f0'0
      end

let branch_Result_u8_Error (self_: t_Result_u8_Error) (return (x: t_ControlFlow_Result_Infallible_Error_u8)) = any
  [ return (result: t_ControlFlow_Result_Infallible_Error_u8) ->
  {[@stop_split] [@expl:branch_Result_u8_Error ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Result_Infallible_Error_u8 result)
    /\ ([@stop_split] [@expl:branch ensures] match self_ with
      | Ok'0 v -> result = Continue v
      | Err'0 e -> result = Break (Err'1 e)
      end)}
    (! return {result}) ]

let elim_Break (_x: t_ControlFlow_Result_Infallible_Error_u8) (return (f0'0: t_Result_Infallible_Error)) = any
  [ _k (f0'0: t_Result_Infallible_Error) -> {Break f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

type tup2_Result_RawDate_Error_Result_Infallible_Error = {
  f0'0: t_Result_RawDate_Error;
  f1'0: t_Result_Infallible_Error }

predicate postcondition_from (self: ()) (args: t_Error) (result: t_Error) = let self_ = args in result = self_

meta "rewrite_def" predicate postcondition_from

let from_Error (self_: t_Error) (return (x: t_Error)) = any
  [ return (result: t_Error) -> {[@stop_split] [@expl:from ensures] result = self_} (! return {result}) ]

let from_residual_Result_RawDate_Error (residual: t_Result_Infallible_Error) (return (x: t_Result_RawDate_Error)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] inv_Result_Infallible_Error residual}
  any
  [ return (result: t_Result_RawDate_Error) -> {[@stop_split] [@expl:from_residual ensures] match { f0'0 = result;
                                                                                                    f1'0 = residual } with
      | {f0'0 = Err result'0; f1'0 = Err'1 residual'0} -> postcondition_from () residual'0 result'0
      | _ -> false
      end}
    (! return {result}) ]

let elim_Continue (_x: t_ControlFlow_Result_Infallible_Error_u8) (return (f0'1: UInt8.t)) = any
  [ _k (f0'1: UInt8.t) -> {Continue f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Continue] match _x with
      | Continue _ -> true
      | _ -> false
      end}
    any) ]

type tup5_u8_u8_u8_u8_u8 = { f0'1: UInt8.t; f1'1: UInt8.t; f2'1: UInt8.t; f3'1: UInt8.t; f4'1: UInt8.t }

type t_Result_u16_Error = Ok'2 UInt16.t | Err'2 t_Error

let toint_4 (s: Slice64.slice UInt8.t) (return (x: t_Result_u16_Error)) =
{[@stop_split] [@expl:toint_4 requires] ge_log_Int (Seq.length (Slice64.view s)) 4}
  any
  [ return (result: t_Result_u16_Error) -> {[@stop_split] [@expl:toint_4 ensures] match result with
      | Ok'2 v -> 48 <= UInt8.t'int (index_slice_u8'0 s 0)
      /\ UInt8.t'int (index_slice_u8'0 s 0) <= 57
      /\ 48 <= UInt8.t'int (index_slice_u8'0 s 1)
      /\ UInt8.t'int (index_slice_u8'0 s 1) <= 57
      /\ 48 <= UInt8.t'int (index_slice_u8'0 s 2)
      /\ UInt8.t'int (index_slice_u8'0 s 2) <= 57
      /\ 48 <= UInt8.t'int (index_slice_u8'0 s 3)
      /\ UInt8.t'int (index_slice_u8'0 s 3) <= 57
      /\ UInt16.t'int v
        = (UInt8.t'int (index_slice_u8'0 s 0) - 48) * 1000 + (UInt8.t'int (index_slice_u8'0 s 1) - 48) * 100
            + (UInt8.t'int (index_slice_u8'0 s 2) - 48) * 10
          + UInt8.t'int (index_slice_u8'0 s 3)
        - 48
      /\ UInt16.t'int v < 10000
      | Err'2 _ -> UInt8.t'int (index_slice_u8'0 s 0) < 48
      \/ 57 < UInt8.t'int (index_slice_u8'0 s 0)
      \/ UInt8.t'int (index_slice_u8'0 s 1) < 48
      \/ 57 < UInt8.t'int (index_slice_u8'0 s 1)
      \/ UInt8.t'int (index_slice_u8'0 s 2) < 48
      \/ 57 < UInt8.t'int (index_slice_u8'0 s 2)
      \/ UInt8.t'int (index_slice_u8'0 s 3) < 48 \/ 57 < UInt8.t'int (index_slice_u8'0 s 3)
      end}
    (! return {result}) ]

type t_ControlFlow_Result_Infallible_Error_u16 = Continue'0 UInt16.t | Break'0 t_Result_Infallible_Error

predicate inv_ControlFlow_Result_Infallible_Error_u16 (_1: t_ControlFlow_Result_Infallible_Error_u16)

axiom inv_axiom'1 [@rewrite]:
  forall x: t_ControlFlow_Result_Infallible_Error_u16 [inv_ControlFlow_Result_Infallible_Error_u16 x]. inv_ControlFlow_Result_Infallible_Error_u16 x
    = match x with
      | Continue'0 f0'2 -> true
      | Break'0 f0'2 -> inv_Result_Infallible_Error f0'2
      end

let branch_Result_u16_Error (self_: t_Result_u16_Error) (return (x: t_ControlFlow_Result_Infallible_Error_u16)) = any
  [ return (result: t_ControlFlow_Result_Infallible_Error_u16) ->
  {[@stop_split] [@expl:branch_Result_u16_Error ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Result_Infallible_Error_u16 result)
    /\ ([@stop_split] [@expl:branch ensures] match self_ with
      | Ok'2 v -> result = Continue'0 v
      | Err'2 e -> result = Break'0 (Err'1 e)
      end)}
    (! return {result}) ]

let elim_Break'0 (_x: t_ControlFlow_Result_Infallible_Error_u16) (return (f0'2: t_Result_Infallible_Error)) = any
  [ _k (f0'2: t_Result_Infallible_Error) -> {Break'0 f0'2 = _x} (! return {f0'2})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break'0 _ -> true
      | _ -> false
      end}
    any) ]

let elim_Continue'0 (_x: t_ControlFlow_Result_Infallible_Error_u16) (return (f0'2: UInt16.t)) = any
  [ _k (f0'2: UInt16.t) -> {Continue'0 f0'2 = _x} (! return {f0'2})
  | _chk -> (! {[@expl:elim Continue] match _x with
      | Continue'0 _ -> true
      | _ -> false
      end}
    any) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

function imf_month [@inline:trivial] (s: Seq.seq UInt8.t) : int = if Seq.get s 7 <> (32: UInt8.t)
  \/ Seq.get s 11 <> (32: UInt8.t) then
    0
  else
    if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (110: UInt8.t) then
      1
    else
      if Seq.get s 8 = (70: UInt8.t) /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (98: UInt8.t) then
        2
      else
        if Seq.get s 8 = (77: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (114: UInt8.t) then
          3
        else
          if Seq.get s 8 = (65: UInt8.t) /\ Seq.get s 9 = (112: UInt8.t) /\ Seq.get s 10 = (114: UInt8.t) then
            4
          else
            if Seq.get s 8 = (77: UInt8.t) /\ Seq.get s 9 = (97: UInt8.t) /\ Seq.get s 10 = (121: UInt8.t) then
              5
            else
              if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (110: UInt8.t) then
                6
              else
                if Seq.get s 8 = (74: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (108: UInt8.t) then
                  7
                else
                  if Seq.get s 8 = (65: UInt8.t) /\ Seq.get s 9 = (117: UInt8.t) /\ Seq.get s 10 = (103: UInt8.t) then
                    8
                  else
                    if Seq.get s 8 = (83: UInt8.t) /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (112: UInt8.t) then
                      9
                    else
                      if Seq.get s 8 = (79: UInt8.t)
                      /\ Seq.get s 9 = (99: UInt8.t) /\ Seq.get s 10 = (116: UInt8.t) then
                        10
                      else
                        if Seq.get s 8 = (78: UInt8.t)
                        /\ Seq.get s 9 = (111: UInt8.t) /\ Seq.get s 10 = (118: UInt8.t) then
                          11
                        else
                          if Seq.get s 8 = (68: UInt8.t)
                          /\ Seq.get s 9 = (101: UInt8.t) /\ Seq.get s 10 = (99: UInt8.t) then
                            12
                          else
                            0
                        
                      
                    
                  
                
              
            
          
        
      
    
  


meta "rewrite_def" function imf_month

function imf_weekday [@inline:trivial] (s: Seq.seq UInt8.t) : int = if Seq.get s 3 <> (44: UInt8.t)
  \/ Seq.get s 4 <> (32: UInt8.t) then
    0
  else
    if Seq.get s 0 = (77: UInt8.t) /\ Seq.get s 1 = (111: UInt8.t) /\ Seq.get s 2 = (110: UInt8.t) then
      1
    else
      if Seq.get s 0 = (84: UInt8.t) /\ Seq.get s 1 = (117: UInt8.t) /\ Seq.get s 2 = (101: UInt8.t) then
        2
      else
        if Seq.get s 0 = (87: UInt8.t) /\ Seq.get s 1 = (101: UInt8.t) /\ Seq.get s 2 = (100: UInt8.t) then
          3
        else
          if Seq.get s 0 = (84: UInt8.t) /\ Seq.get s 1 = (104: UInt8.t) /\ Seq.get s 2 = (117: UInt8.t) then
            4
          else
            if Seq.get s 0 = (70: UInt8.t) /\ Seq.get s 1 = (114: UInt8.t) /\ Seq.get s 2 = (105: UInt8.t) then
              5
            else
              if Seq.get s 0 = (83: UInt8.t) /\ Seq.get s 1 = (97: UInt8.t) /\ Seq.get s 2 = (116: UInt8.t) then
                6
              else
                if Seq.get s 0 = (83: UInt8.t) /\ Seq.get s 1 = (117: UInt8.t) /\ Seq.get s 2 = (110: UInt8.t) then
                  7
                else
                  0
              
            
          
        
      
    
  


meta "rewrite_def" function imf_weekday

predicate imf_digit [@inline:trivial] (b: UInt8.t) = 48 <= UInt8.t'int b /\ UInt8.t'int b <= 57

meta "rewrite_def" predicate imf_digit

predicate imf_syntax [@inline:trivial] (s: Seq.seq UInt8.t) =
  Seq.length s = 29
  /\ gt_log_Int (imf_month s) 0
  /\ gt_log_Int (imf_weekday s) 0
  /\ Seq.get s 16 = (32: UInt8.t)
  /\ Seq.get s 19 = (58: UInt8.t)
  /\ Seq.get s 22 = (58: UInt8.t)
  /\ Seq.get s 25 = (32: UInt8.t)
  /\ Seq.get s 26 = (71: UInt8.t)
  /\ Seq.get s 27 = (77: UInt8.t)
  /\ Seq.get s 28 = (84: UInt8.t)
  /\ imf_digit (Seq.get s 5)
  /\ imf_digit (Seq.get s 6)
  /\ imf_digit (Seq.get s 12)
  /\ imf_digit (Seq.get s 13)
  /\ imf_digit (Seq.get s 14)
  /\ imf_digit (Seq.get s 15)
  /\ imf_digit (Seq.get s 17)
  /\ imf_digit (Seq.get s 18)
  /\ imf_digit (Seq.get s 20) /\ imf_digit (Seq.get s 21) /\ imf_digit (Seq.get s 23) /\ imf_digit (Seq.get s 24)

meta "rewrite_def" predicate imf_syntax

predicate imf_encoding [@inline:trivial] (s: Seq.seq UInt8.t) (d: t_RawDate) =
  imf_syntax s
  /\ imf_month s = UInt8.t'int d.mon
  /\ imf_weekday s = UInt8.t'int d.wday
  /\ (UInt8.t'int (Seq.get s 5) - 48) * 10 + UInt8.t'int (Seq.get s 6) - 48 = UInt8.t'int d.day
  /\ (UInt8.t'int (Seq.get s 12) - 48) * 1000 + (UInt8.t'int (Seq.get s 13) - 48) * 100
          + (UInt8.t'int (Seq.get s 14) - 48) * 10
        + UInt8.t'int (Seq.get s 15)
      - 48
    = UInt16.t'int d.year
  /\ (UInt8.t'int (Seq.get s 17) - 48) * 10 + UInt8.t'int (Seq.get s 18) - 48 = UInt8.t'int d.hour
  /\ (UInt8.t'int (Seq.get s 20) - 48) * 10 + UInt8.t'int (Seq.get s 21) - 48 = UInt8.t'int d.min
  /\ (UInt8.t'int (Seq.get s 23) - 48) * 10 + UInt8.t'int (Seq.get s 24) - 48 = UInt8.t'int d.sec

meta "rewrite_def" predicate imf_encoding

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

