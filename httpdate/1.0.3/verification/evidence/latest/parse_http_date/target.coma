use creusot.prelude.Char
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_HttpDate

type t_Error = { f0: () }

type t_Result_HttpDate_Error = Ok t_HttpDate | Err t_Error

predicate invariant_HttpDate (self: t_HttpDate)

predicate inv_HttpDate (_1: t_HttpDate)

axiom inv_axiom: forall x: t_HttpDate [inv_HttpDate x]. inv_HttpDate x -> invariant_HttpDate x

predicate inv_Result_HttpDate_Error (_1: t_Result_HttpDate_Error)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_Result_HttpDate_Error [inv_Result_HttpDate_Error x]. inv_Result_HttpDate_Error x
    = match x with
      | Ok f0'0 -> inv_HttpDate f0'0
      | Err f0'0 -> true
      end

type t_RawDate

predicate valid_calendar (d: t_RawDate)

function raw_model (self: t_HttpDate) : t_RawDate

predicate parsed_text (s: Seq.seq Char.t) (d: t_RawDate)

function view_str (self: string) : Seq.seq Char.t

let from_str_HttpDate (s: string) (return (x: t_Result_HttpDate_Error)) = any
  [ return (result: t_Result_HttpDate_Error) ->
  {[@stop_split] [@expl:from_str_HttpDate ensures] ([@stop_split] [@expl:from_str result type invariant] inv_Result_HttpDate_Error result)
    /\ ([@stop_split] [@expl:from_str ensures] match result with
      | Ok d -> valid_calendar (raw_model d) /\ parsed_text (view_str s) (raw_model d)
      | Err _ -> forall d: t_RawDate. parsed_text (view_str s) d -> not valid_calendar d
      end)}
    (! return {result}) ]

let elim_Err (_x: t_Result_HttpDate_Error) (return (f0'0: t_Error)) = any
  [ _k (f0'0: t_Error) -> {Err f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_SystemTime

type t_Result_SystemTime_Error = Ok'0 t_SystemTime | Err'0 t_Error

let elim_Ok (_x: t_Result_HttpDate_Error) (return (f0'0: t_HttpDate)) = any
  [ _k (f0'0: t_HttpDate) -> {Ok f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

predicate inv_SystemTime (_1: t_SystemTime)

function time_ns (_t: t_SystemTime) : int

function unix_seconds_model (d: t_RawDate) : int

let from_SystemTime (v: t_HttpDate) (return (x: t_SystemTime)) =
{[@stop_split] [@expl:from 'v' type invariant] inv_HttpDate v}
  any
  [ return (result: t_SystemTime) ->
  {[@stop_split] [@expl:from_SystemTime ensures] ([@stop_split] [@expl:from result type invariant] inv_SystemTime result)
    /\ ([@stop_split] [@expl:from ensures] time_ns result = unix_seconds_model (raw_model v) * 1000000000)}
    (! return {result}) ]

predicate inv_Result_SystemTime_Error (_1: t_Result_SystemTime_Error)

axiom inv_axiom'1 [@rewrite]:
  forall x: t_Result_SystemTime_Error [inv_Result_SystemTime_Error x]. inv_Result_SystemTime_Error x
    = match x with
      | Ok'0 f0'0 -> inv_SystemTime f0'0
      | Err'0 f0'0 -> true
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let parse_http_date (s: string) (return (x: t_Result_SystemTime_Error)) = (! bb0
  [ bb0 = s0
    [ s0 = from_str_HttpDate {s} (fun (_x: t_Result_HttpDate_Error) -> [ &_4 <- _x ] s1)
    | s1 = any [ br0 (x0: t_HttpDate) -> {_4 = Ok x0} (! bb5) | br1 (x0: t_Error) -> {_4 = Err x0} (! bb4) ] ]
  | bb4 = s0
    [ s0 = elim_Err {_4} (fun (r0: t_Error) -> [ &error <- r0 ] s1)
    | s1 = [ &_ret <- Err'0 error ] s2
    | s2 = return {_ret} ]
  | bb5 = s0
    [ s0 = elim_Ok {_4} (fun (r0: t_HttpDate) -> [ &d <- r0 ] s1)
    | s1 = from_SystemTime {d} (fun (_x: t_SystemTime) -> [ &_8 <- _x ] s2)
    | s2 = [ &_ret <- Ok'0 _8 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_SystemTime_Error = Any.any_l ()
  | & s: string = s
  | & _4: t_Result_HttpDate_Error = Any.any_l ()
  | & d: t_HttpDate = Any.any_l ()
  | & _8: t_SystemTime = Any.any_l ()
  | & error: t_Error = Any.any_l () ])
  [ return (result: t_Result_SystemTime_Error) ->
  {[@stop_split] [@expl:parse_http_date ensures] ([@stop_split] [@expl:parse_http_date result type invariant] inv_Result_SystemTime_Error result)
    /\ ([@stop_split] [@expl:parse_http_date ensures] match result with
      | Ok'0 t -> exists d: t_RawDate. valid_calendar d
        /\ parsed_text (view_str s) d /\ time_ns t = unix_seconds_model d * 1000000000
      | Err'0 _ -> forall d: t_RawDate. parsed_text (view_str s) d -> not valid_calendar d
      end)}
    (! return {result}) ]
