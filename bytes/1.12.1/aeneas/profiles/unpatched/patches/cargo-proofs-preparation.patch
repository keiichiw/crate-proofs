+        fs::write(
+            root.join("proofs-prepare.toml"),
+            r#"
+schema_version = 1
+command = ["default"]
+source_lock = "source.lock.json"
+source_dir = ".work/source"
+[profiles."aeneas/profiles/stage3"]
+schema_version = 1
+command = ["stage3"]
+source_lock = "source.lock.json"
+source_dir = ".work/source"
+lean_source = "aeneas/profiles/stage3/proofs"
