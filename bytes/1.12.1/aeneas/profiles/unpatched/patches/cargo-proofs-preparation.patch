new file mode 100644
index 0000000..c26e48f
--- /dev/null
+++ b/cli/src/preparation.rs
@@ -0,0 +1,1025 @@
+//! Optional repository preparation. Its code and logs never enter SARIF.
+use anyhow::{ensure, Context, Result};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    fs,
+    io::Read,
+    path::{Component, Path, PathBuf},
+    process::{Command, Stdio},
+};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Preparation {
+    pub schema_version: u32,
+    pub command: Vec<String>,
+    pub source_lock: PathBuf,
+    pub source_dir: PathBuf,
+    #[serde(default)]
+    pub toolchain_lock: Option<PathBuf>,
+    #[serde(default)]
+    pub tool_dir: Option<PathBuf>,
+    #[serde(default)]
+    pub lean_source: Option<PathBuf>,
+    #[serde(default)]
+    pub lean_build: Option<PathBuf>,
+    /// Package-relative report directory to preparation settings. Longest prefix wins.
+    #[serde(default)]
+    pub profiles: BTreeMap<PathBuf, Preparation>,
+}
+
+pub fn sha(path: &Path) -> Result<String> {
+    Ok(format!("{:x}", Sha256::digest(fs::read(path)?)))
+}
+
+fn native_host() -> Result<&'static str> {
+    match (std::env::consts::OS, std::env::consts::ARCH) {
+        ("macos", "aarch64") => Ok("aarch64-apple-darwin"),
+        ("linux", "x86_64") => Ok("x86_64-unknown-linux-gnu"),
+        _ => anyhow::bail!("Unsupported prepared native host"),
+    }
+}
+
+fn local(root: &Path, path: &Path) -> Result<PathBuf> {
+    ensure!(
+        !path.as_os_str().is_empty()
+            && !path.is_absolute()
+            && path.components().all(|c| matches!(c, Component::Normal(_))),
+        "Preparation path must stay within package"
+    );
+    let rendered = path.to_string_lossy().replace("@HOST@", native_host()?);
+    let joined = root.join(rendered);
+    ensure!(
+        joined.canonicalize()?.starts_with(root.canonicalize()?),
+        "Preparation path escapes package"
+    );
+    Ok(joined)
+}
+
+// Tool caches can be shared outside the package. Their Git trees and patches are
+// checked independently; this exception never applies to application sources.
+fn tool_directory(root: &Path, path: &Path) -> Result<PathBuf> {
+    ensure!(
+        !path.as_os_str().is_empty()
+            && !path.is_absolute()
+            && path.components().all(|c| matches!(c, Component::Normal(_))),
+        "Tool cache reference must be package-relative"
+    );
+    Ok(root.join(path).canonicalize()?)
+}
+
+pub fn manifest(args: &crate::ProjectArgs) -> Result<PathBuf> {
+    if let Some(path) = &args.manifest_path {
+        return Ok(path.canonicalize()?);
+    }
+    let mut dir = std::env::current_dir()?;
+    loop {
+        if dir.join("Cargo.toml").is_file() {
+            return Ok(dir.join("Cargo.toml"));
+        }
+        ensure!(dir.pop(), "Cannot find Cargo.toml before preparation");
+    }
+}
+
+pub fn read(root: &Path) -> Result<Option<Preparation>> {
+    let file = root.join("proofs-prepare.toml");
+    if !file.exists() {
+        return Ok(None);
+    }
+    let spec: Preparation = toml::from_str(&fs::read_to_string(file)?)?;
+    ensure!(spec.schema_version == 1, "Unsupported preparation schema");
+    ensure!(
+        !spec.command.is_empty() && spec.command.iter().all(|s| !s.contains('\0')),
+        "Empty/invalid preparation command"
+    );
+    ensure!(
+        spec.toolchain_lock.is_some() == spec.tool_dir.is_some(),
+        "Tool lock and directory must be specified together"
+    );
+    ensure!(
+        spec.lean_source.is_some() == spec.lean_build.is_some(),
+        "Lean source and build must be specified together"
+    );
+    Ok(Some(spec))
+}
+
+pub fn read_for(root: &Path, config: Option<&Path>) -> Result<Option<Preparation>> {
+    let Some(mut spec) = read(root)? else {
+        return Ok(None);
+    };
+    let selected = config.and_then(|path| {
+        spec.profiles
+            .keys()
+            .filter(|prefix| path.starts_with(prefix))
+            .max_by_key(|prefix| prefix.components().count())
+            .cloned()
+    });
+    if let Some(key) = selected {
+        let child = spec.profiles.remove(&key).unwrap();
+        ensure!(
+            child.profiles.is_empty(),
+            "Nested preparation profile maps are unsupported"
+        );
+        ensure!(
+            !child.command.is_empty() && child.command.iter().all(|s| !s.contains('\0')),
+            "Empty/invalid profile preparation command"
+        );
+        ensure!(
+            child.schema_version == 1
+                && child.toolchain_lock.is_some() == child.tool_dir.is_some()
+                && child.lean_source.is_some() == child.lean_build.is_some(),
+            "Invalid profile preparation settings"
+        );
+        return Ok(Some(child));
+    }
+    Ok(Some(spec))
+}
+
+/// Called only by explicit run, before Cargo discovery, and in its isolated checkout.
+#[cfg(test)]
+pub fn prepare(root: &Path) -> Result<Option<Value>> {
+    prepare_for(root, None)
+}
+
+pub fn prepare_for(root: &Path, config: Option<&Path>) -> Result<Option<Value>> {
+    let Some(spec) = read_for(root, config)? else {
+        return Ok(None);
+    };
+    let logs = root.join(".work/preparation");
+    fs::create_dir_all(&logs)?;
+    let name = uuid::Uuid::new_v4().to_string();
+    let out = fs::File::create(logs.join(format!("{name}.stdout.log")))?;
+    let err = fs::File::create(logs.join(format!("{name}.stderr.log")))?;
+    let status = Command::new(&spec.command[0])
+        .args(&spec.command[1..])
+        .current_dir(root)
+        .stdin(Stdio::null())
+        .stdout(out)
+        .stderr(err)
+        .status()
+        .context("Start repository preparation")?;
+    ensure!(
+        status.success(),
+        "Repository preparation failed; logs: {}",
+        logs.display()
+    );
+    verify(root, &spec).map(Some)
+}
+
+#[derive(Deserialize, PartialEq, Eq, Debug)]
+#[serde(deny_unknown_fields)]
+struct FileIdentity {
+    sha256: String,
+    executable: bool,
+}
+
+fn files(root: &Path, dir: &Path, result: &mut BTreeMap<String, FileIdentity>) -> Result<()> {
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        ensure!(!kind.is_symlink(), "Symlink in prepared source");
+        let path = entry.path();
+        if kind.is_dir() {
+            files(root, &path, result)?;
+        } else {
+            ensure!(kind.is_file(), "Nonregular prepared source");
+            #[cfg(unix)]
+            let executable = {
+                use std::os::unix::fs::PermissionsExt;
+                entry.metadata()?.permissions().mode() & 0o111 != 0
+            };
+            #[cfg(not(unix))]
+            let executable = false;
+            result.insert(
+                path.strip_prefix(root)?
+                    .to_str()
+                    .context("Non UTF-8 source path")?
+                    .replace('\\', "/"),
+                FileIdentity {
+                    sha256: sha(&path)?,
+                    executable,
+                },
+            );
+        }
+    }
+    Ok(())
+}
+
+pub fn verify(root: &Path, spec: &Preparation) -> Result<Value> {
+    let path = local(root, &spec.source_lock)?;
+    let lock: Value = serde_json::from_slice(&fs::read(&path)?)?;
+    ensure!(lock["schema_version"] == 1, "Unsupported source lock");
+    let kind = lock["kind"].as_str().context("Missing source kind")?;
+    let origin = match kind {
+        "registry" => {
+            let name = lock["name"].as_str().context("Missing crate name")?;
+            let version = lock["version"].as_str().context("Missing crate version")?;
+            ensure!(
+                lock["url"]
+                    == format!("https://static.crates.io/crates/{name}/{name}-{version}.crate"),
+                "Noncanonical registry origin"
+            );
+            ensure!(
+                lock["sha256"].as_str().is_some_and(hex256),
+                "Invalid archive checksum"
+            );
+            json!({"kind":kind,"name":name,"version":version,"url":lock["url"],"sha256":lock["sha256"]})
+        }
+        "git" => {
+            ensure!(
+                lock["url"]
+                    .as_str()
+                    .is_some_and(|s| s.starts_with("https://"))
+                    && lock["commit"]
+                        .as_str()
+                        .is_some_and(|s| s.len() == 40 && s.bytes().all(|c| c.is_ascii_hexdigit())),
+                "Invalid Git origin"
+            );
+            json!({"kind":kind,"url":lock["url"],"commit":lock["commit"],"subdirectory":lock["subdirectory"]})
+        }
+        _ => anyhow::bail!("Unsupported source kind"),
+    };
+    let expected: BTreeMap<String, FileIdentity> = serde_json::from_value(lock["files"].clone())?;
+    ensure!(
+        !expected.is_empty() && expected.values().all(|x| hex256(&x.sha256)),
+        "Invalid source inventory"
+    );
+    verify_origin(root, &lock, &expected)?;
+    let source = local(root, &spec.source_dir)?;
+    let mut actual = BTreeMap::new();
+    files(&source, &source, &mut actual)?;
+    ensure!(
+        actual == expected,
+        "Prepared source differs from pinned inventory"
+    );
+    let mut provenance = json!({"source":origin,"source_lock":{"path":spec.source_lock,"sha256":sha(&path)?},
+            "configuration":{"path":"proofs-prepare.toml","sha256":sha(&root.join("proofs-prepare.toml"))?},
+            "host":native_host()?});
+    if let (Some(lock_path), Some(tool_dir)) = (&spec.toolchain_lock, &spec.tool_dir) {
+        let file = local(root, lock_path)?;
+        let tools: Value = serde_json::from_slice(&fs::read(&file)?)?;
+        let directory = tool_directory(root, tool_dir)?;
+        verify_tools(file.parent().unwrap(), &directory, &tools)?;
+        // Only references and identities; patch and script contents are deliberately omitted.
+        provenance["toolchain"] = json!({"lock":lock_path,"sha256":sha(&file)?,"repositories":tool_identities(&tools),
+            "native_rust":tools["native_rust"],"extraction_rust":tools["extraction_rust"],"lean":tools["lean"]});
+    }
+    if let (Some(authored), Some(built)) = (&spec.lean_source, &spec.lean_build) {
+        let authored = local(root, authored)?;
+        let built = local(root, built)?;
+        let mut originals = BTreeMap::new();
+        let mut copies = BTreeMap::new();
+        lean_files(&authored, &authored, &mut originals)?;
+        lean_files(&built, &built, &mut copies)?;
+        ensure!(
+            originals == copies,
+            "Build copy differs from maintained Lean sources"
+        );
+        provenance["lean_inputs"] = json!(originals);
+    }
+    Ok(provenance)
+}
+
+/// Only typed identity fields cross the SARIF boundary; lock extensions may contain local notes/logs.
+fn tool_identities(lock: &Value) -> Value {
+    let mut repositories = serde_json::Map::new();
+    if let Some(entries) = lock["repositories"].as_object() {
+        for (name, spec) in entries {
+            let patches: Vec<_> = spec["patches"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .map(|patch| json!({"file":patch["file"],"sha256":patch["sha256"]}))
+                .collect();
+            repositories.insert(name.clone(), json!({"url":spec["url"],"revision":spec["revision"],"tree":spec["tree"],"patches":patches}));
+        }
+    }
+    Value::Object(repositories)
+}
+
+fn lean_files(root: &Path, dir: &Path, result: &mut BTreeMap<String, String>) -> Result<()> {
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        if entry.file_name() == ".lake" {
+            continue;
+        }
+        let path = entry.path();
+        ensure!(
+            !entry.file_type()?.is_symlink(),
+            "Symlink in maintained Lean sources"
+        );
+        if path.is_dir() {
+            lean_files(root, &path, result)?;
+        } else if path.extension().is_some_and(|ext| ext == "lean") {
+            result.insert(
+                path.strip_prefix(root)?.to_string_lossy().to_string(),
+                sha(&path)?,
+            );
+        }
+    }
+    Ok(())
+}
+
+pub fn maintained_path(package: &Path, path: &Path) -> Result<PathBuf> {
+    if let Some(spec) = read(package)? {
+        for candidate in std::iter::once(&spec).chain(spec.profiles.values()) {
+            if let (Some(authored), Some(built)) = (&candidate.lean_source, &candidate.lean_build) {
+                let Ok(build) = local(package, built) else {
+                    continue;
+                };
+                if let Ok(relative) = path.canonicalize()?.strip_prefix(build.canonicalize()?) {
+                    return Ok(local(package, authored)?.join(relative));
+                }
+            }
+        }
+    }
+    Ok(path.to_owned())
+}
+
+fn hex256(s: &str) -> bool {
+    s.len() == 64 && s.bytes().all(|c| c.is_ascii_hexdigit())
+}
+
+fn archive_inventory(reader: impl Read, prefix: &str) -> Result<BTreeMap<String, FileIdentity>> {
+    let mut archive = tar::Archive::new(reader);
+    let mut result = BTreeMap::new();
+    let mut total = 0u64;
+    for item in archive.entries()? {
+        let mut item = item?;
+        let path = item.path()?.into_owned();
+        ensure!(
+            path.components().all(|c| matches!(c, Component::Normal(_))),
+            "Unsafe archive path"
+        );
+        ensure!(path.starts_with(prefix), "Archive prefix mismatch");
+        if item.header().entry_type().is_dir() {
+            continue;
+        }
+        ensure!(
+            item.header().entry_type().is_file(),
+            "Unsupported archive member"
+        );
+        let name = path
+            .strip_prefix(prefix)?
+            .to_str()
+            .context("Non UTF-8 archive path")?
+            .to_owned();
+        ensure!(
+            !name.is_empty() && !result.contains_key(&name),
+            "Duplicate or empty archive member"
+        );
+        total = total
+            .checked_add(item.size())
+            .context("Archive size overflow")?;
+        ensure!(total <= 512 * 1024 * 1024, "Expanded archive too large");
+        let executable = item.header().mode()? & 0o111 != 0;
+        let mut hash = Sha256::new();
+        std::io::copy(&mut item, &mut hash)?;
+        result.insert(
+            name,
+            FileIdentity {
+                sha256: format!("{:x}", hash.finalize()),
+                executable,
+            },
+        );
+    }
+    Ok(result)
+}
+
+fn verify_origin(
+    root: &Path,
+    lock: &Value,
+    expected: &BTreeMap<String, FileIdentity>,
+) -> Result<()> {
+    let actual = if lock["kind"] == "registry" {
+        let checksum = lock["sha256"]
+            .as_str()
+            .context("Missing archive checksum")?;
+        let archive = root.join(".work/cache").join(format!("{checksum}.crate"));
+        ensure!(
+            sha(&archive)? == checksum,
+            "Cached source archive checksum mismatch"
+        );
+        let prefix = format!(
+            "{}-{}",
+            lock["name"].as_str().unwrap(),
+            lock["version"].as_str().unwrap()
+        );
+        archive_inventory(
+            flate2::read::GzDecoder::new(fs::File::open(archive)?),
+            &prefix,
+        )?
+    } else {
+        let url = lock["url"].as_str().unwrap();
+        let commit = lock["commit"].as_str().unwrap();
+        let key = format!("{:x}", Sha256::digest(format!("{url}{commit}").as_bytes()));
+        let cache = root.join(".work/cache").join(format!("{key}.git"));
+        ensure!(
+            git(&cache, &["rev-parse", &format!("{commit}^{{commit}}")])? == commit,
+            "Git source commit missing"
+        );
+        let sub = lock["subdirectory"].as_str().unwrap_or("");
+        ensure!(
+            sub.is_empty()
+                || Path::new(sub)
+                    .components()
+                    .all(|c| matches!(c, Component::Normal(_))),
+            "Unsafe Git subdirectory"
+        );
+        let tree = if sub.is_empty() {
+            commit.to_owned()
+        } else {
+            format!("{commit}:{sub}")
+        };
+        let temp = tempfile::tempfile()?;
+        let status = Command::new("git")
+            .arg("-C")
+            .arg(cache)
+            .args(["archive", "--prefix=source/", &tree])
+            .stdout(temp.try_clone()?)
+            .status()?;
+        ensure!(status.success(), "Cannot inspect pinned Git source");
+        use std::io::{Seek, SeekFrom};
+        let mut temp = temp;
+        temp.seek(SeekFrom::Start(0))?;
+        archive_inventory(temp, "source")?
+    };
+    ensure!(
+        &actual == expected,
+        "Source inventory is not the pinned upstream archive/tree"
+    );
+    Ok(())
+}
+
+fn git(dir: &Path, args: &[&str]) -> Result<String> {
+    crate::git::run(dir, args)
+}
+
+// Git's index flags can suppress working-tree diffs. Read every staged blob and
+// compare actual files as well, so assume-unchanged/skip-worktree cannot hide edits.
+fn verify_tracked_files(checkout: &Path) -> Result<()> {
+    use std::io::{BufRead, BufReader, Write};
+    let entries = git(checkout, &["ls-files", "--stage", "-z"])?;
+    let mut child = Command::new("git")
+        .arg("-C")
+        .arg(checkout)
+        .args(["cat-file", "--batch"])
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()?;
+    let mut input = child.stdin.take().context("Missing Git input")?;
+    let mut output = BufReader::new(child.stdout.take().context("Missing Git output")?);
+    for entry in entries.split('\0').filter(|s| !s.is_empty()) {
+        let (metadata, name) = entry.split_once('\t').context("Invalid Git index entry")?;
+        let fields: Vec<_> = metadata.split_whitespace().collect();
+        ensure!(fields.len() == 3 && fields[2] == "0", "Unmerged tool index");
+        // The Charon repository has its own full lock and may have reviewed patches.
+        if fields[0] == "160000" {
+            continue;
+        }
+        let relative = Path::new(name);
+        ensure!(
+            relative
+                .components()
+                .all(|c| matches!(c, Component::Normal(_))),
+            "Invalid tool source path"
+        );
+        let path = checkout.join(relative);
+        let mut parent = path.parent();
+        while let Some(dir) = parent {
+            if dir == checkout {
+                break;
+            }
+            ensure!(
+                !fs::symlink_metadata(dir)?.file_type().is_symlink(),
+                "Symlink tool source directory"
+            );
+            parent = dir.parent();
+        }
+        let stat = fs::symlink_metadata(&path)?;
+        let actual = match fields[0] {
+            "120000" => {
+                ensure!(stat.file_type().is_symlink(), "Tool symlink changed");
+                fs::read_link(&path)?
+                    .to_str()
+                    .context("Non UTF-8 tool symlink")?
+                    .as_bytes()
+                    .to_vec()
+            }
+            "100644" | "100755" => {
+                ensure!(
+                    stat.is_file() && !stat.file_type().is_symlink(),
+                    "Tool source is not a regular file"
+                );
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::PermissionsExt;
+                    ensure!(
+                        (stat.permissions().mode() & 0o111 != 0) == (fields[0] == "100755"),
+                        "Tool executable mode changed"
+                    );
+                }
+                fs::read(&path)?
+            }
+            _ => anyhow::bail!("Unsupported tool source mode"),
+        };
+        writeln!(input, "{}", fields[1])?;
+        input.flush()?;
+        let mut header = String::new();
+        output.read_line(&mut header)?;
+        let parts: Vec<_> = header.split_whitespace().collect();
+        ensure!(
+            parts.len() == 3 && parts[0] == fields[1] && parts[1] == "blob",
+            "Missing staged tool blob"
+        );
+        let size: usize = parts[2].parse()?;
+        ensure!(size == actual.len(), "Tool tracked source changed: {name}");
+        let mut expected = vec![0; size];
+        output.read_exact(&mut expected)?;
+        let mut newline = [0];
+        output.read_exact(&mut newline)?;
+        ensure!(
+            newline == [b'\n'] && actual == expected,
+            "Tool tracked source changed: {name}"
+        );
+    }
+    drop(input);
+    ensure!(child.wait()?.success(), "Cannot read pinned tool blobs");
+    Ok(())
+}
+
+fn verify_tools(profile: &Path, root: &Path, lock: &Value) -> Result<()> {
+    ensure!(lock["schema_version"] == 1, "Unsupported tool lock");
+    let repos = lock["repositories"]
+        .as_object()
+        .context("Missing tool repositories")?;
+    ensure!(
+        repos.len() == 3
+            && ["aeneas", "charon", "proofs-rs"]
+                .iter()
+                .all(|name| repos.contains_key(*name)),
+        "Tool lock must include Aeneas, Charon and cargo-proofs"
+    );
+    ensure!(
+        sha(&profile.join("opam.locked"))? == lock["opam_sha256"],
+        "OCaml dependency lock changed"
+    );
+    for (name, spec) in repos {
+        ensure!(
+            ["aeneas", "charon", "proofs-rs"].contains(&name.as_str()),
+            "Unknown tool repository"
+        );
+        let checkout = root.join(if name == "charon" {
+            "aeneas/charon"
+        } else {
+            name
+        });
+        let revision = spec["revision"].as_str().context("Missing tool revision")?;
+        let tree = spec["tree"].as_str().context("Missing tool tree")?;
+        ensure!(
+            revision.len() == 40 && revision.bytes().all(|c| c.is_ascii_hexdigit()),
+            "Tool revision must be a full commit ID"
+        );
+        let origin = spec["url"].as_str().context("Missing tool origin")?;
+        ensure!(
+            git(&checkout, &["remote", "get-url", "origin"])? == origin,
+            "Tool repository origin changed"
+        );
+        ensure!(
+            git(&checkout, &["ls-files", "--others", "--exclude-standard"])?.is_empty(),
+            "Untracked tool source files"
+        );
+        ensure!(
+            git(&checkout, &["rev-parse", "HEAD"])? == revision,
+            "Tool base changed"
+        );
+        // Reconstruct the declared patch tree independently of the preparation receipt/index.
+        let temp = tempfile::tempdir()?;
+        let index = temp.path().join("index");
+        let replay = |args: &[&str]| -> Result<String> {
+            let out = Command::new("git")
+                .arg("-C")
+                .arg(&checkout)
+                .args(args)
+                .env("GIT_INDEX_FILE", &index)
+                .output()?;
+            ensure!(out.status.success(), "Cannot replay pinned tool patches");
+            Ok(String::from_utf8(out.stdout)?.trim().to_owned())
+        };
+        replay(&["read-tree", revision])?;
+        for patch in spec["patches"].as_array().context("Missing patch list")? {
+            let path = local(
+                profile,
+                Path::new(patch["file"].as_str().context("Missing patch path")?),
+            )?;
+            ensure!(sha(&path)? == patch["sha256"], "Tool patch changed");
+            replay(&[
+                "apply",
+                "--cached",
+                path.to_str().context("Non UTF-8 patch path")?,
+            ])?;
+        }
+        ensure!(
+            replay(&["write-tree"])? == tree,
+            "Declared patches do not produce tool tree"
+        );
+        // Read the shared index without locking or refreshing it. Patch replay above
+        // owns a private index and independently establishes the declared tree.
+        git(
+            &checkout,
+            &[
+                "diff",
+                "--cached",
+                "--ignore-submodules=none",
+                "--quiet",
+                tree,
+                "--",
+            ],
+        )
+        .context("Tool patched tree changed")?;
+        git(
+            &checkout,
+            &["diff", "--ignore-submodules=all", "--exit-code"],
+        )?;
+        verify_tracked_files(&checkout)?;
+    }
+    Ok(())
+}
+
+/// The local Lake dependency exception is limited to a fully replayed tool lock.
+pub fn backend_allowed(dir: &Path, version: &str) -> Result<bool> {
+    for root in dir.ancestors() {
+        if let Some(config) = read(root)? {
+            let candidates: Vec<_> = std::iter::once(&config)
+                .chain(config.profiles.values())
+                .filter(|spec| {
+                    spec.lean_build.as_ref().is_some_and(|path| {
+                        local(root, path)
+                            .ok()
+                            .is_some_and(|build| crate::config::same_path(&build, dir))
+                    })
+                })
+                .collect();
+            ensure!(
+                candidates.len() <= 1,
+                "Ambiguous preparation profile for Lean directory"
+            );
+            let Some(spec) = candidates.first() else {
+                return Ok(false);
+            };
+            verify(root, &spec)?;
+            if let (Some(lock_path), Some(tool_dir)) = (&spec.toolchain_lock, &spec.tool_dir) {
+                let lock: Value = serde_json::from_slice(&fs::read(local(root, lock_path)?)?)?;
+                ensure!(
+                    lock["repositories"]["aeneas"]["url"]
+                        == "https://github.com/AeneasVerif/aeneas.git"
+                        && lock["repositories"]["aeneas"]["revision"] == version,
+                    "Aeneas base differs from report"
+                );
+                let manifest: Value =
+                    serde_json::from_slice(&fs::read(dir.join("lake-manifest.json"))?)?;
+                let packages = manifest["packages"]
+                    .as_array()
+                    .context("Missing Lake packages")?;
+                let a: Vec<_> = packages.iter().filter(|p| p["name"] == "aeneas").collect();
+                if a.len() != 1 || a[0]["type"] != "path" {
+                    return Ok(false);
+                }
+                let path = a[0]["dir"].as_str().context("Missing backend path")?;
+                return Ok(crate::config::same_path(
+                    &dir.join(path),
+                    &tool_directory(root, tool_dir)?.join("aeneas/backends/lean"),
+                ));
+            }
+            return Ok(false);
+        }
+    }
+    Ok(false)
+}
