+    #[test]
+    fn source_and_sarif_boundary() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path();
+        fs::create_dir(root.join("source")).unwrap();
+        fs::write(root.join("source/lib.rs"), "pub fn f() {}\n").unwrap();
+        let hash = sha(&root.join("source/lib.rs")).unwrap();
+        fs::create_dir_all(root.join(".work/cache")).unwrap();
+        let encoder = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+        let mut archive = tar::Builder::new(encoder);
+        let content = fs::read(root.join("source/lib.rs")).unwrap();
+        let mut header = tar::Header::new_gnu();
+        header.set_size(content.len() as u64);
+        header.set_mode(0o644);
+        header.set_cksum();
+        archive
+            .append_data(&mut header, "demo-1.0.0/lib.rs", content.as_slice())
+            .unwrap();
+        let bytes = archive.into_inner().unwrap().finish().unwrap();
+        let checksum = format!("{:x}", Sha256::digest(&bytes));
+        fs::write(
+            root.join(".work/cache").join(format!("{checksum}.crate")),
+            bytes,
+        )
+        .unwrap();
+        let lock = json!({"schema_version":1,"kind":"registry","name":"demo","version":"1.0.0",
+            "url":"https://static.crates.io/crates/demo/demo-1.0.0.crate","sha256":checksum,
+            "files":{"lib.rs":{"sha256":hash,"executable":false}}});
+        fs::write(root.join("source.lock.json"), lock.to_string()).unwrap();
+        let spec = Preparation {
+            schema_version: 1,
+            command: vec!["SECRET_SETUP_SCRIPT".into()],
+            source_lock: "source.lock.json".into(),
+            source_dir: "source".into(),
+            toolchain_lock: None,
+            tool_dir: None,
+            lean_source: None,
+            lean_build: None,
+            profiles: BTreeMap::new(),
+        };
+        fs::write(
+            root.join("proofs-prepare.toml"),
+            "test configuration identity",
+        )
+        .unwrap();
+        let provenance = verify(root, &spec).unwrap().to_string();
+        assert!(!provenance.contains("SECRET_SETUP_SCRIPT"));
+        fs::write(
+            root.join("proofs-prepare.toml"),
+            r#"
+schema_version = 1
+command = ["sh", "-c", "echo SECRET_SETUP_STDOUT; echo SECRET_SETUP_STDERR >&2"]
+source_lock = "source.lock.json"
+source_dir = "source"
+"#,
+        )
+        .unwrap();
+        let prepared = prepare(root).unwrap().unwrap().to_string();
+        assert!(!prepared.contains("SECRET_SETUP"));
+        let logs: String = fs::read_dir(root.join(".work/preparation"))
+            .unwrap()
+            .map(|p| fs::read_to_string(p.unwrap().path()).unwrap())
+            .collect();
+        assert!(logs.contains("SECRET_SETUP_STDOUT") && logs.contains("SECRET_SETUP_STDERR"));
+        let failed = fs::read_to_string(root.join("proofs-prepare.toml"))
+            .unwrap()
+            .replace(
+                "echo SECRET_SETUP_STDERR >&2",
+                "echo SECRET_SETUP_STDERR >&2; exit 1",
+            );
+        fs::write(root.join("proofs-prepare.toml"), failed).unwrap();
+        let failure = prepare(root).unwrap_err().to_string();
+        assert!(!failure.contains("SECRET_SETUP"));
+        assert!(!root.join("run.sarif.json").exists());
+        fs::write(root.join("source/extra.rs"), "extra").unwrap();
+        assert!(verify(root, &spec).is_err());
+        fs::remove_file(root.join("source/extra.rs")).unwrap();
+        fs::write(root.join("source/lib.rs"), "changed").unwrap();
+        assert!(verify(root, &spec).is_err());
+    }
+    #[test]
