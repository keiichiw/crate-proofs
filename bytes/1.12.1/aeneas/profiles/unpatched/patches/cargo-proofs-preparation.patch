+            let url = format!("https://example.invalid/{name}.git");
+            git(&dir, &["remote", "add", "origin", &url]).unwrap();
+            let mut patches = Vec::new();
+            if name == "aeneas" {
+                fs::write(dir.join("model.txt"), "reviewed patch\n").unwrap();
+                let patch = git(&dir, &["diff", "--binary"]).unwrap() + "\n";
+                fs::write(profile.join("model.patch"), patch).unwrap();
+                patches.push(json!({"file":"model.patch", "sha256":sha(&profile.join("model.patch")).unwrap()}));
+                git(&dir, &["add", "model.txt"]).unwrap();
+            }
+            repositories.insert(
+                name.into(),
+                json!({"url":url,"revision":revision,
+                "tree":git(&dir,&["write-tree"]).unwrap(),"patches":patches}),
+            );
+        }
+        let lock = json!({"schema_version":1,"opam_sha256":sha(&profile.join("opam.locked")).unwrap(),"repositories":repositories});
+        // A fresh git apply --index need not have materialized the tree object.
+        // The independent private-index replay must establish it before comparison.
+        let tree = lock["repositories"]["aeneas"]["tree"].as_str().unwrap();
+        let object = root
+            .join("aeneas/.git/objects")
+            .join(&tree[..2])
+            .join(&tree[2..]);
+        fs::remove_file(&object).unwrap();
+        verify_tools(&profile, root, &lock).unwrap();
+        assert!(object.is_file());
+        // Independent preparations may share tool sources. A legitimate lock held
+        // by another process must not prevent these read-only trust checks.
+        let indexes: Vec<_> = ["aeneas", "aeneas/charon", "proofs-rs"]
+            .iter()
+            .map(|name| {
+                let index = root.join(name).join(".git/index");
+                let before = fs::read(&index).unwrap();
+                let held = index.with_file_name("index.lock");
+                fs::write(&held, "sentinel").unwrap();
+                (index, before, held)
+            })
+            .collect();
+        std::thread::scope(|scope| {
+            for _ in 0..8 {
+                scope.spawn(|| verify_tools(&profile, root, &lock).unwrap());
+            }
+        });
+        for (index, before, held) in indexes {
+            assert_eq!(fs::read(index).unwrap(), before);
+            assert_eq!(fs::read_to_string(&held).unwrap(), "sentinel");
+            fs::remove_file(held).unwrap();
+        }
+        let dir = root.join("aeneas");
+        for flag in ["--assume-unchanged", "--skip-worktree"] {
+            git(&dir, &["update-index", flag, "model.txt"]).unwrap();
+            fs::write(dir.join("model.txt"), "hidden mutated body\n").unwrap();
+            assert!(verify_tools(&profile, root, &lock)
+                .unwrap_err()
+                .to_string()
+                .contains("tracked source changed"));
+            fs::write(dir.join("model.txt"), "reviewed patch\n").unwrap();
+            let reset = if flag == "--assume-unchanged" {
+                "--no-assume-unchanged"
+            } else {
+                "--no-skip-worktree"
+            };
+            git(&dir, &["update-index", reset, "model.txt"]).unwrap();
+        }
+        fs::create_dir(dir.join("build")).unwrap();
+        fs::write(dir.join("build/output"), "ignored build output").unwrap();
+        verify_tools(&profile, root, &lock).unwrap();
+        fs::write(dir.join("Extra.lean"), "unbound model").unwrap();
+        assert!(verify_tools(&profile, root, &lock)
+            .unwrap_err()
+            .to_string()
+            .contains("Untracked"));
+        fs::remove_file(dir.join("Extra.lean")).unwrap();
+        git(
+            &dir,
+            &[
+                "remote",
+                "set-url",
+                "origin",
+                "https://example.invalid/wrong.git",
+            ],
+        )
+        .unwrap();
+        assert!(verify_tools(&profile, root, &lock)
+            .unwrap_err()
+            .to_string()
+            .contains("origin"));
+        git(
+            &dir,
+            &[
+                "remote",
+                "set-url",
+                "origin",
+                "https://example.invalid/aeneas.git",
+            ],
+        )
+        .unwrap();
+        fs::write(profile.join("model.patch"), "tampered").unwrap();
+        assert!(verify_tools(&profile, root, &lock)
+            .unwrap_err()
+            .to_string()
+            .contains("patch changed"));
+        let mut missing = lock.clone();
+        missing["repositories"]
+            .as_object_mut()
+            .unwrap()
+            .remove("charon");
+        assert!(verify_tools(&profile, root, &missing)
+            .unwrap_err()
+            .to_string()
+            .contains("must include"));
+        fs::write(profile.join("opam.locked"), "different").unwrap();
+        assert!(verify_tools(&profile, root, &lock)
+            .unwrap_err()
+            .to_string()
+            .contains("OCaml"));
+    }
