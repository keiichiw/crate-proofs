+source_lock = "source.lock.json"
+source_dir = ".work/source"
+[profiles."aeneas/profiles/stage3/reports"]
+schema_version = 1
+command = ["stage3-report"]
+source_lock = "source.lock.json"
+source_dir = ".work/source"
+"#;
+        fs::write(temp.path().join("proofs-prepare.toml"), text).unwrap();
+        let selected = read_for(
+            temp.path(),
+            Some(Path::new("aeneas/profiles/stage3/reports/part-01.toml")),
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!(selected.command, ["stage3-report"]);
+        let selected = read_for(
+            temp.path(),
+            Some(Path::new("aeneas/profiles/stage3/proofs.toml")),
