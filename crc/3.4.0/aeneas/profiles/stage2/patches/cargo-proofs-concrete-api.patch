+fn concrete_public_apis(project: &Project, tool: &Tool) -> Result<Vec<scan::Contract>> {
+    use quote::ToTokens;
+    ensure!(
+        !tool.expand_api,
+        "Select concrete_api or expand_api, not both"
+    );
