        if algorithm.refin
        then
          do
          let poly1 ← core.num.U128.reverse_bits algorithm.poly
          let i1 ← 128#u8 - algorithm.width
          poly1 >>> i1
        else do
             let i1 ← 128#u8 - algorithm.width
             algorithm.poly <<< i1
      if algorithm.refin
      then crc128.update_table_loop3 crc1 bytes len i algorithm.refin poly
      else crc128.update_table_loop4 crc1 bytes len i algorithm.refin poly
